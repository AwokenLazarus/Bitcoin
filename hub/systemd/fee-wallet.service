[Unit]
Description=Lazarus fee-wallet refunds and jfaq fee sweep (hub, services node :9342)
After=hub-autounlock.service bitcoind-services.service lazarus-prime.service
Requires=bitcoind-services.service

[Service]
Type=oneshot
User=web
Group=web
SupplementaryGroups=btc-services
EnvironmentFile=/etc/lazarus/fee-wallet/env
ExecStart=/usr/bin/python3 /opt/lazarus/bin/fee_wallet.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/pool/fee-wallet /srv/pool/lazarus-pool
