[Unit]
Description=Lazarus pool site backend: read-only replica %i (:8889)
After=hub-autounlock.service lazarus-pool-writer.service
RequiresMountsFor=/srv/pool
[Service]
User=web
Group=web
SupplementaryGroups=btc-mining
WorkingDirectory=/opt/lazarus-pool
Environment=POOL_LISTEN_PORT=8889 POOL_UI_NO_WRITE=1 POOL_DB=/srv/pool/lazarus-pool/pool.sqlite
ExecStart=/usr/bin/python3 /opt/lazarus-pool/server.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/pool/lazarus-pool
[Install]
WantedBy=multi-user.target
