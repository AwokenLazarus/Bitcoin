[Unit]
Description=Bitcoin Knots (BLAKE2b) - lazarus-hub mining node
After=network-online.target srv-node\x2dmining.mount
Wants=network-online.target
RequiresMountsFor=/srv/node-mining

[Service]
User=btc-mining
Group=btc-mining
ExecStart=/opt/knots/current/bin/bitcoind -conf=/etc/bitcoin-mining/bitcoin.conf -datadir=/srv/node-mining/bitcoin -startupnotify='systemd-notify --ready' -shutdownnotify='systemd-notify --stopping'
Type=notify
NotifyAccess=all
Restart=always
RestartSec=15
TimeoutStartSec=infinity
TimeoutStopSec=900
LimitNOFILE=1048576
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/node-mining/bitcoin
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
