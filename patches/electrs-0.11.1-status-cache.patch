+/// Recently queried statuses of scripthashes no client subscribed to, kept so the next query for
+/// the same scripthash syncs only what changed since (new blocks, the mempool) instead of fetching
+/// every block of its history again. A block explorer asks get_balance, get_history and
+/// listunspent for one address page: without this that is three full rebuilds, each fetching every
+/// block the address appears in, while every other client waits (requests are served in turn).
+struct StatusCache {
+    entries: HashMap<ScriptHash, (ScriptHashStatus, u64)>,
+    tick: u64,
+}
+
+/// Statuses kept; the least recently used is dropped past this. An entry holds one address's
+/// history, capped by `index_lookup_limit`.
+const STATUS_CACHE_ENTRIES: usize = 256;
+
 /// Electrum RPC handler
 pub struct Rpc {
     tracker: Tracker,
     cache: Cache,
+    status_cache: Mutex<StatusCache>,
     rpc_duration: Histogram,
     daemon: Daemon,
     signal: Signal,
