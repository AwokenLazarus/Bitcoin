+    /// Answer from the cached status of an unsubscribed scripthash, brought up to date first. The
+    /// status is taken out of the cache while it syncs, so a failed sync simply drops it.
+    fn with_status<T>(
+        &self,
+        scripthash: ScriptHash,
+        f: impl FnOnce(&ScriptHashStatus) -> T,
+    ) -> Result<T> {
+        let cached = self
+            .status_cache
+            .lock()
+            .entries
+            .remove(&scripthash)
+            .map(|(status, _)| status);
+        let mut status = cached.unwrap_or_else(|| ScriptHashStatus::new(scripthash));
+        self.tracker
+            .update_scripthash_status(&mut status, &self.daemon, &self.cache)?;
+        let result = f(&status);
+        let mut cache = self.status_cache.lock();
+        cache.tick += 1;
+        let tick = cache.tick;
+        if cache.entries.len() >= STATUS_CACHE_ENTRIES {
+            let oldest = cache
+                .entries
+                .iter()
+                .min_by_key(|(_, (_, used))| *used)
+                .map(|(k, _)| *k);
+            if let Some(oldest) = oldest {
+                cache.entries.remove(&oldest);
+            }
+        }
+        cache.entries.insert(scripthash, (status, tick));
+        Ok(result)
+    }
+
