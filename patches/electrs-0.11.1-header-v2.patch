+
+    #[test]
+    fn roundtrips_the_wire_format() {
+        for v in &vectors() {
+            let wire = bytes(&v["serialized"]);
+            let h = HeaderV2::parse(&wire).unwrap();
+            assert_eq!(h.serialize(), wire, "{}", v["name"].as_str().unwrap());
