+
+    #[test]
+    fn size_is_read_from_the_version_field() {
+        let v2 = bytes(&vectors()[0]["serialized"]);
+        assert_eq!(header_size(&v2).unwrap(), HEADER_V2_SIZE);
+        // A v1 header: same first four bytes with bit 31 cleared.
+        let mut v1 = v2.clone();
+        v1[3] &= 0x7f;
+        assert_eq!(header_size(&v1).unwrap(), HEADER_V1_SIZE);
