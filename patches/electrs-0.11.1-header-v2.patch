+                v["asic_input"].as_str().unwrap(),
+                "{}: asic_input",
+                name
+            );
+            assert_eq!(s.blake2b_2, hex32(&v["blake2b_2"]), "{}: blake2b_2", name);
+            assert_eq!(
+                s.block_hash,
+                hex32(&v["block_hash"]),
+                "{}: block_hash",
+                name
+            );
