index 2abcf9d..61530bd 100644
--- a/src/tracker.rs
+++ b/src/tracker.rs
@@ -2,7 +2,7 @@ use std::ops::ControlFlow;
 
 use anyhow::{Context, Result};
 use bitcoin::{BlockHash, Txid};
-use bitcoin_slices::{bsl, Error::VisitBreak, Visit, Visitor};
+use bitcoin_slices::{bsl, Visitor};
 
 use crate::{
     cache::Cache,
@@ -10,6 +10,7 @@ use crate::{
     config::Config,
     daemon::Daemon,
     db::DBStore,
+    headerv2::{visit_block_txs, AnyHeader},
     index::Index,
     mempool::{FeeHistogram, Mempool},
     metrics::Metrics,
@@ -115,9 +116,14 @@ impl Tracker {
                 return; // keep first matching transaction
             }
             let mut visitor = FindTransaction::new(txid);
-            result = match bsl::Block::visit(&block, &mut visitor) {
-                Ok(_) | Err(VisitBreak) => visitor.found.map(|tx| (blockhash, tx)),
-                Err(e) => panic!("core returned invalid block: {:?}", e),
+            // Not `bsl::Block::visit`, which assumes an 80-byte header.
+            let header =
+                AnyHeader::parse(&block).expect("core returned an unparseable block header");
+            result = match visit_block_txs(&block, &header, &mut visitor) {
+                // `visit_block_txs` surfaces a visitor break as an error, and a
+                // break is how FindTransaction reports success, so both arms
+                // just ask the visitor what it found.
+                Ok(()) | Err(_) => visitor.found.map(|tx| (blockhash, tx)),
             };
         })?;
         Ok(result)
