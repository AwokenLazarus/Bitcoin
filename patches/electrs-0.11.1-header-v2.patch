+            assert_eq!(s.h1, hex32(&v["h1"]), "{}: h1", name);
+            assert_eq!(s.h2, hex32(&v["h2"]), "{}: h2", name);
+            assert_eq!(s.blake2b_1, hex32(&v["blake2b_1"]), "{}: blake2b_1", name);
+            assert_eq!(
