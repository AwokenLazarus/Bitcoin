+            // block_hash() must agree with the stage value once byte order is
+            // accounted for, since everything downstream uses the BlockHash.
+            assert_eq!(
+                h.block_hash().to_string(),
+                v["block_hash"].as_str().unwrap(),
+                "{}: BlockHash display",
+                name
