+    /// Fetched from mempool.guide/testnet4 (`block/<hash>/header`) and frozen
+    /// here so the test needs no network.
+    #[test]
+    fn matches_live_testnet4_headers() {
+        const LIVE: [(u32, &str, &str); 4] = [
+            (
+                149537,
+                "000000000068f60429c933dc0c8befbcc7edadb1cf8f8d0d7804c608fd736d82",
+                "000000a05119dc259b59eaefbccf48ecc15bfd50c499d9d65b500b361b1b600000000000\
+                 63be46460c5e75edfe6e1fba731e3fc096396af99c299e70625484ffc6f9184101fb896a\
+                 ffff001d986cd88b510d792301fb896a00000000b14cf00d010000000000000000000000\
+                 0f0000000000000000000000000000000000000021480200000000000000000000000000\
+                 0000000000000000000000000000000000000000",
+            ),
+            (
+                149538,
+                "000000000008b8d8f1ce043359100c971e3e0db6bb8ae8ac8618f554564d9177",
+                "000000a0826d73fd08c604780d8d8fcfb1adedc7bcef8b0cdc33c92904f6680000000000\
+                 a56c8509d818afaadcea27a066a820f5c8ac610bb0f8bc297528a52e8bf6c2d202fb896a\
+                 ffff001dbe7b778a800e881f02fb896a00000000b10cf00d010000000000000000000000\
+                 010000000000000000000000000000000000000022480200000000000000000000000000\
+                 0000000000000000000000000000000000000000",
+            ),
+            (
+                160500,
+                "0000000000143a4b1c5889b8ee9fe766dd5a1cc4c1fb142a60fffe35e79bc294",
+                "000000a0a698963b95f72a9ce39a58b3d6581ee672b9a99ab4131c9731ee030000000000\
+                 8c0588cbf7b1fb3f81ac8fd0ae6f3b473a2f2033519e3f46896a0df91137292244198a6a\
+                 c0ff3f1b8607cf6e52202e3744198a6a00000000b14cf00d010000000000000000000000\
+                 0100000000000000000000000000000000000000f4720200000000000000000000000000\
+                 0000000000000000000000000000000000000000",
+            ),
+            (
+                169000,
+                "000000000000324e94407a3c8335ead2213d881a105b1cc6c0797e0713b26d86",
+                "000000a01dcfc4f5d4c36dc2f87ff8a85d917fd831943afa67cd32767036000000000000\
+                 2cec7771eee23efd0994a49788eb85d691c2e4ab5e15fffb58ab9e0278592cfa799f8b6a\
+                 c0ff3f1af597cee794573e760000000000000000b10cf00d0300000000000000799f8b6a\
