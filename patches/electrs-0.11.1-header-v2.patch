+    /// The transaction walk over real blocks of both versions.
+    ///
+    /// This is the failure that would not announce itself. `bsl::Block::visit`
+    /// reads the transaction count from offset 80 unconditionally, so on a
+    /// 164-byte header it takes four bytes of `m_extranonce` as the count and
+    /// parses transactions out of the middle of the header. That does not
+    /// necessarily error; it can just index the wrong things. So the assertion
+    /// that matters is the transaction *count*, checked against what the node
+    /// reported, plus every txid matching.
+    #[test]
+    fn walks_transactions_in_blocks_of_both_versions() {
+        use bitcoin_slices::{bsl, Visit, Visitor};
+        use core::ops::ControlFlow;
+
+        let raw = include_str!("tests/blake2b_regtest.json");
+        let doc: serde_json::Value = serde_json::from_str(raw).unwrap();
+
+        #[derive(Default)]
+        struct Count {
+            txs: Vec<String>,
+            announced: usize,
+        }
+        impl Visitor for Count {
+            fn visit_block_begin(&mut self, total: usize) {
+                self.announced = total;
+            }
+            fn visit_transaction(&mut self, tx: &bsl::Transaction) -> ControlFlow<()> {
+                self.txs.push(crate::types::bsl_txid(tx).to_string());
+                ControlFlow::Continue(())
+            }
+        }
+
+        let mut saw_v1 = false;
+        let mut saw_v2_multi_tx = false;
+        for (height, entry) in doc["blocks"].as_object().unwrap() {
+            let block = bytes(&entry["raw"]);
+            let ntx = entry["ntx"].as_u64().unwrap() as usize;
+
+            let header = AnyHeader::parse(&block).unwrap();
+            assert_eq!(
+                header.block_hash().to_string(),
+                entry["hash"].as_str().unwrap(),
+                "block {} hash",
+                height
+            );
+
+            let mut v = Count::default();
+            visit_block_txs(&block, &header, &mut v)
+                .unwrap_or_else(|e| panic!("block {}: {}", height, e));
+
+            assert_eq!(v.announced, ntx, "block {} announced tx count", height);
+            assert_eq!(v.txs.len(), ntx, "block {} visited tx count", height);
+            assert!(
+                v.txs.iter().all(|t| t.len() == 64),
+                "block {} produced a malformed txid, so the walk was misaligned",
+                height
+            );
+
+            if header.is_v2() {
+                if ntx > 1 {
+                    saw_v2_multi_tx = true;
+                }
+            } else {
+                saw_v1 = true;
+                // On a v1 block our walker must agree with the upstream one,
+                // byte for byte, since that path is unchanged in production.
+                let mut u = Count::default();
+                bsl::Block::visit(&block, &mut u).unwrap();
+                assert_eq!(u.txs, v.txs, "block {} diverges from bsl::Block", height);
+            }
+        }
+        assert!(saw_v1, "fixture needs a v1 block");
+        assert!(
+            saw_v2_multi_tx,
+            "fixture needs a v2 block with more than just a coinbase, \
+             or the walk is only proven on the trivial case"
+        );
+    }
+
+    /// The specific silent corruption this design avoids: handing a v2 block to
+    /// the upstream fixed-80-byte walker.
+    ///
+    /// Recorded as a test because "it would have errored anyway" is the natural
+    /// assumption and it is not true. On this fixture, offset 80 lands in
+    /// `m_nonce2`, whose first byte is zero, so `bsl::Block::visit` reads a
+    /// transaction count of 0, returns `Ok`, and visits nothing. A block with
+    /// four transactions indexes as empty, with no error anywhere. The real
+    /// count varint is at offset 164 and reads 4.
+    ///
+    /// That byte is miner-controlled, so the exact damage varies: zero means
+    /// silently dropping the block's transactions, a large value means a parse
+    /// error, and something in between means indexing garbage as transactions.
+    /// The assertion below is therefore only that upstream does not accidentally
+    /// get it right.
+    #[test]
+    fn upstream_walker_mishandles_a_v2_block() {
+        use bitcoin_slices::{bsl, Visit, Visitor};
+        use core::ops::ControlFlow;
+
+        struct Count(usize);
+        impl Visitor for Count {
+            fn visit_transaction(&mut self, _tx: &bsl::Transaction) -> ControlFlow<()> {
+                self.0 += 1;
+                ControlFlow::Continue(())
+            }
+        }
+
+        let doc: serde_json::Value =
+            serde_json::from_str(include_str!("tests/blake2b_regtest.json")).unwrap();
+        let entry = &doc["blocks"]["131"];
+        let block = bytes(&entry["raw"]);
+        let real_ntx = entry["ntx"].as_u64().unwrap() as usize;
+        assert!(real_ntx > 1);
+
+        let mut c = Count(0);
+        let upstream = bsl::Block::visit(&block, &mut c);
+        // Either it errors, or it "succeeds" with the wrong transactions. What
+        // it must not do is quietly agree with the truth.
+        let agreed = upstream.is_ok() && c.0 == real_ntx;
+        assert!(
+            !agreed,
+            "bsl::Block::visit accepted a v2 block and found the right {} transactions, \
+             which would mean this whole replacement is unnecessary",
+            real_ntx
+        );
+        // And specifically, on this fixture, it fails by succeeding.
+        assert!(
+            upstream.is_ok() && c.0 == 0,
+            "expected the silent case: Ok with zero transactions, got ok={} txs={}",
+            upstream.is_ok(),
+            c.0
+        );
+    }
+
+    /// The v2 payload must stay boxed.
+    ///
+    /// `Chain` holds one `AnyHeader` per block for the whole chain, so this
+    /// type's size is multiplied by the height: at 900k blocks, every extra 8
+    /// bytes is another 7 MB of resident memory on a box that is often also
+    /// running two Bitcoin nodes. Inlining the 164-byte v2 payload would take
+    /// the enum from 88 bytes to 168 and cost about 80 MB on a chain where every
+    /// header is v1 anyway.
+    #[test]
+    fn v2_payload_stays_boxed() {
+        use std::mem::size_of;
+        // No padding: every field aligns to 4 or less and 164 is a multiple of 4.
+        assert_eq!(
+            size_of::<HeaderV2>(),
+            HEADER_V2_SIZE,
+            "unexpected HeaderV2 layout"
+        );
+        assert!(
+            size_of::<AnyHeader>() <= size_of::<HeaderV1>() + 8,
+            "AnyHeader grew to {} bytes, larger than a v1 header plus a discriminant. \
+             Did the Box around HeaderV2 get removed?",
+            size_of::<AnyHeader>()
+        );
+    }
+
+    /// `rust-bitcoin`'s own block decoder on a v2 block.
+    ///
+    /// This is why `HeaderV2` exists at all, and it matters beyond electrs:
+    /// `btc-rpc-proxy`, which is what serves blocks bitcoind has pruned, decodes
+    /// peer blocks with exactly this and then checks `block_hash()` against the
+    /// hash it asked for. So on a BLAKE2b chain the proxy cannot serve a pruned
+    /// block, and the pruning support and the header-v2 support do not compose
+    /// until the proxy is taught the format too.
+    ///
+    /// Observed: strict `deserialize` refuses with "data not consumed entirely",
+    /// having read a transaction count of zero from offset 80 and left the rest
+    /// of the block unread. A lenient decode would instead yield a
+    /// zero-transaction block whose SHA256d hash is not the block's hash. Either
+    /// way the proxy's check fails.
+    #[test]
+    fn rust_bitcoin_mishandles_a_v2_block() {
+        let doc: serde_json::Value =
+            serde_json::from_str(include_str!("tests/blake2b_regtest.json")).unwrap();
+        let entry = &doc["blocks"]["131"];
+        let block = bytes(&entry["raw"]);
+        let real_ntx = entry["ntx"].as_u64().unwrap() as usize;
+        let real_hash = entry["hash"].as_str().unwrap();
+
+        match bitcoin::consensus::deserialize::<bitcoin::Block>(&block) {
+            Err(_) => { /* fine: it refuses, loudly */ }
+            Ok(b) => {
+                // It did not refuse. Then it must at least be wrong, or this
+                // whole module is unnecessary.
+                assert_ne!(
+                    b.block_hash().to_string(),
+                    real_hash,
+                    "rust-bitcoin computed the correct BLAKE2b block hash, which it cannot do"
+                );
+                assert_ne!(
+                    b.txdata.len(),
+                    real_ntx,
+                    "rust-bitcoin found the right transaction count in a v2 block"
+                );
+            }
+        }
+
+        // And the same bytes through AnyHeader give the hash the node reported.
+        assert_eq!(
+            AnyHeader::parse(&block).unwrap().block_hash().to_string(),
+            real_hash
+        );
+    }
+
+    #[test]
+    fn rejects_a_truncated_run() {
+        let v2 = bytes(&vectors()[0]["serialized"]);
+        assert!(AnyHeader::parse_all(&v2[..HEADER_V2_SIZE - 1]).is_err());
+    }
+}
