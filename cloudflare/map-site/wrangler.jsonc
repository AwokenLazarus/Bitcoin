{
  // lazarus-xbt.xyz/map: galaxy map of the XBT (BLAKE2b Bitcoin) network. Public data only.
  "name": "lazarus-map",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lazarus-xbt.xyz", "custom_domain": true }],
  // The Worker runs first only for the two pages it fills with live figures (src/hubfill.js).
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": ["/", "/ecosystem/"] },
  "kv_namespaces": [{ "binding": "GALAXY", "id": "8242de880afd41f79e03b586eb16e227" }],
  // Lazarus Key app builds: too large for Workers assets, so they are served from R2.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "lazarus-key-downloads" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
