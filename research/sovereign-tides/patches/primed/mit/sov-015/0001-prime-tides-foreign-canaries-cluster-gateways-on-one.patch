+    #[test]
+    fn a_shared_template_source_is_one_cluster_and_splits_independence() {
+        let mut e = engine();
+        let gws = ["t1", "t2", "t3", "honest"];
+        let c = |k: u64, i: u64| format!("{:064x}", 0xf000 + k * 10 + i);
+        for k in 0..12u64 {
+            let t0 = k as f64 * 300.0;
+            for (i, g) in gws.iter().enumerate() {
+                let others: Vec<String> = gws.iter().filter(|o| *o != g).map(|o| o.to_uppercase()).collect();
+                let canary = Canary::new(t0 + i as f64, c(k, i as u64));
+                // targets are matched case-blind; the source itself and repeats are skipped
+                let mut targets = others.clone();
+                targets.push(g.to_string());
+                targets.push(others[0].clone());
+                assert_eq!(e.note_foreign(g, &canary, &targets), others.iter().map(|o| o.to_lowercase()).collect::<Vec<_>>());
+                e.note_canary(g, canary);
+            }
+            let on_t: Vec<String> = (0..3).map(|i| c(k, i)).collect();
+            for g in ["t1", "t2", "t3"] {
+                e.note_check_demo(g, t0 + 45.0, &on_t);
+            }
+            e.note_check_demo("honest", t0 + 45.0, &[c(k, 3)]);
+        }
+        let rows = e.detector_rows();
+        assert_eq!(e.shared_sources(), vec![vec!["t1".to_string(), "t2".into(), "t3".into()]]);
+        for g in ["t1", "t2", "t3"] {
+            let f = &rows[g];
+            assert_eq!((f.canaries_due, f.canary_hits, f.foreign_due, f.foreign_hits), (12, 12, 36, 24), "{g}");
+            assert_eq!(f.flag_reasons, vec!["shared-template-source"]);
+            assert!(!f.flagged);
+            assert_eq!(e.independence_of(g), 333_000, "{g}");
+        }
+        assert_eq!((rows["honest"].foreign_due, rows["honest"].foreign_hits), (36, 0));
+        assert_eq!(e.independence_of("honest"), 1_000_000);
+        assert!(e.flagged().is_empty());
+        let body = e.current().body.clone();
+        assert_eq!(body["shared_sources"], json!([["t1", "t2", "t3"]]));
+        assert_eq!(body["gateways"]["t1"]["shared_source"], json!(["t2", "t3"]));
+        assert_eq!(body["gateways"]["t1"]["foreign"]["t2"], json!({"due": 12, "hits": 12}));
+        assert_eq!(body["gateways"]["honest"]["foreign"]["t1"], json!({"due": 12, "hits": 0}));
+        assert!((body["gateways"]["t1"]["weight"].as_f64().unwrap() - 0.333).abs() < 1e-9);
+        // a block settles every copy of a canary at once: t1's k=0 canary is then due nowhere
+        assert!(e.note_canary_mined(&c(0, 0), 1, 5.0));
+        let rows = e.detector_rows();
+        assert_eq!((rows["t1"].canaries_due, rows["t2"].foreign["t1"].due, rows["honest"].foreign["t1"].due), (11, 11, 11));
+    }
