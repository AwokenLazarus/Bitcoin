+    #[test]
+    fn a_block_at_five_seconds_does_not_penalise_the_honest_gateway() {
+        let empty = PoolView::new(std::iter::empty());
+        // every canary is checked at +45; 12 stay in the mempool, 40 are beaten by a block at +5
+        let mut canaries = Vec::new();
+        let mut honest = Vec::new();
+        let mut proxy = Vec::new();
+        for k in 0..52u64 {
+            let t = 1_000.0 + k as f64 * 300.0;
+            let c = Canary::new(t, hex32(9_100_000 + k));
+            let early = k >= 12;
+            // the honest node templates C unless C′ was mined first; the proxy never has C
+            honest.push(Check::new(t + 45.0, &if early { vec![hex32(5)] } else { vec![c.txid.clone(), hex32(5)] }));
+            proxy.push(Check::new(t + 45.0, &[hex32(5)]));
+            canaries.push((c, early));
+        }
+        let run = |fixed: bool, checks: &[Check]| {
+            let cs: Vec<Canary> = canaries
+                .iter()
+                .map(|(c, early)| if fixed && *early { c.clone().mined_at(100, c.t + 5.0) } else { c.clone() })
+                .collect();
+            features_checked(&[], &empty, &cs.iter().collect::<Vec<_>>(), &checks.iter().collect::<Vec<_>>())
+        };
+        let before = run(false, &honest);
+        assert!(before.flagged && before.canaries_due == 52 && before.canary_hits == 12, "{before:?}");
+        let after = run(true, &honest);
+        assert_eq!((after.canaries_due, after.canary_hits), (12, 12), "{after:?}");
+        assert!(!after.flagged && after.independence == 1.0, "{after:?}");
+        // the proxy: its 12 mempool canaries are still due and still missed
+        let p = run(true, &proxy);
+        assert_eq!((p.canaries_due, p.canary_hits), (12, 0), "{p:?}");
+        assert!(p.flagged && p.flag_reasons == vec!["own-canaries-missed"], "{p:?}");
+    }
