+    #[test]
+    fn a_canary_mined_before_its_first_due_check_is_not_due() {
+        let empty = PoolView::new(std::iter::empty());
+        let c = Canary::new(1_000.0, hex32(9_000_002));
+        // the gateway's node switched to the block that mined C′: its job at +45 lacks C
