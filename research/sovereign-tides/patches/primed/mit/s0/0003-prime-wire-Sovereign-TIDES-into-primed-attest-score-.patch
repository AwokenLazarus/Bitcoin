@@ -0,0 +1,489 @@
+//! Template-entropy detector (research note C.2 #5 / XBT-051 `entropy.py`).
+//!
+//! Prime already sees every gateway's jobs. From those snapshots, against the pool node's
+//! own templates, this scores how independently a gateway is building:
+//!
+//! * `identical` — merkle branches equal a pool template on the same parent in the last
+//!   `window` seconds (a straight proxy).
+//! * `lead` — share of the gateway's txs it templated before the pool did. A copy can never
+//!   be ahead of its source.
+//! * `subset` (containment) — share of each template's txs the pool's recent templates
+//!   already had.
+//!
+//! ```text
+//! follower     = subset × (1 − min(1, lead / lead_ref))
+//! independence = 1 − max(identical, follower)
+//! ```
+//!
+//! Fewer than 20 comparable snapshots scores 0: an unknown gateway earns no bonus.
+//! Switch lag and lockstep are reported but not scored (on a LAN honest nodes lockstep too).
+
+use serde::Serialize;
+
+const WINDOW: f64 = 3.0;
+const LOCKSTEP: f64 = 0.25;
+const LEAD_MARGIN: f64 = 0.1;
+const LEAD_REF: f64 = 0.25;
+const MIN_COMPARED: usize = 20;
+const CLUSTER_THRESHOLD: f64 = 0.8;
+
+/// One template snapshot, as Prime would log it from a DATUM job (or the pool node poll).
+#[derive(Clone, Debug, PartialEq, Serialize)]
+pub struct Snapshot {
+    /// Unix seconds (fractional).
+    pub t: f64,
+    /// Previous block hash, hex (either endian; compared as a string).
+    pub prev: String,
+    /// Non-coinbase txids in template order, hex.
+    pub txids: Vec<String>,
+}
+
+impl Snapshot {
+    pub fn new(t: f64, prev: impl Into<String>, txids: Vec<String>) -> Self {
+        Snapshot { t, prev: prev.into(), txids }
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct Features {
+    pub snapshots: usize,
+    pub compared: usize,
+    pub identical: f64,
+    pub branch_sim: f64,
+    pub jaccard: f64,
+    pub jaccard_hi: f64,
+    pub switches: usize,
+    pub switch_lag: Option<f64>,
+    pub lockstep: f64,
+    pub incl_lag: Option<f64>,
+    pub lead: f64,
+    pub subset: f64,
+    pub follower: f64,
+    pub independence: f64,
+    pub insufficient: bool,
+}
+
+#[derive(Clone)]
+struct Prepared {
+    t: f64,
+    prev: String,
+    txids: Vec<String>,
+    br: Vec<Vec<u8>>,
+}
+
+fn dsha(b: &[u8]) -> [u8; 32] {
+    use sha2::{Digest, Sha256};
+    let first = Sha256::digest(b);
+    Sha256::digest(first).into()
+}
+
+fn decode_txid(hex: &str) -> Option<[u8; 32]> {
+    let raw = hex::decode(hex).ok()?;
+    if raw.len() != 32 {
+        return None;
+    }
+    let mut out = [0u8; 32];
+    out.copy_from_slice(&raw);
+    out.reverse();
+    Some(out)
+}
+
+/// Stratum merkle branches for the coinbase path, from the template's txids (hex).
+pub fn branches(txids: &[String]) -> Vec<Vec<u8>> {
+    let mut out = Vec::new();
+    let mut level: Vec<Option<[u8; 32]>> = std::iter::once(None).chain(txids.iter().filter_map(|t| decode_txid(t).map(Some))).collect();
+    // if a txid failed to decode, still keep a placeholder so the caller sees a mismatch
+    if level.len() != txids.len() + 1 {
+        level = std::iter::once(None)
+            .chain(txids.iter().map(|t| decode_txid(t).or_else(|| {
+                let mut h = [0u8; 32];
+                let b = t.as_bytes();
+                let n = b.len().min(32);
+                h[..n].copy_from_slice(&b[..n]);
+                Some(h)
+            })))
+            .collect();
+    }
+    while level.len() > 1 {
+        if let Some(b) = level.get(1).and_then(|x| *x) {
+            out.push(b.to_vec());
+        } else {
+            out.push(vec![0; 32]);
+        }
+        if level.len() % 2 == 1 {
+            level.push(*level.last().unwrap());
+        }
+        level = level
+            .chunks(2)
+            .map(|p| match (p[0], p[1]) {
+                (Some(a), Some(b)) => {
+                    let mut cat = [0u8; 64];
+                    cat[..32].copy_from_slice(&a);
+                    cat[32..].copy_from_slice(&b);
+                    Some(dsha(&cat))
+                }
+                _ => None,
+            })
+            .collect();
+    }
+    out
+}
+
+/// b10c-style weighted similarity of two branch lists (1.0 = same template).
+pub fn branch_sim(a: &[Vec<u8>], b: &[Vec<u8>]) -> f64 {
+    let n = a.len().max(b.len());
+    if n == 0 {
+        return 1.0;
+    }
+    let mut same = 0u64;
+    let mut total = 0u64;
+    for i in 0..n {
+        let w = 1u64 << i;
+        total += w;
+        if i < a.len() && i < b.len() && a[i] == b[i] {
+            same += w;
+        }
+    }
+    same as f64 / total as f64
+}
+
+pub fn jaccard(a: &[String], b: &[String]) -> f64 {
+    use std::collections::HashSet;
+    let aa: HashSet<&str> = a.iter().map(String::as_str).collect();
+    let bb: HashSet<&str> = b.iter().map(String::as_str).collect();
+    if aa.is_empty() && bb.is_empty() {
+        return 1.0;
+    }
+    let inter = aa.intersection(&bb).count();
+    let union = aa.union(&bb).count();
+    inter as f64 / union as f64
+}
+
+fn prep(snaps: &[Snapshot]) -> Vec<Prepared> {
+    let mut v: Vec<Prepared> = snaps
+        .iter()
+        .map(|s| Prepared { t: s.t, prev: s.prev.clone(), txids: s.txids.clone(), br: branches(&s.txids) })
+        .collect();
+    v.sort_by(|a, b| a.t.partial_cmp(&b.t).unwrap_or(std::cmp::Ordering::Equal));
+    v
+}
+
+fn first_on_parent(snaps: &[Prepared]) -> std::collections::HashMap<String, f64> {
+    let mut first = std::collections::HashMap::new();
+    for s in snaps {
+        first.entry(s.prev.clone()).or_insert(s.t);
+    }
+    first
+}
+
+fn first_seen(snaps: &[Prepared]) -> std::collections::HashMap<String, f64> {
+    let mut seen = std::collections::HashMap::new();
+    for s in snaps {
+        for t in &s.txids {
+            seen.entry(t.clone()).or_insert(s.t);
+        }
+    }
+    seen
+}
+
+fn median(mut v: Vec<f64>) -> Option<f64> {
+    if v.is_empty() {
+        return None;
+    }
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    let n = v.len();
+    Some(if n % 2 == 1 { v[n / 2] } else { (v[n / 2 - 1] + v[n / 2]) / 2.0 })
+}
+
+/// Detector features for `gw` against the pool node's snapshots.
+pub fn features(gw: &[Snapshot], pool: &[Snapshot]) -> Features {
+    let gw = prep(gw);
+    let pool = prep(pool);
+    let mut by_prev: std::collections::HashMap<&str, Vec<&Prepared>> = std::collections::HashMap::new();
+    for p in &pool {
+        by_prev.entry(p.prev.as_str()).or_default().push(p);
+    }
+    let mut ident = 0usize;
+    let mut sims = 0.0;
+    let mut jacs = 0.0;
+    let mut jhi = 0usize;
+    let mut n = 0usize;
+    for s in &gw {
+        let Some(cands) = by_prev.get(s.prev.as_str()) else { continue };
+        let cands: Vec<&&Prepared> =
+            cands.iter().filter(|p| s.t - WINDOW <= p.t && p.t <= s.t + 0.05).collect();
+        if cands.is_empty() {
+            continue;
+        }
+        n += 1;
+        if cands.iter().any(|p| p.br == s.br) {
+            ident += 1;
+        }
+        let near = cands
+            .iter()
+            .min_by(|a, b| {
+                let da = if a.t <= s.t { s.t - a.t } else { 1e9 };
+                let db = if b.t <= s.t { s.t - b.t } else { 1e9 };
+                da.partial_cmp(&db).unwrap_or(std::cmp::Ordering::Equal)
+            })
+            .unwrap();
+        sims += branch_sim(&s.br, &near.br);
+        let j = jaccard(&s.txids, &near.txids);
+        jacs += j;
+        if j >= 0.98 {
+            jhi += 1;
+        }
+    }
+    let pf = first_on_parent(&pool);
+    let gf = first_on_parent(&gw);
+    let mut lags: Vec<f64> = gf.iter().filter_map(|(p, &gt)| pf.get(p).map(|&pt| gt - pt)).collect();
+    if lags.len() > 1 {
+        lags.remove(0);
+    }
+    let pseen = first_seen(&pool);
+    let gseen = first_seen(&gw);
+    let incl: Vec<f64> = gseen.iter().filter_map(|(t, &gt)| pseen.get(t).map(|&pt| gt - pt)).collect();
+    let lead = if gseen.is_empty() {
+        0.0
+    } else {
+        gseen
+            .iter()
+            .filter(|(t, &gt)| pseen.get(*t).is_none_or(|&pt| gt < pt - LEAD_MARGIN))
+            .count() as f64
+            / gseen.len() as f64
+    };
+    let mut sub = 0.0;
+    let mut subn = 0usize;
+    for s in &gw {
+        if s.txids.is_empty() {
+            continue;
+        }
+        let mut recent = std::collections::HashSet::new();
+        if let Some(cands) = by_prev.get(s.prev.as_str()) {
+            for p in cands {
+                if s.t - WINDOW <= p.t && p.t <= s.t + 0.05 {
+                    recent.extend(p.txids.iter().cloned());
+                }
+            }
+        }
+        if !recent.is_empty() {
+            subn += 1;
+            let hit = s.txids.iter().filter(|t| recent.contains(*t)).count();
+            sub += hit as f64 / s.txids.len() as f64;
+        }
+    }
+    let identical = if n > 0 { ident as f64 / n as f64 } else { 0.0 };
+    let subset = if subn > 0 { sub / subn as f64 } else { 0.0 };
+    let follower = subset * (1.0 - (lead / LEAD_REF).min(1.0));
+    let insufficient = n < MIN_COMPARED;
+    let independence = if insufficient { 0.0 } else { (1.0 - identical.max(follower)).max(0.0) };
+    Features {
+        snapshots: gw.len(),
+        compared: n,
+        identical,
+        branch_sim: if n > 0 { sims / n as f64 } else { 0.0 },
+        jaccard: if n > 0 { jacs / n as f64 } else { 0.0 },
+        jaccard_hi: if n > 0 { jhi as f64 / n as f64 } else { 0.0 },
+        switches: lags.len(),
+        switch_lag: median(lags.clone()),
+        lockstep: if lags.is_empty() {
+            0.0
+        } else {
+            lags.iter().filter(|x| x.abs() <= LOCKSTEP).count() as f64 / lags.len() as f64
+        },
+        incl_lag: median(incl),
+        lead,
+        subset,
+        follower,
+        independence: if insufficient { 0.0 } else { (independence * 1000.0).round() / 1000.0 },
+        insufficient,
+    }
+}
+
+/// Share of `a`'s snapshots whose branches equal one of `b`'s (same parent, within window).
+pub fn pair_identical(a: &[Snapshot], b: &[Snapshot]) -> f64 {
+    let a = prep(a);
+    let b = prep(b);
+    let mut idx: std::collections::HashMap<(String, Vec<Vec<u8>>), Vec<f64>> = std::collections::HashMap::new();
+    for s in &b {
+        idx.entry((s.prev.clone(), s.br.clone())).or_default().push(s.t);
+    }
+    if a.is_empty() {
+        return 0.0;
+    }
+    let hits = a
+        .iter()
+        .filter(|s| {
+            idx.get(&(s.prev.clone(), s.br.clone())).is_some_and(|ts| ts.iter().any(|t| (t - s.t).abs() <= WINDOW))
+        })
+        .count();
+    hits as f64 / a.len() as f64
+}
+
+/// Single-linkage clusters of gateways whose templates are identical ≥ 80% of the time.
+pub fn clusters(gws: &std::collections::BTreeMap<String, Vec<Snapshot>>) -> Vec<Vec<String>> {
+    let names: Vec<String> = gws.keys().cloned().collect();
+    let mut parent: std::collections::HashMap<String, String> = names.iter().map(|n| (n.clone(), n.clone())).collect();
+    fn root(parent: &mut std::collections::HashMap<String, String>, mut x: String) -> String {
+        while parent[&x] != x {
+            x = parent[&x].clone();
+        }
+        x
+    }
+    for (i, a) in names.iter().enumerate() {
+        for b in names.iter().skip(i + 1) {
+            let ab = pair_identical(&gws[a], &gws[b]);
+            let ba = pair_identical(&gws[b], &gws[a]);
+            if ab.min(ba) >= CLUSTER_THRESHOLD {
+                let ra = root(&mut parent, a.clone());
+                let rb = root(&mut parent, b.clone());
+                parent.insert(ra, rb);
+            }
+        }
+    }
+    let mut out: std::collections::HashMap<String, Vec<String>> = std::collections::HashMap::new();
+    for n in &names {
+        out.entry(root(&mut parent, n.clone())).or_default().push(n.clone());
+    }
+    for v in out.values_mut() {
+        v.sort();
+    }
+    let mut groups: Vec<Vec<String>> = out.into_values().collect();
+    groups.sort_by(|a, b| b.len().cmp(&a.len()).then_with(|| a.cmp(b)));
+    groups
+}
+
+pub fn report(
+    gws: &std::collections::BTreeMap<String, Vec<Snapshot>>,
+    pool: &[Snapshot],
+) -> (std::collections::BTreeMap<String, Features>, Vec<Vec<String>>) {
+    let rows = gws.iter().map(|(g, s)| (g.clone(), features(s, pool))).collect();
+    let mut all = gws.clone();
+    all.insert("POOL".into(), pool.to_vec());
+    let cl = clusters(&all);
+    (rows, cl)
+}
+
+/// Independence as parts-per-million for the TIDES bonus weight.
+pub fn independence_ppm(f: &Features) -> u32 {
+    (f.independence.clamp(0.0, 1.0) * 1_000_000.0).round() as u32
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn hex32(i: u64) -> String {
+        format!("{i:064x}")
+    }
+
+    /// Pool templates, an honest node with its own relay view, a proxy and a mimic.
+    fn synth(n: usize, seed: u64) -> (Vec<Snapshot>, Vec<Snapshot>, Vec<Snapshot>, Vec<Snapshot>) {
+        let mut s = seed;
+        let mut next = |m: u64| {
+            s = s.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+            (s >> 33) % m
+        };
+        let mut pool = Vec::new();
+        let mut honest = Vec::new();
+        let mut proxy = Vec::new();
+        let mut mimic = Vec::new();
+        let mut mp_pool: Vec<String> = Vec::new();
+        let mut mp_h: Vec<String> = Vec::new();
+        let mut prev = "aa".to_string();
+        for i in 0..n {
+            let t = i as f64 * 0.5;
+            if i % 30 == 0 {
+                prev = hex32(i as u64);
+                mp_pool.clear();
+                mp_h.clear();
+            }
+            let extra = next(3) as usize;
+            for _ in 0..extra {
+                let tx = hex32(next(u64::MAX));
+                if next(2) == 0 {
+                    mp_pool.push(tx);
+                } else {
+                    mp_h.push(tx);
+                }
+            }
+            for tx in mp_pool.iter().rev().take(3).cloned().collect::<Vec<_>>() {
+                if !mp_h.contains(&tx) && next(10) < 4 {
+                    mp_h.push(tx);
+                }
+            }
+            for tx in mp_h.iter().rev().take(3).cloned().collect::<Vec<_>>() {
+                if !mp_pool.contains(&tx) && next(10) < 4 {
+                    mp_pool.push(tx);
+                }
+            }
+            pool.push(Snapshot::new(t, prev.clone(), mp_pool.clone()));
+            honest.push(Snapshot::new(t + 0.01, prev.clone(), mp_h.clone()));
+            proxy.push(Snapshot::new(t + 0.05, prev.clone(), mp_pool.clone()));
+            let mut m = mp_pool.clone();
+            // Fisher–Yates
+            for i in (1..m.len()).rev() {
+                let j = next((i + 1) as u64) as usize;
+                m.swap(i, j);
+            }
+            mimic.push(Snapshot::new(t + 0.8, prev.clone(), m));
+        }
+        (pool, honest, proxy, mimic)
+    }
+
+    #[test]
+    fn separates_honest_from_copies() {
+        let (pool, honest, proxy, mimic) = synth(200, 1);
+        let fh = features(&honest, &pool);
+        let fp = features(&proxy, &pool);
+        let fm = features(&mimic, &pool);
+        assert!(fp.independence < 0.05, "proxy {}", fp.independence);
+        assert!(fm.independence < 0.2, "mimic {}", fm.independence);
+        assert!(fh.independence > 0.8, "honest {}", fh.independence);
+        assert_eq!(fp.lead, 0.0);
+    }
+
+    #[test]
+    fn unknown_earns_nothing() {
+        let (pool, honest, _, _) = synth(10, 1);
+        let f = features(&honest, &pool);
+        assert!(f.insufficient);
+        assert_eq!(f.independence, 0.0);
+    }
+
+    #[test]
+    fn clusters_group_the_proxy_with_the_pool() {
+        let (pool, honest, proxy, _) = synth(200, 1);
+        let mut gws = std::collections::BTreeMap::new();
+        gws.insert("POOL".into(), pool);
+        gws.insert("H".into(), honest);
+        gws.insert("X".into(), proxy);
+        let cl = clusters(&gws);
+        assert!(cl.iter().any(|c| c == &vec!["POOL".to_string(), "X".to_string()]), "{cl:?}");
+    }
+
+    #[test]
+    fn branch_similarity() {
+        let a = branches(&[hex32(0x11), hex32(0x22), hex32(0x33)]);
+        assert_eq!(branch_sim(&a, &a), 1.0);
+        let b = branches(&[hex32(0x11), hex32(0x22), hex32(0x44)]);
+        let s = branch_sim(&a, &b);
+        assert!(s < 1.0 && s > 0.0, "{s}");
+    }
+
+    #[test]
+    fn a_straight_copy_is_identical_and_scores_zero() {
+        let pool = vec![
+            Snapshot::new(1.0, "p", vec![hex32(1), hex32(2), hex32(3)]),
+            Snapshot::new(2.0, "p", vec![hex32(1), hex32(2), hex32(3), hex32(4)]),
+        ];
+        // 30 copies so compared ≥ 20
+        let mut gw = Vec::new();
+        for i in 0..30 {
+            gw.push(Snapshot::new(1.0 + i as f64 * 0.05, "p", vec![hex32(1), hex32(2), hex32(3)]));
+        }
+        let f = features(&gw, &pool);
+        assert!(f.identical > 0.9, "{}", f.identical);
+        assert_eq!(f.independence, 0.0);
+    }
+}
