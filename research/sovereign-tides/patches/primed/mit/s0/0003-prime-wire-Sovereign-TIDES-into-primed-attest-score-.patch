+fn ingest(shared: &Shared, path: &str, body: &str) -> Result<Value, String> {
+    let demo = shared.sovereignty.lock().unwrap().demo();
+    let v: Value = if body.trim().is_empty() { json!({}) } else { serde_json::from_str(body).map_err(|e| e.to_string())? };
+    match path {
+        "/sovereignty/register" => {
+            let g = v["g"].as_str().ok_or("g")?;
+            let payout = v["payout"].as_str().unwrap_or("");
+            let house = v["house"].as_bool().unwrap_or(false);
+            let sig = v["sig"].as_str();
+            let rec = shared.sovereignty.lock().unwrap().register(g, payout, house, sig)?;
+            Ok(serde_json::to_value(rec).unwrap())
+        }
+        "/sovereignty/snapshot" => {
+            if !demo {
+                return Err("sovereignty-demo is off".into());
+            }
+            let gw = v["gateway"].as_str().ok_or("gateway")?;
+            let t = v["t"].as_f64().ok_or("t")?;
+            let prev = v["prev"].as_str().ok_or("prev")?;
+            let txids = v["txids"].as_array().ok_or("txids")?
+                .iter()
+                .filter_map(|x| x.as_str().map(str::to_string))
+                .collect();
+            shared.sovereignty.lock().unwrap().note_snapshot(gw, tides::Snapshot::new(t, prev, txids));
+            Ok(json!({"ok": true}))
+        }
+        "/sovereignty/attest" => {
+            let a = v["a"].as_str().ok_or("a")?;
+            let sig = v["sig"].as_str().ok_or("sig")?;
+            let cb = v["coinbase"].as_str().ok_or("coinbase")?;
+            let prev = v["prev"].as_str().ok_or("prev")?;
+            let branches: Vec<String> = v["branches"]
+                .as_array()
+                .ok_or("branches")?
+                .iter()
+                .filter_map(|x| x.as_str().map(str::to_string))
+                .collect();
+            let expect = v["g"].as_str();
+            let g = shared.sovereignty.lock().unwrap().ingest_attest(a, sig, cb, prev, &branches, expect)?;
+            Ok(json!({"ok": true, "g": g}))
+        }
+        "/sovereignty/credit" => {
+            if !demo {
+                return Err("sovereignty-demo is off".into());
+            }
+            let identity = v["identity"].as_str().ok_or("identity")?;
+            let gateway = v["gateway"].as_str().ok_or("gateway")?;
+            let work = v["work"].as_u64().ok_or("work")?;
+            let source = if v["stratum"].as_bool().unwrap_or(false) { tides::SOURCE_STRATUM } else { tides::SOURCE_DATUM };
+            {
+                let mut ledger = shared.ledger.lock().unwrap();
+                ledger.credit(identity, work, v["height"].as_u64().unwrap_or(1) as u32, now() as u32, source)
+                    .map_err(|e| e.to_string())?;
+            }
+            if source != tides::SOURCE_STRATUM {
+                shared.sovereignty.lock().unwrap().credit_authored(identity, gateway, work);
+            }
+            Ok(json!({"ok": true}))
+        }
+        "/sovereignty/observe" => {
+            if !demo {
+                return Err("sovereignty-demo is off".into());
+            }
+            shared.sovereignty.lock().unwrap().observe(
+                v["builder"].as_str().unwrap_or("unknown"),
+                v["claimed"].as_bool().unwrap_or(false),
+                v["verified"].as_bool().unwrap_or(false),
+            );
+            Ok(json!({"ok": true}))
+        }
+        "/sovereignty/apply-bonus" => {
+            if !demo || !shared.cfg.sovereignty_bonus {
+                return Err("bonus off or not in demo".into());
+            }
