+#[cfg(test)]
+mod tests {
+    use super::*;
+    use datum_wire::authorship::{attest, NodeView};
+    use datum_wire::coinbase::{self, TxOut};
+
+    fn engine() -> Engine {
+        Engine { demo: true, min_key_age_secs: 0, started_ts: 1, ..Engine::default() }
+    }
+
+    fn p2wpkh(fill: u8) -> Vec<u8> {
+        let mut s = vec![0x00, 0x14];
+        s.extend_from_slice(&[fill; 20]);
+        s
+    }
+
+    fn sample_outs(value: u64) -> Vec<TxOut> {
+        vec![
+            TxOut { value: value / 2, script: p2wpkh(0x11) },
+            TxOut { value: value - value / 2, script: p2wpkh(0x22) },
+        ]
+    }
+
+    #[test]
+    fn register_without_sig_is_demo_only() {
+        let mut e = engine();
+        e.demo = false;
+        assert!(e.register("aa".repeat(32).as_str(), "bc1q", false, None).is_err());
+        e.demo = true;
+        let g = Identity::from_secret_bytes(&[0x11; 64]);
+        let hex = hex::encode(g.sign_pk());
+        assert!(e.register(&hex, "bc1q", false, None).is_ok());
+        assert!(!e.is_house(&hex));
+    }
+
+    #[test]
+    fn register_checks_the_key_signature() {
+        let mut e = Engine { demo: false, ..Engine::default() };
+        let g = Identity::from_secret_bytes(&[0x22; 64]);
+        let (hex, sig) = Engine::sign_register(&g);
+        assert!(e.register(&hex, "bc1qtest", false, Some(&sig)).is_ok());
+        let other = Identity::from_secret_bytes(&[0x23; 64]);
+        let bad = hex::encode(other.sign(&Engine::register_message(&hex)));
+        assert!(e.register(&hex, "bc1q", false, Some(&bad)).is_err());
+    }
+
+    #[test]
+    fn house_keys_never_earn() {
+        let mut e = engine();
+        let g = Identity::from_secret_bytes(&[0x33; 64]);
+        let hex = hex::encode(g.sign_pk());
+        e.register(&hex, "bc1q", true, None).unwrap();
+        e.credit_authored("miner", &hex, 1_000);
+        assert!(e.authored.is_empty());
+    }
+
+    #[test]
+    fn ingest_attest_and_score() {
+        let mut e = engine();
+        let g = Identity::from_secret_bytes(&[0x44; 64]);
+        let g_hex = hex::encode(g.sign_pk());
+        e.register(&g_hex, "bc1q", false, None).unwrap();
+        let prev = [0x77u8; 32];
+        let height = 966_267u32;
+        let txs: Vec<Hash> = (1..=4u8).map(|i| [i; 32]).collect();
+        let branches = datum_wire::pow::merkle_branches_for_coinbase(&txs);
+        let mut outs = sample_outs(312_538_966);
+        let (a, sig, c) = attest(&g, height, &prev, &branches, &outs, NodeView::default());
+        outs.push(c);
+        let (bytes, _, _) = coinbase::build(height, b"Lazarus\x0fTofu", &outs, 0);
+        let g_out = e
+            .ingest_attest(
+                &hex::encode(a.encode()),
+                &hex::encode(sig),
+                &hex::encode(&bytes),
+                &hex::encode(prev),
+                &branches.iter().map(hex::encode).collect::<Vec<_>>(),
+                Some(&g_hex),
+            )
+            .unwrap();
+        assert_eq!(g_out, g_hex);
+        let s = e.score();
+        assert_eq!(s.verified, 1);
+        assert!(s.score > 0.0);
+    }
+
+    #[test]
+    fn detector_flags_only_the_proxy() {
+        let mut e = engine();
+        // 30 pool templates; honest has its own txs first; proxy copies pool.
+        for i in 0..30u64 {
+            let t = i as f64;
+            let prev = format!("{i:064x}");
+            let pool_tx = vec![format!("{:064x}", i + 100), format!("{:064x}", i + 200)];
+            let honest_tx = vec![format!("{:064x}", i + 300), format!("{:064x}", i + 400)];
+            e.note_snapshot("POOL", Snapshot::new(t, prev.clone(), pool_tx.clone()));
+            e.note_snapshot("h1", Snapshot::new(t + 0.01, prev.clone(), honest_tx));
+            e.note_snapshot("h2", Snapshot::new(t + 0.02, prev.clone(), vec![format!("{:064x}", i + 500)]));
+            e.note_snapshot("proxy", Snapshot::new(t + 0.04, prev, pool_tx));
+        }
+        let rows = e.detector_rows();
+        assert!(rows["proxy"].independence < 0.05, "{}", rows["proxy"].independence);
+        assert!(rows["h1"].independence > 0.8, "{}", rows["h1"].independence);
+        assert!(rows["h2"].independence > 0.8, "{}", rows["h2"].independence);
+        let flagged = e.flagged();
+        assert_eq!(flagged, vec!["proxy".to_string()]);
+        let cl = e.clusters();
+        assert!(cl.iter().any(|c| c.contains(&"POOL".to_string()) && c.contains(&"proxy".to_string())), "{cl:?}");
+    }
+}
