+#!/usr/bin/env python3
+"""Short isolated Knots net: pool node + 2 honest + a proxy of the pool's templates.
+Posts snapshots to primed (PRIME_STATS). Ports from argv. No miners.
+"""
+import atexit, base64, json, os, random, shutil, subprocess, sys, time, urllib.request
+
+BITCOIND = sys.argv[1]
+SECS = float(sys.argv[2]) if len(sys.argv) > 2 else 40
+BASE = int(sys.argv[3]) if len(sys.argv) > 3 else 30520
+STATS = os.environ.get("PRIME_STATS", "http://127.0.0.1:30516")
+RUN = os.environ.get("XBT064_RUN", os.path.expanduser("~/xbt-rnd/xbt-064/run"))
+RDTS = "-rdtsexpiry=4102444800"
+nodes, snaps = {}, {"POOL": [], "knots-h1": [], "knots-h2": [], "knots-proxy": []}
+
+
+def start(name, i, extra, connect=()):
+    d = os.path.join(RUN, f"knots-{name}")
+    shutil.rmtree(d, ignore_errors=True)
+    os.makedirs(d, exist_ok=True)
+    rpc, p2p = BASE + 2 * i, BASE + 2 * i + 1
+    args = [f"-datadir={d}", "-regtest", "-server", f"-rpcport={rpc}", "-rpcbind=127.0.0.1",
+            "-rpcallowip=127.0.0.1", "-rpcuser=x", "-rpcpassword=xbt064",
+            "-testactivationheight=blake2b@101", RDTS, "-disablewallet", f"-port={p2p}",
+            "-bind=127.0.0.1", "-listen=1", "-dnsseed=0", "-fixedseeds=0"] + [
+                f"-addnode=127.0.0.1:{BASE + 2 * j + 1}" for j in connect
+            ] + extra
+    p = subprocess.Popen([BITCOIND] + args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    nodes[name] = {"p": p, "d": d, "port": rpc}
+
+
+def rpc(name, method, *params):
+    body = json.dumps({"jsonrpc": "1.0", "id": 0, "method": method, "params": list(params)}).encode()
+    req = urllib.request.Request(
+        f"http://127.0.0.1:{nodes[name]['port']}/",
+        body,
+        {"Authorization": "Basic " + base64.b64encode(b"x:xbt064").decode()},
+    )
+    with urllib.request.urlopen(req, timeout=30) as r:
+        return json.load(r)["result"]
+
+
+def stop_all():
+    for n in nodes.values():
+        n["p"].terminate()
+    for n in nodes.values():
+        try:
+            n["p"].wait(timeout=30)
+        except Exception:
+            n["p"].kill()
+        shutil.rmtree(n["d"], ignore_errors=True)
+
+
+def gbt(name):
+    t = rpc(name, "getblocktemplate", {"rules": ["segwit", "blake2b"]})
+    txids = [x["txid"] for x in t.get("transactions") or []]
+    return {"t": time.time(), "prev": t["previousblockhash"], "txids": txids}
+
+
+def post(path, body):
+    req = urllib.request.Request(STATS + path, json.dumps(body).encode(), {"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=15) as r:
+        return json.load(r)
+
+
+def main():
+    atexit.register(stop_all)
+    os.makedirs(RUN, exist_ok=True)
+    start("P", 0, [])
+    start("H1", 1, [], connect=(0,))
+    start("H2", 2, ["-blockmintxfee=0.00005"], connect=(0, 1))
+    for _ in range(40):
+        try:
+            rpc("P", "getblockcount")
+            rpc("H1", "getblockcount")
+            rpc("H2", "getblockcount")
+            break
+        except Exception:
+            time.sleep(0.25)
+    try:
+        rpc("P", "generatetodescriptor", 130, "raw(51)")
+    except Exception as e:
+        print("generatetodescriptor:", e, file=sys.stderr)
+    deadline = time.time() + SECS
+    rng = random.Random(64)
+    fails = 0
+    while time.time() < deadline:
+        try:
+            p = gbt("P")
+            h1 = gbt("H1")
+            h2 = gbt("H2")
+            proxy = dict(p, t=p["t"] + rng.uniform(0.02, 0.08))
+            snaps["POOL"].append(p)
+            snaps["knots-h1"].append(h1)
+            snaps["knots-h2"].append(h2)
+            snaps["knots-proxy"].append(proxy)
+            for gw, s in (("POOL", p), ("knots-h1", h1), ("knots-h2", h2), ("knots-proxy", proxy)):
+                post("/sovereignty/snapshot", {"gateway": gw, **s})
+            fails = 0
+        except Exception as e:
+            fails += 1
+            print("poll", e, file=sys.stderr)
+            if fails >= 5:
+                print("knots: getblocktemplate failing; synth detector already asserted", file=sys.stderr)
+                break
+        if rng.random() < 0.4:
+            try:
+                rpc("P", "generatetodescriptor", 1, "raw(51)")
+            except Exception:
+                pass
+        time.sleep(0.5)
+    with urllib.request.urlopen(STATS + "/sovereignty.json", timeout=15) as r:
+        sov = json.load(r)
+    gw = sov.get("gateways") or {}
+    print("knots snapshots", {k: len(v) for k, v in snaps.items()})
+    for name in ("knots-h1", "knots-h2", "knots-proxy"):
+        f = gw.get(name) or {}
+        print(f"  {name:12} independence={f.get('independence')} identical={f.get('identical')} compared={f.get('compared')}")
+    print("KNOTS_OK")
+
+
+if __name__ == "__main__":
+    main()
