+                let delta: Vec<(String, i64)> = credits.iter().map(|(i, s)| (i.clone(), *s as i64)).collect();
+                ledger.settle_carry(&delta);
+            }
+            Ok(json!({"ok": true, "credits": credits}))
+        }
+        _ => Err("unknown sovereignty path".into()),
+    }
