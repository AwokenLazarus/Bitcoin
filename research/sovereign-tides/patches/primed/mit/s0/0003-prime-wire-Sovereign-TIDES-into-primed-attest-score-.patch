+//! XBT-064: primed sovereignty ingest — register, detector, attestation, bonus.
+//! Uses the stats HTTP API with `sovereignty-demo` on; no miners.
+
+mod common;
+
+use std::io::{Read, Write};
+use std::net::TcpStream;
+
+use datum_wire::authorship::{attest, NodeView};
+use datum_wire::coinbase::{self, TxOut};
+use datum_wire::crypto::Identity;
+use datum_wire::pow;
+use serde_json::{json, Value};
+
+fn make_attest(id: &Identity) -> (String, String, String, String, Vec<String>) {
+    let prev = [0x77u8; 32];
+    let height = 966_267u32;
+    let txs: Vec<[u8; 32]> = (1..=4u8).map(|i| [i; 32]).collect();
+    let branches = pow::merkle_branches_for_coinbase(&txs);
+    let mut outs = vec![
+        TxOut { value: 150_000_000, script: { let mut s = vec![0x00, 0x14]; s.extend_from_slice(&[0x11; 20]); s } },
+        TxOut { value: 162_538_966, script: { let mut s = vec![0x00, 0x14]; s.extend_from_slice(&[0x22; 20]); s } },
+    ];
+    let (a, sig, c) = attest(id, height, &prev, &branches, &outs, NodeView::default());
+    outs.push(c);
+    let (bytes, _, _) = coinbase::build(height, b"Lazarus\x0fH1", &outs, 0);
+    (
+        hex::encode(a.encode()),
+        hex::encode(sig),
+        hex::encode(bytes),
+        hex::encode(prev),
+        branches.iter().map(hex::encode).collect(),
+    )
+}
+
+fn post(port: u16, path: &str, body: &Value) -> Value {
+    let payload = body.to_string();
+    let req = format!(
+        "POST {path} HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: {}\r\n\r\n{payload}",
+        payload.len()
+    );
+    let mut s = TcpStream::connect(("127.0.0.1", port)).unwrap();
+    s.write_all(req.as_bytes()).unwrap();
+    let mut buf = Vec::new();
+    s.read_to_end(&mut buf).unwrap();
+    let text = String::from_utf8_lossy(&buf);
+    let body = text.split("\r\n\r\n").nth(1).unwrap_or("");
+    serde_json::from_str(body).unwrap_or_else(|_| json!({"raw": body}))
+}
+
+fn hex32(i: u64) -> String {
+    format!("{i:064x}")
+}
+
+fn snaps(n: usize) -> (Vec<Value>, Vec<Value>, Vec<Value>, Vec<Value>) {
+    let mut pool = Vec::new();
+    let mut h1 = Vec::new();
+    let mut h2 = Vec::new();
+    let mut proxy = Vec::new();
+    for i in 0..n as u64 {
+        let t = i as f64;
+        let prev = hex32(i / 8);
+        let ptx = vec![hex32(i + 100), hex32(i + 200)];
+        let h1tx = vec![hex32(i + 300), hex32(i + 400)];
+        let h2tx = vec![hex32(i + 500)];
+        pool.push(json!({"t": t, "prev": prev, "txids": ptx}));
+        h1.push(json!({"t": t + 0.01, "prev": prev, "txids": h1tx}));
+        h2.push(json!({"t": t + 0.02, "prev": prev, "txids": h2tx}));
+        proxy.push(json!({"t": t + 0.04, "prev": prev, "txids": ptx}));
+    }
+    (pool, h1, h2, proxy)
+}
+
+#[test]
+fn primed_flags_the_fake_gateway_and_moves_bonus_credit() {
+    let pool = Identity::from_secret_bytes(&[0x64; 64]);
+    let extra = r#"
+rpc = "http://127.0.0.1:9"
+poll = 60
+sovereignty-bonus = true
+sovereignty-demo = true
+sovereignty-bonus-bps = 500
+sovereignty-min-key-age-secs = 0
+stratum-fee-bps = 2500
+datum-rebate-bps = 1000
+house-loopback = false
+"#;
+    let (p, _listen) = common::start_primed(&pool, extra);
+    let stats = p.stats; // u16, passed by value to post()
+
+    let h1 = Identity::from_secret_bytes(&[0x11; 64]);
+    let h2 = Identity::from_secret_bytes(&[0x12; 64]);
+    let px = Identity::from_secret_bytes(&[0x13; 64]);
+    for (id, name) in [(&h1, "h1"), (&h2, "h2"), (&px, "proxy")] {
+        let g = hex::encode(id.sign_pk());
+        let r = post(stats, "/sovereignty/register", &json!({"g": g, "payout": format!("bc1q{name}"), "house": false}));
+        assert!(r.get("g").is_some(), "{r}");
+    }
+
+    let (pool_s, h1_s, h2_s, px_s) = snaps(30);
+    for (gw, snaps) in [("POOL", pool_s), ("h1", h1_s), ("h2", h2_s), ("proxy", px_s)] {
+        for s in snaps {
+            let mut body = s;
+            body["gateway"] = json!(gw);
+            let r = post(stats, "/sovereignty/snapshot", &body);
+            assert_eq!(r["ok"], true, "{r}");
+        }
+    }
+
+    let attester = Identity::from_secret_bytes(&[0x42; 64]);
+    let pk = hex::encode(attester.sign_pk());
+    post(stats, "/sovereignty/register", &json!({"g": pk, "payout": "bc1qhonest", "house": false}));
+    let (a_hex, sig_hex, cb_hex, prev_hex, branches_hex) = make_attest(&attester);
+    let att = post(
+        stats,
+        "/sovereignty/attest",
+        &json!({
+            "a": a_hex,
+            "sig": sig_hex,
+            "coinbase": cb_hex,
+            "prev": prev_hex,
+            "branches": branches_hex,
+            "g": pk,
+        }),
+    );
+    assert_eq!(att["ok"], true, "{att}");
+
+    // Window work: stratum + attested honest + proxy (proxy independence 0 → no bonus).
+    post(stats, "/sovereignty/credit", &json!({"identity": "bc1qstratum", "gateway": "house", "work": 400, "stratum": true}));
+    post(stats, "/sovereignty/credit", &json!({"identity": "bc1qh1", "gateway": "h1", "work": 200}));
+    post(stats, "/sovereignty/credit", &json!({"identity": "bc1qh2", "gateway": "h2", "work": 100}));
+    post(stats, "/sovereignty/credit", &json!({"identity": "bc1qproxy", "gateway": "proxy", "work": 200}));
+
+    let applied = post(stats, "/sovereignty/apply-bonus", &json!({"value": 312_500_000}));
+    assert_eq!(applied["ok"], true, "{applied}");
+    let credits = applied["credits"].as_array().cloned().unwrap_or_default();
+    let got = |id: &str| -> u64 {
+        credits.iter().find(|c| c[0] == id).and_then(|c| c[1].as_u64()).unwrap_or(0)
+    };
+    assert!(got("bc1qh1") > 0, "honest h1 should take bonus: {credits:?}");
+    assert!(got("bc1qh2") > 0, "honest h2 should take bonus: {credits:?}");
+    assert_eq!(got("bc1qproxy"), 0, "proxy independence 0 earns nothing: {credits:?}");
+
+    let doc = common::settled_stats(&p);
+    let sov = &doc["sovereignty"];
+    assert_eq!(sov["bonus"]["on"], true);
+    assert!(sov["score"]["verified"].as_u64().unwrap() >= 1);
+    let gw = &sov["gateways"];
+    assert!(gw["proxy"]["independence"].as_f64().unwrap() < 0.05, "{gw}");
+    assert!(gw["h1"]["independence"].as_f64().unwrap() > 0.8, "{gw}");
+    assert!(gw["h2"]["independence"].as_f64().unwrap() > 0.8, "{gw}");
+    let flagged = sov["flagged"].as_array().unwrap();
+    assert_eq!(flagged, &vec![json!("proxy")]);
+}
