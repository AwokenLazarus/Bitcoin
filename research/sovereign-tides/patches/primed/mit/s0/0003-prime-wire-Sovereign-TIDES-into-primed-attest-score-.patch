index 0000000..b2e7ce6
--- /dev/null
+++ b/prime/primed/src/sovereignty.rs
@@ -0,0 +1,627 @@
+//! Primed side of Sovereign TIDES (P-003 A2 / XBT-064).
+//!
+//! * Directory of registered gateway keys `G`.
+//! * Per-job LZT1 attestation check (once, when the coinbase is absorbed).
+//! * Template-entropy detector over job snapshots (Rust port of `~/xbt-rnd/XBT-051/entropy.py`).
+//! * Sovereignty score and the TIDES bonus pot (flag, default off).
+//!
+//! The DATUM sub-command that will carry `A`+sig is not in stock gateways yet. Until it is,
+//! attestations and extra snapshots arrive over the stats HTTP ingest (only when
+//! `sovereignty-demo` is on). Live sessions still record job snapshots from the job section
+//! (prev + merkle branches) so a straight proxy is visible from Prime's own telemetry.
+
+use std::collections::{BTreeMap, HashMap};
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use datum_wire::authorship::{self, Attestation, AttestError};
+use datum_wire::coinbase::Coinbase;
+use datum_wire::crypto::{Identity, SIGN_PK, SIG};
+use datum_wire::pow::Hash;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use tides::entropy::{self, Snapshot};
+use tides::score::{self, PoolScore};
+use tides::sovereignty::{self as bonus, Authored, Bonus, BonusParams, WorkTotals};
+use tides::Window;
+
+use crate::config::Config;
+use crate::state::now;
+
+const REGISTER_PREFIX: &[u8] = b"LZT1 register G=";
+const REGISTER_SUFFIX: &[u8] = b" pool=lazarus";
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct KeyRecord {
+    pub g: String,
+    pub payout: String,
+    pub first_seen: u64,
+    #[serde(default)]
+    pub house: bool,
+    #[serde(default)]
+    pub node_tag: String,
+}
+
+#[derive(Clone, Debug)]
+struct JobKey {
+    g: [u8; SIGN_PK],
+    prev: Hash,
+    branches_hash: Hash,
+}
+
+impl JobKey {
+    fn id(&self) -> String {
+        format!("{}:{}:{}", hex::encode(self.g), hex::encode(self.prev), hex::encode(self.branches_hash))
+    }
+}
+
+#[derive(Clone, Debug)]
+#[allow(dead_code)]
+struct AttestedJob {
+    a: Attestation,
+    sig: [u8; SIG],
+}
+
+#[derive(Default)]
+pub struct Engine {
+    dir: PathBuf,
+    keys: HashMap<String, KeyRecord>,
+    snapshots: BTreeMap<String, Vec<Snapshot>>,
+    attested: HashMap<String, AttestedJob>,
+    authored: Vec<Authored>,
+    /// Observed blocks for the public score (demo + any LZT1-verified job).
+    observed_blocks: u64,
+    observed_claimed: u64,
+    observed_verified: u64,
+    builder_counts: HashMap<String, u64>,
+    params: BonusParams,
+    bonus_on: bool,
+    demo: bool,
+    min_key_age_secs: u32,
+    started_ts: u64,
+}
+
+impl Engine {
+    pub fn from_config(cfg: &Config) -> Self {
+        let mut e = Engine {
+            dir: cfg.data_dir.clone(),
+            params: BonusParams {
+                stratum_fee_bps: cfg.stratum_fee_bps,
+                datum_rebate_bps: cfg.datum_rebate_bps,
+                bonus_bps: cfg.sovereignty_bonus_bps,
+                diff_bps: cfg.sovereignty_diff_bps,
+                cap_per_gateway_bps: cfg.sovereignty_cap_per_gateway_bps,
+            },
+            bonus_on: cfg.sovereignty_bonus,
+            demo: cfg.sovereignty_demo,
+            min_key_age_secs: cfg.sovereignty_min_key_age_secs,
+            started_ts: now(),
+            ..Engine::default()
+        };
+        e.load_keys();
+        for h in &cfg.house_gateways {
+            if h.is_empty() {
+                continue;
+            }
+            let g = h.to_ascii_lowercase();
+            e.keys.entry(g.clone()).or_insert(KeyRecord {
+                g: g.clone(),
+                payout: String::new(),
+                first_seen: e.started_ts,
+                house: true,
+                node_tag: "house".into(),
+            }).house = true;
+        }
+        e
+    }
+
+    pub fn demo(&self) -> bool {
+        self.demo
+    }
+
+    #[allow(dead_code)]
+    pub fn bonus_on(&self) -> bool {
+        self.bonus_on
+    }
+
+    fn load_keys(&mut self) {
+        let path = self.dir.join("sovereignty-keys.json");
+        let Ok(bytes) = std::fs::read(&path) else { return };
+        let Ok(list) = serde_json::from_slice::<Vec<KeyRecord>>(&bytes) else { return };
+        for r in list {
+            self.keys.insert(r.g.to_ascii_lowercase(), r);
+        }
+    }
+
+    fn persist_keys(&self) {
+        if self.dir.as_os_str().is_empty() {
+            return;
+        }
+        let _ = std::fs::create_dir_all(&self.dir);
+        let mut list: Vec<&KeyRecord> = self.keys.values().collect();
+        list.sort_by(|a, b| a.g.cmp(&b.g));
+        if let Ok(bytes) = serde_json::to_vec_pretty(&list) {
+            let tmp = self.dir.join("sovereignty-keys.json.tmp");
+            if std::fs::write(&tmp, bytes).is_ok() {
+                let _ = std::fs::rename(tmp, self.dir.join("sovereignty-keys.json"));
+            }
+        }
+    }
+
+    /// Register `G`. Proof of possession is an ed25519 signature by `G` over
+    /// `LZT1 register G=<hex> pool=lazarus` (BIP322 binding to the payout address is the
+    /// production path; this is the pool-side check that the caller holds the DATUM key).
+    /// `sovereignty-demo` may omit the signature.
+    pub fn register(&mut self, g_hex: &str, payout: &str, house: bool, sig_hex: Option<&str>) -> Result<KeyRecord, String> {
+        let g_hex = g_hex.to_ascii_lowercase();
+        let g = decode_pk(&g_hex)?;
+        if !self.demo {
+            let sig = sig_hex.ok_or("signature required")?;
+            let sigb = decode_sig(sig)?;
+            let mut msg = REGISTER_PREFIX.to_vec();
+            msg.extend_from_slice(g_hex.as_bytes());
+            msg.extend_from_slice(REGISTER_SUFFIX);
+            datum_wire::crypto::verify(&g, &msg, &sigb).map_err(|_| "bad register signature".to_string())?;
+        }
+        let rec = KeyRecord {
+            g: g_hex.clone(),
+            payout: payout.to_string(),
+            first_seen: now(),
+            house,
+            node_tag: String::new(),
+        };
+        self.keys.insert(g_hex, rec.clone());
+        self.persist_keys();
+        Ok(rec)
+    }
+
+    pub fn lookup(&self, g_hex: &str) -> Option<&KeyRecord> {
+        let g = g_hex.to_ascii_lowercase();
+        self.keys.get(&g).or_else(|| self.keys.values().find(|r| g.starts_with(&r.g) || r.g.starts_with(&g)))
+    }
+
+    fn is_house(&self, g_hex: &str) -> bool {
+        self.lookup(g_hex).is_some_and(|r| r.house)
+    }
+
+    fn key_old_enough(&self, g_hex: &str, ts: u64) -> bool {
+        if self.min_key_age_secs == 0 {
+            return true;
+        }
+        match self.lookup(g_hex) {
+            Some(r) => ts.saturating_sub(r.first_seen) >= u64::from(self.min_key_age_secs),
+            None => false,
+        }
+    }
+
+    pub fn note_snapshot(&mut self, gateway: &str, snap: Snapshot) {
+        let name = if gateway.eq_ignore_ascii_case("pool") { "POOL".to_string() } else { gateway.to_ascii_lowercase() };
+        let v = self.snapshots.entry(name).or_default();
+        v.push(snap);
+        if v.len() > 2_000 {
+            v.drain(..v.len() - 1_500);
+        }
+    }
+
+    /// A live session's job: prev + merkle branches. Txids are empty until a validation
+    /// reply or an HTTP ingest fills them in; `identical` still works from branches alone
+    /// if we store the branch list as a synthetic txid set.
+    pub fn note_job(&mut self, gateway: &str, t: f64, prev: &Hash, branches: &[Hash]) {
+        let prev_hex = hex::encode(prev);
+        let txids = branches.iter().map(hex::encode).collect();
+        self.note_snapshot(gateway, Snapshot::new(t, prev_hex, txids));
+    }
+
+    pub fn ingest_attest(
+        &mut self,
+        a_hex: &str,
+        sig_hex: &str,
+        coinbase_hex: &str,
+        prev_hex: &str,
+        branches_hex: &[String],
+        expect_g: Option<&str>,
+    ) -> Result<String, String> {
+        let a = Attestation::decode(&decode_hex(a_hex, "attestation")?).map_err(|e| format!("attestation: {e:?}"))?;
+        let sig = decode_sig(sig_hex)?;
+        let cb = datum_wire::coinbase::parse(&decode_hex(coinbase_hex, "coinbase")?)
+            .map_err(|e| format!("coinbase: {e}"))?;
+        let prev = decode_hash(prev_hex)?;
+        let branches: Result<Vec<Hash>, String> = branches_hex.iter().map(|h| decode_hash(h)).collect();
+        let branches = branches?;
+        let expect = match expect_g {
+            Some(h) => Some(decode_pk(h)?),
+            None => None,
+        };
+        let g = authorship::verify(&cb, &a, &sig, &prev, &branches, expect.as_ref()).map_err(attest_err)?;
+        let g_hex = hex::encode(g);
+        if self.is_house(&g_hex) {
+            return Err("house key never attests for score or bonus".into());
+        }
+        if self.lookup(&g_hex).is_none() && !self.demo {
+            return Err("G is not registered".into());
+        }
+        let key = JobKey { g, prev, branches_hash: authorship::branches_hash(&branches) }.id();
+        self.attested.insert(key, AttestedJob { a, sig });
+        self.observe_block(&g_hex, true, true);
+        Ok(g_hex)
+    }
+
+    /// Verify a live share's coinbase against a stored attestation for this job, or just
+    /// record the job as claimed.
+    pub fn note_share(
+        &mut self,
+        gateway: &str,
+        house: bool,
+        identity: &str,
+        work: u64,
+        cb: &Coinbase,
+        prev: &Hash,
+        branches: &[Hash],
+        ts: u32,
+    ) {
+        if work == 0 || house {
+            return;
+        }
+        let g_hex = gateway.to_ascii_lowercase();
+        let claimed = authorship::find(&cb.outputs).ok().flatten().is_some();
+        let key = JobKey {
+            g: decode_pk(&g_hex).unwrap_or([0; 32]),
+            prev: *prev,
+            branches_hash: authorship::branches_hash(branches),
+        }
+        .id();
+        let verified = self.attested.contains_key(&key)
+            && !self.is_house(&g_hex)
+            && self.key_old_enough(&g_hex, u64::from(ts));
+        if claimed || verified {
+            self.observe_block(&g_hex, claimed, verified);
+        }
+        if !verified {
+            return;
+        }
+        let ppm = self.independence_of(&g_hex);
+        match self.authored.iter_mut().find(|a| a.identity == identity && a.gateway == g_hex) {
+            Some(a) => {
+                a.work = a.work.saturating_add(work);
+                a.independence_ppm = ppm;
+            }
+            None => self.authored.push(Authored {
+                identity: identity.to_string(),
+                gateway: g_hex,
+                work,
+                independence_ppm: ppm,
+            }),
+        }
+    }
+
+    fn observe_block(&mut self, builder: &str, claimed: bool, verified: bool) {
+        self.observed_blocks += 1;
+        if claimed {
+            self.observed_claimed += 1;
+        }
+        if verified {
+            self.observed_verified += 1;
+        }
+        *self.builder_counts.entry(builder.to_string()).or_insert(0) += 1;
+    }
+
+    pub fn observe(&mut self, builder: &str, claimed: bool, verified: bool) {
+        self.observe_block(builder, claimed, verified);
+    }
+
+    pub fn credit_authored(&mut self, identity: &str, gateway: &str, work: u64) {
+        let g = gateway.to_ascii_lowercase();
+        if self.is_house(&g) {
+            return;
+        }
+        let ppm = self.independence_of(&g);
+        match self.authored.iter_mut().find(|a| a.identity == identity && a.gateway == g) {
+            Some(a) => a.work = a.work.saturating_add(work),
+            None => self.authored.push(Authored {
+                identity: identity.to_string(),
+                gateway: g,
+                work,
+                independence_ppm: ppm,
+            }),
+        }
+    }
+
+    fn pool_snaps(&self) -> &[Snapshot] {
+        self.snapshots.get("POOL").map(Vec::as_slice).unwrap_or(&[])
+    }
+
+    pub fn independence_of(&self, gateway: &str) -> u32 {
+        let g = if gateway.eq_ignore_ascii_case("pool") { "POOL".to_string() } else { gateway.to_ascii_lowercase() };
+        let Some(snaps) = self.snapshots.get(&g) else { return 0 };
+        entropy::independence_ppm(&entropy::features(snaps, self.pool_snaps()))
+    }
+
+    pub fn detector_rows(&self) -> BTreeMap<String, entropy::Features> {
+        let pool = self.pool_snaps();
+        self.snapshots
+            .iter()
+            .filter(|(n, _)| n.as_str() != "POOL")
+            .map(|(n, s)| (n.clone(), entropy::features(s, pool)))
+            .collect()
+    }
+
+    pub fn clusters(&self) -> Vec<Vec<String>> {
+        entropy::clusters(&self.snapshots)
+    }
+
+    pub fn flagged(&self) -> Vec<String> {
+        self.detector_rows()
+            .into_iter()
+            .filter(|(_, f)| !f.insufficient && f.independence < 0.2)
+            .map(|(n, _)| n)
+            .collect()
+    }
+
+    pub fn work_totals(&self, w: &Window) -> WorkTotals {
+        let mut stratum = 0u64;
+        let mut datum = 0u64;
+        for m in w.miners() {
+            stratum = stratum.saturating_add(m.stratum_work);
+            datum = datum.saturating_add(m.work.saturating_sub(m.stratum_work));
+        }
+        let authored: u64 = self.authored.iter().map(|a| a.work).sum();
+        let authored = authored.min(datum);
+        WorkTotals {
+            total: w.total_work(),
+            stratum,
+            unauthored_datum: datum.saturating_sub(authored),
+            authored,
+        }
+    }
+
+    pub fn sample_bonus(&self, value: u64, w: &Window) -> Bonus {
+        bonus::compute(value, self.work_totals(w), self.params, &self.authored)
+    }
+
+    /// Credits the found-block bonus (identity → sats). Empty when the flag is off.
+    pub fn bonus_for_block(&self, value: u64, w: &Window) -> Vec<(String, u64)> {
+        if !self.bonus_on {
+            return Vec::new();
+        }
+        self.sample_bonus(value, w).credits
+    }
+
+    pub fn score(&self) -> PoolScore {
+        let counts: Vec<u64> = self.builder_counts.values().copied().collect();
+        score::summarize(self.observed_blocks, self.observed_claimed, self.observed_verified, &counts)
+    }
+
+    pub fn stats_json(&self, w: Option<&Window>) -> Value {
+        let rows = self.detector_rows();
+        let clusters = self.clusters();
+        let flagged = self.flagged();
+        let score = self.score();
+        let sample = w.map(|win| {
+            let b = self.sample_bonus(312_500_000, win);
+            json!({
+                "from_stratum": b.from_stratum,
+                "from_diff": b.from_diff,
+                "credits": b.credits,
+                "to_pool": b.to_pool,
+                "diff_waived": b.diff_waived,
+            })
+        });
+        let gateways: BTreeMap<String, Value> = rows
+            .into_iter()
+            .map(|(n, f)| {
+                (n.clone(), json!({
+                    "snapshots": f.snapshots,
+                    "compared": f.compared,
+                    "identical": f.identical,
+                    "branch_sim": f.branch_sim,
+                    "jaccard": f.jaccard,
+                    "lead": f.lead,
+                    "subset": f.subset,
+                    "follower": f.follower,
+                    "independence": f.independence,
+                    "insufficient": f.insufficient,
+                    "independence_ppm": entropy::independence_ppm(&f),
+                    "house": self.is_house(&n),
+                    "registered": self.lookup(&n).is_some(),
+                }))
+            })
+            .collect();
+        json!({
+            "bonus": {
+                "on": self.bonus_on,
+                "bps": self.params.bonus_bps,
+                "effective_bps": self.params.effective_bonus_bps(),
+                "diff_bps": self.params.diff_bps,
+                "cap_per_gateway_bps": self.params.cap_per_gateway_bps,
+                "min_key_age_secs": self.min_key_age_secs,
+                "sample": sample,
+            },
+            "score": {
+                "blocks": score.blocks,
+                "claimed": score.claimed,
+                "verified": score.verified,
+                "score": score.score,
+                "builders": score.builders,
+                "effective_builders": score.effective_builders,
+                "top_builder_share": score.top_builder_share,
+                "template_nakamoto": score.template_nakamoto,
+            },
+            "authored": self.authored.iter().map(|a| json!({
+                "identity": a.identity,
+                "gateway": a.gateway,
+                "work": a.work,
+                "independence_ppm": a.independence_ppm,
+            })).collect::<Vec<_>>(),
+            "directory": self.keys.values().map(|k| json!({
+                "g": k.g, "payout": k.payout, "first_seen": k.first_seen, "house": k.house,
+            })).collect::<Vec<_>>(),
+            "gateways": gateways,
+            "clusters": clusters,
+            "flagged": flagged,
+            "demo": self.demo,
+        })
+    }
+
+    /// Sign a registration message with `G` (helper for tests and the demo).
+    #[allow(dead_code)]
+    pub fn register_message(g_hex: &str) -> Vec<u8> {
+        let mut msg = REGISTER_PREFIX.to_vec();
+        msg.extend_from_slice(g_hex.to_ascii_lowercase().as_bytes());
+        msg.extend_from_slice(REGISTER_SUFFIX);
+        msg
+    }
+
+    #[allow(dead_code)]
+    pub fn sign_register(g: &Identity) -> (String, String) {
+        let hex = hex::encode(g.sign_pk());
+        let sig = hex::encode(g.sign(&Self::register_message(&hex)));
+        (hex, sig)
+    }
+}
+
+fn decode_hex(s: &str, what: &str) -> Result<Vec<u8>, String> {
+    hex::decode(s.trim()).map_err(|e| format!("{what}: {e}"))
+}
+
+fn decode_pk(s: &str) -> Result<[u8; SIGN_PK], String> {
+    let b = decode_hex(s, "G")?;
+    if b.len() < SIGN_PK {
+        return Err("G is short".into());
+    }
+    Ok(b[..SIGN_PK].try_into().unwrap())
+}
+
+fn decode_sig(s: &str) -> Result<[u8; SIG], String> {
+    let b = decode_hex(s, "sig")?;
+    b.try_into().map_err(|_| "sig must be 64 bytes".into())
+}
+
+fn decode_hash(s: &str) -> Result<Hash, String> {
+    let b = decode_hex(s, "hash")?;
+    b.try_into().map_err(|_| "hash must be 32 bytes".into())
+}
+
+fn attest_err(e: AttestError) -> String {
+    format!("{e:?}")
+}
+
+/// Unix seconds with a fractional part, for detector snapshots.
+pub fn now_f64() -> f64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_secs_f64()).unwrap_or(0.0)
+}
+
+#[allow(dead_code)]
+pub fn data_dir_ok(p: &Path) -> bool {
+    p.exists()
+}
