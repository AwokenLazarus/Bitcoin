+//! Public sovereignty score: `100 × (verified + ½·(claimed − verified)) ÷ blocks`.
+//!
+//! *claimed* is gateway-built blocks (the DATUM secondary tag is unauthenticated, so a claim
+//! counts half). *verified* is blocks with a valid LZT1 attestation by a non-house key. A
+//! pool with no attestations maxes out at 50; only attestations reach 100.
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct PoolScore {
+    pub blocks: u64,
+    pub claimed: u64,
+    pub verified: u64,
+    pub score: f64,
+    pub builders: usize,
+    pub effective_builders: f64,
+    pub top_builder_share: f64,
+    pub template_nakamoto: usize,
+}
+
+/// `100 × (verified + ½·(claimed − verified)) ÷ blocks`.
+pub fn sovereignty_score(blocks: u64, claimed: u64, verified: u64) -> f64 {
+    if blocks == 0 {
+        return 0.0;
+    }
+    let claimed = claimed.min(blocks);
+    let verified = verified.min(claimed);
+    100.0 * (verified as f64 + 0.5 * (claimed - verified) as f64) / blocks as f64
+}
+
+/// Fewest builders holding more than half the blocks (counts are already sorted desc).
+pub fn nakamoto(shares: &[u64]) -> usize {
+    let total: u64 = shares.iter().sum();
+    if total == 0 {
+        return 0;
+    }
+    let mut acc = 0u64;
+    for (i, &s) in shares.iter().enumerate() {
+        acc += s;
+        if acc * 2 > total {
+            return i + 1;
+        }
+    }
+    shares.len()
+}
+
+/// Effective builders: 1 / HHI over the share of blocks.
+pub fn hhi_effective(counts: &[u64]) -> f64 {
+    let total: u64 = counts.iter().sum();
+    if total == 0 {
+        return 0.0;
+    }
+    let hhi: f64 = counts.iter().map(|&c| {
+        let p = c as f64 / total as f64;
+        p * p
+    }).sum();
+    if hhi == 0.0 {
+        0.0
+    } else {
+        1.0 / hhi
+    }
+}
+
+pub fn summarize(blocks: u64, claimed: u64, verified: u64, builder_counts: &[u64]) -> PoolScore {
+    let mut counts = builder_counts.to_vec();
+    counts.sort_by(|a, b| b.cmp(a));
+    let top = counts.first().copied().unwrap_or(0);
+    PoolScore {
+        blocks,
+        claimed,
+        verified,
+        score: sovereignty_score(blocks, claimed, verified),
+        builders: counts.iter().filter(|&&c| c > 0).count(),
+        effective_builders: hhi_effective(&counts),
+        top_builder_share: if blocks == 0 { 0.0 } else { 100.0 * top as f64 / blocks as f64 },
+        template_nakamoto: nakamoto(&counts),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn score_weights() {
+        assert_eq!(sovereignty_score(100, 0, 0), 0.0);
+        assert_eq!(sovereignty_score(100, 100, 0), 50.0);
+        assert_eq!(sovereignty_score(100, 100, 100), 100.0);
+        assert_eq!(sovereignty_score(100, 60, 20), 40.0);
+        assert_eq!(sovereignty_score(0, 0, 0), 0.0);
+    }
+
+    #[test]
+    fn concentration() {
+        assert_eq!(nakamoto(&[50, 30, 20]), 2);
+        assert_eq!(nakamoto(&[51, 49]), 1);
+        assert!((hhi_effective(&[1, 1, 1, 1]) - 4.0).abs() < 1e-9);
+        assert!((hhi_effective(&[10]) - 1.0).abs() < 1e-9);
+    }
+
+    #[test]
+    fn a_pool_without_attestations_caps_at_fifty() {
+        let s = summarize(333, 238, 0, &[95, 40, 30, 20, 15, 10, 8, 7, 6, 5, 97]);
+        assert!((s.score - 35.7).abs() < 0.1, "{}", s.score);
+        assert!(s.template_nakamoto >= 2);
+    }
+}
