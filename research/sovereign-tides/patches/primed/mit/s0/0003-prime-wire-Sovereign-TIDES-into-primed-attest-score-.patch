+#!/usr/bin/env python3
+"""Drive a primed with sovereignty-demo on: 2 honest + 1 proxy snapshots, LZT1 attest,
+TIDES bonus. Optional Knots 29.4.2 poll (ports 30520+) if bitcoind is given.
+"""
+import json, os, random, subprocess, sys, time, urllib.request
+
+STATS = os.environ.get("PRIME_STATS", "http://127.0.0.1:30516")
+HERE = os.path.dirname(os.path.abspath(__file__))
+PRIME = os.path.abspath(os.path.join(HERE, ".."))
+
+
+def post(path, body):
+    req = urllib.request.Request(STATS + path, json.dumps(body).encode(), {"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=30) as r:
+        return json.load(r)
+
+
+def get(path="/sovereignty.json"):
+    with urllib.request.urlopen(STATS + path, timeout=30) as r:
+        return json.load(r)
+
+
+def hex32(i):
+    return f"{i:064x}"
+
+
+def synth(n=30):
+    pool, h1, h2, proxy = [], [], [], []
+    for i in range(n):
+        t, prev = float(i), hex32(i // 8)
+        ptx = [hex32(i + 100), hex32(i + 200)]
+        pool.append({"t": t, "prev": prev, "txids": ptx})
+        h1.append({"t": t + 0.01, "prev": prev, "txids": [hex32(i + 300), hex32(i + 400)]})
+        h2.append({"t": t + 0.02, "prev": prev, "txids": [hex32(i + 500)]})
+        proxy.append({"t": t + 0.04, "prev": prev, "txids": list(ptx)})
+    return {"POOL": pool, "h1": h1, "h2": h2, "proxy": proxy}
+
+
+def push_snaps(gws):
+    for gw, snaps in gws.items():
+        for s in snaps:
+            post("/sovereignty/snapshot", {"gateway": gw, **s})
+
+
+def fixture():
+    out = subprocess.check_output(
+        ["cargo", "run", "--offline", "-q", "-p", "datum-wire", "--example", "lzt1_fixture"],
+        cwd=PRIME,
+    )
+    return json.loads(out)
+
+
+def main():
+    print("== register + snapshots (2 honest, 1 proxy) ==")
+    for name in ("h1", "h2", "proxy"):
+        post("/sovereignty/register", {"g": name.encode().hex().ljust(64, "0"), "payout": f"bc1q{name}", "house": False})
+    push_snaps(synth())
+
+    print("== LZT1 attestation (rnd/a2 fixture) ==")
+    fx = fixture()
+    post("/sovereignty/register", {"g": fx["pk"], "payout": "bc1qattested", "house": False})
+    r = post("/sovereignty/attest", {
+        "a": fx["attestation"], "sig": fx["sig"], "coinbase": fx["coinbase"],
+        "prev": fx["prev_hash"], "branches": fx["branches"], "g": fx["pk"],
+    })
+    print("attest", r)
+
+    print("== credit window + apply bonus ==")
+    post("/sovereignty/credit", {"identity": "bc1qstratum", "gateway": "house", "work": 400, "stratum": True})
+    post("/sovereignty/credit", {"identity": "bc1qh1", "gateway": "h1", "work": 200})
+    post("/sovereignty/credit", {"identity": "bc1qh2", "gateway": "h2", "work": 100})
+    post("/sovereignty/credit", {"identity": "bc1qproxy", "gateway": "proxy", "work": 200})
+    bonus = post("/sovereignty/apply-bonus", {"value": 312500000})
+    print("bonus", json.dumps(bonus, indent=2))
+
+    sov = get()
+    gw = sov["gateways"]
+    print("== detector ==")
+    for name in ("h1", "h2", "proxy"):
+        f = gw[name]
+        print(f"  {name:6} independence={f['independence']:.3f} identical={f['identical']:.3f} lead={f['lead']:.3f}")
+    print("flagged", sov["flagged"])
+    print("score", json.dumps(sov["score"], indent=2))
+    print("sample bonus", json.dumps(sov["bonus"]["sample"], indent=2))
+
+    assert sov["flagged"] == ["proxy"], sov["flagged"]
+    assert gw["proxy"]["independence"] < 0.05
+    assert gw["h1"]["independence"] > 0.8
+    assert gw["h2"]["independence"] > 0.8
+    credits = {c[0]: c[1] for c in bonus.get("credits") or []}
+    assert credits.get("bc1qh1", 0) > 0
+    assert credits.get("bc1qh2", 0) > 0
+    assert credits.get("bc1qproxy", 0) == 0
+    assert sov["score"]["verified"] >= 1
+    print("FEED_OK")
+
+
+if __name__ == "__main__":
+    main()
