+    /// W7: `sovereignty-attest.jsonl` rolls over at the first verdict of a new (UTC) day, and
+    /// only `ATTEST_KEEP_DAYS` of old files are kept.
+    #[test]
+    fn the_attest_log_rotates_daily() {
+        assert_eq!(ymd(0), "1970-01-01");
+        assert_eq!(ymd(11_016), "2000-02-29");
+        assert_eq!(ymd(20_721), "2026-09-25");
+        let dir = std::env::temp_dir().join(format!("sov007-rotate-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut e = Engine { dir: dir.clone(), ..engine() };
+        let today = now() / 86_400;
+        let stale = dir.join(format!("{ATTEST_FILE}.{}", ymd(today - ATTEST_KEEP_DAYS)));
+        std::fs::write(&stale, "old\n").unwrap();
+        let g = Identity::from_secret_bytes(&[0x64; 64]);
+        let (a, sig, _, _, _) = datum_job(&g, 0x35);
+        std::fs::write(dir.join(ATTEST_FILE), "yesterday\n").unwrap();
+        e.datum_attest.day = Some(today - 1);
+        e.note_datum_verdict(g.sign_pk(), false, 1, 0, &a, &sig, Ok(()));
+        let rolled = std::fs::read_to_string(dir.join(format!("{ATTEST_FILE}.{}", ymd(today - 1)))).unwrap();
+        assert_eq!(rolled, "yesterday\n");
+        assert_eq!(std::fs::read_to_string(dir.join(ATTEST_FILE)).unwrap().lines().count(), 1);
+        assert!(!stale.exists(), "files older than the keep window go");
+        e.note_datum_verdict(g.sign_pk(), false, 2, 0, &a, &sig, Ok(()));
+        assert_eq!(std::fs::read_to_string(dir.join(ATTEST_FILE)).unwrap().lines().count(), 2, "same day: appended");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
 }
