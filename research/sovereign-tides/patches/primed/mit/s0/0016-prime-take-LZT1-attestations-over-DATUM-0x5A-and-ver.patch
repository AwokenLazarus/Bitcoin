+/// DATUM mining sub-command, gateway → Prime: an LZT1 attestation for one job and coinbase
+/// variant (SOV-P-002 W7). Unused by OCEAN datum_gateway v0.4.1 in either direction (its client
+/// sends 0x10, 0x27 and 0x50; it takes 0x11, 0x50, 0x8F, 0x99 and 0xF9), and beside rnd/sov-002's
+/// 0x4e. A Prime that does not know it ignores it (`ClientMsg::Unknown`).
+pub const SUB_LZT1_ATTEST: u8 = 0x5A;
+/// `0x5A | job_id | variant | A (185) | sig (64) | 0xFE`
+pub const ATTEST_MSG_LEN: usize = 3 + ENCODED_LEN + SIG + 1;
+
+/// `A` and its signature for the coinbase a gateway publishes as `variant` (the share's
+/// coinbase id) of `job_id`. Sent before the first share on that job, so Prime has it when the
+/// coinbase arrives.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Lzt1Attest {
+    pub job_id: u8,
+    pub variant: u8,
+    pub a: Attestation,
+    pub sig: [u8; SIG],
+}
+
+impl Lzt1Attest {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut o = Vec::with_capacity(ATTEST_MSG_LEN);
+        o.push(SUB_LZT1_ATTEST);
+        o.push(self.job_id);
+        o.push(self.variant);
+        o.extend_from_slice(&self.a.encode());
+        o.extend_from_slice(&self.sig);
+        o.push(0xFE);
+        o
+    }
+
+    /// Parse the body after the sub-command byte.
+    pub fn decode(body: &[u8]) -> crate::Result<Self> {
+        if body.len() < ATTEST_MSG_LEN - 1 {
+            return Err(crate::Error::Short);
+        }
+        if body.len() != ATTEST_MSG_LEN - 1 || body[body.len() - 1] != 0xFE {
+            return Err(crate::Error::Malformed("lzt1 attestation"));
+        }
+        let a = Attestation::decode(&body[2..2 + ENCODED_LEN])
+            .map_err(|_| crate::Error::Malformed("lzt1 attestation version"))?;
+        let sig = body[2 + ENCODED_LEN..2 + ENCODED_LEN + SIG].try_into().unwrap();
+        Ok(Self { job_id: body[0], variant: body[1], a, sig })
+    }
+}
