@@ -0,0 +1,47 @@
+//! Check a gateway's LZT1 DATUM message (`0x5A …`) against the coinbase it committed to, with
+//! the verifier Prime runs (`authorship::verify`). For testing other gateways' LZT1 code (the
+//! split-only datum_gateway patch) without a Prime.
+//!
+//! cargo run -q -p datum-wire --example lzt1_check -- <0x5A msg hex> <coinbase hex> <prev hex,
+//! internal order> <G hex> [branch hex, internal order ...]
+//!
+//! Prints `ok job=… variant=… G=…` and exits 0, or the verdict and exits 1.
+
+use datum_wire::authorship::{self, Lzt1Attest, SUB_LZT1_ATTEST};
+use datum_wire::coinbase;
+
+fn h(s: &str, what: &str) -> Vec<u8> {
+    hex::decode(s.trim()).unwrap_or_else(|e| panic!("{what}: {e}"))
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.len() < 4 {
+        eprintln!("usage: lzt1_check <0x5A msg> <coinbase> <prev> <G> [branches...]");
+        std::process::exit(2);
+    }
+    let msg = h(&args[0], "msg");
+    if msg.first() != Some(&SUB_LZT1_ATTEST) {
+        println!("not a 0x5A message");
+        std::process::exit(1);
+    }
+    let m = match Lzt1Attest::decode(&msg[1..]) {
+        Ok(m) => m,
+        Err(e) => {
+            println!("malformed: {e}");
+            std::process::exit(1);
+        }
+    };
+    let cb = coinbase::parse(&h(&args[1], "coinbase")).expect("coinbase");
+    let prev: [u8; 32] = h(&args[2], "prev").try_into().expect("prev is 32 bytes");
+    let g: [u8; 32] = h(&args[3], "G").try_into().expect("G is 32 bytes");
+    let branches: Vec<[u8; 32]> =
+        args[4..].iter().map(|b| h(b, "branch").try_into().expect("branch is 32 bytes")).collect();
+    match authorship::verify(&cb, &m.a, &m.sig, &prev, &branches, Some(&g)) {
+        Ok(g) => println!("ok job={} variant={} G={}", m.job_id, m.variant, hex::encode(g)),
+        Err(e) => {
+            println!("{e:?}");
+            std::process::exit(1);
+        }
+    }
+}
