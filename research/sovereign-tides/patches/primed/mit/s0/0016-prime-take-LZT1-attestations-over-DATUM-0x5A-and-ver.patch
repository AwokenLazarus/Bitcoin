+    // --- LZT1 over DATUM (SOV-P-002 W7) --------------------------------------------------
+
+    /// Keep a `0x5A` attestation for its (job, variant) until the first share on that coinbase.
+    /// A newer one for the same pair replaces it. Nothing is checked here: the coinbase it
+    /// belongs to has not arrived yet (it comes with the job's first share).
+    fn on_lzt1_attest(&mut self, m: datum_wire::authorship::Lzt1Attest) -> Result<(), SessionError> {
+        if !self.shared.sovereignty.on() {
+            log::debug!("[{}] LZT1 attestation ignored: sovereignty-mode is off", self.id);
+            return Ok(());
+        }
+        self.shared.sovereignty.engine().note_datum_received();
+        if self.lzt1.len() >= MAX_PENDING_LZT1 && !self.lzt1.contains_key(&(m.job_id, m.variant)) {
+            // Decided ones first; a gateway that floods undecided ones loses the oldest slot.
+            self.lzt1.retain(|_, p| !p.decided);
+            if self.lzt1.len() >= MAX_PENDING_LZT1 {
+                self.lzt1.clear();
+            }
+        }
+        log::debug!(
+            "[{}] {} LZT1 attestation job={} variant={} height={}",
+            self.id,
+            self.gateway_hex,
+            m.job_id,
+            m.variant,
+            m.a.height
+        );
+        let id = m.a.id();
+        self.lzt1.insert((m.job_id, m.variant), PendingLzt1 { msg: m, id, decided: false });
+        Ok(())
+    }
+
+    /// The first accepted share on a coinbase with an attestation on file decides it:
+    /// `authorship::verify` against this job's parent and branches, with this session's identity
+    /// key as the only acceptable `G`. An attestation that neither matches the job's template nor
+    /// is what the coinbase commits to is left alone: it is for a job still to come in this
+    /// slot, or for one that is gone.
+    fn decide_lzt1(&mut self, job_id: u8, variant: u8, cb: &datum_wire::coinbase::Coinbase) {
+        let Some(p) = self.lzt1.get_mut(&(job_id, variant)) else { return };
+        if p.decided {
+            return;
+        }
+        let Some(job) = self.slots[usize::from(job_id)].job.as_ref() else { return };
+        let for_this_job = p.msg.a.prev_hash == job.prev_hash
+            && p.msg.a.branches_hash == datum_wire::authorship::branches_hash(&job.merkle_branches);
+        let committed = matches!(datum_wire::authorship::find(&cb.outputs), Ok(Some((_, id, _))) if id == p.id);
+        if !for_this_job && !committed {
+            return;
+        }
+        p.decided = true;
+        let g = self.hello.identity_sign_pk;
+        let result = datum_wire::authorship::verify(cb, &p.msg.a, &p.msg.sig, &job.prev_hash, &job.merkle_branches, Some(&g))
+            .map(|_| ());
+        let (msg, house) = (p.msg.clone(), self.is_house_stratum());
+        match &result {
+            Ok(()) => log::info!(
+                "[{}] {} LZT1 verified job={} variant={} height={}",
+                self.id,
+                self.gateway_hex,
+                msg.job_id,
+                msg.variant,
+                msg.a.height
+            ),
+            Err(e) => log::warn!(
+                "[{}] {} LZT1 attestation failed job={} variant={} height={}: {e:?}",
+                self.id,
+                self.gateway_hex,
+                msg.job_id,
+                msg.variant,
+                msg.a.height
+            ),
+        }
+        self.shared.sovereignty.engine().note_datum_verdict(
+            g,
+            house,
+            msg.job_id,
+            msg.variant,
+            &msg.a,
+            &msg.sig,
+            result,
+        );
+    }
+
