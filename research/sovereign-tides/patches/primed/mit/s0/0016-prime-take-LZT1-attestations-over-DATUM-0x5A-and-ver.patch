+    /// A DATUM attestation for a fresh job by `g`, and the coinbase it commits to.
+    fn datum_job(g: &Identity, seed: u8) -> (Attestation, [u8; SIG], Coinbase, Hash, Vec<Hash>) {
+        let prev = [seed; 32];
+        let txs: Vec<Hash> = (1..=3u8).map(|i| [i ^ seed; 32]).collect();
+        let branches = datum_wire::pow::merkle_branches_for_coinbase(&txs);
+        let mut outs = sample_outs(312_538_966);
+        let (a, sig, c) = attest(g, 966_267, &prev, &branches, &outs, NodeView::default());
+        outs.push(c);
+        let (bytes, _, _) = coinbase::build(966_267, b"Lazarus", &outs, 0);
+        (a, sig, coinbase::parse(&bytes).unwrap(), prev, branches)
+    }
