+    fn insert_attested(&mut self, key: String, a: Attestation, sig: [u8; SIG]) {
+        if self.attested.insert(key.clone(), AttestedJob { a, sig }).is_none() {
+            self.attested_order.push_back(key);
+            while self.attested_order.len() > MAX_ATTESTED {
+                if let Some(old) = self.attested_order.pop_front() {
+                    self.attested.remove(&old);
+                }
+            }
+        }
+        self.dirty = true;
+    }
+
+    /// W7: a `0x5A` message arrived on a session.
+    pub fn note_datum_received(&mut self) {
+        self.datum_attest.received += 1;
+    }
+
+    /// W7: Prime's verdict on a DATUM-delivered attestation, reached once per job × variant on
+    /// the first share whose coinbase it belongs to (`authorship::verify` against the job, with
+    /// the session's identity key as `G`). A verified attestation from a registered, non-house
+    /// key enters the attested-job set exactly as the HTTP ingest's does, so the job's shares
+    /// credit authored work and its block counts as verified. Every verdict is logged. Returns
+    /// whether the job entered the set.
+    #[allow(clippy::too_many_arguments)]
+    pub fn note_datum_verdict(
+        &mut self,
+        g: [u8; SIGN_PK],
+        house_session: bool,
+        job_id: u8,
+        variant: u8,
+        a: &Attestation,
+        sig: &[u8; SIG],
+        result: Result<(), AttestError>,
+    ) -> bool {
+        let g_hex = hex::encode(g);
+        let house = house_session || self.is_house(&g_hex);
+        let registered = self.lookup(&g_hex).is_some() || self.demo;
+        let attested = result.is_ok() && registered && !house;
+        if attested {
+            let key = JobKey { g, prev: a.prev_hash, branches_hash: a.branches_hash }.id();
+            self.insert_attested(key, a.clone(), *sig);
+        }
+        let verdict = match result {
+            Ok(()) => {
+                self.datum_attest.verified += 1;
+                "verified".to_string()
+            }
+            Err(e) => {
+                self.datum_attest.failed += 1;
+                let why = attest_err(e);
+                *self.datum_attest.reasons.entry(why.clone()).or_insert(0) += 1;
+                why
+            }
+        };
+        let v = AttestVerdict {
+            ts: now(),
+            g: g_hex,
+            job_id,
+            variant,
+            height: a.height,
+            prev: hex::encode(a.prev_hash),
+            id: hex::encode(a.id()),
+            verdict,
+            registered,
+            house,
+            attested,
+        };
+        self.persist_verdict(&v);
+        self.datum_attest.last.push_back(v);
+        while self.datum_attest.last.len() > ATTEST_LAST {
+            self.datum_attest.last.pop_front();
+        }
+        self.dirty = true;
+        attested
+    }
+
+    /// Append a verdict to `ATTEST_FILE`, rotating it first when the day has changed.
+    fn persist_verdict(&mut self, v: &AttestVerdict) {
+        if !self.persists() {
+            return;
+        }
+        let path = self.dir.join(ATTEST_FILE);
+        let today = v.ts / 86_400;
+        let held = self.datum_attest.day.or_else(|| {
+            let m = std::fs::metadata(&path).and_then(|m| m.modified()).ok()?;
+            Some(m.duration_since(UNIX_EPOCH).ok()?.as_secs() / 86_400)
+        });
+        if let Some(day) = held.filter(|d| *d != today) {
+            let rotated = self.dir.join(format!("{ATTEST_FILE}.{}", ymd(day)));
+            if let Err(e) = std::fs::rename(&path, &rotated) {
+                if e.kind() != std::io::ErrorKind::NotFound {
+                    log::warn!("sovereignty: cannot rotate {}: {e}", path.display());
+                }
+            }
+            if let Some(old) = today.checked_sub(ATTEST_KEEP_DAYS) {
+                let _ = std::fs::remove_file(self.dir.join(format!("{ATTEST_FILE}.{}", ymd(old))));
+            }
+        }
+        self.datum_attest.day = Some(today);
+        let line = serde_json::to_string(v).unwrap_or_default() + "\n";
+        let ok = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&path)
+            .and_then(|mut f| f.write_all(line.as_bytes()));
+        if let Err(e) = ok {
+            log::warn!("sovereignty: cannot append to {}: {e}", path.display());
+        }
+    }
