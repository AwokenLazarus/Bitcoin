@@ -0,0 +1,352 @@
+//! Template authorship: a gateway's signed claim, inside its own coinbase, that it built the
+//! block template. R&D sketch for P-003 A2 ([[Tasks/XBT-051]]); nothing in Prime calls it yet.
+//!
+//! The gateway adds one zero-value output to each coinbase variant it publishes:
+//!
+//! ```text
+//! OP_RETURN OP_PUSHDATA1 100 | "XTA" 0x01 | ed25519 pk (32) | signature (64)
+//! ```
+//!
+//! The signature is by `pk` over [`message`]:
+//!
+//! ```text
+//! "XBT-TEMPLATE-AUTHOR/1" 0x00 | height (u32 LE) | prev hash (32, internal order)
+//! | template root (32) | outputs digest (32)
+//! ```
+//!
+//! * The **template root** is the block's merkle root with the coinbase txid replaced by 32 zero
+//!   bytes: it commits to every other transaction and their order, and it is what the gateway's
+//!   stratum merkle branches fold to from a zero leaf. A public verifier gets it from the block's
+//!   txids; Prime gets it from the job's branches. The coinbase is left out because it holds
+//!   the signature.
+//! * The **outputs digest** is SHA256d over the coinbase outputs, serialized as in a transaction
+//!   (count, then value and script each), with the commitment output itself left out. It pins the
+//!   payout split and the segwit witness commitment (hence the wtxids) to the same key.
+//!
+//! What a valid claim proves: whoever holds `pk` approved exactly this transaction set and payout
+//! on this parent, before the block existed. It does not prove whose node produced the set; see
+//! the design note for what that leaves open.
+//!
+//! The key is the gateway's DATUM identity signing key, so Prime can require the claim's key to
+//! be the one the session handshook with. The domain prefix keeps these signatures from ever
+//! being valid handshake or configuration signatures, and the other way round.
+
+use crate::coinbase::{write_varint, Coinbase, TxOut};
+use crate::crypto::{self, Identity, SIG, SIGN_PK};
+use crate::pow::{self, Hash};
+
+pub const MAGIC: [u8; 4] = *b"XTA\x01";
+pub const DOMAIN: &[u8] = b"XBT-TEMPLATE-AUTHOR/1\0";
+/// Bytes pushed after `OP_RETURN OP_PUSHDATA1 len`.
+pub const PAYLOAD: usize = MAGIC.len() + SIGN_PK + SIG;
+/// Serialized size of the commitment output: value, script length, script.
+pub const OUTPUT_BYTES: usize = 8 + 1 + 3 + PAYLOAD;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Claim {
+    pub pk: [u8; SIGN_PK],
+    pub sig: [u8; SIG],
+    /// Position of the commitment among the coinbase outputs.
+    pub index: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AuthorshipError {
+    /// No output carries the magic.
+    Missing,
+    /// More than one does: refused rather than guessing which counts.
+    Multiple,
+    /// The magic is there but the output is not exactly the layout above, carries value, or the
+    /// coinbase has no BIP34 height to bind.
+    Malformed,
+    /// Signed by a key other than the one expected (the session's identity key).
+    WrongKey,
+    /// The signature does not cover this template.
+    BadSignature,
+}
+
+/// Merkle root with a zero coinbase txid, from the coinbase's stratum merkle branches.
+pub fn template_root(branches: &[Hash]) -> Hash {
+    pow::merkle_root([0u8; 32], branches)
+}
+
+/// The same root from a block's transactions: `others` is every txid after the coinbase, in
+/// block order.
+pub fn template_root_from_txids(others: &[Hash]) -> Hash {
+    template_root(&pow::merkle_branches_for_coinbase(others))
+}
+
+/// SHA256d over the outputs, skipping the one at `skip`.
+pub fn outputs_digest(outputs: &[TxOut], skip: Option<usize>) -> Hash {
+    let kept: Vec<&TxOut> = outputs.iter().enumerate().filter(|(i, _)| Some(*i) != skip).map(|(_, o)| o).collect();
+    let mut buf = Vec::new();
+    write_varint(&mut buf, kept.len() as u64);
+    for o in kept {
+        buf.extend_from_slice(&o.value.to_le_bytes());
+        write_varint(&mut buf, o.script.len() as u64);
+        buf.extend_from_slice(&o.script);
+    }
+    pow::sha256d(&buf)
+}
+
+pub fn message(height: u32, prev_hash: &Hash, template_root: &Hash, outputs_digest: &Hash) -> Vec<u8> {
+    let mut m = Vec::with_capacity(DOMAIN.len() + 4 + 96);
+    m.extend_from_slice(DOMAIN);
+    m.extend_from_slice(&height.to_le_bytes());
+    m.extend_from_slice(prev_hash);
+    m.extend_from_slice(template_root);
+    m.extend_from_slice(outputs_digest);
+    m
+}
+
+fn script(pk: &[u8; SIGN_PK], sig: &[u8; SIG]) -> Vec<u8> {
+    let mut s = Vec::with_capacity(3 + PAYLOAD);
+    s.extend_from_slice(&[0x6a, 0x4c, PAYLOAD as u8]);
+    s.extend_from_slice(&MAGIC);
+    s.extend_from_slice(pk);
+    s.extend_from_slice(sig);
+    s
+}
+
+/// What the gateway does: sign the template and return the output to add to `outputs`
+/// (anywhere; the digest is over the others in order).
+pub fn commitment_output(id: &Identity, height: u32, prev_hash: &Hash, branches: &[Hash], outputs: &[TxOut]) -> TxOut {
+    let m = message(height, prev_hash, &template_root(branches), &outputs_digest(outputs, None));
+    TxOut { value: 0, script: script(&id.sign_pk(), &id.sign(&m)) }
+}
+
+/// An OP_RETURN whose first push opens with the magic, by either push opcode.
+fn carries_magic(o: &TxOut) -> bool {
+    let s = &o.script;
+    s.first() == Some(&0x6a) && (s.get(2..6) == Some(&MAGIC[..]) || s.get(3..7) == Some(&MAGIC[..]))
+}
+
+/// Find the commitment among `outputs`. `Ok(None)` when there is none.
+pub fn find(outputs: &[TxOut]) -> Result<Option<Claim>, AuthorshipError> {
+    let mut hits = outputs.iter().enumerate().filter(|(_, o)| carries_magic(o));
+    let Some((index, o)) = hits.next() else {
+        return Ok(None);
+    };
+    if hits.next().is_some() {
+        return Err(AuthorshipError::Multiple);
+    }
+    let s = &o.script;
+    if o.value != 0 || s.len() != 3 + PAYLOAD || s[..3] != [0x6a, 0x4c, PAYLOAD as u8] || s[3..7] != MAGIC {
+        return Err(AuthorshipError::Malformed);
+    }
+    let mut pk = [0u8; SIGN_PK];
+    pk.copy_from_slice(&s[7..7 + SIGN_PK]);
+    let mut sig = [0u8; SIG];
+    sig.copy_from_slice(&s[7 + SIGN_PK..]);
+    Ok(Some(Claim { pk, sig, index }))
+}
+
+/// Check a coinbase's claim against the template it sits in. `expect` is the key the claim must
+/// be made with (Prime: the session's identity key); `None` accepts any key (a public verifier,
+/// which then looks the key up in the gateway directory). Returns the signing key.
+pub fn verify(
+    cb: &Coinbase,
+    prev_hash: &Hash,
+    template_root: &Hash,
+    expect: Option<&[u8; SIGN_PK]>,
+) -> Result<[u8; SIGN_PK], AuthorshipError> {
+    let claim = find(&cb.outputs)?.ok_or(AuthorshipError::Missing)?;
+    let height = cb.height.ok_or(AuthorshipError::Malformed)?;
+    if expect.is_some_and(|k| *k != claim.pk) {
+        return Err(AuthorshipError::WrongKey);
+    }
+    let m = message(height, prev_hash, template_root, &outputs_digest(&cb.outputs, Some(claim.index)));
+    crypto::verify(&claim.pk, &m, &claim.sig).map_err(|_| AuthorshipError::BadSignature)?;
+    Ok(claim.pk)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::coinbase;
+    use crate::verify::fixtures::*;
+    use crate::verify::{verify_with_target, CoinbaseKind, JobSlot, Policy};
+
+    const PREV: Hash = [0x77; 32];
+
+    fn gateway() -> Identity {
+        Identity::from_secret_bytes(&[0x42; 64])
+    }
+
+    /// Split outputs with the gateway's claim appended, and the coinbase they make.
+    fn authored(id: &Identity, txs: &[Hash]) -> (Vec<TxOut>, Coinbase) {
+        let mut outs = gateway_outputs(&split(), &pool_script(), VALUE);
+        let c = commitment_output(id, HEIGHT, &PREV, &pow::merkle_branches_for_coinbase(txs), &outs);
+        outs.push(c);
+        let (bytes, _, _) = coinbase::build(HEIGHT, b"Lazarus\x0fTofu Toes", &outs, 0);
+        (outs, coinbase::parse(&bytes).unwrap())
+    }
+
+    fn root(txs: &[Hash]) -> Hash {
+        template_root_from_txids(txs)
+    }
+
+    #[test]
+    fn claim_round_trips_and_names_its_key() {
+        let id = gateway();
+        let txs = txids(7);
+        let (_, cb) = authored(&id, &txs);
+        assert_eq!(verify(&cb, &PREV, &root(&txs), None), Ok(id.sign_pk()));
+        assert_eq!(verify(&cb, &PREV, &root(&txs), Some(&id.sign_pk())), Ok(id.sign_pk()));
+    }
+
+    #[test]
+    fn output_is_the_documented_size() {
+        let (outs, _) = authored(&gateway(), &txids(3));
+        let c = outs.last().unwrap();
+        assert_eq!(8 + 1 + c.script.len(), OUTPUT_BYTES);
+        assert_eq!(OUTPUT_BYTES, 112);
+    }
+
+    #[test]
+    fn root_from_branches_matches_root_from_block() {
+        for n in [0usize, 1, 2, 3, 4, 5, 16, 17, 1000] {
+            let txs = txids(n);
+            assert_eq!(template_root(&pow::merkle_branches_for_coinbase(&txs)), root(&txs), "{n} txs");
+        }
+        // and folding the real coinbase txid through the same branches gives the block's
+        // merkle root, computed here level by level as a node does
+        let txs = txids(9);
+        let cbid = [0xabu8; 32];
+        let mut level = vec![cbid];
+        level.extend_from_slice(&txs);
+        while level.len() > 1 {
+            if level.len() % 2 == 1 {
+                level.push(*level.last().unwrap());
+            }
+            level = level.chunks(2).map(|p| pow::sha256d(&[p[0], p[1]].concat())).collect();
+        }
+        assert_eq!(pow::merkle_root(cbid, &pow::merkle_branches_for_coinbase(&txs)), level[0]);
+    }
+
+    #[test]
+    fn another_transaction_set_breaks_it() {
+        let txs = txids(7);
+        let (_, cb) = authored(&gateway(), &txs);
+        let mut swapped = txs.clone();
+        swapped.swap(2, 3);
+        assert_eq!(verify(&cb, &PREV, &root(&swapped), None), Err(AuthorshipError::BadSignature));
+        assert_eq!(verify(&cb, &PREV, &root(&txs[..6]), None), Err(AuthorshipError::BadSignature));
+    }
+
+    #[test]
+    fn another_parent_breaks_it() {
+        let txs = txids(4);
+        let (_, cb) = authored(&gateway(), &txs);
+        assert_eq!(verify(&cb, &[0x78; 32], &root(&txs), None), Err(AuthorshipError::BadSignature));
+    }
+
+    #[test]
+    fn lifting_the_claim_onto_another_payout_breaks_it() {
+        // A stratum pool that copies a gateway's claim into its own coinbase (same template,
+        // its own payout) does not get a valid claim.
+        let txs = txids(4);
+        let (outs, _) = authored(&gateway(), &txs);
+        let claim = outs.last().unwrap().clone();
+        let mut theirs = vec![TxOut { value: VALUE, script: p2wpkh(0x99) }, outs[outs.len() - 2].clone()];
+        theirs.push(claim);
+        let (bytes, _, _) = coinbase::build(HEIGHT, b"Other", &theirs, 0);
+        let cb = coinbase::parse(&bytes).unwrap();
+        assert_eq!(verify(&cb, &PREV, &root(&txs), None), Err(AuthorshipError::BadSignature));
+    }
+
+    #[test]
+    fn a_different_height_in_the_scriptsig_breaks_it() {
+        let txs = txids(4);
+        let (outs, _) = authored(&gateway(), &txs);
+        let (bytes, _, _) = coinbase::build(HEIGHT + 1, b"Lazarus", &outs, 0);
+        let cb = coinbase::parse(&bytes).unwrap();
+        assert_eq!(verify(&cb, &PREV, &root(&txs), None), Err(AuthorshipError::BadSignature));
+    }
+
+    #[test]
+    fn prime_requires_the_session_key() {
+        let txs = txids(4);
+        let (_, cb) = authored(&gateway(), &txs);
+        let session = Identity::from_secret_bytes(&[0x43; 64]);
+        assert_eq!(verify(&cb, &PREV, &root(&txs), Some(&session.sign_pk())), Err(AuthorshipError::WrongKey));
+    }
+
+    #[test]
+    fn swapping_in_another_key_breaks_it() {
+        // Replace the pk inside the claim, keep the signature: the name is not forgeable.
+        let txs = txids(4);
+        let (mut outs, _) = authored(&gateway(), &txs);
+        let other = Identity::from_secret_bytes(&[0x44; 64]).sign_pk();
+        let last = outs.last_mut().unwrap();
+        last.script[7..7 + SIGN_PK].copy_from_slice(&other);
+        let (bytes, _, _) = coinbase::build(HEIGHT, b"Lazarus", &outs, 0);
+        let cb = coinbase::parse(&bytes).unwrap();
+        assert_eq!(verify(&cb, &PREV, &root(&txs), None), Err(AuthorshipError::BadSignature));
+    }
+
+    #[test]
+    fn missing_multiple_and_malformed_claims() {
+        let txs = txids(4);
+        let plain = gateway_outputs(&split(), &pool_script(), VALUE);
+        let (bytes, _, _) = coinbase::build(HEIGHT, b"Lazarus", &plain, 0);
+        let cb = coinbase::parse(&bytes).unwrap();
+        assert_eq!(verify(&cb, &PREV, &root(&txs), None), Err(AuthorshipError::Missing));
+
+        let (mut outs, _) = authored(&gateway(), &txs);
+        let c = outs.last().unwrap().clone();
+        outs.push(c.clone());
+        assert_eq!(find(&outs), Err(AuthorshipError::Multiple));
+
+        let mut valued = c.clone();
+        valued.value = 1;
+        assert_eq!(find(&[valued]), Err(AuthorshipError::Malformed));
+        let mut short = c;
+        short.script.pop();
+        assert_eq!(find(&[short]), Err(AuthorshipError::Malformed));
+    }
+
+    #[test]
+    fn claim_can_sit_anywhere_among_the_outputs() {
+        let id = gateway();
+        let txs = txids(5);
+        let plain = gateway_outputs(&split(), &pool_script(), VALUE);
+        let c = commitment_output(&id, HEIGHT, &PREV, &pow::merkle_branches_for_coinbase(&txs), &plain);
+        let mut outs = plain.clone();
+        outs.insert(1, c);
+        let (bytes, _, _) = coinbase::build(HEIGHT, b"Lazarus", &outs, 0);
+        let cb = coinbase::parse(&bytes).unwrap();
+        assert_eq!(verify(&cb, &PREV, &root(&txs), None), Ok(id.sign_pk()));
+    }
+
+    /// End to end through Prime's share verifier: an authored coinbase is still a full Split
+    /// (the claim is a zero-value OP_RETURN), and the job Prime holds is enough to check the
+    /// claim with the session key: prev hash and branches from the job, coinbase from the share.
+    #[test]
+    fn prime_checks_a_real_share_on_an_authored_job() {
+        let id = gateway();
+        let txs = txids(12);
+        let (outs, _) = authored(&id, &txs);
+        let iss = split();
+        let pool = pool_script();
+        let p = Policy {
+            pool_script: &pool,
+            issued: Some(&iss),
+            tolerance: 2,
+            now: NOW,
+            min_pot: 0,
+            gateway_script: None,
+            empty_solo_fee_bps: 250,
+            trusted_target: false,
+            uncommitted_pot: 20,
+        };
+        let mut slot = JobSlot::default();
+        let mut s = share(2, 4, 9, &outs, &txs, 3, [0; 8], [0; 8]);
+        let job = s.job.clone().unwrap();
+        grind(&mut slot, &mut s);
+        let v = verify_with_target(&mut slot, &s, &p, &easy_target()).expect("share verifies");
+        assert_eq!(v.coinbase_kind, CoinbaseKind::Split);
+        let troot = template_root(&job.merkle_branches);
+        assert_eq!(verify(&v.coinbase, &job.prev_hash, &troot, Some(&id.sign_pk())), Ok(id.sign_pk()));
+    }
+}
