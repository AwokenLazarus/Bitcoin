+//! Print a signed template-authorship fixture as JSON, for cross-checking other verifiers
+//! (the Python chain scanner in ~/xbt-rnd/XBT-051). Deterministic: fixed key, fixed template.
+//!
+//! cargo run --offline -q -p datum-wire --example xta_fixture > fixture.json
+
+use datum_wire::authorship;
+use datum_wire::coinbase::{self, TxOut};
+use datum_wire::crypto::Identity;
+use datum_wire::pow;
+
+fn main() {
+    let id = Identity::from_secret_bytes(&[0x42; 64]);
+    let height = 974_100u32;
+    let prev = pow::sha256d(b"xbt-051 fixture parent");
+    let txids: Vec<[u8; 32]> = (0u32..11).map(|i| pow::sha256d(&i.to_le_bytes())).collect();
+    let mut outs = vec![
+        TxOut { value: 200_000_000, script: [&[0x00, 0x14][..], &[0x11; 20]].concat() },
+        TxOut { value: 112_538_966, script: [&[0x00, 0x20][..], &[0x5d; 32]].concat() },
+        TxOut { value: 0, script: [&[0x6a, 0x24, 0xaa, 0x21, 0xa9, 0xed][..], &[0x76; 32]].concat() },
+    ];
+    let c = authorship::commitment_output(&id, height, &prev, &pow::merkle_branches_for_coinbase(&txids), &outs);
+    outs.push(c);
+    let (cb, _, _) = coinbase::build(height, b"Lazarus\x0fTofu Toes", &outs, 0);
+    let hx = |h: &[u8]| hex::encode(h);
+    println!(
+        "{{\"height\":{height},\"prev_hash\":\"{}\",\"txids\":[{}],\"coinbase\":\"{}\",\"pk\":\"{}\",\"template_root\":\"{}\"}}",
+        hx(&prev),
+        txids.iter().map(|t| format!("\"{}\"", hx(t))).collect::<Vec<_>>().join(","),
+        hx(&cb),
+        hx(&id.sign_pk()),
+        hx(&authorship::template_root_from_txids(&txids)),
+    );
+}
