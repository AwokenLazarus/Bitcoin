+//! Sovereignty bonus: extra TIDES credit for work on templates a gateway provably signed.
+//! R&D sketch for P-003 A2 ([[Tasks/XBT-051]]); nothing calls it yet.
+//!
+//! **Eligible ("authored") work** is DATUM work on a job whose coinbase carried a valid
+//! `datum_wire::authorship` claim made with the session's own identity key, from a gateway
+//! that is not the pool's (house keys never qualify) and whose key has been seen for at least
+//! the configured age. Prime decides this per job when it absorbs the job's coinbase, so every
+//! share on the job is authored or none is.
+//!
+//! **Pot.** Two sources, both closed-form on the window totals like the DATUM rebate:
+//!
+//! ```text
+//! from_stratum = value × stratum_work / total_work × bonus_bps           (bonus_bps ≤ stratum fee − rebate)
+//! from_diff    = value × unauthored_datum_work / total_work × diff_bps   (charged on unsigned DATUM work)
+//! ```
+//!
+//! The first is the rebate's twin, paid out of the same stratum fee, so the pool's net on
+//! stratum work stays `fee − rebate − bonus ≥ 0`. It dies with stratum (P-001). The second is
+//! what keeps the incentive alive after that: unsigned DATUM work pays a small fee that goes,
+//! whole, to signed DATUM work; the pool keeps none of it.
+//!
+//! **Credit.** The pot is shared pro rata by authored work and joins each identity's carry, the
+//! way rebate credits do (reversed on orphan by the same `carry_delta`). Linear pro rata is
+//! deliberate: splitting one operator into many identities or many gateway keys changes
+//! nothing (up to rounding), so there is nothing to gain from Sybils.
+//!
+//! **No deferral.** Unlike `rebate_owed`, a pot with no authored work to credit goes back to
+//! the pool (or, for `from_diff`, is simply not charged). An owed pot would grow while nobody
+//! signs and hand the first signer a windfall, which is exactly what a gamer waits for.
+
+use crate::split::fee_for;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct BonusParams {
+    /// House-stratum fee, basis points of stratum work's value.
+    pub stratum_fee_bps: u32,
+    /// The DATUM rebate already taken out of that fee.
+    pub datum_rebate_bps: u32,
+    /// Bonus out of the stratum fee. Clamped to `stratum_fee_bps − datum_rebate_bps`.
+    pub bonus_bps: u32,
+    /// Differential charged on unauthored DATUM work, all of it credited to authored work.
+    pub diff_bps: u32,
+}
+
+impl BonusParams {
+    /// The bonus rate actually applied after the clamp.
+    pub fn effective_bonus_bps(&self) -> u32 {
+        let rebate = self.datum_rebate_bps.min(self.stratum_fee_bps);
+        self.bonus_bps.min(self.stratum_fee_bps - rebate)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct WorkTotals {
+    pub total: u64,
+    pub stratum: u64,
+    /// DATUM work on jobs with no valid claim (or a house or too-young key).
+    pub unauthored_datum: u64,
+    /// DATUM work on authored jobs.
+    pub authored: u64,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Bonus {
+    pub from_stratum: u64,
+    pub from_diff: u64,
+    /// identity → sats, joins carry when the block is found.
+    pub credits: Vec<(String, u64)>,
+    /// Stratum-funded bonus nobody could take (no authored work, or rounding): the pool keeps it.
+    pub to_pool: u64,
+    /// Differential not charged because nobody was authored to receive it.
+    pub diff_waived: u64,
+}
+
+fn share_of(value: u64, part: u64, total: u64, bps: u32) -> u64 {
+    if total == 0 || bps == 0 {
+        return 0;
+    }
+    (u128::from(value) * u128::from(part.min(total)) * u128::from(bps) / u128::from(total) / 10_000) as u64
+}
+
+/// This block's bonus. `authored` is identity → authored work in the window.
+pub fn compute(value: u64, t: WorkTotals, p: BonusParams, authored: &[(String, u64)]) -> Bonus {
+    let from_stratum = fee_for(share_of(value, t.stratum, t.total, 10_000), p.effective_bonus_bps());
+    let from_diff = share_of(value, t.unauthored_datum, t.total, p.diff_bps);
+    let total_authored: u64 = authored.iter().map(|a| a.1).sum();
+    if total_authored == 0 {
+        return Bonus { from_stratum, from_diff, credits: Vec::new(), to_pool: from_stratum, diff_waived: from_diff };
+    }
+    let pot = from_stratum + from_diff;
+    let mut credited = 0u64;
+    let credits: Vec<(String, u64)> = authored
+        .iter()
+        .filter_map(|(id, w)| {
+            let c = (u128::from(pot) * u128::from(*w) / u128::from(total_authored)) as u64;
+            credited += c;
+            (c > 0).then(|| (id.clone(), c))
+        })
+        .collect();
+    Bonus { from_stratum, from_diff, credits, to_pool: pot - credited, diff_waived: 0 }
+}
+
+/// What the pool nets on stratum work after the rebate and the bonus: never negative.
+pub fn pool_net_on_stratum(value: u64, t: WorkTotals, p: BonusParams) -> u64 {
+    let stratum_value = share_of(value, t.stratum, t.total, 10_000);
+    let fee = fee_for(stratum_value, p.stratum_fee_bps);
+    // All three off the same floored stratum value, so floor(a) + floor(b) <= floor(a + b)
+    // keeps the sum inside the fee.
+    let rebate = fee_for(stratum_value, p.datum_rebate_bps.min(p.stratum_fee_bps));
+    let bonus = fee_for(stratum_value, p.effective_bonus_bps());
+    fee.checked_sub(rebate + bonus).expect("rebate + bonus never exceed the stratum fee")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const V: u64 = 312_500_000;
+
+    fn totals(stratum: u64, unauth: u64, auth: u64) -> WorkTotals {
+        WorkTotals { total: stratum + unauth + auth, stratum, unauthored_datum: unauth, authored: auth }
+    }
+
+    fn sum(b: &Bonus) -> u64 {
+        b.credits.iter().map(|c| c.1).sum()
+    }
+
+    #[test]
+    fn bonus_is_clamped_under_the_fee_left_after_the_rebate() {
+        let p = BonusParams { stratum_fee_bps: 800, datum_rebate_bps: 500, bonus_bps: 500, diff_bps: 0 };
+        assert_eq!(p.effective_bonus_bps(), 300);
+        let p = BonusParams { stratum_fee_bps: 800, datum_rebate_bps: 900, bonus_bps: 500, diff_bps: 0 };
+        assert_eq!(p.effective_bonus_bps(), 0);
+    }
+
+    #[test]
+    fn stratum_funded_bonus_goes_to_authored_work_pro_rata() {
+        // 37% stratum, 40% unsigned DATUM, 23% signed; 25% fee, 10% rebate, 5% bonus.
+        let t = totals(370, 400, 230);
+        let p = BonusParams { stratum_fee_bps: 2500, datum_rebate_bps: 1000, bonus_bps: 500, diff_bps: 0 };
+        let b = compute(V, t, p, &[("a".into(), 200), ("b".into(), 30)]);
+        assert_eq!(b.from_stratum, V * 370 / 1000 * 500 / 10_000);
+        assert_eq!(sum(&b) + b.to_pool, b.from_stratum);
+        let a = b.credits.iter().find(|c| c.0 == "a").unwrap().1;
+        let bb = b.credits.iter().find(|c| c.0 == "b").unwrap().1;
+        assert!((a as i64 - (bb as i64) * 200 / 30).abs() <= 7);
+    }
+
+    #[test]
+    fn nobody_authored_means_the_pool_keeps_it_and_nothing_is_owed() {
+        let t = totals(500, 500, 0);
+        let p = BonusParams { stratum_fee_bps: 2500, datum_rebate_bps: 1000, bonus_bps: 500, diff_bps: 100 };
+        let b = compute(V, t, p, &[]);
+        assert!(b.credits.is_empty());
+        assert_eq!(b.to_pool, b.from_stratum);
+        assert_eq!(b.diff_waived, b.from_diff);
+        assert!(b.from_diff > 0);
+    }
+
+    #[test]
+    fn differential_keeps_the_bonus_alive_after_stratum_is_gone() {
+        let t = totals(0, 700, 300);
+        let p = BonusParams { stratum_fee_bps: 2500, datum_rebate_bps: 1000, bonus_bps: 500, diff_bps: 100 };
+        let b = compute(V, t, p, &[("x".into(), 300)]);
+        assert_eq!(b.from_stratum, 0);
+        assert_eq!(b.from_diff, V * 700 / 1000 / 100);
+        assert_eq!(sum(&b) + b.to_pool, b.from_diff);
+        assert!(b.to_pool <= 1);
+    }
+
+    #[test]
+    fn splitting_into_sybils_gains_nothing() {
+        let t = totals(400, 300, 300);
+        let p = BonusParams { stratum_fee_bps: 2500, datum_rebate_bps: 1000, bonus_bps: 500, diff_bps: 50 };
+        let one = compute(V, t, p, &[("farm".into(), 250), ("solo".into(), 50)]);
+        let many: Vec<(String, u64)> =
+            (0..25).map(|i| (format!("farm{i}"), 10)).chain(std::iter::once(("solo".into(), 50))).collect();
+        let split = compute(V, t, p, &many);
+        let farm_one = one.credits.iter().find(|c| c.0 == "farm").unwrap().1;
+        let farm_many: u64 = split.credits.iter().filter(|c| c.0.starts_with("farm")).map(|c| c.1).sum();
+        assert!(farm_many <= farm_one, "Sybils must not earn more: {farm_many} > {farm_one}");
+        assert!(farm_one - farm_many <= 25, "only rounding");
+    }
+
+    #[test]
+    fn conservation_and_pool_net_hold_across_random_windows() {
+        // Small LCG so the test needs no dependency.
+        let mut s = 0x2545_f491_4f6c_dd1du64;
+        let mut next = |m: u64| {
+            s = s.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+            (s >> 33) % m
+        };
+        for _ in 0..5_000 {
+            let t = totals(next(1 << 40), next(1 << 40), next(1 << 40));
+            if t.total == 0 {
+                continue;
+            }
+            let p = BonusParams {
+                stratum_fee_bps: next(3000) as u32,
+                datum_rebate_bps: next(3000) as u32,
+                bonus_bps: next(3000) as u32,
+                diff_bps: next(300) as u32,
+            };
+            let n = 1 + next(40) as usize;
+            let mut left = t.authored;
+            let authored: Vec<(String, u64)> = (0..n)
+                .map(|i| {
+                    let w = if i + 1 == n { left } else { next(left + 1) };
+                    left -= w;
+                    (format!("m{i}"), w)
+                })
+                .collect();
+            let v = 1 + next(1_000_000_000);
+            let b = compute(v, t, p, &authored);
+            assert_eq!(sum(&b) + b.to_pool + b.diff_waived, b.from_stratum + b.from_diff);
+            assert!(b.to_pool <= b.from_stratum + n as u64);
+            let _ = pool_net_on_stratum(v, t, p); // panics if the fee is over-spent
+        }
+    }
+}
