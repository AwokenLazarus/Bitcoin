--- a/prime/primed/src/node.rs
+++ b/prime/primed/src/node.rs
@@ -287,17 +287,20 @@ fn settle_confirmed(shared: &Shared, hash: &str) {
 /// out. `duplicate` and `inconclusive` mean the node already has it, and `rejected: ...` is a
 /// failure to ask. Anything not listed here waits for `confirm_blocks`, as it always did.
 pub fn says_invalid(outcome: &str) -> bool {
-    matches!(
-        outcome,
-        "high-hash"
-            | "bad-diffbits"
-            | "bad-prevblk"
-            | "bad-version"
-            | "bad-cb-height"
-            | "time-too-old"
-            | "time-too-new"
-            | "duplicate-invalid"
-    )
+    // rnd/sov-002: an XBT-NTA refusal is about the coinbase Prime issued, so the block can
+    // never become valid: release its books now (it is not the gateway's template fault).
+    outcome.trim().starts_with("bad-nta-")
+        || matches!(
+            outcome,
+            "high-hash"
+                | "bad-diffbits"
+                | "bad-prevblk"
+                | "bad-version"
+                | "bad-cb-height"
+                | "time-too-old"
+                | "time-too-new"
+                | "duplicate-invalid"
+        )
 }
 
