 use crate::coinbase::{write_varint, Coinbase, TxOut};
 use crate::crypto::{self, Identity, SIG, SIGN_PK};
 use crate::pow::{self, Hash};
 
-pub const MAGIC: [u8; 4] = *b"XTA\x01";
-pub const DOMAIN: &[u8] = b"XBT-TEMPLATE-AUTHOR/1\0";
