+    /// Prime handed to that gateway's node (the pool node never templates them).
+    fn converged(n: usize) -> (Vec<Snapshot>, Vec<Snapshot>, Vec<Snapshot>, Vec<Snapshot>, Vec<Canary>) {
+        let mut pool = Vec::new();
+        let mut honest = Vec::new();
+        let mut proxy = Vec::new();
+        let mut hybrid = Vec::new();
+        let mut canaries = Vec::new();
+        let mut live: Vec<String> = Vec::new();
+        for i in 0..n {
+            let t = i as f64 * 0.5;
+            let prev = hex32(1 + (i / 30) as u64);
+            let shared: Vec<String> = (0..5).map(|k| hex32(1_000 + (i / 4 + k) as u64)).collect();
+            if i % 8 == 0 {
+                let c = hex32(9_000_000 + i as u64);
+                canaries.push(Canary::new(t, c.clone()));
+                live.push(c);
+            }
+            if i % 30 == 0 {
+                live.clear(); // mined into the gateway's block
+            }
+            let mut h = shared.clone();
+            // the gateway's node refreshes its template a couple of seconds after delivery
+            h.extend(live.iter().filter(|c| canaries.iter().any(|k| &&k.txid == c && k.t + 2.0 <= t)).cloned());
+            pool.push(Snapshot::new(t, prev.clone(), shared.clone()));
+            honest.push(Snapshot::new(t + 0.01, prev.clone(), h.clone()));
+            proxy.push(Snapshot::new(t + 0.05, prev.clone(), shared.clone()));
+            hybrid.push(Snapshot::new(t + 0.3, prev.clone(), h));
+        }
+        (pool, honest, proxy, hybrid, canaries)
+    }
+
+    #[test]
+    fn converged_honest_is_not_flagged_without_canaries() {
+        let (pool, _, _, _, _) = converged(200);
+        // no canaries yet: the honest node's template is the pool's, 10 ms later
+        let honest: Vec<Snapshot> = pool.iter().map(|s| Snapshot { t: s.t + 0.01, ..s.clone() }).collect();
+        let f = features(&honest, &pool);
+        assert!(f.identical > 0.9, "{}", f.identical);
+        assert!(!f.flagged, "identity to the pool alone must never flag");
+        assert_eq!(f.evidence, "timing");
+    }
+
+    #[test]
+    fn canaries_clear_converged_honest_and_convict_proxies() {
+        let (pool, honest, proxy, _, canaries) = converged(200);
+        let fh = features_with(&honest, &pool, &canaries);
+        assert_eq!(fh.evidence, "canary");
+        assert!(fh.canaries_due >= CANARY_MIN, "{}", fh.canaries_due);
+        assert!(fh.independence > 0.8, "honest {}", fh.independence);
+        assert!(!fh.flagged);
+        let fp = features_with(&proxy, &pool, &canaries);
+        assert_eq!(fp.canary_hits, 0);
+        assert_eq!(fp.independence, 0.0);
+        assert!(fp.flagged);
+        let mut mimic = proxy.clone();
+        for s in &mut mimic {
+            s.t += 1.0;
+            s.txids.reverse();
+        }
+        let fm = features_with(&mimic, &pool, &canaries);
+        assert!(fm.flagged && fm.canary_hits == 0);
+    }
+
+    #[test]
+    fn a_canary_the_pool_had_first_is_not_a_hit() {
+        let (mut pool, honest, _, _, canaries) = converged(200);
+        // pool node ignored its prioritisetransaction: every canary shows up there first
+        for c in &canaries {
+            pool.push(Snapshot::new(c.t, "zz", vec![c.txid.clone()]));
+        }
+        let f = features_with(&honest, &pool, &canaries);
+        assert_eq!(f.canary_hits, 0);
+        assert_eq!(f.canary_pool_leaks, canaries.len());
+    }
+
+    /// Known limit: a proxy that also runs the registered node and merges its mempool into the
+    /// pool's template carries the canaries. It is only priced by key age and the cap.
+    #[test]
+    fn hybrid_merging_its_own_node_passes_canaries() {
+        let (pool, _, _, hybrid, canaries) = converged(200);
+        let f = features_with(&hybrid, &pool, &canaries);
+        assert!(!f.flagged);
+    }
