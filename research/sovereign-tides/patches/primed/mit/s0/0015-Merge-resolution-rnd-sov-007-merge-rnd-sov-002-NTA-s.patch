From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: michael moore <mrmoore27@pm.me>
Date: Fri, 25 Sep 2026 09:20:30 +0000
Subject: [PATCH 15/27] Merge resolution: rnd/sov-007: merge rnd/sov-002 (NTA
 signing) into rnd/sov-006 (S0 rework)

Linearised for publication: the side-branch commits above were replayed onto the
first parent; this commit brings the tree to exactly 634b572 (the merge).
---
 prime/primed/src/main.rs  |  4 +++-
 prime/primed/src/state.rs |  5 +++--
 prime/primed/src/stats.rs | 15 ++++++++++-----
 3 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/prime/primed/src/main.rs b/prime/primed/src/main.rs
index 3ef3c20..d247907 100644
--- a/prime/primed/src/main.rs
+++ b/prime/primed/src/main.rs
@@ -312,7 +312,7 @@ fn run(cfg: Config) -> i32 {
         next_client_id: AtomicU64::new(1),
         coinbaser_base: Mutex::new(None),
         gateway_payouts: Mutex::new(Shared::load_gateway_payouts(&cfg.data_dir)),
-        sovereignty: Mutex::new(crate::sovereignty::Engine::from_config(&cfg)),
+        sovereignty: crate::sovereignty::Sovereignty::from_config(&cfg),
         nta_pool,
         nta: Mutex::new(Default::default()),
         cfg,
@@ -569,6 +569,8 @@ pub fn test_shared(dir: &std::path::Path, extra: &str) -> Shared {
         coinbaser_base: Mutex::new(None),
         gateway_payouts: Mutex::new(Default::default()),
         sovereignty: crate::sovereignty::Sovereignty::from_config(&cfg),
+        nta_pool: None,
+        nta: Mutex::new(Default::default()),
         cfg,
     }
 }
