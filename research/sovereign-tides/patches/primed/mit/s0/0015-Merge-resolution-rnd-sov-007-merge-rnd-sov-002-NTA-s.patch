-    /// Sovereign TIDES: key directory, job snapshots, attestations, detector, bonus.
-    pub sovereignty: Mutex<crate::sovereignty::Engine>,
+    /// Sovereign TIDES: key directory, job snapshots, attestations, detector, bonus. Inert
+    /// unless `sovereignty-mode` is on.
+    pub sovereignty: crate::sovereignty::Sovereignty,
     /// rnd/sov-002: the pool payout key when `nta-height` is set, and the attestation book.
     pub nta_pool: Option<datum_wire::nta::Signer>,
     pub nta: Mutex<crate::nta::Book>,
diff --git a/prime/primed/src/stats.rs b/prime/primed/src/stats.rs
index d6300aa..a62a1d2 100644
--- a/prime/primed/src/stats.rs
+++ b/prime/primed/src/stats.rs
@@ -403,7 +403,8 @@ pub async fn serve(shared: Arc<Shared>) {
                 ("GET", "/" | "/stats.json" | "/stats") => ("200 OK", "application/json", document(0).await),
                 ("GET", "/ledger.json") => ("200 OK", "application/json", document(1).await),
                 ("GET", "/healthz") => ("200 OK", "text/plain", plain("ok\n")),
-                ("GET", "/nta.json" | "/nta") => {
+                // Only with `nta-height` set, so a Prime without NTA serves the old routes.
+                ("GET", "/nta.json" | "/nta") if shared.cfg.nta_height.is_some() => {
                     let body = shared
                         .nta
                         .lock()
@@ -412,10 +413,14 @@ pub async fn serve(shared: Arc<Shared>) {
                         .to_string();
                     ("200 OK", "application/json", Arc::new(body))
                 }
-                ("GET", "/sovereignty.json" | "/sovereignty") => {
-                    let ledger = shared.ledger.lock().unwrap();
-                    let body = shared.sovereignty.lock().unwrap().stats_json(Some(&ledger.window)).to_string();
-                    ("200 OK", "application/json", Arc::new(body))
+                // `sovereignty-mode = "off"`: these routes do not exist (the 404 below).
