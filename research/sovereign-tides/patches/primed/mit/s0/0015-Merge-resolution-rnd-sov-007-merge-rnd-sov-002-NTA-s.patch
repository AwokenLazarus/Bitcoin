+                    // one lock at a time: the window's work (only with the bonus on), then render
+                    let work = r
+                        .needs_window()
+                        .then(|| crate::sovereignty::WindowWork::of(&shared.ledger.lock().unwrap().window));
+                    ("200 OK", "application/json", Arc::new(r.render(work).to_string()))
                 }
                 ("POST", p) if p.starts_with("/sovereignty/") && shared.sovereignty.on() => {
                     let token = header(&req, crate::sovereignty::TOKEN_HEADER);
