diff --git a/prime/primed/src/nta.rs b/prime/primed/src/nta.rs
new file mode 100644
index 0000000..f7f931f
--- /dev/null
+++ b/prime/primed/src/nta.rs
@@ -0,0 +1,288 @@
+//! XBT-NTA (rnd/sov-002): the attestations gateways sent for each tip, and the coinbaser
+//! filter they drive.
+//!
+//! After `nta-height`, a coinbase may pay only `OP_1 <K>` scripts whose key signed
+//! `NtaAttestationHash(script, height, nBits, prev)` for the block being built. A signing
+//! gateway sends that signature ([`NtaAttest`]) on every new tip, ahead of its coinbaser
+//! request. The book keeps them per tip; a coinbaser for the tip pays only the scripts found
+//! here plus the pool's own (Prime signs that with `nta-pool-key-file`), and every other
+//! payee's share is carried ([`tides::UnpaidReason::Unattested`]).
+//!
+//! The (height, nBits) a coinbaser commits to are always Prime's own, from its node's tip,
+//! never a gateway's claim: one validly signed attestation for the wrong nBits would make
+//! every block that lists it invalid.
+
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::time::Instant;
+
+use datum_wire::nta::{self, NtaAttest, Signer};
+use serde_json::{json, Value};
+
+/// Tips kept: the current one, and a few for a gateway still finishing work on its parent.
+const TIPS_KEPT: usize = 8;
+/// Latency samples kept for the percentiles.
+const SAMPLES_KEPT: usize = 4096;
+
+/// Where the next block goes, as Prime's node says.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Target {
+    pub prev: [u8; 32],
+    pub height: u32,
+    pub nbits: u32,
+}
+
+#[derive(Debug)]
+struct Signed {
+    sig: [u8; 64],
+    gateway: String,
+    /// Milliseconds after Prime first knew of the tip.
+    ms: f64,
+}
+
+#[derive(Debug)]
+struct TipBook {
+    target: Target,
+    first_seen: Instant,
+    first_seen_ts: u64,
+    /// Payee script -> its signature for this tip.
+    sigs: HashMap<Vec<u8>, Signed>,
+    pool_sig: [u8; 64],
+    coinbasers: u32,
+    /// Most attested payees any coinbaser on this tip listed, and when (ms) it first did.
+    best_payees: usize,
+    best_at_ms: f64,
+}
+
+#[derive(Debug, Default)]
+pub struct Book {
+    tips: VecDeque<TipBook>,
+    samples: VecDeque<f64>,
+    pub accepted: u64,
+    pub refused: u64,
+    pub unknown_tip: u64,
+    pub coinbasers: u64,
+    pub coinbasers_carrying: u64,
+}
+
+/// What an attestation came to.
+#[derive(Debug, PartialEq)]
+pub enum Outcome {
+    /// Stored; milliseconds after Prime first knew of the tip.
+    Accepted(f64),
+    /// Same script already signed this tip.
+    Duplicate,
+    /// Not for a tip Prime knows (yet): nothing it could be checked against.
+    UnknownTip,
+    /// Its (height, nBits) are not the node's for that tip, or the signature does not verify.
+    Refused(&'static str),
+}
+
+impl Book {
+    fn tip_mut(&mut self, t: Target, seen: Instant, seen_ts: u64, pool: &Signer) -> &mut TipBook {
+        if let Some(i) = self.tips.iter().position(|b| b.target.prev == t.prev) {
+            if self.tips[i].target != t {
+                // The node's view of the block after this parent changed (it cannot, for a
+                // given parent, except that we first learned it from something else): start over.
+                self.tips.remove(i);
+            } else {
+                let b = &mut self.tips[i];
+                if seen < b.first_seen {
+                    b.first_seen = seen;
+                    b.first_seen_ts = seen_ts;
+                }
+                return &mut self.tips[i];
+            }
+        }
+        self.tips.push_back(TipBook {
+            target: t,
+            first_seen: seen,
+            first_seen_ts: seen_ts,
+            sigs: HashMap::new(),
+            pool_sig: pool.sign(t.height, t.nbits, &t.prev),
+            coinbasers: 0,
+            best_payees: 0,
+            best_at_ms: 0.0,
+        });
+        while self.tips.len() > TIPS_KEPT {
+            self.tips.pop_front();
+        }
+        self.tips.back_mut().unwrap()
+    }
+
+    /// Note a tip Prime's node reported, so latency counts from when Prime first knew it.
+    pub fn note_tip(&mut self, t: Target, seen: Instant, seen_ts: u64, pool: &Signer) {
+        self.tip_mut(t, seen, seen_ts, pool);
+    }
+
+    /// File an attestation, checked against `target` (Prime's own view of the block after
+    /// `a.prev_hash`, or `None` if its node does not know that parent).
+    pub fn add(&mut self, a: &NtaAttest, target: Option<Target>, gateway: &str, pool: &Signer) -> Outcome {
+        let Some(t) = target.filter(|t| t.prev == a.prev_hash) else {
+            self.unknown_tip += 1;
+            return Outcome::UnknownTip;
+        };
+        if (a.height, a.nbits) != (t.height, t.nbits) {
+            self.refused += 1;
+            return Outcome::Refused("height or nbits is not the node's for this tip");
+        }
+        if !a.verify() {
+            self.refused += 1;
+            return Outcome::Refused("signature does not verify");
+        }
+        let now = Instant::now();
+        let book = self.tip_mut(t, now, crate::state::now(), pool);
+        let script = a.script();
+        if book.sigs.contains_key(&script) {
+            return Outcome::Duplicate;
+        }
+        let ms = now.duration_since(book.first_seen).as_secs_f64() * 1000.0;
+        book.sigs.insert(script, Signed { sig: a.sig, gateway: gateway.to_string(), ms });
+        self.accepted += 1;
+        self.samples.push_back(ms);
+        while self.samples.len() > SAMPLES_KEPT {
+            self.samples.pop_front();
+        }
+        Outcome::Accepted(ms)
+    }
+
+    /// Scripts a coinbaser for `t` may pay: every attested one, and the pool's.
+    pub fn payable(&mut self, t: Target, pool: &Signer) -> HashSet<Vec<u8>> {
+        let book = self.tip_mut(t, Instant::now(), crate::state::now(), pool);
+        let mut s: HashSet<Vec<u8>> = book.sigs.keys().cloned().collect();
+        s.insert(pool.script());
+        s
+    }
+
+    /// The attestation outputs for `outputs` on `t`: one per distinct value-bearing script,
+    /// in output order, as Knots checks them. `None` if a paid script has no signature here
+    /// (a bug upstream: the coinbaser must not be sent).
+    pub fn attestations(&mut self, t: Target, outputs: &[(u64, Vec<u8>)], pool: &Signer) -> Option<Vec<Vec<u8>>> {
+        let pool_script = pool.script();
+        let book = self.tip_mut(t, Instant::now(), crate::state::now(), pool);
+        let mut out = Vec::new();
+        for script in nta::required_payees(outputs.iter().map(|(s, p)| (*s, p.as_slice()))) {
+            let sig = if script == pool_script.as_slice() { book.pool_sig } else { book.sigs.get(script)?.sig };
+            out.push(nta::attestation_script(&sig));
+        }
+        Some(out)
+    }
+
+    /// Count a coinbaser issued on `t` listing `attested` payees and carrying `carried`.
+    pub fn note_coinbaser(&mut self, t: Target, attested: usize, carried: usize, pool: &Signer) {
+        self.coinbasers += 1;
+        if carried > 0 {
+            self.coinbasers_carrying += 1;
+        }
+        let book = self.tip_mut(t, Instant::now(), crate::state::now(), pool);
+        book.coinbasers += 1;
+        if attested > book.best_payees {
+            book.best_payees = attested;
+            book.best_at_ms = book.first_seen.elapsed().as_secs_f64() * 1000.0;
+        }
+    }
+
+    pub fn stats_json(&self, nta_height: Option<u32>, pool: Option<&Signer>) -> Value {
+        let mut v: Vec<f64> = self.samples.iter().copied().collect();
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let pct = |p: f64| -> Value {
+            if v.is_empty() {
+                Value::Null
+            } else {
+                let i = ((p / 100.0) * (v.len() - 1) as f64).round() as usize;
+                json!((v[i] * 10.0).round() / 10.0)
+            }
+        };
+        let tips: Vec<Value> = self
+            .tips
+            .iter()
+            .map(|b| {
+                let mut prev = b.target.prev;
+                prev.reverse();
+                let mut signers: Vec<Value> = b
+                    .sigs
+                    .iter()
+                    .map(|(s, x)| json!({"script": hex::encode(s), "gateway": x.gateway, "ms": (x.ms * 10.0).round() / 10.0}))
+                    .collect();
+                signers.sort_by(|a, b| a["ms"].as_f64().partial_cmp(&b["ms"].as_f64()).unwrap());
+                json!({
+                    "height": b.target.height,
+                    "nbits": format!("{:08x}", b.target.nbits),
+                    "prev": hex::encode(prev),
+                    "first_seen_ts": b.first_seen_ts,
+                    "signers": signers,
+                    "coinbasers": b.coinbasers,
+                    "best_payees": b.best_payees,
+                    "best_payees_ms": (b.best_at_ms * 10.0).round() / 10.0,
+                })
+            })
+            .collect();
+        json!({
+            "nta_height": nta_height,
+            "pool_script": pool.map(|p| hex::encode(p.script())),
+            "accepted": self.accepted,
+            "refused": self.refused,
+            "unknown_tip": self.unknown_tip,
+            "coinbasers": self.coinbasers,
+            "coinbasers_carrying": self.coinbasers_carrying,
+            "latency_ms": {"n": v.len(), "p50": pct(50.0), "p95": pct(95.0), "max": v.last().copied()},
+            "tips": tips,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn signer(n: u8) -> Signer {
+        let mut sk = [0u8; 32];
+        sk[31] = n;
+        Signer::from_secret(&sk).unwrap()
+    }
+
+    const T: Target = Target { prev: [3u8; 32], height: 140, nbits: 0x207f_ffff };
+
+    #[test]
+    fn only_a_signature_for_the_nodes_own_tip_is_filed() {
+        let (pool, gw) = (signer(1), signer(2));
+        let mut b = Book::default();
+        let good = gw.attest(T.height, T.nbits, &T.prev);
+        assert_eq!(b.add(&good, None, "g", &pool), Outcome::UnknownTip);
+        let other = Target { prev: [4u8; 32], ..T };
+        assert_eq!(b.add(&good, Some(other), "g", &pool), Outcome::UnknownTip);
+        // a real signature, but for bits the node would not accept: never listed
+        let wrong_bits = gw.attest(T.height, 0x1d00_ffff, &T.prev);
+        assert!(matches!(b.add(&wrong_bits, Some(T), "g", &pool), Outcome::Refused(_)));
+        let mut forged = good.clone();
+        forged.sig[0] ^= 1;
+        assert!(matches!(b.add(&forged, Some(T), "g", &pool), Outcome::Refused(_)));
+        assert!(matches!(b.add(&good, Some(T), "g", &pool), Outcome::Accepted(_)));
+        assert_eq!(b.add(&good, Some(T), "g", &pool), Outcome::Duplicate);
+        let payable = b.payable(T, &pool);
+        assert!(payable.contains(&gw.script()) && payable.contains(&pool.script()));
+        assert_eq!(payable.len(), 2);
+        assert_eq!(b.accepted, 1);
+    }
+
+    #[test]
+    fn attestations_follow_distinct_paid_scripts_in_output_order_and_verify() {
+        let (pool, a, c) = (signer(1), signer(2), signer(3));
+        let mut b = Book::default();
+        b.add(&a.attest(T.height, T.nbits, &T.prev), Some(T), "a", &pool);
+        let outs = vec![
+            (500, a.script()),
+            (300, pool.script()),
+            (0, vec![0x6a, 0x24, 0xaa, 0x21]), // witness commitment: no attestation
+            (100, a.script()),                  // repeated script: one attestation
+        ];
+        let atts = b.attestations(T, &outs, &pool).unwrap();
+        assert_eq!(atts.len(), 2);
+        for (att, key) in atts.iter().zip([a.key(), pool.key()]) {
+            assert!(nta::is_attestation(att));
+            let sig: [u8; 64] = att[6..].try_into().unwrap();
+            assert!(nta::verify(&key, T.height, T.nbits, &T.prev, &sig));
+        }
+        // a paid script nobody signed: no attestation list, so no coinbaser
+        assert!(b.attestations(T, &[(1, c.script())], &pool).is_none());
+    }
+}
