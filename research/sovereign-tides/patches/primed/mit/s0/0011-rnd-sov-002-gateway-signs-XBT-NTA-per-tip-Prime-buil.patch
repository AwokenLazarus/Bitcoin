+//! XBT-NTA (rnd/sov-002): payee-signed coinbase attestations, inline variant.
+//!
+//! Once `nta` is active, every value-bearing coinbase output must pay a key-path taproot
+//! script `OP_1 <K>`, and for each distinct such script (in output order) the coinbase
+//! carries one zero-value output
+//!
+//! ```text
+//! OP_RETURN PUSH68 ( "NTA" 0x02 || sig64 )
+//! ```
+//!
+//! where `sig64` is a BIP340 signature by `K` over [`attestation_hash`]. The digest is the
+//! one the Knots patch (`NtaAttestationHash`, validation.cpp) computes:
+//! `TaggedHash("XBT-NTA/attestation", ser(script) || height || nBits || hashPrevBlock)`,
+//! with `ser(script)` a compact-size length and the bytes, `height` an int32 LE, `nBits` a
+//! uint32 LE and `hashPrevBlock` in internal byte order.
+//!
+//! A gateway signs this for its payout script on every new tip and sends it to Prime as a
+//! [`NtaAttest`] mining sub-command ahead of its coinbaser request; Prime pays only scripts
+//! whose signature for the tip it holds.
+
+use secp256k1::{schnorr, Keypair, Message, Secp256k1, SecretKey, XOnlyPublicKey};
+use sha2::{Digest, Sha256};
+
+use crate::{Cursor, Error, Result};
+
+pub const TAG: &[u8] = b"XBT-NTA/attestation";
+/// `OP_RETURN`, a 68-byte push, then `"NTA"` and version 2.
+pub const PREFIX: [u8; 6] = [0x6a, 68, b'N', b'T', b'A', 0x02];
+pub const SCRIPT_LEN: usize = PREFIX.len() + 64;
+/// Mining sub-command carrying a gateway's attestation for a tip. Unknown to older Primes,
+/// which ignore it, so a signing gateway still works against them.
+pub const SUB_NTA_ATTEST: u8 = 0x4e;
+pub const ATTEST_VERSION: u8 = 1;
+
+/// `OP_1 <K>`: the only payee shape NTA allows.
+pub fn p2tr(key: &[u8; 32]) -> Vec<u8> {
+    let mut s = Vec::with_capacity(34);
+    s.extend_from_slice(&[0x51, 0x20]);
+    s.extend_from_slice(key);
+    s
+}
+
+/// The x-only key of an `OP_1 <K>` script.
+pub fn p2tr_key(script: &[u8]) -> Option<[u8; 32]> {
+    (script.len() == 34 && script[0] == 0x51 && script[1] == 0x20).then(|| script[2..].try_into().unwrap())
+}
+
+fn compact(n: usize, out: &mut Vec<u8>) {
+    match n {
+        0..=0xfc => out.push(n as u8),
+        0xfd..=0xffff => {
+            out.push(0xfd);
+            out.extend_from_slice(&(n as u16).to_le_bytes());
+        }
+        _ => {
+            out.push(0xfe);
+            out.extend_from_slice(&(n as u32).to_le_bytes());
+        }
+    }
+}
+
+/// `NtaAttestationHash(script, height, nBits, prev)`; `prev_le` in internal byte order.
+pub fn attestation_hash(script: &[u8], height: u32, nbits: u32, prev_le: &[u8; 32]) -> [u8; 32] {
+    let tag = Sha256::digest(TAG);
+    let mut msg = Vec::with_capacity(64 + 9 + script.len() + 40);
+    msg.extend_from_slice(&tag);
+    msg.extend_from_slice(&tag);
+    compact(script.len(), &mut msg);
+    msg.extend_from_slice(script);
+    msg.extend_from_slice(&(height as i32).to_le_bytes());
+    msg.extend_from_slice(&nbits.to_le_bytes());
+    msg.extend_from_slice(prev_le);
+    Sha256::digest(&msg).into()
+}
+
+/// The 70-byte attestation output script for `sig`.
+pub fn attestation_script(sig: &[u8; 64]) -> Vec<u8> {
+    let mut s = PREFIX.to_vec();
+    s.extend_from_slice(sig);
+    s
+}
+
+/// Exact bytes, as Knots matches them: anything else is an ordinary `OP_RETURN`.
+pub fn is_attestation(script: &[u8]) -> bool {
+    script.len() == SCRIPT_LEN && script.starts_with(&PREFIX)
+}
+
+/// The payees an attestation list must follow, as Knots derives them: each distinct script
+/// of a value-bearing, spendable output that is not itself an attestation, in output order.
+pub fn required_payees<'a>(outputs: impl IntoIterator<Item = (u64, &'a [u8])>) -> Vec<&'a [u8]> {
+    let mut payees: Vec<&[u8]> = Vec::new();
+    for (sats, script) in outputs {
+        if is_attestation(script) || sats == 0 || script.first() == Some(&0x6a) || payees.contains(&script) {
+            continue;
+        }
+        payees.push(script);
+    }
+    payees
+}
+
+/// A payout key. The secret never leaves this type except to sign.
+pub struct Signer {
+    keypair: Keypair,
+    key: [u8; 32],
+}
+
+impl Signer {
+    pub fn from_secret(secret: &[u8; 32]) -> Option<Self> {
+        let secp = Secp256k1::signing_only();
+        let sk = SecretKey::from_slice(secret).ok()?;
+        let keypair = Keypair::from_secret_key(&secp, &sk);
+        let key = keypair.x_only_public_key().0.serialize();
+        Some(Self { keypair, key })
+    }
+
+    /// Parse a key file: 64 hex characters (surrounding whitespace ignored).
+    pub fn from_hex(text: &str) -> Option<Self> {
+        let raw = hex::decode(text.trim()).ok()?;
+        Self::from_secret(&raw.try_into().ok()?)
+    }
+
+    pub fn key(&self) -> [u8; 32] {
+        self.key
+    }
+
+    pub fn script(&self) -> Vec<u8> {
+        p2tr(&self.key)
+    }
+
+    /// BIP340 signature over the attestation hash for this key's own script. Zero aux
+    /// randomness: deterministic, the same as the Knots test framework's `sign_schnorr`.
+    pub fn sign(&self, height: u32, nbits: u32, prev_le: &[u8; 32]) -> [u8; 64] {
+        let digest = attestation_hash(&self.script(), height, nbits, prev_le);
+        let secp = Secp256k1::signing_only();
+        secp.sign_schnorr_no_aux_rand(&Message::from_digest(digest), &self.keypair).serialize()
+    }
+
+    pub fn attest(&self, height: u32, nbits: u32, prev_le: &[u8; 32]) -> NtaAttest {
+        NtaAttest { key: self.key, height, nbits, prev_hash: *prev_le, sig: self.sign(height, nbits, prev_le) }
+    }
+}
+
+impl std::fmt::Debug for Signer {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "Signer({})", hex::encode(self.key))
+    }
+}
+
+/// Whether `sig` is `key`'s BIP340 signature over the attestation for `OP_1 <key>`.
+pub fn verify(key: &[u8; 32], height: u32, nbits: u32, prev_le: &[u8; 32], sig: &[u8; 64]) -> bool {
+    let (Ok(pk), Ok(sig)) = (XOnlyPublicKey::from_slice(key), schnorr::Signature::from_slice(sig)) else {
+        return false;
+    };
+    let digest = attestation_hash(&p2tr(key), height, nbits, prev_le);
+    Secp256k1::verification_only().verify_schnorr(&sig, &Message::from_digest(digest), &pk).is_ok()
+}
+
+/// A gateway's attestation for one tip: `OP_1 <key>` may be paid by the block at `height`
+/// on `prev_hash` (internal byte order) at `nbits`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NtaAttest {
+    pub key: [u8; 32],
+    pub height: u32,
+    pub nbits: u32,
+    pub prev_hash: [u8; 32],
+    pub sig: [u8; 64],
+}
+
+impl NtaAttest {
+    pub fn script(&self) -> Vec<u8> {
+        p2tr(&self.key)
+    }
+
+    pub fn verify(&self) -> bool {
+        verify(&self.key, self.height, self.nbits, &self.prev_hash, &self.sig)
+    }
+
+    /// `0x4e | version | key[32] | height u32 | nbits u32 | prev[32] | sig[64] | 0xFE`
+    pub fn encode(&self) -> Vec<u8> {
+        let mut o = Vec::with_capacity(2 + 32 + 8 + 32 + 64 + 1);
+        o.push(SUB_NTA_ATTEST);
+        o.push(ATTEST_VERSION);
+        o.extend_from_slice(&self.key);
+        o.extend_from_slice(&self.height.to_le_bytes());
+        o.extend_from_slice(&self.nbits.to_le_bytes());
+        o.extend_from_slice(&self.prev_hash);
+        o.extend_from_slice(&self.sig);
+        o.push(0xFE);
+        o
+    }
+
+    /// Parse the body after the sub-command byte.
+    pub fn decode(body: &[u8]) -> Result<Self> {
+        let mut c = Cursor::new(body);
+        if c.u8()? != ATTEST_VERSION {
+            return Err(Error::Malformed("nta attestation version"));
+        }
+        let key = c.array::<32>()?;
+        let height = c.u32()?;
+        let nbits = c.u32()?;
+        let prev_hash = c.array::<32>()?;
+        let sig = c.array::<64>()?;
+        if c.u8()? != 0xFE {
+            return Err(Error::Malformed("nta attestation"));
+        }
+        Ok(Self { key, height, nbits, prev_hash, sig })
+    }
+}
+
