-/// `100 × (verified + ½·(claimed − verified)) ÷ blocks`.
-pub fn sovereignty_score(blocks: u64, claimed: u64, verified: u64) -> f64 {
+/// One observed block (a claimed or verified template) for the public score.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct BlockCredit {
+    pub builder: String,
+    pub claimed: bool,
+    pub verified: bool,
+}
+
+/// *c(block)*: 1 if the LZT1 is verified, ½ if claimed but unverified, 0 otherwise.
+pub fn claim_credit(claimed: bool, verified: bool) -> f64 {
+    if verified {
+        1.0
+    } else if claimed {
+        0.5
+    } else {
+        0.0
+    }
+}
+
+/// *w(builder)*: independence, or 0 if flagged / pool-clustered / unknown.
+pub fn builder_weight(independence: f64, flagged: bool, pool_clustered: bool, unknown: bool) -> f64 {
+    if flagged || pool_clustered || unknown {
+        0.0
+    } else {
+        independence.clamp(0.0, 1.0)
+    }
+}
+
+/// `score = 100 × Σ w(builder) × c(block) ÷ blocks`.
+pub fn sovereignty_score<'a, I, F>(blocks: I, mut weight: F) -> f64
+where
+    I: IntoIterator<Item = &'a BlockCredit>,
+    F: FnMut(&str) -> f64,
+{
+    let mut n = 0u64;
+    let mut sum = 0.0;
+    for b in blocks {
+        n += 1;
+        sum += weight(&b.builder) * claim_credit(b.claimed, b.verified);
+    }
+    if n == 0 {
+        0.0
+    } else {
+        100.0 * sum / n as f64
+    }
+}
+
+/// Raw verified fraction as a 0–100 share.
+pub fn verified_share(blocks: u64, verified: u64) -> f64 {
     if blocks == 0 {
-        return 0.0;
+        0.0
+    } else {
+        100.0 * verified.min(blocks) as f64 / blocks as f64
     }
-    let claimed = claimed.min(blocks);
-    let verified = verified.min(claimed);
-    100.0 * (verified as f64 + 0.5 * (claimed - verified) as f64) / blocks as f64
 }
 
