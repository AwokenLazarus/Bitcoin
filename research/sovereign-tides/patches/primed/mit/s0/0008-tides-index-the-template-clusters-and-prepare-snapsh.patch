+    #[derive(Clone)]
+    struct Prepared {
+        t: f64,
+        prev: String,
+        txids: Vec<String>,
+        br: Vec<Vec<u8>>,
+    }
+
+    fn prep(snaps: &[Snapshot]) -> Vec<Prepared> {
+        let mut v: Vec<Prepared> = snaps
+            .iter()
+            .map(|s| Prepared { t: s.t, prev: s.prev.clone(), txids: s.txids.clone(), br: branches(&s.txids) })
+            .collect();
+        v.sort_by(|a, b| a.t.partial_cmp(&b.t).unwrap_or(std::cmp::Ordering::Equal));
+        v
+    }
+
+    fn first_on_parent(snaps: &[Prepared]) -> std::collections::HashMap<String, f64> {
+        let mut first = std::collections::HashMap::new();
+        for s in snaps {
+            first.entry(s.prev.clone()).or_insert(s.t);
+        }
+        first
+    }
+
+    fn first_seen(snaps: &[Prepared]) -> std::collections::HashMap<String, f64> {
+        let mut seen = std::collections::HashMap::new();
+        for s in snaps {
+            for t in &s.txids {
+                seen.entry(t.clone()).or_insert(s.t);
+            }
+        }
+        seen
+    }
+
+    fn first_with(snaps: &[Prepared], txid: &str, from: f64, to: f64) -> Option<f64> {
+        snaps.iter().find(|s| s.t >= from && s.t <= to && s.txids.iter().any(|t| t == txid)).map(|s| s.t)
+    }
+
+    /// Pre-SOV-006 `features_with`.
+    pub fn features_with(gw: &[Snapshot], pool: &[Snapshot], canaries: &[Canary]) -> Features {
