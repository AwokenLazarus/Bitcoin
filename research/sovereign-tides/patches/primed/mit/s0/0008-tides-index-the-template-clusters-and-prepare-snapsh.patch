+        Features {
+            snapshots: gw.len(),
+            compared: n,
+            identical,
+            branch_sim: if n > 0 { sims / n as f64 } else { 0.0 },
+            jaccard: if n > 0 { jacs / n as f64 } else { 0.0 },
+            jaccard_hi: if n > 0 { jhi as f64 / n as f64 } else { 0.0 },
+            switches: lags.len(),
