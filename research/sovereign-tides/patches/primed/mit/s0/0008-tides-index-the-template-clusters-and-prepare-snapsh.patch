+/// Times (in snapshot order) at which each of `wanted` appears in `snaps`.
+fn occurrences(snaps: &[&Prepared], wanted: Option<&std::collections::HashSet<u64>>) -> FpMap<Vec<f64>> {
+    let mut at: FpMap<Vec<f64>> = FpMap::new();
+    for s in snaps {
+        for &t in &s.txids {
+            if wanted.is_none_or(|w| w.contains(&t)) {
+                at.entry(t).or_default().push(s.t);
+            }
+        }
+    }
+    at
+}
+
+/// The first `t` in `[from, to]` of an occurrence list in snapshot order.
+fn first_between(times: Option<&Vec<f64>>, from: f64, to: f64) -> Option<f64> {
+    let times = times?;
+    let i = times.partition_point(|&t| t < from);
+    times.get(i).copied().filter(|&t| t >= from && t <= to)
+}
