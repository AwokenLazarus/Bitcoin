+/// A snapshot prepared once, when it is recorded: txids and parent fingerprinted, merkle
+/// branches computed. The detector never rehashes a snapshot, and the store holds no hex.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Prepared {
+    pub t: f64,
+    prev: u64,
+    /// Template order, duplicates kept.
+    txids: Vec<u64>,
+    /// Sorted and deduplicated.
+    set: Vec<u64>,
+    br: Vec<[u8; 32]>,
+    brk: u64,
+}
+
+impl Prepared {
+    pub fn new(s: &Snapshot) -> Self {
+        Self::from_parts(s.t, &s.prev, &s.txids)
+    }
+
+    pub fn from_parts(t: f64, prev: &str, txids: &[String]) -> Self {
+        let ids: Vec<u64> = txids.iter().map(|x| fp(x)).collect();
+        let mut set = ids.clone();
+        set.sort_unstable();
+        set.dedup();
+        let br = branches32(txids);
+        Prepared { t, prev: fp(prev), txids: ids, set, brk: fp_branches(&br), br }
+    }
+
+    /// Bytes the snapshot store holds for this one (for the memory bound).
+    pub fn heap_bytes(&self) -> usize {
+        std::mem::size_of::<Self>() + self.txids.capacity() * 8 + self.set.capacity() * 8 + self.br.capacity() * 32
+    }
+}
