+/// A txid, parent or branch list as the detector compares it: a 64-bit SipHash of the string
+/// (fixed keys, so equal inputs agree within a process; never persisted). Two distinct txids
+/// collide with probability ~2⁻⁶⁴ per pair.
+pub fn fp(s: &str) -> u64 {
+    use std::hash::{Hash, Hasher};
+    #[allow(deprecated)]
+    let mut h = std::hash::SipHasher::new_with_keys(0x5452_4944_4553_0006, 0x0006_5345_4449_5254);
+    s.hash(&mut h);
+    h.finish()
+}
+
+fn fp_branches(br: &[[u8; 32]]) -> u64 {
+    use std::hash::{Hash, Hasher};
+    #[allow(deprecated)]
+    let mut h = std::hash::SipHasher::new_with_keys(0x6272_616e_6368_0006, 0x0006_6863_6e61_7262);
+    br.hash(&mut h);
+    h.finish()
+}
