+    /// A small random world for the property tests: a pool and `k` gateways that copy it
+    /// (exactly, late, partly or not at all), on a coarse time grid so window edges are hit
+    /// exactly, with repeated and non-hex txids, empty templates and every canary kind.
+    fn random_world(seed: u64) -> (std::collections::BTreeMap<String, Vec<Snapshot>>, Vec<Canary>) {
+        let mut s = seed.wrapping_mul(0x9e37_79b9_7f4a_7c15) | 1;
+        let mut next = |m: u64| {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            s % m.max(1)
+        };
+        let tx = |i: u64| if i % 11 == 0 { format!("x{i}") } else { hex32(i) };
+        let k = 2 + next(6) as usize;
+        let n = 5 + next(40) as usize;
+        let mut pool = Vec::new();
+        for i in 0..n {
+            let t = (i as u64 * (1 + next(4))) as f64 * 0.5;
+            let prev = hex32(next(3));
+            let txids: Vec<String> = (0..next(6)).map(|_| tx(next(12))).collect();
+            pool.push(Snapshot::new(t, prev, txids));
+        }
+        let mut gws = std::collections::BTreeMap::new();
+        for g in 0..k {
+            let style = next(4);
+            let mut v = Vec::new();
+            for p in &pool {
+                if next(10) < 2 {
+                    continue;
+                }
+                let dt = [0.0, 0.5, 3.0, 3.5, -3.0, 0.05, 1.0][next(7) as usize];
+                let mut txids = p.txids.clone();
+                match style {
+                    0 => {}
+                    1 if next(3) == 0 => txids.push(tx(next(12))),
+                    2 => txids = (0..next(6)).map(|_| tx(next(12))).collect(),
+                    _ if next(2) == 0 => txids.reverse(),
+                    _ => {}
+                }
+                v.push(Snapshot::new(p.t + dt, p.prev.clone(), txids));
+            }
+            if next(3) == 0 {
+                v.push(v.last().cloned().unwrap_or_else(|| Snapshot::new(0.0, "p", vec![])));
+            }
+            gws.insert(format!("g{g}"), v);
+        }
+        gws.insert("POOL".into(), pool);
+        let mut canaries = Vec::new();
+        for _ in 0..next(30) {
+            let t = next(60) as f64 * 0.5;
+            let id = tx(next(12));
+            canaries.push(match next(3) {
+                0 => Canary::new(t, id),
+                1 => Canary::shared(t, id),
+                _ => Canary::decoy(t, id),
+            });
+        }
+        (gws, canaries)
+    }
