+/// [`clusters`] through one index `(parent, branches) → [(t, gateway)]` instead of every pair
+/// of gateways: O(total snapshots + matches within the window). `gws` names must be unique.
+/// Same result as `reference::clusters` (the pairwise version, O(gateways² × snapshots)).
+pub fn clusters_prepared(gws: &[(String, Vec<&Prepared>)]) -> Vec<Vec<String>> {
+    let n = gws.len();
+    let mut index: std::collections::HashMap<(u64, u64), Vec<(f64, u32, &Prepared)>> = std::collections::HashMap::new();
+    for (g, (_, snaps)) in gws.iter().enumerate() {
+        for s in snaps {
+            index.entry((s.prev, s.brk)).or_default().push((s.t, g as u32, s));
+        }
+    }
+    // matched[a·n + b]: snapshots of `a` that `b` had too (same key, |Δt| ≤ WINDOW)
+    let mut matched = vec![0u32; n * n];
+    let mut stamp = vec![usize::MAX; n];
+    let mut id = 0usize;
+    for bucket in index.values_mut() {
+        bucket.sort_by(|x, y| x.0.partial_cmp(&y.0).unwrap_or(std::cmp::Ordering::Equal));
+        let mut lo = 0usize;
+        for i in 0..bucket.len() {
+            let (t, a, s) = bucket[i];
+            id += 1;
+            while lo < bucket.len() && bucket[lo].0 < t - WINDOW - 1.0 {
+                lo += 1;
+            }
+            for &(u, b, o) in &bucket[lo..] {
