index 5579d20..60f83ad 100644
--- a/pool/server.py
+++ b/pool/server.py
@@ -5508,6 +5508,115 @@ _CHEAP_PATHS = frozenset(
 )
 
 
+# --- Sovereign TIDES registration (SOV-P-002 §4, W10) ---------------------------------------
+# POST /api/sovereignty/enrol takes a gateway's `LZT1 register v1|v2` (or `LZT1 revoke v2`) with
+# its signatures and hands it to primed's loopback ingest, which checks everything (G's
+# signature, `at` against the node, BIP322 / signmessage / enrol-by-spend) and holds the
+# directory. This side only rate-limits (per client IP and per key G), bounds the body and
+# forwards the fields primed reads, with primed's local token. Node addresses stay in primed's
+# sovereignty-nodes.json; nothing here stores or returns them.
+SOV_ENROL_URL = CONF.get("sovereignty_enrol_url") or PRIME_STATS.rsplit("/", 1)[0] + "/sovereignty/enrol"
+SOV_TOKEN_FILE = Path(CONF.get("sovereignty_token_file", "/var/lib/primed/sovereignty.token"))
+# (attempts, seconds): every attempt counts, accepted or not
+SOV_ENROL_PER_IP = tuple(CONF.get("sovereignty_enrol_per_ip", (10, 3600)))
+SOV_ENROL_PER_G = tuple(CONF.get("sovereignty_enrol_per_g", (6, 3600)))
+# Behind the site's proxy (cloudflared/NPM on loopback) the client is in CF-Connecting-IP or the
+# first X-Forwarded-For hop; from anywhere else those headers are the client's to invent.
+SOV_TRUSTED_PROXIES = frozenset(CONF.get("trusted_proxies", ["127.0.0.1", "::1"]))
+_SOV_FIELDS = ("message", "g_sig", "payout_sig", "proof", "spend_txid", "spend_block")
+_SOV_MAX_BODY = 8192
+_SOV_G_RE = re.compile(r"^G: ([0-9a-f]{64})$", re.M)
+_sov_hits = {}
+_sov_hits_lock = threading.Lock()
+_sov_token = {"mtime": None, "value": ""}
+
+
+def sov_rate_ok(key, limit):
+    """Sliding-window limiter: True and counted, or False once `key` has `limit[0]` attempts in
+    the last `limit[1]` seconds. Keys are bounded, so a flood of new ones cannot grow memory."""
+    n, span = int(limit[0]), float(limit[1])
+    now = time.time()
+    with _sov_hits_lock:
+        if len(_sov_hits) > 20000:
+            for k in [k for k, q in _sov_hits.items() if not q or q[-1] < now - span]:
+                del _sov_hits[k]
+            if len(_sov_hits) > 20000:
+                return False
+        q = _sov_hits.setdefault(key, deque())
+        while q and q[0] < now - span:
+            q.popleft()
+        if len(q) >= n:
+            return False
+        q.append(now)
+        return True
+
+
+def sov_token():
+    """primed's ingest token (data-dir/sovereignty.token), re-read when the file changes."""
+    try:
+        mtime = SOV_TOKEN_FILE.stat().st_mtime
+    except OSError:
+        return ""
+    if mtime != _sov_token["mtime"]:
+        try:
+            _sov_token.update(mtime=mtime, value=SOV_TOKEN_FILE.read_text().strip())
+        except OSError:
+            return ""
+    return _sov_token["value"]
+
+
+def sov_enrol(body, client_ip):
+    """(status, reply) for one enrol POST body."""
+    try:
+        doc = json.loads(body)
+    except ValueError:
+        return 400, {"error": "body must be JSON"}
+    if not isinstance(doc, dict) or not isinstance(doc.get("message"), str):
+        return 400, {"error": "message is required"}
+    fwd = {}
+    for k in _SOV_FIELDS:
+        v = doc.get(k)
+        if v is None:
+            continue
+        if not isinstance(v, str) or len(v) > 4096:
+            return 400, {"error": f"{k} must be a string"}
+        fwd[k] = v
+    if len(fwd["message"]) > 1024:
+        return 400, {"error": "message too long"}
+    m = _SOV_G_RE.search(fwd["message"])
+    if not m:
+        return 400, {"error": "message has no G line"}
+    if not sov_rate_ok(("ip", client_ip), SOV_ENROL_PER_IP):
+        return 429, {"error": "too many enrolment attempts from this address; try again later"}
+    if not sov_rate_ok(("g", m.group(1)), SOV_ENROL_PER_G):
+        return 429, {"error": "too many enrolment attempts for this key; try again later"}
+    token = sov_token()
+    if not token:
+        return 503, {"error": "enrolment is not open"}
+    import urllib.error
+    import urllib.request
+
+    req = urllib.request.Request(
+        SOV_ENROL_URL,
+        json.dumps(fwd).encode(),
+        {"Content-Type": "application/json", "X-Sovereignty-Token": token},
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=30) as r:
+            return 200, json.loads(r.read(65536) or b"{}")
+    except urllib.error.HTTPError as e:
+        if e.code == 400:
+            try:
+                err = json.loads(e.read(65536)).get("error") or "refused"
+            except ValueError:
+                err = "refused"
+            return 400, {"error": str(err)[:300]}
+        # 403 (token) and 404 (sovereignty-mode off) both mean the door is shut
+        return 503, {"error": "enrolment is not open"}
+    except (OSError, ValueError):
+        return 503, {"error": "enrolment is not open"}
+
+
 class Handler(BaseHTTPRequestHandler):
     # Socket timeout per request: a client that opens a connection and trickles bytes
     # (slowloris) otherwise holds a thread forever on this thread-per-connection server.
@@ -5642,6 +5751,40 @@ class Handler(BaseHTTPRequestHandler):
         finally:
             self._head_only = False
 
+    def client_ip(self):
+        peer = self.client_address[0]
+        if peer in SOV_TRUSTED_PROXIES:
+            fwd = self.headers.get("CF-Connecting-IP") or (self.headers.get("X-Forwarded-For") or "").split(",")[0]
+            if fwd.strip():
+                return fwd.strip()
+        return peer
+
+    def do_POST(self):
+        """Only the enrol route takes a POST (SOV-P-002 §4)."""
+        try:
+            path = urlparse(self.path).path
+            if path != "/api/sovereignty/enrol":
+                self.send_json({"error": "not found"}, 404)
+                return
+            try:
+                n = int(self.headers.get("Content-Length") or "0")
+            except ValueError:
+                n = -1
+            if n < 0 or n > _SOV_MAX_BODY:
+                self.close_connection = True
+                self.send_json({"error": "body too large"}, 413)
+                return
+            code, reply = sov_enrol(self.rfile.read(n).decode("utf-8", "replace"), self.client_ip())
+            self.send_json(reply, code)
+        except (BrokenPipeError, ConnectionResetError, TimeoutError):
+            raise
+        except Exception as e:
+            print("enrol", type(e).__name__, str(e)[:160], flush=True)
+            try:
+                self.send_json({"error": "server"}, 500)
+            except Exception:
+                pass
+
     def do_GET(self):
         # Anything a handler did not expect (`/static/%00` made pathlib raise) used to drop the
         # connection and write a traceback to the log, once per request, for as long as asked.
