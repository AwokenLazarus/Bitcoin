+    /// A DATUM attestation for a fresh job by `g`, and the coinbase it commits to.
+    fn datum_job(g: &Identity, seed: u8) -> (Attestation, [u8; SIG], Coinbase, Hash, Vec<Hash>) {
+        let prev = [seed; 32];
+        let txs: Vec<Hash> = (1..=3u8).map(|i| [i ^ seed; 32]).collect();
+        let branches = datum_wire::pow::merkle_branches_for_coinbase(&txs);
+        let mut outs = sample_outs(312_538_966);
+        let (a, sig, c) = attest(g, 966_267, &prev, &branches, &outs, NodeView::default());
+        outs.push(c);
+        let (bytes, _, _) = coinbase::build(966_267, b"Lazarus", &outs, 0);
+        (a, sig, coinbase::parse(&bytes).unwrap(), prev, branches)
+    }
+
+    /// W7: a verified DATUM attestation from a registered key is an attested job (its shares
+    /// credit, its block counts as verified); unregistered, house and failed ones are only
+    /// logged. Every verdict is counted.
+    #[test]
+    fn datum_attestations_enter_the_set_only_verified_registered_and_not_house() {
+        let dir = std::env::temp_dir().join(format!("sov007-attest-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut e = Engine { dir: dir.clone(), ..engine() };
+        let (reg, unreg, house) = (
+            Identity::from_secret_bytes(&[0x61; 64]),
+            Identity::from_secret_bytes(&[0x62; 64]),
+            Identity::from_secret_bytes(&[0x63; 64]),
+        );
+        e.register(&hex::encode(reg.sign_pk()), "bc1qreg", false, None).unwrap();
+        e.register(&hex::encode(house.sign_pk()), "", true, None).unwrap();
+        e.demo = false;
+
+        let (a, sig, cb, prev, branches) = datum_job(&reg, 0x31);
+        let verdict = authorship::verify(&cb, &a, &sig, &prev, &branches, Some(&reg.sign_pk())).map(|_| ());
+        assert!(e.note_datum_verdict(reg.sign_pk(), false, 4, 0, &a, &sig, verdict));
+        let g_hex = hex::encode(reg.sign_pk());
+        e.note_share(&g_hex, false, "bc1qminer", 8, &prev, &branches, 1_000);
+        assert_eq!(e.authored.iter().map(|x| x.work).sum::<u64>(), 8, "shares on the job are attested work");
+        assert!(e.note_block(&g_hex, false, None, &cb, &prev, &branches, 966_267, "bb"));
+        assert!(e.blocks.back().unwrap().verified, "and its block is verified");
+
+        let (a2, sig2, cb2, prev2, br2) = datum_job(&unreg, 0x32);
+        let v2 = authorship::verify(&cb2, &a2, &sig2, &prev2, &br2, Some(&unreg.sign_pk())).map(|_| ());
+        assert!(v2.is_ok());
+        assert!(!e.note_datum_verdict(unreg.sign_pk(), false, 5, 0, &a2, &sig2, v2), "not registered");
+
+        let (a3, sig3, _, _, _) = datum_job(&house, 0x33);
+        assert!(!e.note_datum_verdict(house.sign_pk(), false, 6, 0, &a3, &sig3, Ok(())), "house key");
+        assert!(!e.note_datum_verdict(reg.sign_pk(), true, 6, 1, &a3, &sig3, Ok(())), "house session");
+
+        let (a4, sig4, _, _, _) = datum_job(&reg, 0x34);
+        assert!(!e.note_datum_verdict(reg.sign_pk(), false, 7, 2, &a4, &sig4, Err(AttestError::WrongPayout)));
+
+        let d = &e.datum_attest;
+        assert_eq!((d.verified, d.failed), (4, 1));
+        assert_eq!(d.reasons.get("WrongPayout"), Some(&1));
+        assert_eq!(d.last.len(), 5);
+        let lines: Vec<AttestVerdict> = std::fs::read_to_string(dir.join(ATTEST_FILE))
+            .unwrap()
+            .lines()
+            .map(|l| serde_json::from_str(l).unwrap())
+            .collect();
+        assert_eq!(lines, d.last.iter().cloned().collect::<Vec<_>>(), "every verdict is on disk");
+        assert_eq!(
+            lines.iter().map(|v| (v.verdict.as_str(), v.registered, v.house, v.attested)).collect::<Vec<_>>(),
+            vec![
+                ("verified", true, false, true),
+                ("verified", false, false, false),
+                ("verified", true, true, false),
+                ("verified", true, true, false),
+                ("WrongPayout", true, false, false),
+            ]
+        );
+        let body = compute(&e.inputs(now())).body;
+        assert_eq!(body["attest"]["verified"], 4, "{body}");
+        assert_eq!(body["attest"]["failed"], 1, "{body}");
+        assert_eq!(body["attest"]["reasons"]["WrongPayout"], 1, "{body}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// W7: `sovereignty-attest.jsonl` rolls over at the first verdict of a new (UTC) day, and
+    /// only `ATTEST_KEEP_DAYS` of old files are kept.
+    #[test]
+    fn the_attest_log_rotates_daily() {
+        assert_eq!(ymd(0), "1970-01-01");
+        assert_eq!(ymd(11_016), "2000-02-29");
+        assert_eq!(ymd(20_721), "2026-09-25");
+        let dir = std::env::temp_dir().join(format!("sov007-rotate-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut e = Engine { dir: dir.clone(), ..engine() };
+        let today = now() / 86_400;
+        let stale = dir.join(format!("{ATTEST_FILE}.{}", ymd(today - ATTEST_KEEP_DAYS)));
+        std::fs::write(&stale, "old\n").unwrap();
+        let g = Identity::from_secret_bytes(&[0x64; 64]);
+        let (a, sig, _, _, _) = datum_job(&g, 0x35);
+        std::fs::write(dir.join(ATTEST_FILE), "yesterday\n").unwrap();
+        e.datum_attest.day = Some(today - 1);
+        e.note_datum_verdict(g.sign_pk(), false, 1, 0, &a, &sig, Ok(()));
+        let rolled = std::fs::read_to_string(dir.join(format!("{ATTEST_FILE}.{}", ymd(today - 1)))).unwrap();
+        assert_eq!(rolled, "yesterday\n");
+        assert_eq!(std::fs::read_to_string(dir.join(ATTEST_FILE)).unwrap().lines().count(), 1);
+        assert!(!stale.exists(), "files older than the keep window go");
+        e.note_datum_verdict(g.sign_pk(), false, 2, 0, &a, &sig, Ok(()));
+        assert_eq!(std::fs::read_to_string(dir.join(ATTEST_FILE)).unwrap().lines().count(), 2, "same day: appended");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
