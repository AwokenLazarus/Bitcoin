+//! SOV-009: registration v1/v2 over `POST /sovereignty/enrol`, against a stand-in node that
+//! answers the RPCs the route asks (tip, block hash, header). The Knots path, `verifymessage`
+//! and enrol-by-spend run in `~/xbt-rnd/sov-009/enrol-demo.sh`.
+
+mod common;
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::{TcpListener, TcpStream};
+
+use datum_wire::bip322::signer;
+use datum_wire::crypto::Identity;
+use serde_json::{json, Value};
+
+const TIP: u64 = 300;
+
+fn block_hash(h: u64) -> String {
+    format!("{:064x}", h + 0xb10c_0000)
+}
+
+/// A JSON-RPC node with a 300-block chain; anything else is "method not found".
+fn fake_node() -> u16 {
+    let l = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = l.local_addr().unwrap().port();
+    std::thread::spawn(move || {
+        for s in l.incoming().flatten() {
+            std::thread::spawn(move || serve(s));
+        }
+    });
+    port
+}
+
+fn serve(s: TcpStream) {
+    let mut r = BufReader::new(s.try_clone().unwrap());
+    let mut len = 0;
+    loop {
+        let mut line = String::new();
+        if r.read_line(&mut line).unwrap_or(0) == 0 {
+            return;
+        }
+        if line == "\r\n" {
+            break;
+        }
+        if let Some(v) = line.to_ascii_lowercase().strip_prefix("content-length:") {
+            len = v.trim().parse().unwrap_or(0);
+        }
+    }
+    let mut body = vec![0; len];
+    if r.read_exact(&mut body).is_err() {
+        return;
+    }
+    let req: Value = serde_json::from_slice(&body).unwrap_or(Value::Null);
+    let p = &req["params"];
+    let (result, error) = match req["method"].as_str().unwrap_or("") {
+        "getblockcount" => (json!(TIP), Value::Null),
+        "getblockhash" => (json!(block_hash(p[0].as_u64().unwrap_or(0))), Value::Null),
+        "getblockheader" => {
+            let h = u64::from_str_radix(&p[0].as_str().unwrap_or("0")[48..], 16).unwrap_or(0) - 0xb10c_0000;
+            (json!({"height": h, "time": 1_700_000_000 + h * 600}), Value::Null)
+        }
+        _ => (Value::Null, json!({"code": -32601, "message": "Method not found"})),
+    };
+    let out = json!({"result": result, "error": error, "id": req["id"]}).to_string();
+    let _ = (&s).write_all(
+        format!("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{out}", out.len())
+            .as_bytes(),
+    );
+}
+
+fn post(port: u16, path: &str, body: &Value, token: &str) -> Value {
+    let payload = body.to_string();
+    let req = format!(
+        "POST {path} HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nX-Sovereignty-Token: {token}\r\nContent-Length: {}\r\n\r\n{payload}",
+        payload.len()
+    );
+    let text = get_raw(port, &req);
+    serde_json::from_str(text.split("\r\n\r\n").nth(1).unwrap_or("")).unwrap_or(json!({"raw": text}))
+}
+
+fn get_raw(port: u16, req: &str) -> String {
+    let mut s = TcpStream::connect(("127.0.0.1", port)).unwrap();
+    s.write_all(req.as_bytes()).unwrap();
+    let mut buf = Vec::new();
+    s.read_to_end(&mut buf).unwrap();
+    String::from_utf8_lossy(&buf).to_string()
+}
+
+fn get(port: u16, path: &str) -> String {
+    get_raw(port, &format!("GET {path} HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n"))
+}
+
+fn msg(version: &str, g: &Identity, node: &str, at: u64, chain: &str, payout: Option<&str>) -> String {
+    let mut m = format!(
+        "LZT1 register {version}\npool: lazarus-xbt\nchain: {chain}\nG: {}\nnode: {node}\ntag: e2e\nat: {at} {}",
+        hex::encode(g.sign_pk()),
+        block_hash(at)
+    );
+    if let Some(p) = payout {
+        m.push_str(&format!("\npayout: {p}"));
+    }
+    m
+}
+
+fn g_sig(g: &Identity, m: &str) -> String {
+    hex::encode(g.sign(&[b"XBT-SOVEREIGN-TIDES/register\0".as_slice(), m.as_bytes()].concat()))
+}
+
+fn p2tr_address(sk: &[u8; 32]) -> String {
+    let s = signer::p2tr_script(sk);
+    bech32::segwit::encode(bech32::hrp::BC, bech32::segwit::VERSION_1, &s[2..]).unwrap()
+}
+
+#[test]
+fn registration_over_the_stats_listener() {
+    let node = fake_node();
+    let pool = Identity::from_secret_bytes(&[0x61; 64]);
+    let (p, _listen) = common::start_primed(
+        &pool,
+        &format!(
+            "rpc = \"http://127.0.0.1:{node}\"\nrpc-user = \"u\"\nrpc-password = \"p\"\npoll = 60\nsovereignty-mode = \"observe\"\nsovereignty-recompute-secs = 1\n"
+        ),
+    );
+    let token = std::fs::read_to_string(p.dir.join("sovereignty.token")).unwrap().trim().to_string();
+    let enrol = |body: Value| post(p.stats, "/sovereignty/enrol", &body, &token);
+    let (g1, g2) = (Identity::from_secret_bytes(&[0x62; 64]), Identity::from_secret_bytes(&[0x63; 64]));
+    let secret_node = "198.51.100.19:8333";
+
+    // v1: G-signed, names the node
+    let m = msg("v1", &g1, secret_node, TIP - 3, "XBT", None);
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g1, &m)}));
+    assert_eq!((r["ok"].as_bool(), r["version"].as_u64()), (Some(true), Some(1)), "{r}");
+    let nodes = std::fs::read_to_string(p.dir.join("sovereignty-nodes.json")).unwrap();
+    assert!(nodes.contains(secret_node), "{nodes}");
+    // the same message again is a replay
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g1, &m)}));
+    assert!(r["error"].as_str().unwrap().contains("replay"), "{r}");
+
+    // negatives: stale at, wrong chain, G's signature by another key, no token
+    for (m, sig_by, want) in [
+        (msg("v1", &g2, "none", TIP - 144, "XBT", None), &g2, "stale at"),
+        (msg("v1", &g2, "none", TIP + 1, "XBT", None), &g2, "ahead"),
+        (msg("v1", &g2, "none", TIP - 1, "BTC", None), &g2, "wrong chain line"),
+        (msg("v1", &g2, "none", TIP - 1, "XBT", None), &g1, "bad G signature"),
+    ] {
+        let r = enrol(json!({"message": m, "g_sig": g_sig(sig_by, &m)}));
+        assert!(r["error"].as_str().unwrap_or("").contains(want), "{want}: {r}");
+    }
+    let m = msg("v1", &g2, "none", TIP - 1, "XBT", None);
+    let r = post(p.stats, "/sovereignty/enrol", &json!({"message": m, "g_sig": g_sig(&g2, &m)}), "wrong");
+    assert_eq!(r["error"], "sovereignty token", "{r}");
+    // at names a height we have, but not our block there
+    let m = msg("v1", &g2, "none", TIP - 1, "XBT", None).replace(&block_hash(TIP - 1), &"ee".repeat(32));
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g2, &m)}));
+    assert!(r["error"].as_str().unwrap().contains("not the pool node's block"), "{r}");
+
+    // v2: BIP322 simple (P2TR key path) by the payout
+    let sk = [0x64u8; 32];
+    let payout = p2tr_address(&sk);
+    let m = msg("v2", &g1, secret_node, TIP - 2, "XBT", Some(&payout));
+    let bad = signer::simple_p2tr(&sk, b"not the message", 0x00);
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g1, &m), "payout_sig": bad}));
+    assert!(r["error"].as_str().unwrap().contains("BIP322"), "{r}");
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g1, &m), "payout_sig": signer::simple_p2tr(&sk, m.as_bytes(), 0x00)}));
+    assert_eq!((r["version"].as_u64(), r["bound_height"].as_u64()), (Some(2), Some(TIP - 2)), "{r}");
+    // signmessage is refused for a non-P2PKH payout without asking the node
+    let m2 = msg("v2", &g1, "none", TIP - 1, "XBT", Some(&payout));
+    let r = enrol(json!({"message": m2, "g_sig": g_sig(&g1, &m2), "proof": "signmessage", "payout_sig": "AAAA"}));
+    assert!(r["error"].as_str().unwrap().contains("P2PKH"), "{r}");
+
+    // rotation: G2 with the same payout supersedes G1; G1's old v1 cannot come back
+    let m = msg("v2", &g2, "none", TIP - 1, "XBT", Some(&payout));
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g2, &m), "payout_sig": signer::simple_p2tr(&sk, m.as_bytes(), 0x01)}));
+    assert_eq!(r["status"], "active", "{r}");
+    let m = msg("v1", &g1, secret_node, TIP, "XBT", None);
+    let r = enrol(json!({"message": m, "g_sig": g_sig(&g1, &m)}));
+    assert!(r["error"].as_str().unwrap().contains("superseded"), "{r}");
+
+    // the old demo ingest is closed outside the demo
+    let r = post(p.stats, "/sovereignty/register", &json!({"g": hex::encode(g1.sign_pk())}), &token);
+    assert!(r["error"].as_str().unwrap().contains("/sovereignty/enrol"), "{r}");
+
+    // the node address is in sovereignty-nodes.json (0600) and nowhere served
+    std::thread::sleep(std::time::Duration::from_millis(5_600)); // a housekeeping pass writes stats.json
+    let sov = get(p.stats, "/sovereignty.json");
+    assert!(sov.contains("\"registrations\""), "{sov}");
+    for text in [get(p.stats, "/stats.json"), sov, std::fs::read_to_string(p.dir.join("stats.json")).unwrap(),
+                 std::fs::read_to_string(p.dir.join("sovereignty-keys.json")).unwrap()] {
+        assert!(!text.contains("198.51.100.19"), "node address exposed: {text}");
+    }
+    let nodes = std::fs::read_to_string(p.dir.join("sovereignty-nodes.json")).unwrap();
+    // G1 was superseded, so its node is gone too
+    assert!(!nodes.contains("198.51.100.19"), "{nodes}");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mode = std::fs::metadata(p.dir.join("sovereignty-nodes.json")).unwrap().permissions().mode();
+        assert_eq!(mode & 0o777, 0o600);
+    }
+}
