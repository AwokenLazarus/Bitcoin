+//! Gateway registration for Sovereign TIDES (SOV-P-002 §4, W10).
+//!
+//! * **v1** proves the DATUM identity key `G` and names the gateway's node (canary delivery):
+//!   an ed25519 signature by `G` over `"XBT-SOVEREIGN-TIDES/register\0" ‖ message`.
+//! * **v2** is v1 plus a `payout:` line and a second proof, by the payout owner: BIP322
+//!   (simple or full, [`datum_wire::bip322`]), the legacy `signmessage` for P2PKH (checked by
+//!   the pool node's `verifymessage`), or *enrol by spend*: a confirmed tx from `payout` to
+//!   itself carrying `OP_RETURN "LZT1E" ‖ SHA256(message)[0..16]`.
+//! * **revoke** (`LZT1 revoke v2`) is signed by the payout alone and ends its binding to `G`.
+//!
+//! `at: <height> <hash>` must name a block of the pool node's active chain at most
+//! [`AT_WINDOW`] − 1 blocks below its tip: a stateless nonce, so a signed message cannot be
+//! replayed later. Per key, `at` must also move forward, so an older message cannot be replayed
+//! inside the window either. The `pool:` and `chain:` lines keep a signature from being reused
+//! against another pool or chain.
+//!
+//! This module parses and checks proofs, and runs the node lookups (async); the registration
+//! rules themselves (rotation, revocation, payout consistency, key age) live in
+//! [`crate::sovereignty::Engine::enrol`].
+
+use serde_json::{json, Value};
+
+use crate::address;
+use crate::state::Shared;
+
+pub const DOMAIN: &[u8] = b"XBT-SOVEREIGN-TIDES/register\0";
+pub const POOL_NAME: &str = "lazarus-xbt";
+pub const CHAIN: &str = "XBT";
+/// `at` must be one of the last this many blocks of the pool node's chain.
+pub const AT_WINDOW: u32 = 144;
+/// Enrol-by-spend marker, followed by 16 bytes of SHA256(message).
+pub const SPEND_TAG: &[u8] = b"LZT1E";
+pub const MAX_TAG: usize = 32;
+const MAX_MESSAGE: usize = 1024;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    V1,
+    V2,
+    Revoke,
+}
+
+impl Kind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Kind::V1 => "v1",
+            Kind::V2 => "v2",
+            Kind::Revoke => "revoke",
+        }
+    }
+}
+
+/// A parsed registration or revocation message.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Message {
+    pub raw: String,
+    pub kind: Kind,
+    pub g: [u8; 32],
+    pub g_hex: String,
+    /// `None` for `node: none` (and for a revocation).
+    pub node: Option<String>,
+    pub tag: String,
+    pub at_height: u32,
+    pub at_hash: String,
+    pub payout: Option<String>,
+}
+
+/// How the payout owner consented (v2 and revoke).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Proof {
+    Bip322,
+    SignMessage,
+    Spend,
+}
+
+impl Proof {
+    pub fn parse(s: Option<&str>) -> Result<Proof, String> {
+        match s.unwrap_or("bip322") {
+            "bip322" => Ok(Proof::Bip322),
+            "signmessage" => Ok(Proof::SignMessage),
+            "spend" => Ok(Proof::Spend),
+            other => Err(format!("proof must be bip322, signmessage or spend, not {other:?}")),
+        }
+    }
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Proof::Bip322 => "bip322",
+            Proof::SignMessage => "signmessage",
+            Proof::Spend => "spend",
+        }
+    }
+}
+
+fn field<'a>(line: Option<&'a str>, name: &str) -> Result<&'a str, String> {
+    let line = line.ok_or_else(|| format!("missing line {name:?}"))?;
+    line.strip_prefix(name)
+        .and_then(|r| r.strip_prefix(": "))
+        .ok_or_else(|| format!("expected line \"{name}: …\", got {line:?}"))
+}
+
+/// Parse the exact line format of SOV-P-002 §4.1/§4.2 (lines separated by `\n`, no trailing
+/// newline, no `\r`). `payout:` is the last line of a v2.
+pub fn parse(raw: &str) -> Result<Message, String> {
+    if raw.len() > MAX_MESSAGE {
+        return Err("message too long".into());
+    }
+    if raw.contains('\r') || raw.ends_with('\n') {
+        return Err("lines are separated by \\n, with no \\r and no trailing newline".into());
+    }
+    let mut lines = raw.split('\n');
+    let kind = match lines.next() {
+        Some("LZT1 register v1") => Kind::V1,
+        Some("LZT1 register v2") => Kind::V2,
+        Some("LZT1 revoke v2") => Kind::Revoke,
+        other => return Err(format!("first line must be LZT1 register v1|v2 or LZT1 revoke v2, got {other:?}")),
+    };
+    let pool = field(lines.next(), "pool")?;
+    if pool != POOL_NAME {
+        return Err(format!("wrong pool line: {pool:?} (this pool is {POOL_NAME})"));
+    }
+    let chain = field(lines.next(), "chain")?;
+    if chain != CHAIN {
+        return Err(format!("wrong chain line: {chain:?} (this chain is {CHAIN})"));
+    }
+    let g_hex = field(lines.next(), "G")?;
+    if g_hex.len() != 64 || !g_hex.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) {
+        return Err("G must be 64 lowercase hex digits".into());
+    }
+    let g: [u8; 32] = hex::decode(g_hex).unwrap().try_into().unwrap();
+    let (mut node, mut tag, mut payout) = (None, String::new(), None);
+    if kind == Kind::Revoke {
+        payout = Some(field(lines.next(), "payout")?.to_string());
+    } else {
+        let n = field(lines.next(), "node")?;
+        node = parse_node(n)?;
+        let t = field(lines.next(), "tag")?;
+        if t.chars().count() > MAX_TAG || t.chars().any(|c| c.is_control()) {
+            return Err(format!("tag must be at most {MAX_TAG} printable characters"));
+        }
+        tag = t.to_string();
+    }
+    let at = field(lines.next(), "at")?;
+    let (h, hash) = at.split_once(' ').ok_or("at must be \"<height> <block hash>\"")?;
+    let at_height: u32 = h.parse().map_err(|_| "at height is not a number")?;
+    if hash.len() != 64 || !hash.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("at hash must be 64 hex digits".into());
+    }
+    if kind == Kind::V2 {
+        payout = Some(field(lines.next(), "payout")?.to_string());
+    }
+    if let Some(extra) = lines.next() {
+        return Err(format!("unexpected line {extra:?}"));
+    }
+    if payout.as_deref().is_some_and(|p| p.is_empty() || p.len() > 90) {
+        return Err("payout must be an address".into());
+    }
+    Ok(Message {
+        raw: raw.to_string(),
+        kind,
+        g,
+        g_hex: g_hex.to_string(),
+        node,
+        tag,
+        at_height,
+        at_hash: hash.to_ascii_lowercase(),
+        payout,
+    })
+}
+
+/// `host:port`, `[v6]:port`, `xxx.onion:port`, or `none`.
+fn parse_node(n: &str) -> Result<Option<String>, String> {
+    if n == "none" {
+        return Ok(None);
+    }
+    let bad = || format!("node must be host:port, [ipv6]:port, xxx.onion:port or none, not {n:?}");
+    let (host, port) = n.rsplit_once(':').ok_or_else(bad)?;
+    let port: u16 = port.parse().map_err(|_| bad())?;
+    if port == 0 || host.is_empty() || host.len() > 255 {
+        return Err(bad());
+    }
+    let ok = if let Some(v6) = host.strip_prefix('[').and_then(|h| h.strip_suffix(']')) {
+        v6.parse::<std::net::Ipv6Addr>().is_ok()
+    } else {
+        host.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'.' || b == b'-')
+            && !host.starts_with(['.', '-'])
+            && !host.ends_with(['.', '-'])
+    };
+    if !ok {
+        return Err(bad());
+    }
+    Ok(Some(n.to_string()))
+}
+
+/// The bytes G signs.
+pub fn g_preimage(raw: &str) -> Vec<u8> {
+    [DOMAIN, raw.as_bytes()].concat()
+}
+
+pub fn check_g_sig(m: &Message, sig_hex: &str) -> Result<(), String> {
+    let sig: [u8; 64] = hex::decode(sig_hex.trim())
+        .ok()
+        .and_then(|b| b.try_into().ok())
+        .ok_or("g_sig must be 128 hex digits")?;
+    datum_wire::crypto::verify(&m.g, &g_preimage(&m.raw), &sig).map_err(|_| "bad G signature".to_string())
+}
+
+/// `at` against the pool node: `tip` its height, `hash_at` the hash of its block at the
+/// message's height (`None` if it has none).
+pub fn check_at(m: &Message, tip: u32, hash_at: Option<&str>) -> Result<(), String> {
+    if m.at_height > tip {
+        return Err(format!("at height {} is ahead of the pool node's tip {tip}", m.at_height));
+    }
+    let behind = tip - m.at_height;
+    if behind >= AT_WINDOW {
+        return Err(format!(
+            "stale at: height {} is {behind} blocks below the tip {tip}; it must be one of the last {AT_WINDOW}",
+            m.at_height
+        ));
+    }
+    if hash_at.map(str::to_ascii_lowercase).as_deref() != Some(m.at_hash.as_str()) {
+        return Err(format!("at: {} is not the pool node's block at height {}", m.at_hash, m.at_height));
+    }
+    Ok(())
+}
+
+/// The enrol-by-spend marker script: `OP_RETURN PUSH21("LZT1E" ‖ SHA256(message)[0..16])`.
+pub fn spend_marker(raw: &str) -> Vec<u8> {
+    let mut data = SPEND_TAG.to_vec();
+    data.extend_from_slice(&datum_wire::bip322::sha256(raw.as_bytes())[..16]);
+    let mut s = vec![0x6a, data.len() as u8];
+    s.extend_from_slice(&data);
+    s
+}
+
+/// A verbose (`getrawtransaction … 2`) transaction as an enrol-by-spend proof for
+/// `payout_script`: confirmed, every input spends `payout`, every other output pays it back,
+/// and exactly one output is the marker.
+pub fn check_spend(tx: &Value, payout_script: &[u8], raw: &str, at_height: u32, block_height: Option<u32>) -> Result<(), String> {
+    let confs = tx["confirmations"].as_u64().unwrap_or(0);
+    if confs == 0 {
+        return Err("the enrol-by-spend tx is not confirmed yet".into());
+    }
+    if let Some(h) = block_height {
+        if h < at_height {
+            return Err("the enrol-by-spend tx is older than the message's at".into());
+        }
+    }
+    let payout_hex = hex::encode(payout_script);
+    let vin = tx["vin"].as_array().ok_or("tx has no vin")?;
+    if vin.is_empty() {
+        return Err("tx has no inputs".into());
+    }
+    for i in vin {
+        if i.get("coinbase").is_some() {
+            return Err("a coinbase is not an enrol-by-spend".into());
+        }
+        let spk = i["prevout"]["scriptPubKey"]["hex"].as_str().ok_or("node did not return the spent outputs (prevout)")?;
+        if spk != payout_hex {
+            return Err("an input of the enrol-by-spend tx is not held by the payout".into());
+        }
+    }
+    let marker = hex::encode(spend_marker(raw));
+    let mut markers = 0;
+    for o in tx["vout"].as_array().ok_or("tx has no vout")? {
+        let spk = o["scriptPubKey"]["hex"].as_str().unwrap_or("");
+        if spk.starts_with("6a") {
+            if spk != marker {
+                return Err("the tx's OP_RETURN is not LZT1E ‖ SHA256(message)[0..16] for this message".into());
+            }
+            markers += 1;
+        } else if spk != payout_hex {
+            return Err("the enrol-by-spend tx pays somewhere other than the payout".into());
+        }
+    }
+    if markers != 1 {
+        return Err("the enrol-by-spend tx must carry exactly one LZT1E output".into());
+    }
+    Ok(())
+}
+
+/// A checked message, ready for the registration rules.
+pub struct Checked {
+    pub msg: Message,
+    pub proof: Option<Proof>,
+    pub payout_script: Option<Vec<u8>>,
+    /// Time of the `at` block (key age for v2 counts from it).
+    pub at_time: u64,
+}
+
+async fn rpc(shared: &Shared, method: &str, params: Value) -> Result<Value, String> {
+    shared.rpc.call(method, params).await.map_err(|e| format!("pool node {method}: {e}"))
+}
+
+/// `POST /sovereignty/enrol` (token checked by the caller): a v1, v2 or revoke.
+///
+/// Body: `{"message", "g_sig"?, "payout_sig"?, "proof"?: "bip322"|"signmessage"|"spend",
+/// "spend_txid"?, "spend_block"?}`.
+pub async fn handle(shared: &Shared, body: &str) -> Result<Value, String> {
+    let v: Value = serde_json::from_str(body).map_err(|e| format!("body: {e}"))?;
+    let raw = v["message"].as_str().ok_or("message")?;
+    let msg = parse(raw)?;
+    if msg.kind != Kind::Revoke {
+        check_g_sig(&msg, v["g_sig"].as_str().ok_or("g_sig (G's signature) is required")?)?;
+    }
+    // at: one of the last AT_WINDOW blocks of the pool node's chain
+    let tip = rpc(shared, "getblockcount", json!([])).await?.as_u64().ok_or("getblockcount")? as u32;
+    let hash_at = if msg.at_height <= tip {
+        rpc(shared, "getblockhash", json!([msg.at_height])).await.ok().and_then(|h| h.as_str().map(str::to_string))
+    } else {
+        None
+    };
+    check_at(&msg, tip, hash_at.as_deref())?;
+    let header = rpc(shared, "getblockheader", json!([msg.at_hash, true])).await?;
+    let at_time = header["time"].as_u64().unwrap_or(0);
+
+    let (mut proof, mut payout_script) = (None, None);
+    if let Some(payout) = &msg.payout {
+        let script = address::decode_script(payout, shared.network)
+            .ok_or_else(|| format!("payout {payout:?} is not an address on this network"))?;
+        let p = Proof::parse(v["proof"].as_str())?;
+        match p {
+            Proof::Bip322 => {
+                let sig = v["payout_sig"].as_str().ok_or("payout_sig (BIP322 by the payout) is required")?;
+                let opts = datum_wire::bip322::Options { unified_sighash: true };
+                match datum_wire::bip322::verify(&script, raw.as_bytes(), sig, opts) {
+                    datum_wire::bip322::Verdict::Valid(ok) if ok.untimed() => {}
+                    datum_wire::bip322::Verdict::Valid(_) => return Err("BIP322 proof carries a timelock".into()),
+                    datum_wire::bip322::Verdict::Invalid(e) => return Err(format!("BIP322: {e}")),
+                    datum_wire::bip322::Verdict::Inconclusive(e) => {
+                        return Err(format!("BIP322 inconclusive (not accepted): {e}"))
+                    }
+                }
+            }
+            Proof::SignMessage => {
+                // BIP322: the legacy format is for P2PKH only
+                if !(script.len() == 25 && script[0] == 0x76) {
+                    return Err("signmessage is for P2PKH payouts only; use BIP322".into());
+                }
+                let sig = v["payout_sig"].as_str().ok_or("payout_sig (signmessage) is required")?;
+                let ok = rpc(shared, "verifymessage", json!([payout, sig, raw])).await?;
+                if ok != Value::Bool(true) {
+                    return Err("signmessage: the pool node's verifymessage says no".into());
+                }
+            }
+            Proof::Spend => {
+                let txid = v["spend_txid"].as_str().ok_or("spend_txid is required")?;
+                let tx = match v["spend_block"].as_str() {
+                    Some(b) => rpc(shared, "getrawtransaction", json!([txid, 2, b])).await?,
+                    None => rpc(shared, "getrawtransaction", json!([txid, 2])).await?,
+                };
+                let block_height = match tx["blockhash"].as_str() {
+                    Some(b) => rpc(shared, "getblockheader", json!([b, true])).await?["height"].as_u64().map(|h| h as u32),
+                    None => None,
+                };
+                check_spend(&tx, &script, raw, msg.at_height, block_height)?;
+            }
+        }
+        proof = Some(p);
+        payout_script = Some(script);
+    }
+    let known = shared.lookup_gateway_script(&msg.g_hex);
+    let checked = Checked { msg, proof, payout_script, at_time };
+    let rec = shared.sovereignty.engine().enrol(checked, known.as_deref())?;
+    Ok(json!({
+        "ok": true,
+        "g": rec.g,
+        "version": rec.version,
+        "status": rec.status.as_str(),
+        "payout_confirmed": rec.payout_confirmed,
+        "bound_height": rec.bound_height,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    pub fn v1(g: &str, node: &str, at: (u32, &str)) -> String {
+        format!("LZT1 register v1\npool: lazarus-xbt\nchain: XBT\nG: {g}\nnode: {node}\ntag: t\nat: {} {}", at.0, at.1)
+    }
+
+    #[test]
+    fn parses_the_spec_format() {
+        let g = "ab".repeat(32);
+        let h = "cd".repeat(32);
+        let m = parse(&v1(&g, "203.0.113.5:8333", (100, &h))).unwrap();
+        assert_eq!((m.kind, m.at_height, m.node.as_deref()), (Kind::V1, 100, Some("203.0.113.5:8333")));
+        let v2 = format!("{}\npayout: bcrt1qxyz", v1(&g, "none", (100, &h)).replace("register v1", "register v2"));
+        let m = parse(&v2).unwrap();
+        assert_eq!((m.kind, m.node, m.payout.as_deref()), (Kind::V2, None, Some("bcrt1qxyz")));
+        let rv = format!("LZT1 revoke v2\npool: lazarus-xbt\nchain: XBT\nG: {g}\npayout: bcrt1qxyz\nat: 7 {h}");
+        assert_eq!(parse(&rv).unwrap().kind, Kind::Revoke);
+        for node in ["abcdefghij234567.onion:8333", "[2001:db8::1]:8333", "node.example:18444"] {
+            assert!(parse(&v1(&g, node, (1, &h))).is_ok(), "{node}");
+        }
+    }
+
+    #[test]
+    fn refuses_what_the_spec_does_not_say() {
+        let g = "ab".repeat(32);
+        let h = "cd".repeat(32);
+        let good = v1(&g, "none", (1, &h));
+        let cases = [
+            (good.replace("chain: XBT", "chain: BTC"), "wrong chain line"),
+            (good.replace("pool: lazarus-xbt", "pool: ocean"), "wrong pool line"),
+            (format!("{good}\n"), "trailing newline"),
+            (good.replace('\n', "\r\n"), "\\r"),
+            (good.replace(&g, &g.to_uppercase()), "lowercase hex"),
+            (good.replace("node: none", "node: 1.2.3.4"), "node must be"),
+            (good.replace("node: none", "node: a b:1"), "node must be"),
+            (good.replace("tag: t", &format!("tag: {}", "x".repeat(33))), "at most 32"),
+            (format!("{good}\npayout: bcrt1q"), "unexpected line"),
+            (good.replace("register v1", "register v2"), "missing line \"payout\""),
+        ];
+        for (m, want) in cases {
+            let e = parse(&m).unwrap_err();
+            assert!(e.contains(want), "{m:?}: {e} (want {want})");
+        }
+    }
+
+    #[test]
+    fn at_is_a_recent_block_of_our_chain() {
+        let h = "cd".repeat(32);
+        let m = parse(&v1(&"ab".repeat(32), "none", (1000, &h))).unwrap();
+        assert!(check_at(&m, 1000, Some(&h)).is_ok());
+        assert!(check_at(&m, 1143, Some(&h)).is_ok());
