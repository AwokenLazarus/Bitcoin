+/// Which node Prime handed a canary to, and so what an honest gateway does with it.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum CanaryKind {
+    /// To one gateway's node, with a conflicting twin to the pool node: that gateway must carry it.
+    #[default]
+    Own,
+    /// Into the pool node's mempool, never its template, relayed to all: every gateway must carry it.
+    Shared,
+    /// Pool node only, under the relay floor, in its template: no gateway may carry it.
+    Decoy,
+}
+
+impl CanaryKind {
+    pub fn parse(s: &str) -> Option<Self> {
+        match s {
+            "own" => Some(Self::Own),
+            "shared" => Some(Self::Shared),
+            "decoy" => Some(Self::Decoy),
+            _ => None,
