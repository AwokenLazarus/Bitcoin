+    /// Templates in a converged network with every canary kind, `t` every 0.5 s:
+    /// `pool`, `honest`, `proxy`, and three hybrids built from the pool's template `T` and the
+    /// hybrid's own node's mempool `L` (the pool's mempool is `M`):
+    /// `naive` = T ∪ (L∖T), own canaries winning conflicts; `filtered` = (T∩L) ∪ (L∖M);
+    /// `forced` = (T∩L) ∪ (L∖T), which is L: the hybrid's own node's tx set.
+    struct World {
+        pool: Vec<Snapshot>,
+        honest: Vec<Snapshot>,
+        proxy: Vec<Snapshot>,
+        naive: Vec<Snapshot>,
+        filtered: Vec<Snapshot>,
+        forced: Vec<Snapshot>,
+        /// Own canaries of the honest gateway and of the hybrids (same node in this model).
+        own: Vec<Canary>,
+        /// Shared canaries and decoys (every gateway).
+        global: Vec<Canary>,
+    }
+
+    fn world(n: usize) -> World {
+        let mut w = World {
+            pool: vec![],
+            honest: vec![],
+            proxy: vec![],
+            naive: vec![],
+            filtered: vec![],
+            forced: vec![],
+            own: vec![],
+            global: vec![],
+        };
+        // (canary, twin the pool holds instead)
+        let mut own_live: Vec<(String, String)> = vec![];
+        let mut shared_live: Vec<String> = vec![];
+        let mut decoy_live: Vec<String> = vec![];
+        let delivered = |cs: &[Canary], id: &str, t: f64, lag: f64| cs.iter().any(|c| c.txid == id && c.t + lag <= t);
+        for i in 0..n {
+            let t = i as f64 * 0.5;
+            if i % 30 == 0 {
+                // a block: canaries and decoys so far are mined (by whoever)
+                own_live.clear();
+                shared_live.clear();
+                decoy_live.clear();
+            }
+            let prev = hex32(1 + (i / 30) as u64);
+            let common: Vec<String> = (0..5).map(|k| hex32(1_000 + (i / 4 + k) as u64)).collect();
+            if i % 8 == 0 {
+                let c = hex32(9_000_000 + i as u64);
+                w.own.push(Canary::new(t, c.clone()));
+                own_live.push((c, hex32(8_000_000 + i as u64)));
+            }
+            if i % 8 == 3 {
+                let d = hex32(7_000_000 + i as u64);
+                w.global.push(Canary::shared(t, d.clone()));
+                shared_live.push(d);
+            }
+            if i % 8 == 5 {
+                let q = hex32(6_000_000 + i as u64);
+                w.global.push(Canary::decoy(t, q.clone()));
+                decoy_live.push(q);
+            }
+            // pool: template = common + own twins + decoys; mempool additionally the shared ones
+            let mut tp = common.clone();
+            tp.extend(own_live.iter().map(|(_, twin)| twin.clone()));
+            tp.extend(decoy_live.iter().cloned());
+            let mut mp = tp.clone();
+            mp.extend(shared_live.iter().cloned());
+            // the gateway's node: common + its own canaries (2 s to refresh) + shared (1.5 s relay)
+            let mut l = common.clone();
+            l.extend(own_live.iter().filter(|(c, _)| delivered(&w.own, c, t, 2.0)).map(|(c, _)| c.clone()));
+            l.extend(shared_live.iter().filter(|d| delivered(&w.global, d, t, 1.5)).cloned());
+            let lset: std::collections::HashSet<&String> = l.iter().collect();
+            let tset: std::collections::HashSet<&String> = tp.iter().collect();
+            let mset: std::collections::HashSet<&String> = mp.iter().collect();
+            let beaten: std::collections::HashSet<&String> =
+                own_live.iter().filter(|(c, _)| lset.contains(c)).map(|(_, twin)| twin).collect();
+            let mut naive: Vec<String> = tp.iter().filter(|x| !beaten.contains(x)).cloned().collect();
+            naive.extend(l.iter().filter(|x| !tset.contains(x)).cloned());
+            let mut filtered: Vec<String> = tp.iter().filter(|x| lset.contains(x)).cloned().collect();
+            filtered.extend(l.iter().filter(|x| !mset.contains(x)).cloned());
+            let mut forced: Vec<String> = tp.iter().filter(|x| lset.contains(x)).cloned().collect();
+            forced.extend(l.iter().filter(|x| !tset.contains(x)).cloned());
+            w.pool.push(Snapshot::new(t, prev.clone(), tp.clone()));
+            w.honest.push(Snapshot::new(t + 0.01, prev.clone(), l));
+            w.proxy.push(Snapshot::new(t + 0.05, prev.clone(), tp));
+            w.naive.push(Snapshot::new(t + 0.3, prev.clone(), naive));
+            w.filtered.push(Snapshot::new(t + 0.3, prev.clone(), filtered));
+            w.forced.push(Snapshot::new(t + 0.3, prev, forced));
+        }
+        w
+    }
+
+    fn judge(w: &World, s: &[Snapshot]) -> Features {
+        let all: Vec<Canary> = w.own.iter().chain(&w.global).cloned().collect();
+        features_with(s, &w.pool, &all)
+    }
+
+    #[test]
+    fn every_canary_kind_clears_the_honest_gateway() {
+        let w = world(240);
+        let f = judge(&w, &w.honest);
+        assert!(f.canaries_due >= CANARY_MIN && f.shared_due >= CANARY_MIN && f.decoys_due >= CANARY_MIN, "{f:?}");
+        assert_eq!(f.decoys_carried, 0);
+        assert_eq!(f.canary_pool_leaks, 0);
+        assert!(!f.flagged, "{:?}", f.flag_reasons);
+        assert!(f.independence > 0.8, "{}", f.independence);
+    }
+
+    #[test]
+    fn decoys_catch_the_hybrid_that_merges_its_node_into_the_pool_template() {
+        let w = world(240);
+        let f = judge(&w, &w.naive);
+        // it passes both must-carry tests...
+        assert!(f.canary_rate.unwrap() > 0.8 && f.shared_rate.unwrap() > 0.8, "{f:?}");
+        // ...and carries the pool-only decoys
+        assert!(f.flagged);
+        assert_eq!(f.flag_reasons, vec!["decoys-carried"]);
+        assert_eq!(f.independence, 0.0);
+    }
+
+    #[test]
+    fn shared_canaries_catch_the_hybrid_that_follows_the_pools_exclusions() {
+        let w = world(240);
+        let f = judge(&w, &w.filtered);
+        assert_eq!(f.decoys_carried, 0);
+        assert!(f.canary_rate.unwrap() > 0.8, "{f:?}");
+        assert_eq!(f.shared_hits, 0);
+        assert_eq!(f.flag_reasons, vec!["shared-canaries-missed"]);
+        assert_eq!(f.independence, 0.0);
+    }
+
+    /// The bound: a hybrid that passes every kind has built its own node's tx set.
+    #[test]
+    fn a_hybrid_that_passes_every_kind_templates_its_own_nodes_set() {
+        let w = world(240);
+        let f = judge(&w, &w.forced);
+        assert!(!f.flagged, "{:?}", f.flag_reasons);
+        for (h, x) in w.honest.iter().zip(&w.forced) {
+            assert!(jaccard(&h.txids, &x.txids) == 1.0, "{:?} vs {:?}", h.txids, x.txids);
+        }
+    }
+
+    #[test]
+    fn proxies_fail_every_kind() {
+        let w = world(240);
+        let f = judge(&w, &w.proxy);
+        assert_eq!(f.flag_reasons, vec!["own-canaries-missed", "shared-canaries-missed", "decoys-carried"]);
+        assert_eq!(f.independence, 0.0);
+    }
+
+    #[test]
+    fn decoys_alone_convict_but_never_clear() {
+        let w = world(240);
+        let decoys: Vec<Canary> = w.global.iter().filter(|c| c.kind == CanaryKind::Decoy).cloned().collect();
+        let f = features_with(&w.honest, &w.pool, &decoys);
+        assert!(f.decoys_due >= CANARY_MIN && f.decoys_carried == 0);
+        assert_ne!(f.evidence, "canary");
+        let f = features_with(&w.proxy, &w.pool, &decoys);
+        assert!(f.flagged && f.evidence == "canary");
+    }
+
+    /// A gateway that misses most canaries is flagged, and a flagged gateway earns nothing even
+    /// if it carried a few (it used to keep hits/due as its weight).
+    #[test]
+    fn flagged_means_zero_independence() {
+        let w = world(240);
+        // honest templates, but only one own canary in six makes it in
+        let keep: std::collections::HashSet<&str> = w.own.iter().step_by(6).map(|c| c.txid.as_str()).collect();
+        let owned: std::collections::HashSet<&str> = w.own.iter().map(|c| c.txid.as_str()).collect();
+        let sparse: Vec<Snapshot> = w
+            .honest
+            .iter()
+            .map(|s| Snapshot {
+                txids: s.txids.iter().filter(|x| !owned.contains(x.as_str()) || keep.contains(x.as_str())).cloned().collect(),
+                ..s.clone()
+            })
+            .collect();
+        let f = judge(&w, &sparse);
+        assert!(f.canary_hits > 0 && f.canary_rate.unwrap() < CANARY_FLAG, "{f:?}");
+        assert_eq!(f.flag_reasons, vec!["own-canaries-missed"]);
+        assert_eq!(f.independence, 0.0);
+    }
