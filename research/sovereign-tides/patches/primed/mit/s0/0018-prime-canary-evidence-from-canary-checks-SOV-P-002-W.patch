+    /// The job in slot `id` as a check would judge it; `None` for an empty slot, or a job with no
+    /// transactions (nothing to hold a canary).
+    fn checked_job(&self, id: u8) -> Option<CheckedJob> {
+        let j = self.slots.get(usize::from(id))?.job.as_ref()?;
+        (!j.merkle_branches.is_empty()).then(|| CheckedJob {
+            id,
+            seen: self.job_seen[usize::from(id)],
+            branches: j.merkle_branches.clone(),
+        })
+    }
+
+    /// W8: a canary was registered for this gateway a while ago (`sovereignty-canary-check-secs`);
+    /// ask for the transactions of its newest job, whatever its shares scored, and read the
+    /// canary verdict from them (`on_validation` → `note_check`). One check in flight at a time;
+    /// `Sovereignty::take_check` rate-limits them per gateway.
+    async fn maybe_check_canaries(&mut self) -> Result<(), SessionError> {
+        let sov = &self.shared.sovereignty;
+        if !sov.on() || self.is_house_stratum() {
+            return Ok(());
+        }
+        if self.canary_check.as_ref().is_some_and(|(_, t)| t.elapsed() < CANARY_CHECK_TTL) {
+            return Ok(());
+        }
+        self.canary_check = None;
+        let Some(job) = self.newest_slot.and_then(|id| self.checked_job(id)) else { return Ok(()) };
+        if !sov.take_check(&self.gateway_key_hex(), crate::sovereignty::now_f64()) {
+            return Ok(());
+        }
+        let now = Instant::now();
+        let id = job.id;
+        self.canary_check = Some((job, now));
+        // a found block on this very job has already asked for its transactions: that reply serves both
+        if self.pending_blocks.contains_key(&id) {
+            return Ok(());
+        }
+        log::debug!("[{}] {}: canary check on job {id}", self.id, self.gateway_hex);
+        self.send_mining(&mining::request_full_block(id), false).await
+    }
+
+    /// A job's transactions arrived for a canary check: if they are the job's, they are canary
+    /// evidence for this gateway.
+    fn note_check(&self, job: &CheckedJob, txns: &[Vec<u8>]) {
+        let sov = &self.shared.sovereignty;
+        if !sov.on() || self.is_house_stratum() {
+            return;
+        }
+        let Some(ids) = verify::job_txids(txns, &job.branches) else {
+            log::warn!(
+                "[{}] {}: the transactions sent for job {} do not hash to that job's merkle branches; not taken as canary evidence",
+                self.id,
+                self.gateway_hex,
+                job.id
+            );
+            sov.note_check_refused();
+            return;
+        };
+        let txids: Vec<String> = ids
+            .iter()
+            .map(|h| {
+                let mut b = *h;
+                b.reverse();
+                hex::encode(b)
+            })
+            .collect();
+        sov.engine().note_check(
+            &self.gateway_key_hex(),
+            self.is_house_stratum(),
+            self.gateway_script.as_deref(),
+            job.seen,
+            &txids,
+        );
+    }
