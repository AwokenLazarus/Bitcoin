+    let job = s.job.as_mut().unwrap();
+    job.merkle_branches = pow::merkle_branches_for_coinbase(&ids);
+    job.txn_count = ids.len() as u32;
+    s
+}
+
+/// The gateway's side of `request_full_block`: wait for Prime to ask about `slot`.
+fn await_full_block_request(gw: &mut common::Gateway, slot: u8) {
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+    loop {
+        assert!(std::time::Instant::now() < deadline, "Prime never asked for job {slot}'s transactions");
+        let m = gw.next_mining();
+        if m.len() >= 3 && m[..3] == [datum_wire::mining::SUB_JOB_VALIDATION, 0x12, slot] {
+            return;
+        }
+    }
+}
+
+fn full_block_reply(slot: u8, txns: &[Vec<u8>]) -> Vec<u8> {
+    let mut m = vec![datum_wire::mining::SUB_JOB_VALIDATION, 0x92, slot, 0x01];
+    m.extend_from_slice(&(txns.len() as u16).to_le_bytes());
+    for t in txns {
+        m.extend_from_slice(&(t.len() as u16).to_le_bytes());
+        m.push((t.len() >> 16) as u8);
+        m.extend_from_slice(t);
+    }
+    m.push(datum_wire::mining::END);
+    m
+}
