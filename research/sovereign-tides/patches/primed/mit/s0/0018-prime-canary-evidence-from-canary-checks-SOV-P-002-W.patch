+/// W8 end to end over DATUM: a canary registered for G makes Prime fetch G's newest job with
+/// `request_full_block` on its own; the job's transactions (matched to its merkle branches) are
+/// the canary evidence. A gateway that answers with a list its job does not hash to, one with
+/// the canary added, is not believed.
+#[test]
+fn a_canary_check_reads_the_gateways_own_job() {
+    let pool = Identity::from_secret_bytes(&[0x65; 64]);
+    let extra = r#"
+rpc = "http://127.0.0.1:9"
+poll = 60
+house-loopback = false
+sovereignty-mode = "observe"
+sovereignty-demo = true
+sovereignty-canary-check-secs = 1
+sovereignty-canary-check-gap-secs = 300
+"#;
+    let (p, listen) = common::start_primed(&pool, extra);
+    use_token_of(&p);
+    let honest = Identity::from_secret_bytes(&[0x31; 64]);
+    let forger = Identity::from_secret_bytes(&[0x32; 64]);
+    let (hg, fg) = (hex::encode(honest.sign_pk()), hex::encode(forger.sign_pk()));
+    for g in [&hg, &fg] {
+        let r = post(p.stats, "/sovereignty/register", &json!({"g": g, "payout": "bc1q"}));
+        assert_eq!(&r["g"], g, "{r}");
+    }
+
+    // the honest gateway's job holds its canary (tx 2); the forger's job does not hold its own
+    // (tx 9), and it answers the check with tx 9 appended
+    let honest_job = vec![raw_tx(1), raw_tx(2), raw_tx(3)];
+    let forger_job = vec![raw_tx(4), raw_tx(5)];
+    let mut forged = forger_job.clone();
+    forged.push(raw_tx(9));
+    let mut h = common::Gateway::connect(listen, &pool, &honest);
+    let mut f = common::Gateway::connect(listen, &pool, &forger);
+    let (hs, fs) = (3u8, 4u8);
+    let (status, _) = h.submit(&share_on(&honest_job, hs));
+    assert_ne!(status, datum_wire::mining::ACCEPTED, "an unground share is refused");
+    f.submit(&share_on(&forger_job, fs));
+
+    // delivered 13 s before the jobs were first seen, so those jobs can judge them
+    let t = crate_now() - 13.0;
+    for (g, txid) in [(&hg, display_txid(&raw_tx(2))), (&fg, display_txid(&raw_tx(9)))] {
+        let r = post(p.stats, "/sovereignty/canary", &json!({"gateway": g, "t": t, "txid": txid, "kind": "own"}));
+        assert_eq!(r["ok"], true, "{r}");
+    }
+    await_full_block_request(&mut h, hs);
+    h.send_mining(&full_block_reply(hs, &honest_job));
+    await_full_block_request(&mut f, fs);
+    f.send_mining(&full_block_reply(fs, &forged));
+
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(15);
+    let doc = loop {
+        let (_, body) = request(p.stats, "GET", "/sovereignty.json", "", None);
+        let doc: Value = serde_json::from_str(&body).unwrap();
+        if doc["gateways"][&hg]["checks"] == 1 && doc["store"]["checks_refused"] == 1 {
+            break doc;
+        }
+        assert!(std::time::Instant::now() < deadline, "no check evidence: {doc}");
+        std::thread::sleep(std::time::Duration::from_millis(300));
+    };
+    let hrow = &doc["gateways"][&hg];
+    assert_eq!((hrow["canaries_due"].as_u64(), hrow["canary_hits"].as_u64()), (Some(1), Some(1)), "{hrow}");
+    assert_eq!(hrow["canary_source"], "checks");
+    let frow = &doc["gateways"][&fg];
+    assert_eq!(frow["checks"], 0, "a forged list is no evidence: {frow}");
+    assert_eq!(frow["canary_hits"], 0, "{frow}");
+    let log = std::fs::read_to_string(p.dir.join("primed.log")).unwrap_or_default()
+        + &std::fs::read_to_string(p.dir.join("primed.err")).unwrap_or_default();
+    assert!(log.contains("do not hash to that job's merkle branches"), "{log}");
+}
+
+fn crate_now() -> f64 {
+    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64()
+}
