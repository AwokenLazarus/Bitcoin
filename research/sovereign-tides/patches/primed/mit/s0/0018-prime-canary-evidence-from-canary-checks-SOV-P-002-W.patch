+/// Canary hits read from template checks (W8): a canary is due when a check's job was first
+/// seen between `CANARY_DUE` and `CHECK_WINDOW` s after its delivery, and a hit if one of those
+/// jobs holds it. A canary with no check in that span is not judged at all (neither hit nor
+/// miss), so a gateway is never marked down for a check Prime did not make.
+fn tally_checks(checks: &[&Check], pool: &PoolView, canaries: &[&Canary]) -> Tally {
+    let mut checks: Vec<&Check> = checks.to_vec();
+    checks.sort_by(|a, b| a.t.partial_cmp(&b.t).unwrap_or(std::cmp::Ordering::Equal));
+    let mut tally = [(0usize, 0usize); 3];
+    let mut leaks = 0usize;
+    for c in canaries {
+        let id = fp(&c.txid);
+        let pool_at = first_between(pool.occ.get(&id), c.t - WINDOW, f64::INFINITY);
+        if pool_at.is_some() && c.kind != CanaryKind::Decoy {
+            leaks += 1;
+        }
+        let (from, to) = (c.t + CANARY_DUE, c.t + CHECK_WINDOW);
+        let lo = checks.partition_point(|k| k.t < from);
+        let judging = checks[lo..].iter().take_while(|k| k.t <= to);
+        let mut due = false;
+        let mut hit = false;
+        for k in judging {
+            due = true;
+            // as on the snapshot path: a must-carry canary the pool's template had first is no
+            // evidence of the gateway's own view
+            if k.has(id) && (c.kind == CanaryKind::Decoy || pool_at.is_none_or(|pt| k.t < pt - LEAD_MARGIN)) {
+                hit = true;
+                break;
+            }
+        }
+        if due {
+            let (d, h) = &mut tally[c.kind as usize];
+            *d += 1;
+            *h += usize::from(hit);
+        }
+    }
+    (tally, leaks)
+}
