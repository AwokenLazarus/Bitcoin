+/// The txid of one raw transaction as a gateway sends it (legacy or segwit serialization):
+/// SHA256d of the legacy bytes, internal byte order. `None` unless `raw` is exactly one
+/// well-formed transaction.
+pub fn txid(raw: &[u8]) -> Option<Hash> {
+    use crate::coinbase::read_varint;
+    let mut c = crate::Cursor::new(raw);
+    let version = c.take(4).ok()?;
+    let segwit = raw.get(4..6) == Some(&[0x00, 0x01][..]);
+    if segwit {
+        c.take(2).ok()?;
+    }
+    let body_at = c.pos;
+    let nin = read_varint(&mut c).ok()?;
+    if nin == 0 || nin > 100_000 {
+        return None;
+    }
+    for _ in 0..nin {
+        c.take(36).ok()?;
+        let n = read_varint(&mut c).ok()?;
+        c.take(usize::try_from(n).ok()?).ok()?;
+        c.take(4).ok()?;
+    }
+    let nout = read_varint(&mut c).ok()?;
+    if nout > 100_000 {
+        return None;
+    }
+    for _ in 0..nout {
+        c.take(8).ok()?;
+        let n = read_varint(&mut c).ok()?;
+        c.take(usize::try_from(n).ok()?).ok()?;
+    }
+    let body_end = c.pos;
+    if segwit {
+        for _ in 0..nin {
+            let items = read_varint(&mut c).ok()?;
+            for _ in 0..items {
+                let n = read_varint(&mut c).ok()?;
+                c.take(usize::try_from(n).ok()?).ok()?;
+            }
+        }
+    }
+    let lock = c.take(4).ok()?;
+    if c.remaining() != 0 {
+        return None;
+    }
+    let mut legacy = Vec::with_capacity(8 + body_end - body_at);
+    legacy.extend_from_slice(version);
+    legacy.extend_from_slice(&raw[body_at..body_end]);
+    legacy.extend_from_slice(lock);
+    Some(pow::sha256d(&legacy))
+}
+
+/// The txids of a job's transactions (coinbase excluded), in order, if and only if they are the
+/// job's: the coinbase merkle branches they make equal the ones the gateway's job section
+/// carried. A gateway cannot answer a template check with a list other than the one its miners
+/// are hashing.
+pub fn job_txids(txns: &[Vec<u8>], merkle_branches: &[Hash]) -> Option<Vec<Hash>> {
+    let ids: Option<Vec<Hash>> = txns.iter().map(|t| txid(t)).collect();
+    let ids = ids?;
+    (pow::merkle_branches_for_coinbase(&ids) == merkle_branches).then_some(ids)
+}
