+/// A minimal raw transaction, distinct per `i`.
+fn raw_tx(i: u8) -> Vec<u8> {
+    let mut t = 2u32.to_le_bytes().to_vec();
+    t.push(1);
+    t.extend_from_slice(&[i; 32]);
+    t.extend_from_slice(&0u32.to_le_bytes());
+    t.push(0);
+    t.extend_from_slice(&0xffff_fffdu32.to_le_bytes());
+    t.push(1);
+    t.extend_from_slice(&(1_000 + u64::from(i)).to_le_bytes());
+    t.extend_from_slice(&[1, 0x51]);
+    t.extend_from_slice(&[0; 4]);
+    t
+}
