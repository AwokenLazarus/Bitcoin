+fn share_on(txns: &[Vec<u8>], slot: u8) -> datum_wire::mining::PowSubmit {
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as u32;
+    let mut s = common::pool_only_share(slot, common::HEIGHT, [7u8; 32], 0x1d00_ffff, 4_000, now);
