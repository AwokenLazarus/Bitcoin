+/// One template check (W8): the whole transaction list of one of a gateway's jobs, as the
+/// gateway sent it for `request_full_block` and Prime matched it to the job's merkle branches,
+/// stamped with when Prime first saw that job. This, not a job snapshot, is canary evidence:
+/// a job's merkle branches say nothing about which txs it holds, and a list that does not hash
+/// to the job the gateway is mining never gets this far.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Check {
+    /// Unix seconds (fractional) Prime first saw the checked job.
+    pub t: f64,
+    /// Txid fingerprints ([`fp`] of display hex), sorted and deduplicated.
+    set: Vec<u64>,
+}
+
+impl Check {
+    /// `txids` in display (big-endian) hex, as canaries are posted.
+    pub fn new(t: f64, txids: &[String]) -> Self {
+        let mut set: Vec<u64> = txids.iter().map(|x| fp(x)).collect();
+        set.sort_unstable();
+        set.dedup();
+        Check { t, set }
+    }
+
+    pub fn len(&self) -> usize {
+        self.set.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.set.is_empty()
+    }
+
+    fn has(&self, id: u64) -> bool {
+        self.set.binary_search(&id).is_ok()
+    }
+
+    pub fn heap_bytes(&self) -> usize {
+        std::mem::size_of::<Self>() + self.set.capacity() * 8
+    }
+}
