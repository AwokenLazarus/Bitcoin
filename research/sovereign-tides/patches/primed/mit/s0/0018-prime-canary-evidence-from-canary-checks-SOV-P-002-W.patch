+                .iter()
+                .max_by(|a, b| a.1.front().partial_cmp(&b.1.front()).unwrap_or(std::cmp::Ordering::Equal))
+                .map(|(k, _)| k.clone());
+            if let Some(k) = drop {
+                s.due.remove(&k);
+            }
+        }
+        let q = s.due.entry(gateway.to_ascii_lowercase()).or_default();
+        let i = q.partition_point(|&d| d <= at);
+        q.insert(i, at);
+        while q.len() > MAX_PENDING_CHECKS {
+            // keep the latest: it judges the most recent canaries, and the earlier ones' window
+            // (`entropy::CHECK_WINDOW`) still covers it
+            q.pop_front();
+        }
+    }
+
+    /// Is a canary check of `gateway` due at `now`? Taking it clears every check due by then
+    /// (one look at the newest job answers them all). At most one per `-gap-secs` per gateway.
+    pub fn take_check(&self, gateway: &str, now: f64) -> bool {
+        let g = gateway.to_ascii_lowercase();
+        let mut s = self.schedule.lock().unwrap();
+        let Some(q) = s.due.get_mut(&g) else { return false };
+        if q.front().is_none_or(|&d| d > now) {
+            return false;
+        }
+        if s.last.get(&g).is_some_and(|&l| now - l < self.check_gap) {
+            return false;
+        }
+        let q = s.due.get_mut(&g).unwrap();
+        while q.front().is_some_and(|&d| d <= now) {
+            q.pop_front();
+        }
+        if q.is_empty() {
+            s.due.remove(&g);
+        }
+        s.last.insert(g, now);
+        let stale = now - 2.0 * KEY_TTL_SECS as f64;
+        s.last.retain(|_, l| *l > stale);
+        true
+    }
