+    fn note_check_named(&mut self, name: &str, check: Check) {
+        let seen = now();
+        if !self.checks.contains_key(name) && self.checks.len() >= MAX_KEYS {
+            self.evict(seen);
+            let lru = self.checks.iter().min_by_key(|(_, c)| c.last_seen).map(|(n, _)| n.clone());
+            if let (true, Some(n)) = (self.checks.len() >= MAX_KEYS, lru) {
+                self.checks.remove(&n);
+            }
+        }
+        let c = self.checks.entry(name.to_string()).or_default();
+        c.last_seen = seen;
+        c.list.push_back(Arc::new(check));
+        while c.list.len() > MAX_CHECKS {
+            c.list.pop_front();
+        }
+        self.dirty = true;
+    }
