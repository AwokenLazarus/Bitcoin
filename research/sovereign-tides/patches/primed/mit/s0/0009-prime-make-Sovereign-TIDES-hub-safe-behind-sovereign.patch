+/// Window work by kind, read under the ledger lock (O(miners)); the bonus sample adds authored
+/// work to it outside the lock.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct WindowWork {
+    pub total: u64,
+    pub stratum: u64,
+    pub datum: u64,
+}
+
+impl WindowWork {
+    pub fn of(w: &Window) -> Self {
+        let mut stratum = 0u64;
+        let mut datum = 0u64;
+        for m in w.miners() {
+            stratum = stratum.saturating_add(m.stratum_work);
+            datum = datum.saturating_add(m.work.saturating_sub(m.stratum_work));
+        }
+        WindowWork { total: w.total_work(), stratum, datum }
+    }
+
+    fn with(self, authored: &[Authored]) -> WorkTotals {
+        let authored: u64 = authored.iter().map(|a| a.work).sum::<u64>().min(self.datum);
+        WorkTotals {
+            total: self.total,
+            stratum: self.stratum,
+            unauthored_datum: self.datum.saturating_sub(authored),
+            authored,
+        }
+    }
+}
+
+impl Report {
+    /// The `sovereignty` object. `work` (read under the ledger lock by the caller, which must
+    /// have let go of it by now) fills in the bonus sample when the bonus is on.
+    pub fn render(&self, work: Option<WindowWork>) -> Value {
+        let mut body = self.body.clone();
+        if let (true, Some(work)) = (self.bonus_on, work) {
+            let b = bonus::compute(312_500_000, work.with(&self.authored), self.params, &self.authored);
+            body["bonus"]["sample"] = json!({
+                "from_stratum": b.from_stratum,
+                "from_diff": b.from_diff,
+                "credits": b.credits,
+                "to_pool": b.to_pool,
+                "diff_waived": b.diff_waived,
+            });
+        }
+        body
+    }
+
+    pub fn needs_window(&self) -> bool {
+        self.bonus_on
+    }
+}
