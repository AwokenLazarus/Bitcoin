+    #[test]
+    #[ignore]
+    fn bench_stats_build_ledger_lock() {
+        for (mode, bonus) in [("off", false), ("publish", false), ("publish", true)] {
+            let dir = std::env::temp_dir().join(format!("sov006-stats-{mode}-{bonus}-{}", std::process::id()));
+            let _ = std::fs::remove_dir_all(&dir);
+            let shared = crate::test_shared(
+                &dir,
+                &format!("sovereignty-mode = \"{mode}\"\nsovereignty-bonus = {bonus}\nstratum-fee-bps = 2500\n"),
+            );
+            let ts = now() as u32;
+            {
+                let mut ledger = shared.ledger.lock().unwrap();
+                // 250 gateways' miners, an hour of coalesced credits
+                for i in 0..100_000u32 {
+                    let who = format!("bc1qminer{:03}", i % 250);
+                    let source = if i % 4 == 0 { tides::SOURCE_STRATUM } else { tides::SOURCE_DATUM };
+                    ledger.credit(&who, 1 + u64::from(i % 7), 900_000, ts - 3_600 + i / 28, source).unwrap();
+                }
+            }
+            if shared.sovereignty.on() {
+                crate::sovereignty::fill_hub(&mut shared.sovereignty.engine(), 250, crate::sovereignty::MAX_SNAPSHOTS as u64);
+                shared.sovereignty.recompute_now();
+            }
+            let mut held: Vec<f64> = Vec::new();
+            let mut total: Vec<f64> = Vec::new();
+            for _ in 0..30 {
+                let at = Instant::now();
+                let (doc, h) = build_timed(&shared);
+                total.push(at.elapsed().as_secs_f64() * 1e3);
+                held.push(h.as_secs_f64() * 1e3);
+                assert_eq!(doc.get("sovereignty").is_some(), mode != "off");
+            }
+            held.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            total.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            println!(
