+    pub clusters: Vec<Vec<String>>,
+    pub pool_cluster: HashSet<String>,
+    pub score: PoolScore,
+    independence_ppm: HashMap<String, u32>,
+    /// Weight per builder for the score (W5 applied).
+    weights: HashMap<String, f64>,
+    authored: Vec<Authored>,
+    params: BonusParams,
+    bonus_on: bool,
+    /// The `sovereignty` object, `bonus.sample` still null.
+    body: Value,
+}
+
+/// Everything a detector pass reads, copied out from under the engine lock. Snapshots are shared
+/// (`Arc`), so the copy is one reference count per snapshot.
+struct Inputs {
+    at: u64,
+    mode: SovereigntyMode,
+    recompute_secs: u64,
+    tracks: Vec<(String, Vec<Arc<Prepared>>)>,
+    canaries: HashMap<String, Vec<Canary>>,
+    keys: HashMap<String, KeyRecord>,
+    blocks: Vec<ObservedBlock>,
+    authored: Vec<Authored>,
+    params: BonusParams,
+    bonus_on: bool,
+    demo: bool,
+    min_key_age_secs: u32,
+}
+
+/// Does the pool-cluster rule zero this builder? Only with no canary hit (XBT-073): an honest
+/// node on a quiet chain often builds exactly the pool's template, and its canaries say so.
+pub fn pool_clustered(in_pool_cluster: bool, f: &Features) -> bool {
+    in_pool_cluster && f.canary_hits + f.shared_hits == 0
+}
+
+fn compute(inp: &Inputs) -> Report {
+    let started = Instant::now();
+    let empty = Vec::new();
+    let pool: &Vec<Arc<Prepared>> = inp.tracks.iter().find(|(n, _)| n == POOL).map(|(_, v)| v).unwrap_or(&empty);
+    let view = PoolView::new(pool.iter().map(|a| &**a));
+    let shared: Vec<&Canary> = inp.canaries.get(ALL).map(|v| v.iter().collect()).unwrap_or_default();
+    let mut rows = BTreeMap::new();
+    for (name, snaps) in &inp.tracks {
+        if name == POOL {
+            continue;
+        }
+        let mut canaries: Vec<&Canary> = inp.canaries.get(name).map(|v| v.iter().collect()).unwrap_or_default();
+        canaries.extend(shared.iter().copied());
+        let refs: Vec<&Prepared> = snaps.iter().map(|a| &**a).collect();
+        rows.insert(name.clone(), entropy::features_prepared(&refs, &view, &canaries));
+    }
+    let named: Vec<(String, Vec<&Prepared>)> =
+        inp.tracks.iter().map(|(n, v)| (n.clone(), v.iter().map(|a| &**a).collect())).collect();
+    let clusters = entropy::clusters_prepared(&named);
+    let pool_cluster: HashSet<String> = clusters
+        .iter()
+        .find(|c| c.iter().any(|n| n == POOL))
+        .into_iter()
+        .flatten()
+        .filter(|n| *n != POOL)
+        .cloned()
+        .collect();
+    let weights: HashMap<String, f64> = rows
+        .iter()
+        .map(|(n, f)| {
+            let clustered = pool_clustered(pool_cluster.contains(n), f);
+            (n.clone(), score::builder_weight(f.independence, f.flagged, clustered, f.insufficient))
+        })
+        .collect();
+    let credits: Vec<BlockCredit> = inp
+        .blocks
+        .iter()
+        .map(|b| BlockCredit { builder: b.builder.clone(), claimed: b.claimed, verified: b.verified })
+        .collect();
+    let pool_score = score::summarize(&credits, |b| weights.get(b).copied().unwrap_or(0.0));
+    let independence_ppm = rows.iter().map(|(n, f)| (n.clone(), entropy::independence_ppm(f))).collect();
+    let mut report = Report {
+        computed_at: inp.at,
+        rows,
+        clusters,
+        pool_cluster,
+        score: pool_score,
+        independence_ppm,
+        weights,
+        authored: inp.authored.clone(),
+        params: inp.params,
+        bonus_on: inp.bonus_on,
+        ..Report::default()
+    };
+    report.compute_ms = started.elapsed().as_millis() as u64;
+    report.body = render(inp, &report);
+    report
+}
+
+fn render(inp: &Inputs, r: &Report) -> Value {
+    let mut gw_blocks: HashMap<&str, u64> = HashMap::new();
+    for b in &inp.blocks {
+        *gw_blocks.entry(b.builder.as_str()).or_insert(0) += 1;
+    }
+    let snapshots: usize = inp.tracks.iter().map(|(_, v)| v.len()).sum();
+    let bytes: usize = inp.tracks.iter().flat_map(|(_, v)| v.iter()).map(|p| p.heap_bytes()).sum();
+    let gateways: BTreeMap<&String, Value> = r
+        .rows
+        .iter()
+        .map(|(n, f)| {
+            let key = inp.keys.get(n);
+            (
+                n,
+                json!({
+                    "snapshots": f.snapshots,
+                    "compared": f.compared,
+                    "identical": f.identical,
+                    "branch_sim": f.branch_sim,
+                    "jaccard": f.jaccard,
+                    "lead": f.lead,
+                    "tip_lead": f.tip_lead,
+                    "lockstep": f.lockstep,
+                    "switch_lag": f.switch_lag,
+                    "incl_lag": f.incl_lag,
+                    "canaries": f.canaries,
+                    "canaries_due": f.canaries_due,
+                    "canary_hits": f.canary_hits,
+                    "canary_rate": f.canary_rate,
+                    "shared_due": f.shared_due,
+                    "shared_hits": f.shared_hits,
+                    "shared_rate": f.shared_rate,
+                    "decoys_due": f.decoys_due,
+                    "decoys_carried": f.decoys_carried,
+                    "decoy_rate": f.decoy_rate,
+                    "canary_pool_leaks": f.canary_pool_leaks,
+                    "evidence": f.evidence,
+                    "flagged": f.flagged,
+                    "flag_reasons": f.flag_reasons,
+                    "subset": f.subset,
+                    "follower": f.follower,
+                    "independence": f.independence,
+                    "insufficient": f.insufficient,
+                    "independence_ppm": entropy::independence_ppm(f),
+                    "weight": r.weights.get(n).copied().unwrap_or(0.0),
+                    "pool_clustered": pool_clustered(r.pool_cluster.contains(n), f),
+                    "in_pool_cluster": r.pool_cluster.contains(n),
+                    "blocks": gw_blocks.get(n.as_str()).copied().unwrap_or(0),
+                    "house": key.is_some_and(|k| k.house),
+                    "registered": key.is_some(),
+                }),
+            )
+        })
+        .collect();
+    let s = &r.score;
+    let mut body = json!({
+        "mode": inp.mode.as_str(),
+        "published": inp.mode == SovereigntyMode::Publish,
+        "computed_at": r.computed_at,
+        "compute_ms": r.compute_ms,
+        "recompute_secs": inp.recompute_secs,
+        "store": {"keys": inp.tracks.len(), "snapshots": snapshots, "bytes": bytes},
+        "observed": inp.blocks.len(),
+        "bonus": {
+            "on": inp.bonus_on,
+            "bps": inp.params.bonus_bps,
+            "effective_bps": inp.params.effective_bonus_bps(),
+            "diff_bps": inp.params.diff_bps,
+            "cap_per_gateway_bps": inp.params.cap_per_gateway_bps,
+            "min_key_age_secs": inp.min_key_age_secs,
+            "sample": null,
+        },
+        "score": {
+            "blocks": s.blocks,
+            "claimed": s.claimed,
+            "verified": s.verified,
+            "verified_share": s.verified_share,
+            "score": s.score,
+            "builders": s.builders,
+            "effective_builders": s.effective_builders,
+            "top_builder_share": s.top_builder_share,
+            "template_nakamoto": s.template_nakamoto,
+        },
+        "gateways": gateways,
+        "clusters": r.clusters,
+        "flagged": r.rows.iter().filter(|(_, f)| f.flagged).map(|(n, _)| n).collect::<Vec<_>>(),
+        "demo": inp.demo,
+    });
+    // W11: who earns what, and payout addresses, only when there is a bonus to explain. Node
+    // addresses never appear here.
+    if inp.bonus_on {
+        body["authored"] = json!(inp
+            .authored
+            .iter()
+            .map(|a| json!({
+                "identity": a.identity,
+                "gateway": a.gateway,
+                "work": a.work,
+                "independence_ppm": a.independence_ppm,
+            }))
+            .collect::<Vec<_>>());
+        let mut dir: Vec<&KeyRecord> = inp.keys.values().collect();
+        dir.sort_by(|a, b| a.g.cmp(&b.g));
+        body["directory"] = json!(dir
+            .iter()
+            .map(|k| json!({
+                "g": k.g, "payout": k.payout, "first_seen": k.first_seen, "house": k.house,
+            }))
+            .collect::<Vec<_>>());
+    }
+    body
+}
