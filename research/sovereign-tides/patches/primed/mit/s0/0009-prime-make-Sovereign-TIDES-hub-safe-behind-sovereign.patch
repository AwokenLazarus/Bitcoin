+/// `Shared::sovereignty`: the mode, the engine and the last report.
+pub struct Sovereignty {
+    pub mode: SovereigntyMode,
+    pub recompute: Duration,
+    /// `sovereignty-demo`: reads rerun a stale pass (under the engine lock).
+    demo: bool,
+    token: String,
+    engine: Mutex<Engine>,
+    report: RwLock<Arc<Report>>,
+}
+
+impl Sovereignty {
+    pub fn from_config(cfg: &Config) -> Self {
+        let mode = cfg.sovereignty_mode;
+        let (engine, token) = if mode == SovereigntyMode::Off {
+            (Engine::default(), String::new())
+        } else {
+            (Engine::from_config(cfg), load_or_make_token(&cfg.data_dir))
+        };
+        let s = Sovereignty {
+            mode,
+            recompute: Duration::from_secs(cfg.sovereignty_recompute_secs.max(1)),
+            demo: mode != SovereigntyMode::Off && cfg.sovereignty_demo,
+            token,
+            engine: Mutex::new(engine),
+            report: RwLock::new(Arc::new(Report::default())),
+        };
+        if s.on() {
+            s.recompute_now();
+        }
+        s
+    }
+
+    pub fn on(&self) -> bool {
+        self.mode != SovereigntyMode::Off
+    }
+
+    pub fn engine(&self) -> MutexGuard<'_, Engine> {
+        self.engine.lock().unwrap()
+    }
+
+    /// The last detector pass. With `sovereignty-demo` on, a pass is run first if anything
+    /// changed since the last one, so a demo reads what it just posted.
+    pub fn report(&self) -> Arc<Report> {
+        let fresh = self.demo.then(|| {
+            let mut e = self.engine();
+            e.dirty.then(|| e.refresh())
+        });
+        match fresh.flatten() {
+            Some(r) => {
+                *self.report.write().unwrap() = r.clone();
+                r
+            }
+            None => self.report.read().unwrap().clone(),
+        }
+    }
+
+    /// One background pass: copy the inputs under the engine lock (no ledger lock), compute
+    /// without any lock, publish.
+    pub fn recompute_now(&self) -> Arc<Report> {
+        let inputs = self.engine().inputs(now());
+        let r = Arc::new(compute(&inputs));
+        self.engine().set_report(r.clone());
+        *self.report.write().unwrap() = r.clone();
+        r
+    }
+
+    /// Does the request carry the local token? Compared in constant time.
+    pub fn token_ok(&self, presented: Option<&str>) -> bool {
+        let Some(p) = presented else { return false };
+        let (a, b) = (self.token.as_bytes(), p.trim().as_bytes());
+        !a.is_empty() && a.len() == b.len() && a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+    }
+}
+
+/// The background detector pass, every `sovereignty-recompute-secs`.
+pub async fn recompute_loop(shared: Arc<crate::state::Shared>) {
+    loop {
+        tokio::time::sleep(shared.sovereignty.recompute).await;
+        let s = shared.clone();
+        match tokio::task::spawn_blocking(move || s.sovereignty.recompute_now()).await {
+            Ok(r) => log::debug!("sovereignty: detector pass in {} ms", r.compute_ms),
+            Err(e) => log::error!("sovereignty: detector pass failed: {e}"),
+        }
+    }
+}
+
+fn load_or_make_token(dir: &std::path::Path) -> String {
+    let path = dir.join(TOKEN_FILE);
+    if let Ok(t) = std::fs::read_to_string(&path) {
+        let t = t.trim().to_string();
+        if t.len() >= 32 {
+            return t;
+        }
+    }
+    use rand_core::{OsRng, RngCore};
+    let mut b = [0u8; 32];
+    OsRng.fill_bytes(&mut b);
+    let t = hex::encode(b);
+    let _ = std::fs::create_dir_all(dir);
+    let mut opts = std::fs::OpenOptions::new();
+    opts.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        opts.mode(0o600);
+    }
+    match opts.open(&path).and_then(|mut f| f.write_all(t.as_bytes())) {
+        Ok(()) => log::info!("sovereignty: wrote the ingest token to {}", path.display()),
+        Err(e) => log::warn!("sovereignty: cannot write {}: {e}; ingest is closed until it can", path.display()),
+    }
+    t
+}
