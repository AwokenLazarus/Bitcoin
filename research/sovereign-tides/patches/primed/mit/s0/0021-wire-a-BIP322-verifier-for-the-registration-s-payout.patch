+#[test]
+fn official_generated() {
+    let v: Value = serde_json::from_str(GENERATED).unwrap();
+    let (mut valid, mut inconclusive) = (0, 0);
+    for section in ["simple", "full"] {
+        for c in v[section].as_array().unwrap() {
+            let kind = c["type"].as_str().unwrap();
+            let challenge = script_of(c["address"].as_str().unwrap());
+            for sig in c["bip322_signatures"].as_array().unwrap() {
+                let r = bip322::verify(&challenge, c["message"].as_str().unwrap().as_bytes(), sig.as_str().unwrap(), Options::default());
+                if unsupported(kind) {
+                    assert!(matches!(r, Verdict::Inconclusive(_)), "{section} {kind}: {r:?}");
+                    inconclusive += 1;
+                    continue;
+                }
+                let Verdict::Valid(ok) = r else { panic!("{section} {kind}: {r:?}") };
+                if section == "full" {
+                    // valid at time T and age S
+                    assert_eq!(ok.format, Format::Full);
+                    assert_eq!(u64::from(ok.lock_time), c["lock_time"].as_u64().unwrap(), "{kind}");
+                    assert_eq!(u64::from(ok.sequence), c["sequence"].as_u64().unwrap(), "{kind}");
+                    assert!(!ok.untimed());
+                } else {
+                    assert_eq!(ok.format, Format::Simple);
+                }
+                valid += 1;
+            }
+        }
+    }
+    assert_eq!((valid, inconclusive), (12, 2));
+    for c in v["proof_of_funds"].as_array().unwrap() {
+        let challenge = script_of(c["address"].as_str().unwrap());
+        for sig in c["bip322_signatures"].as_array().unwrap() {
+            let r = bip322::verify(&challenge, c["message"].as_str().unwrap().as_bytes(), sig.as_str().unwrap(), Options::default());
+            assert!(matches!(r, Verdict::Inconclusive(_)), "pof: {r:?}");
+        }
+    }
+    let mut errors = 0;
+    for c in v["error"].as_array().unwrap() {
+        let d = c["description"].as_str().unwrap();
+        let r = bip322::verify(
+            &script_of(c["address"].as_str().unwrap()),
+            c["message"].as_str().unwrap().as_bytes(),
+            c["signature"].as_str().unwrap(),
+            Options::default(),
+        );
+        if unsupported(d) {
+            assert!(!r.is_valid(), "{d}: {r:?}");
+        } else {
+            let want = c["error_substr"].as_str().unwrap();
+            assert!(matches!(r, Verdict::Invalid(ref e) if e.contains(want)), "{d}: {r:?} (want {want})");
+        }
+        errors += 1;
+    }
+    assert_eq!(errors, 28);
+}
+
+/// The XBT vectors: signed by an XBT Knots node's wallet (`signrawtransactionwithwallet` on
+/// `to_sign`, and `signmessage` for the legacy one), for regtest addresses.
+#[test]
+fn xbt_vectors() {
+    let v: Value = serde_json::from_str(XBT).unwrap();
+    let mut seen = std::collections::BTreeSet::new();
+    for c in v["bip322"].as_array().unwrap() {
+        let name = c["name"].as_str().unwrap();
+        let challenge = script_of(c["address"].as_str().unwrap());
+        let unified = c["unified"].as_bool().unwrap_or(false);
+        let r = bip322::verify(&challenge, c["message"].as_str().unwrap().as_bytes(), c["signature"].as_str().unwrap(), Options::default());
+        let r_unified = bip322::verify(
+            &challenge,
+            c["message"].as_str().unwrap().as_bytes(),
+            c["signature"].as_str().unwrap(),
+            Options { unified_sighash: true },
+        );
+        match c["expect"].as_str().unwrap() {
+            "valid" if unified => {
+                assert!(!r.is_valid(), "{name}: 0x21 accepted without the option");
+                assert_eq!(r_unified.is_valid(), cfg!(feature = "unified-sighash"), "{name}: {r_unified:?}");
+            }
+            "valid" => {
+                let Verdict::Valid(ok) = &r else { panic!("{name}: {r:?}") };
+                assert_eq!(ok.kind.name(), c["type"].as_str().unwrap(), "{name}");
+            }
+            "invalid" => assert!(matches!(r, Verdict::Invalid(_)), "{name}: {r:?}"),
+            other => panic!("{name}: expect {other}"),
+        }
+        seen.insert(c["type"].as_str().unwrap().to_string());
+    }
+    for kind in ["p2wpkh", "p2tr", "p2wsh", "p2sh-p2wpkh", "p2pkh"] {
+        assert!(seen.contains(kind), "no XBT vector for {kind}");
+    }
+}
