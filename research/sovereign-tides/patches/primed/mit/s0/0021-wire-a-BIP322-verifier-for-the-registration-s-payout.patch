+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn base64_round_trip_and_strictness() {
+        for n in 0..40u8 {
+            let b: Vec<u8> = (0..n).map(|i| i.wrapping_mul(37)).collect();
+            assert_eq!(base64_decode(&base64_encode(&b)).unwrap(), b);
+        }
+        assert!(base64_decode("not-valid-base64!!!").is_none());
+        assert!(base64_decode("fooAA==").is_none());
+        assert!(base64_decode("AB==").is_none(), "non-zero bits under padding");
+        assert!(base64_decode("A===").is_none());
+    }
+
+    #[test]
+    fn signer_round_trips() {
+        let sk = [7u8; 32];
+        let m = b"LZT1 register v2";
+        let o = Options { unified_sighash: true };
+        let cases: Vec<(Vec<u8>, String, Kind)> = vec![
+            (signer::p2wpkh_script(&sk), signer::simple_p2wpkh(&sk, m, SIGHASH_ALL), Kind::P2wpkh),
+            (signer::p2wsh_pk_script(&sk), signer::simple_p2wsh_pk(&sk, m), Kind::P2wsh),
+            (signer::p2tr_script(&sk), signer::simple_p2tr(&sk, m, 0x00), Kind::P2tr),
+            (signer::p2tr_script(&sk), signer::simple_p2tr(&sk, m, SIGHASH_ALL), Kind::P2tr),
+            (signer::p2sh_p2wpkh_script(&sk), signer::full_p2sh_p2wpkh(&sk, m), Kind::P2shP2wpkh),
+            (signer::p2pkh_script_of(&sk), signer::full_p2pkh(&sk, m), Kind::P2pkh),
+        ];
+        for (challenge, sig, kind) in cases {
+            match verify(&challenge, m, &sig, o) {
+                Verdict::Valid(v) => assert_eq!(v.kind, kind),
+                other => panic!("{kind:?}: {other:?}"),
+            }
+            assert!(!verify(&challenge, b"other", &sig, o).is_valid(), "{kind:?} wrong message");
+            assert!(!verify(&signer::p2wpkh_script(&[8u8; 32]), m, &sig, o).is_valid(), "{kind:?} wrong key");
+        }
+    }
+
+    #[test]
+    fn unified_sighash_is_behind_the_feature_and_the_option() {
+        let sk = [9u8; 32];
+        let m = b"shrike";
+        for (challenge, sig) in [
+            (signer::p2wpkh_script(&sk), signer::simple_p2wpkh(&sk, m, SIGHASH_ALL_UNIFIED)),
+            (signer::p2tr_script(&sk), signer::simple_p2tr(&sk, m, SIGHASH_ALL_UNIFIED)),
+        ] {
+            assert!(!verify(&challenge, m, &sig, Options::default()).is_valid(), "0x21 without the option");
+            let with = verify(&challenge, m, &sig, Options { unified_sighash: true });
+            if cfg!(feature = "unified-sighash") {
+                assert!(matches!(with, Verdict::Valid(Valid { unified: true, .. })), "{with:?}");
+            } else {
+                assert!(!with.is_valid(), "0x21 without the feature");
+            }
+        }
+    }
+
+    #[test]
+    fn simple_is_for_native_segwit_only() {
+        // a P2PKH challenge given a simple witness: no scriptSig, so it cannot verify
+        let sk = [3u8; 32];
+        let wit = signer::simple_p2wpkh(&sk, b"m", SIGHASH_ALL);
+        assert!(!verify(&signer::p2pkh_script_of(&sk), b"m", &wit, Options::default()).is_valid());
+    }
+
+    #[test]
+    fn high_s_and_non_der_are_invalid() {
+        let sk = [5u8; 32];
+        let challenge = signer::p2wpkh_script(&sk);
+        let sig = signer::simple_p2wpkh(&sk, b"m", SIGHASH_ALL);
+        let mut w = parse_witness(&base64_decode(&sig[3..]).unwrap()).unwrap();
+        // flip S to n - S
+        let der = &w[0][..w[0].len() - 1];
+        let mut s = ecdsa::Signature::from_der(der).unwrap().serialize_compact();
+        let n = hex::decode("FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141").unwrap();
+        let mut borrow = 0i32;
+        for i in (0..32).rev() {
+            let v = n[i] as i32 - s[32 + i] as i32 - borrow;
+            s[32 + i] = v.rem_euclid(256) as u8;
+            borrow = (v < 0) as i32;
+        }
+        let high = ecdsa::Signature::from_compact(&s).unwrap();
+        let mut hs = high.serialize_der().to_vec();
+        hs.push(SIGHASH_ALL);
+        w[0] = hs;
+        let forged = format!("smp{}", base64_encode(&serialize_witness(&w)));
+        assert!(matches!(verify(&challenge, b"m", &forged, Options::default()), Verdict::Invalid(e) if e.contains("LOW_S")));
+    }
+}
