+//! The official BIP322 test vectors (bitcoin/bips `bip-0322/*.json`), then the XBT ones
+//! (`bip322-xbt-vectors.json`: made on an XBT Knots regtest node by `gen_xbt_vectors.py`,
+//! SOV-009). XBT addresses use Bitcoin's encodings, so the official vectors apply as they are.
+
+use datum_wire::bip322::{self, Format, Options, Verdict};
+use serde_json::Value;
+
+const BASIC: &str = include_str!("data/bip322-basic-test-vectors.json");
+const GENERATED: &str = include_str!("data/bip322-generated-test-vectors.json");
+const XBT: &str = include_str!("data/bip322-xbt-vectors.json");
+
+/// scriptPubKey of a mainnet/testnet/regtest address.
+fn script_of(addr: &str) -> Vec<u8> {
+    if let Ok((_hrp, ver, prog)) = bech32::segwit::decode(addr) {
+        let v = ver.to_u8();
+        let mut s = vec![if v == 0 { 0 } else { 0x50 + v }, prog.len() as u8];
+        s.extend_from_slice(&prog);
+        return s;
+    }
+    let b = bs58::decode(addr).with_check(None).into_vec().expect("address");
+    match b[0] {
+        0x00 | 0x6f => [&[0x76, 0xa9, 0x14][..], &b[1..], &[0x88, 0xac]].concat(),
+        0x05 | 0xc4 => [&[0xa9, 0x14][..], &b[1..], &[0x87]].concat(),
+        v => panic!("version {v}"),
+    }
+}
+
+/// Needs an interpreter the verifier does not have, so inconclusive (never accepted).
+fn unsupported(kind: &str) -> bool {
+    kind.contains("time-lock")
+}
+
+#[test]
+fn official_basic_tx_hashes() {
+    let v: Value = serde_json::from_str(BASIC).unwrap();
+    for c in v["tx_hashes"].as_array().unwrap() {
+        let msg = c["message"].as_str().unwrap().as_bytes();
+        let challenge = script_of(c["address"].as_str().unwrap());
+        assert_eq!(hex::encode(bip322::message_hash(msg)), c["message_hash"].as_str().unwrap());
+        let spend = bip322::to_spend(&challenge, msg);
+        assert_eq!(spend.txid_hex(), c["to_spend_tx_hash"].as_str().unwrap());
+        assert_eq!(bip322::to_sign(&spend).txid_hex(), c["to_sign_tx_hash"].as_str().unwrap());
+    }
+}
+
+#[test]
+fn official_basic_simple_and_errors() {
+    let v: Value = serde_json::from_str(BASIC).unwrap();
+    let mut n = 0;
+    for c in v["simple"].as_array().unwrap() {
+        let challenge = script_of(c["address"].as_str().unwrap());
+        for sig in c["bip322_signatures"].as_array().unwrap() {
+            let r = bip322::verify(&challenge, c["message"].as_str().unwrap().as_bytes(), sig.as_str().unwrap(), Options::default());
+            assert!(matches!(r, Verdict::Valid(ref ok) if ok.format == Format::Simple && ok.untimed()), "{}: {r:?}", c["type"]);
+            n += 1;
+        }
+    }
+    assert_eq!(n, 6);
+    for c in v["error"].as_array().unwrap() {
+        let r = bip322::verify(
+            &script_of(c["address"].as_str().unwrap()),
+            c["message"].as_str().unwrap().as_bytes(),
+            c["signature"].as_str().unwrap(),
+            Options::default(),
+        );
+        let want = c["error_substr"].as_str().unwrap();
+        assert!(matches!(r, Verdict::Invalid(ref e) if e.contains(want)), "{}: {r:?} (want {want})", c["description"]);
+    }
+}
