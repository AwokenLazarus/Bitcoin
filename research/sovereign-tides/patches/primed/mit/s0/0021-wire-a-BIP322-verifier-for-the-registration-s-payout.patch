+//! BIP322 generic signed messages: the verifier registration v2 checks the payout owner's
+//! consent with (SOV-P-002 §4.2).
+//!
+//! The verifier has no general script interpreter. It knows the standard templates and says
+//! [`Verdict::Inconclusive`] for anything else, as BIP322 allows a validator without a full
+//! interpreter to do; an inconclusive proof is never accepted.
+//!
+//! | challenge | formats | checked as |
+//! |---|---|---|
+//! | P2WPKH | simple, full | BIP143, SIGHASH_ALL |
+//! | P2TR, key path | simple, full | BIP341, SIGHASH_DEFAULT or SIGHASH_ALL |
+//! | P2WSH: `<pk> CHECKSIG`, `DUP HASH160 <h> EQUALVERIFY CHECKSIG`, bare m-of-n multisig | simple, full | BIP143 |
+//! | P2SH-P2WPKH, P2SH-P2WSH (same witness scripts) | full | BIP143 |
+//! | P2SH with a bare redeem script of the same kinds | full | legacy |
+//! | P2PKH | full | legacy |
+//!
+//! Taproot script paths, annexes, timelock scripts, witness versions above 1 and proof of
+//! funds (`pof`) are inconclusive. The legacy `signmessage` format (P2PKH only) is not here:
+//! Prime checks it with the pool node's `verifymessage`.
+//!
+//! BIP322's to_spend/to_sign are never valid on chain, so standard BIP143/BIP341 sighashes
+//! are what a signature is checked under. With the `unified-sighash` feature, and
+//! [`Options::unified_sighash`], a signature whose hash type is `0x21` (SIGHASH_ALL |
+//! SIGHASH_UNIFIED, Knots `UnifiedSighash`, what Shrike signs with on XBT) is checked under
+//! that message instead.
+//!
+//! XBT addresses use Bitcoin's encodings (`bc`/`tb`/`bcrt`, the same base58 versions), so
+//! the verifier takes the challenge as a scriptPubKey and callers decode addresses as usual.
+
+use bitcoin_hashes::{ripemd160, sha256, Hash as _};
+use secp256k1::{ecdsa, schnorr, Message, PublicKey, Secp256k1, XOnlyPublicKey};
+
+/// BIP340 tag of the message hash.
+pub const MESSAGE_TAG: &[u8] = b"BIP0322-signed-message";
+
+/// SIGHASH_ALL.
+const SIGHASH_ALL: u8 = 0x01;
+/// SIGHASH_ALL | SIGHASH_UNIFIED (Knots).
+pub const SIGHASH_ALL_UNIFIED: u8 = 0x21;
+
+const OP_0: u8 = 0x00;
+const OP_PUSHDATA1: u8 = 0x4c;
+const OP_PUSHDATA2: u8 = 0x4d;
+const OP_PUSHDATA4: u8 = 0x4e;
+const OP_1NEGATE: u8 = 0x4f;
+const OP_1: u8 = 0x51;
+const OP_16: u8 = 0x60;
+const OP_RETURN: u8 = 0x6a;
+const OP_DUP: u8 = 0x76;
+const OP_EQUAL: u8 = 0x87;
+const OP_EQUALVERIFY: u8 = 0x88;
+const OP_HASH160: u8 = 0xa9;
+const OP_CODESEPARATOR: u8 = 0xab;
+const OP_CHECKSIG: u8 = 0xac;
+const OP_CHECKMULTISIG: u8 = 0xae;
+
+// ---------------------------------------------------------------------------------------
+// Transactions
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TxIn {
+    /// Internal byte order (as serialized), not the displayed hex.
+    pub prev_txid: [u8; 32],
+    pub vout: u32,
+    pub script_sig: Vec<u8>,
+    pub sequence: u32,
+    pub witness: Vec<Vec<u8>>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TxOut {
+    pub value: u64,
+    pub script: Vec<u8>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Tx {
+    pub version: u32,
+    pub inputs: Vec<TxIn>,
+    pub outputs: Vec<TxOut>,
+    pub lock_time: u32,
+}
+
+fn compact_size(out: &mut Vec<u8>, n: usize) {
+    match n {
+        0..=0xfc => out.push(n as u8),
+        0xfd..=0xffff => {
+            out.push(0xfd);
+            out.extend_from_slice(&(n as u16).to_le_bytes());
+        }
+        0x1_0000..=0xffff_ffff => {
+            out.push(0xfe);
+            out.extend_from_slice(&(n as u32).to_le_bytes());
+        }
+        _ => {
+            out.push(0xff);
+            out.extend_from_slice(&(n as u64).to_le_bytes());
+        }
+    }
+}
+
+fn var_bytes(out: &mut Vec<u8>, b: &[u8]) {
+    compact_size(out, b.len());
+    out.extend_from_slice(b);
+}
+
+fn ser_output(out: &mut Vec<u8>, o: &TxOut) {
+    out.extend_from_slice(&o.value.to_le_bytes());
+    var_bytes(out, &o.script);
+}
+
+impl Tx {
+    /// Consensus serialization; with `witness`, BIP144 when any input has one.
+    pub fn serialize(&self, witness: bool) -> Vec<u8> {
+        let segwit = witness && self.inputs.iter().any(|i| !i.witness.is_empty());
+        let mut out = Vec::with_capacity(128);
+        out.extend_from_slice(&self.version.to_le_bytes());
+        if segwit {
+            out.extend_from_slice(&[0x00, 0x01]);
+        }
+        compact_size(&mut out, self.inputs.len());
+        for i in &self.inputs {
+            out.extend_from_slice(&i.prev_txid);
+            out.extend_from_slice(&i.vout.to_le_bytes());
+            var_bytes(&mut out, &i.script_sig);
+            out.extend_from_slice(&i.sequence.to_le_bytes());
+        }
+        compact_size(&mut out, self.outputs.len());
+        for o in &self.outputs {
+            ser_output(&mut out, o);
+        }
+        if segwit {
+            for i in &self.inputs {
+                compact_size(&mut out, i.witness.len());
+                for item in &i.witness {
+                    var_bytes(&mut out, item);
+                }
+            }
+        }
+        out.extend_from_slice(&self.lock_time.to_le_bytes());
+        out
+    }
+
+    /// Txid in internal byte order.
+    pub fn txid(&self) -> [u8; 32] {
+        dsha256(&self.serialize(false))
+    }
+
+    /// Txid as block explorers show it.
+    pub fn txid_hex(&self) -> String {
+        let mut t = self.txid();
+        t.reverse();
+        hex::encode(t)
+    }
+
+    /// Parse a whole transaction; trailing bytes are an error.
+    pub fn parse(b: &[u8]) -> Result<Tx, String> {
+        let mut r = Reader { b, at: 0 };
+        let version = r.u32()?;
+        let mut n_in = r.compact()?;
+        let mut segwit = false;
+        if n_in == 0 {
+            // BIP144 marker, then the flag
+            if r.u8()? != 0x01 {
+                return Err("bad segwit flag".into());
+            }
+            segwit = true;
+            n_in = r.compact()?;
+        }
+        if n_in > 10_000 {
+            return Err("too many inputs".into());
+        }
+        let mut inputs = Vec::with_capacity(n_in);
+        for _ in 0..n_in {
+            let prev_txid: [u8; 32] = r.take(32)?.try_into().unwrap();
+            let vout = r.u32()?;
+            let script_sig = r.var_bytes()?.to_vec();
+            let sequence = r.u32()?;
+            inputs.push(TxIn { prev_txid, vout, script_sig, sequence, witness: Vec::new() });
+        }
+        let n_out = r.compact()?;
+        if n_out > 10_000 {
+            return Err("too many outputs".into());
+        }
+        let mut outputs = Vec::with_capacity(n_out);
+        for _ in 0..n_out {
+            let value = r.u64()?;
+            let script = r.var_bytes()?.to_vec();
+            outputs.push(TxOut { value, script });
+        }
+        if segwit {
+            for i in inputs.iter_mut() {
+                i.witness = r.witness_stack()?;
+            }
+            if inputs.iter().all(|i| i.witness.is_empty()) {
+                return Err("superfluous segwit marker".into());
+            }
+        }
+        let lock_time = r.u32()?;
+        if r.at != b.len() {
+            return Err("trailing bytes".into());
+        }
+        Ok(Tx { version, inputs, outputs, lock_time })
+    }
+}
+
+struct Reader<'a> {
+    b: &'a [u8],
+    at: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], String> {
+        let end = self.at.checked_add(n).filter(|&e| e <= self.b.len()).ok_or("truncated")?;
+        let s = &self.b[self.at..end];
+        self.at = end;
+        Ok(s)
+    }
+    fn u8(&mut self) -> Result<u8, String> {
+        Ok(self.take(1)?[0])
+    }
+    fn u32(&mut self) -> Result<u32, String> {
+        Ok(u32::from_le_bytes(self.take(4)?.try_into().unwrap()))
+    }
+    fn u64(&mut self) -> Result<u64, String> {
+        Ok(u64::from_le_bytes(self.take(8)?.try_into().unwrap()))
+    }
+    /// Canonical compact size, bounded by what is left to read.
+    fn compact(&mut self) -> Result<usize, String> {
+        let n = match self.u8()? {
+            0xfd => {
+                let v = u16::from_le_bytes(self.take(2)?.try_into().unwrap()) as u64;
+                if v < 0xfd {
+                    return Err("non-canonical compact size".into());
+                }
+                v
+            }
+            0xfe => {
+                let v = u32::from_le_bytes(self.take(4)?.try_into().unwrap()) as u64;
+                if v <= 0xffff {
+                    return Err("non-canonical compact size".into());
+                }
+                v
+            }
+            0xff => {
+                let v = self.u64()?;
+                if v <= 0xffff_ffff {
+                    return Err("non-canonical compact size".into());
+                }
+                v
+            }
+            v => v as u64,
+        };
+        if n > (self.b.len() - self.at) as u64 + 1 {
+            return Err("length past the end".into());
+        }
+        Ok(n as usize)
+    }
+    fn var_bytes(&mut self) -> Result<&'a [u8], String> {
+        let n = self.compact()?;
+        self.take(n)
+    }
+    fn witness_stack(&mut self) -> Result<Vec<Vec<u8>>, String> {
+        let n = self.compact()?;
+        let mut items = Vec::with_capacity(n.min(64));
+        for _ in 0..n {
+            items.push(self.var_bytes()?.to_vec());
+        }
+        Ok(items)
+    }
+}
+
+/// Decode a consensus-encoded witness stack (a *simple* signature), all bytes used.
+pub fn parse_witness(b: &[u8]) -> Result<Vec<Vec<u8>>, String> {
+    let mut r = Reader { b, at: 0 };
+    let w = r.witness_stack()?;
+    if r.at != b.len() {
+        return Err("trailing bytes".into());
+    }
+    Ok(w)
+}
+
+pub fn serialize_witness(stack: &[Vec<u8>]) -> Vec<u8> {
+    let mut out = Vec::new();
+    compact_size(&mut out, stack.len());
+    for item in stack {
+        var_bytes(&mut out, item);
+    }
+    out
+}
+
+// ---------------------------------------------------------------------------------------
+// Hashes
+
+pub fn sha256(b: &[u8]) -> [u8; 32] {
+    sha256::Hash::hash(b).to_byte_array()
+}
+
+pub fn dsha256(b: &[u8]) -> [u8; 32] {
+    sha256(&sha256(b))
+}
+
+pub fn hash160(b: &[u8]) -> [u8; 20] {
+    ripemd160::Hash::hash(&sha256(b)).to_byte_array()
+}
+
+/// BIP340 tagged hash.
+pub fn tagged_hash(tag: &[u8], msg: &[u8]) -> [u8; 32] {
+    let t = sha256(tag);
+    let mut pre = Vec::with_capacity(64 + msg.len());
+    pre.extend_from_slice(&t);
+    pre.extend_from_slice(&t);
+    pre.extend_from_slice(msg);
+    sha256(&pre)
+}
+
+pub fn message_hash(message: &[u8]) -> [u8; 32] {
+    tagged_hash(MESSAGE_TAG, message)
+}
+
+// ---------------------------------------------------------------------------------------
+// to_spend / to_sign
+
+pub fn to_spend(challenge: &[u8], message: &[u8]) -> Tx {
+    let mut script_sig = vec![OP_0, 0x20];
+    script_sig.extend_from_slice(&message_hash(message));
+    Tx {
+        version: 0,
+        inputs: vec![TxIn { prev_txid: [0; 32], vout: 0xffff_ffff, script_sig, sequence: 0, witness: Vec::new() }],
+        outputs: vec![TxOut { value: 0, script: challenge.to_vec() }],
+        lock_time: 0,
+    }
+}
+
+/// The unsigned `to_sign` for a `to_spend`, with the default (simple) field values.
+pub fn to_sign(to_spend: &Tx) -> Tx {
+    Tx {
+        version: 0,
+        inputs: vec![TxIn {
+            prev_txid: to_spend.txid(),
+            vout: 0,
+            script_sig: Vec::new(),
+            sequence: 0,
+            witness: Vec::new(),
+        }],
+        outputs: vec![TxOut { value: 0, script: vec![OP_RETURN] }],
+        lock_time: 0,
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Base64 (standard alphabet, padded)
+
+const B64: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+pub fn base64_encode(b: &[u8]) -> String {
+    let mut out = String::with_capacity(b.len().div_ceil(3) * 4);
+    for c in b.chunks(3) {
+        let n = (u32::from(c[0]) << 16) | (u32::from(*c.get(1).unwrap_or(&0)) << 8) | u32::from(*c.get(2).unwrap_or(&0));
+        for k in 0..4 {
+            if k <= c.len() {
+                out.push(B64[((n >> (18 - 6 * k)) & 63) as usize] as char);
+            } else {
+                out.push('=');
+            }
+        }
+    }
+    out
+}
+
+pub fn base64_decode(s: &str) -> Option<Vec<u8>> {
+    let s = s.as_bytes();
+    if s.len() % 4 != 0 {
+        return None;
+    }
+    let val = |c: u8| B64.iter().position(|&x| x == c).map(|v| v as u32);
+    let mut out = Vec::with_capacity(s.len() / 4 * 3);
+    for (i, q) in s.chunks(4).enumerate() {
+        let last = i + 1 == s.len() / 4;
+        let pad = q.iter().rev().take_while(|&&c| c == b'=').count();
+        if pad > 2 || (pad > 0 && !last) {
+            return None;
+        }
+        let mut n = 0u32;
+        for &c in &q[..4 - pad] {
+            n = (n << 6) | val(c)?;
+        }
+        n <<= 6 * pad as u32;
+        let bytes = [(n >> 16) as u8, (n >> 8) as u8, n as u8];
+        // non-zero bits under the padding are not canonical
+        if (pad == 1 && bytes[2] != 0) || (pad == 2 && (bytes[1] != 0 || bytes[2] != 0)) {
+            return None;
+        }
+        out.extend_from_slice(&bytes[..3 - pad]);
+    }
+    Some(out)
+}
+
+// ---------------------------------------------------------------------------------------
+// Verdicts
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Format {
+    Simple,
+    Full,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    P2pkh,
+    P2shP2wpkh,
+    P2shP2wsh,
+    P2sh,
+    P2wpkh,
+    P2wsh,
+    P2tr,
+}
+
+impl Kind {
+    pub fn name(self) -> &'static str {
+        match self {
+            Kind::P2pkh => "p2pkh",
+            Kind::P2shP2wpkh => "p2sh-p2wpkh",
+            Kind::P2shP2wsh => "p2sh-p2wsh",
+            Kind::P2sh => "p2sh",
+            Kind::P2wpkh => "p2wpkh",
+            Kind::P2wsh => "p2wsh",
+            Kind::P2tr => "p2tr",
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Valid {
+    pub format: Format,
+    pub kind: Kind,
+    /// BIP322 "valid at time T and age S": `to_sign`'s nLockTime and first nSequence.
+    pub lock_time: u32,
+    pub sequence: u32,
+    /// Some signature was checked under `UnifiedSighash` (0x21).
+    pub unified: bool,
+}
+
+impl Valid {
+    /// No timelock: nLockTime 0, and the first input's nSequence either 0 or with the
+    /// relative-lock disable bit set.
+    pub fn untimed(&self) -> bool {
+        self.lock_time == 0 && (self.sequence == 0 || self.sequence & (1 << 31) != 0)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Verdict {
+    Valid(Valid),
+    /// A check failed.
+    Invalid(String),
+    /// The verifier could not check the scripts (BIP322 "inconclusive"); never accepted.
+    Inconclusive(String),
+}
+
+impl Verdict {
+    pub fn is_valid(&self) -> bool {
+        matches!(self, Verdict::Valid(_))
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Options {
+    /// Accept `0x21` (SIGHASH_ALL | SIGHASH_UNIFIED) signatures. Only honoured when built
+    /// with the `unified-sighash` feature.
+    pub unified_sighash: bool,
+}
+
+enum Fail {
+    Invalid(String),
+    Inconclusive(String),
+}
+
+fn invalid<T>(why: &str) -> Result<T, Fail> {
+    Err(Fail::Invalid(format!("invalid signature: {why}")))
+}
+
+fn inconclusive<T>(why: &str) -> Result<T, Fail> {
+    Err(Fail::Inconclusive(why.to_string()))
+}
+
+// ---------------------------------------------------------------------------------------
+// Verification
+
+/// Verify a BIP322 signature (`smp`/`ful`-prefixed, or unprefixed simple) by the owner of
+/// `challenge` (a scriptPubKey) over `message`.
+pub fn verify(challenge: &[u8], message: &[u8], signature: &str, opts: Options) -> Verdict {
+    let signature = signature.trim();
+    if signature.is_empty() {
+        return Verdict::Invalid("signature too short".into());
+    }
+    let (format, body) = if let Some(rest) = signature.strip_prefix("smp") {
+        (Format::Simple, rest)
+    } else if let Some(rest) = signature.strip_prefix("ful") {
+        (Format::Full, rest)
+    } else if signature.starts_with("pof") {
+        return Verdict::Inconclusive("proof of funds (pof) is not supported".into());
+    } else {
+        // BIP322: before the prefixes, a signature was simple
+        (Format::Simple, signature)
+    };
+    let Some(raw) = base64_decode(body) else {
+        return Verdict::Invalid("error decoding signature as base64".into());
+    };
+    if raw.is_empty() {
+        return Verdict::Invalid("signature too short".into());
+    }
+    let spend = to_spend(challenge, message);
+    let tx = match format {
+        Format::Simple => {
+            let Ok(witness) = parse_witness(&raw) else {
+                return Verdict::Invalid("error parsing signature as simple variant (witness stack)".into());
+            };
+            let mut t = to_sign(&spend);
+            t.inputs[0].witness = witness;
+            t
+        }
+        Format::Full => {
+            let Ok(t) = Tx::parse(&raw) else {
+                return Verdict::Invalid("error parsing signature as full variant".into());
+            };
+            if let Err(e) = check_full_shape(&t, &spend) {
+                return fail_verdict(e);
+            }
+            t
+        }
+    };
+    match check_input(&tx, challenge, opts) {
+        Ok((kind, unified)) => {
+            if format == Format::Simple && !matches!(kind, Kind::P2wpkh | Kind::P2wsh | Kind::P2tr) {
+                return Verdict::Invalid("invalid signature: the simple format is for native segwit only".into());
+            }
+            Verdict::Valid(Valid {
+                format,
+                kind,
+                lock_time: tx.lock_time,
+                sequence: tx.inputs[0].sequence,
+                unified,
+            })
+        }
+        Err(e) => fail_verdict(e),
+    }
+}
+
+fn fail_verdict(f: Fail) -> Verdict {
+    match f {
+        Fail::Invalid(s) => Verdict::Invalid(s),
+        Fail::Inconclusive(s) => Verdict::Inconclusive(s),
+    }
+}
+
+/// A full `to_sign` is the template apart from version, nLockTime, nSequence and scriptSig.
+fn check_full_shape(t: &Tx, spend: &Tx) -> Result<(), Fail> {
+    if t.inputs.is_empty() {
+        return invalid("to_sign has no input");
+    }
+    if t.inputs[0].prev_txid != spend.txid() || t.inputs[0].vout != 0 {
+        return invalid("to_sign does not spend to_spend:0 (wrong message or address)");
+    }
+    if t.inputs.len() > 1 {
+        return inconclusive("to_sign has more inputs: that is a proof of funds (pof)");
+    }
+    if t.outputs.len() != 1 || t.outputs[0].value != 0 || t.outputs[0].script != [OP_RETURN] {
+        return invalid("to_sign must have exactly one output, 0 to OP_RETURN");
+    }
+    if t.version != 0 && t.version != 2 {
+        return inconclusive("to_sign version must be 0 or 2");
+    }
+    Ok(())
+}
+
+/// Input 0 of `tx` spends an output locked by `challenge` of value 0.
+fn check_input(tx: &Tx, challenge: &[u8], opts: Options) -> Result<(Kind, bool), Fail> {
+    let input = &tx.inputs[0];
+    let ctx = Ctx { tx, challenge, opts, unified: std::cell::Cell::new(false) };
+    let kind = match classify(challenge) {
+        Script::P2wpkh(h) => {
+            if !input.script_sig.is_empty() {
+                return invalid("native segwit input with a scriptSig");
+            }
+            ctx.p2wpkh(&h, &input.witness)?;
+            Kind::P2wpkh
+        }
+        Script::P2wsh(h) => {
+            if !input.script_sig.is_empty() {
+                return invalid("native segwit input with a scriptSig");
+            }
+            ctx.p2wsh(&h, &input.witness)?;
+            Kind::P2wsh
+        }
+        Script::P2tr(x) => {
+            if !input.script_sig.is_empty() {
+                return invalid("native segwit input with a scriptSig");
+            }
+            ctx.p2tr(&x, &input.witness)?;
+            Kind::P2tr
+        }
+        Script::P2pkh(h) => {
+            if !input.witness.is_empty() {
+                return invalid("witness on a legacy input");
+            }
+            let pushes = push_only(&input.script_sig)?;
+            if pushes.len() != 2 {
+                return invalid("P2PKH scriptSig must be <sig> <pubkey>");
+            }
+            let pk = &pushes[1];
+            check_pubkey(pk, false)?;
+            if hash160(pk) != h {
+                return invalid("public key does not match the address");
+            }
+            ctx.ecdsa(&pushes[0], pk, challenge, SigVersion::Base)?;
+            Kind::P2pkh
+        }
+        Script::P2sh(h) => {
+            let pushes = push_only(&input.script_sig)?;
+            let Some(redeem) = pushes.last() else { return invalid("P2SH input without a redeem script") };
+            if hash160(redeem) != h {
+                return invalid("redeem script does not match the address");
+            }
+            match classify(redeem) {
+                Script::P2wpkh(h) => {
+                    if pushes.len() != 1 {
+                        return invalid("P2SH-P2WPKH scriptSig must be the redeem script alone");
+                    }
+                    ctx.p2wpkh(&h, &input.witness)?;
+                    Kind::P2shP2wpkh
+                }
+                Script::P2wsh(h) => {
+                    if pushes.len() != 1 {
+                        return invalid("P2SH-P2WSH scriptSig must be the redeem script alone");
+                    }
+                    ctx.p2wsh(&h, &input.witness)?;
+                    Kind::P2shP2wsh
+                }
+                Script::WitnessOther => return inconclusive("P2SH-wrapped witness program the verifier does not know"),
+                _ => {
+                    if !input.witness.is_empty() {
+                        return invalid("witness on a legacy P2SH input");
+                    }
+                    ctx.eval(redeem, &pushes[..pushes.len() - 1], SigVersion::Base)?;
+                    Kind::P2sh
+                }
+            }
+        }
+        Script::WitnessOther => return inconclusive("witness version or program the verifier does not know"),
+        Script::Other => return inconclusive("scriptPubKey the verifier does not know"),
+    };
+    Ok((kind, ctx.unified.get()))
+}
+
+enum Script {
+    P2pkh([u8; 20]),
+    P2sh([u8; 20]),
+    P2wpkh([u8; 20]),
+    P2wsh([u8; 32]),
+    P2tr([u8; 32]),
+    WitnessOther,
+    Other,
+}
+
+fn classify(s: &[u8]) -> Script {
+    match s {
+        [OP_DUP, OP_HASH160, 0x14, h @ .., OP_EQUALVERIFY, OP_CHECKSIG] if h.len() == 20 => Script::P2pkh(h.try_into().unwrap()),
+        [OP_HASH160, 0x14, h @ .., OP_EQUAL] if h.len() == 20 => Script::P2sh(h.try_into().unwrap()),
+        [OP_0, 0x14, h @ ..] if h.len() == 20 => Script::P2wpkh(h.try_into().unwrap()),
+        [OP_0, 0x20, h @ ..] if h.len() == 32 => Script::P2wsh(h.try_into().unwrap()),
+        [OP_1, 0x20, x @ ..] if x.len() == 32 => Script::P2tr(x.try_into().unwrap()),
+        [v, n, p @ ..] if (*v == OP_0 || (OP_1..=OP_16).contains(v)) && (2..=40).contains(n) && p.len() == *n as usize => {
+            Script::WitnessOther
+        }
+        _ => Script::Other,
+    }
+}
+
+/// The pushes of a push-only script, each minimally encoded (MINIMALDATA).
+fn push_only(s: &[u8]) -> Result<Vec<Vec<u8>>, Fail> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < s.len() {
+        let op = s[i];
+        i += 1;
+        let data: Vec<u8> = match op {
+            OP_0 => Vec::new(),
+            0x01..=0x4b => {
+                let n = op as usize;
+                let d = s.get(i..i + n).ok_or(Fail::Invalid("invalid signature: truncated push".into()))?;
+                i += n;
+                d.to_vec()
+            }
+            OP_PUSHDATA1 | OP_PUSHDATA2 | OP_PUSHDATA4 => {
+                let w = match op {
+                    OP_PUSHDATA1 => 1,
+                    OP_PUSHDATA2 => 2,
+                    _ => 4,
+                };
+                let lb = s.get(i..i + w).ok_or(Fail::Invalid("invalid signature: truncated push".into()))?;
+                i += w;
+                let mut n = 0usize;
+                for (k, b) in lb.iter().enumerate() {
+                    n |= (*b as usize) << (8 * k);
+                }
+                let d = s.get(i..i + n).ok_or(Fail::Invalid("invalid signature: truncated push".into()))?;
+                i += n;
+                d.to_vec()
+            }
+            OP_1NEGATE => vec![0x81],
+            OP_1..=OP_16 => vec![op - OP_1 + 1],
+            _ => return invalid("scriptSig is not push-only"),
+        };
+        if !minimal_push(op, &data) {
+            return invalid("non-minimal push (MINIMALDATA)");
+        }
+        out.push(data);
+    }
+    Ok(out)
+}
+
+fn minimal_push(op: u8, d: &[u8]) -> bool {
+    match d.len() {
+        0 => op == OP_0,
+        1 if (1..=16).contains(&d[0]) => op == OP_1 + d[0] - 1,
+        1 if d[0] == 0x81 => op == OP_1NEGATE,
+        n if n <= 75 => op as usize == n,
+        n if n <= 255 => op == OP_PUSHDATA1,
+        n if n <= 65535 => op == OP_PUSHDATA2,
+        _ => true,
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum SigVersion {
+    Base,
+    WitnessV0,
+}
+
+struct Ctx<'a> {
+    tx: &'a Tx,
+    challenge: &'a [u8],
+    opts: Options,
+    unified: std::cell::Cell<bool>,
+}
+
+impl Ctx<'_> {
+    fn p2wpkh(&self, h: &[u8; 20], w: &[Vec<u8>]) -> Result<(), Fail> {
+        if w.len() != 2 {
+            return invalid("P2WPKH witness must be <sig> <pubkey>");
+        }
+        check_pubkey(&w[1], true)?;
+        if hash160(&w[1]) != *h {
+            return invalid("public key does not match the address");
+        }
+        let code = p2pkh_script(h);
+        self.ecdsa(&w[0], &w[1], &code, SigVersion::WitnessV0)
+    }
+
+    fn p2wsh(&self, h: &[u8; 32], w: &[Vec<u8>]) -> Result<(), Fail> {
+        let Some((ws, stack)) = w.split_last() else { return invalid("empty witness") };
+        if sha256(ws) != *h {
+            return invalid("witness script does not match the address");
+        }
+        if w.len() > 100 {
+            return invalid("witness stack too large");
+        }
+        self.eval(ws, stack, SigVersion::WitnessV0)
+    }
+
+    fn p2tr(&self, x: &[u8; 32], w: &[Vec<u8>]) -> Result<(), Fail> {
+        match w {
+            [] => invalid("empty witness"),
+            [sig] => self.schnorr(sig, x),
+            [.., last] if last.first() == Some(&0x50) => inconclusive("taproot annex"),
+            [.., script, control] => {
+                // Check the commitment (consensus, so a failure is invalid); a script path
+                // that does commit is past what this verifier runs.
+                if taproot_commits(x, script, control) {
+                    inconclusive("taproot script path")
+                } else {
+                    invalid("taproot script path does not commit to the output key")
+                }
+            }
+        }
+    }
+
+    /// The standard single-key and multisig scripts, with `stack` the items below the script.
+    fn eval(&self, script: &[u8], stack: &[Vec<u8>], sv: SigVersion) -> Result<(), Fail> {
+        if script.contains(&OP_CODESEPARATOR) && script_ops(script).is_some_and(|ops| ops.contains(&OP_CODESEPARATOR)) {
+            return invalid("OP_CODESEPARATOR is forbidden");
+        }
+        let witness = sv == SigVersion::WitnessV0;
+        // <pk> CHECKSIG
+        if let [n, pk @ .., OP_CHECKSIG] = script {
+            if (*n == 33 || *n == 65) && pk.len() == *n as usize {
+                if stack.len() != 1 {
+                    return invalid("stack must be <sig> (CLEANSTACK)");
+                }
+                check_pubkey(pk, witness)?;
+                return self.ecdsa(&stack[0], pk, script, sv);
+            }
+        }
+        // DUP HASH160 <h> EQUALVERIFY CHECKSIG
+        if let Script::P2pkh(h) = classify(script) {
+            if stack.len() != 2 {
+                return invalid("stack must be <sig> <pubkey> (CLEANSTACK)");
+            }
+            check_pubkey(&stack[1], witness)?;
+            if hash160(&stack[1]) != h {
+                return invalid("public key does not match the script");
+            }
+            return self.ecdsa(&stack[0], &stack[1], script, sv);
+        }
+        if let Some((m, pks)) = multisig(script) {
+            if stack.len() != m + 1 {
+                return invalid("multisig stack must be the dummy and m signatures (CLEANSTACK)");
+            }
+            if !stack[0].is_empty() {
+                return invalid("multisig dummy must be empty (NULLDUMMY)");
+            }
+            let sigs = &stack[1..];
+            let mut k = 0;
+            for (i, sig) in sigs.iter().enumerate() {
+                if sig.is_empty() {
+                    return invalid("empty multisig signature");
+                }
+                loop {
+                    if pks.len() - k < sigs.len() - i {
+                        return invalid("multisig signature does not verify");
+                    }
+                    let pk = pks[k];
+                    k += 1;
+                    check_pubkey(pk, witness)?;
+                    match self.ecdsa(sig, pk, script, sv) {
+                        Ok(()) => break,
+                        Err(Fail::Invalid(_)) => continue,
+                        Err(e) => return Err(e),
+                    }
+                }
+            }
+            return Ok(());
+        }
+        inconclusive("script the verifier does not know (only single-key and bare multisig)")
+    }
+
+    fn ecdsa(&self, sig: &[u8], pk: &[u8], script_code: &[u8], sv: SigVersion) -> Result<(), Fail> {
+        let Some((&ht, der)) = sig.split_last() else { return invalid("empty signature") };
+        let unified = match ht {
+            SIGHASH_ALL => false,
+            SIGHASH_ALL_UNIFIED if unified_allowed(self.opts) => true,
+            SIGHASH_ALL_UNIFIED => return invalid("hash type 0x21 (SIGHASH_UNIFIED) is not accepted"),
+            _ => return invalid("hash type must be SIGHASH_ALL"),
+        };
+        if !valid_der(der) {
+            return invalid("signature is not strict DER");
+        }
+        let Ok(mut s) = ecdsa::Signature::from_der(der) else { return invalid("signature is not DER") };
+        let before = s;
+        s.normalize_s();
+        if s != before {
+            return invalid("high-S signature (LOW_S)");
+        }
+        let Ok(key) = PublicKey::from_slice(pk) else { return invalid("bad public key") };
+        let digest = if unified {
+            self.unified.set(true);
+            self.unified_sighash(ht, Some(script_code), if sv == SigVersion::Base { 0 } else { 1 })
+        } else {
+            match sv {
+                SigVersion::Base => self.legacy_sighash(script_code, ht),
+                SigVersion::WitnessV0 => self.bip143_sighash(script_code, ht),
+            }
+        };
+        let secp = Secp256k1::verification_only();
+        secp.verify_ecdsa(&Message::from_digest(digest), &s, &key)
+            .or_else(|_| invalid("ECDSA signature does not verify"))
+    }
+
+    fn schnorr(&self, sig: &[u8], x: &[u8; 32]) -> Result<(), Fail> {
+        let (bytes, ht) = match sig.len() {
+            64 => (sig, 0x00),
+            65 => (&sig[..64], sig[64]),
+            _ => return invalid("Schnorr signature must be 64 or 65 bytes"),
+        };
+        let digest = match ht {
+            0x00 if sig.len() == 64 => self.bip341_sighash(0x00),
+            SIGHASH_ALL => self.bip341_sighash(SIGHASH_ALL),
+            SIGHASH_ALL_UNIFIED if unified_allowed(self.opts) => {
+                self.unified.set(true);
+                self.unified_sighash(ht, None, 2)
+            }
+            SIGHASH_ALL_UNIFIED => return invalid("hash type 0x21 (SIGHASH_UNIFIED) is not accepted"),
+            _ => return invalid("hash type must be SIGHASH_DEFAULT or SIGHASH_ALL"),
+        };
+        let Ok(key) = XOnlyPublicKey::from_slice(x) else { return invalid("bad x-only key") };
+        let Ok(s) = schnorr::Signature::from_slice(bytes) else { return invalid("bad Schnorr signature") };
+        let secp = Secp256k1::verification_only();
+        secp.verify_schnorr(&s, &Message::from_digest(digest), &key)
+            .or_else(|_| invalid("Schnorr signature does not verify"))
+    }
+
+    /// Original sighash, SIGHASH_ALL, every other input's scriptSig emptied.
+    fn legacy_sighash(&self, script_code: &[u8], ht: u8) -> [u8; 32] {
+        let mut t = self.tx.clone();
+        for (i, input) in t.inputs.iter_mut().enumerate() {
+            input.witness.clear();
+            input.script_sig = if i == 0 { script_code.to_vec() } else { Vec::new() };
+        }
+        let mut pre = t.serialize(false);
+        pre.extend_from_slice(&u32::from(ht).to_le_bytes());
+        dsha256(&pre)
+    }
+
+    /// BIP143 for input 0, SIGHASH_ALL, amount 0.
+    fn bip143_sighash(&self, script_code: &[u8], ht: u8) -> [u8; 32] {
+        let t = self.tx;
+        let mut prevouts = Vec::new();
+        let mut seqs = Vec::new();
+        for i in &t.inputs {
+            prevouts.extend_from_slice(&i.prev_txid);
+            prevouts.extend_from_slice(&i.vout.to_le_bytes());
+            seqs.extend_from_slice(&i.sequence.to_le_bytes());
+        }
+        let mut outs = Vec::new();
+        for o in &t.outputs {
+            ser_output(&mut outs, o);
+        }
+        let i0 = &t.inputs[0];
+        let mut pre = Vec::new();
+        pre.extend_from_slice(&t.version.to_le_bytes());
+        pre.extend_from_slice(&dsha256(&prevouts));
+        pre.extend_from_slice(&dsha256(&seqs));
+        pre.extend_from_slice(&i0.prev_txid);
+        pre.extend_from_slice(&i0.vout.to_le_bytes());
+        var_bytes(&mut pre, script_code);
+        pre.extend_from_slice(&0u64.to_le_bytes());
+        pre.extend_from_slice(&i0.sequence.to_le_bytes());
+        pre.extend_from_slice(&dsha256(&outs));
+        pre.extend_from_slice(&t.lock_time.to_le_bytes());
+        pre.extend_from_slice(&u32::from(ht).to_le_bytes());
+        dsha256(&pre)
+    }
+
+    /// The single-SHA256 aggregates BIP341 and `UnifiedSighash` share: prevouts, amounts,
+    /// spent scripts, sequences, outputs. The only spent output is to_spend's (0, challenge).
+    fn aggregates(&self) -> [[u8; 32]; 5] {
+        let t = self.tx;
+        let mut prevouts = Vec::new();
+        let mut amounts = Vec::new();
+        let mut scripts = Vec::new();
+        let mut seqs = Vec::new();
+        for i in &t.inputs {
+            prevouts.extend_from_slice(&i.prev_txid);
+            prevouts.extend_from_slice(&i.vout.to_le_bytes());
+            amounts.extend_from_slice(&0u64.to_le_bytes());
+            var_bytes(&mut scripts, self.challenge);
+            seqs.extend_from_slice(&i.sequence.to_le_bytes());
+        }
+        let mut outs = Vec::new();
+        for o in &t.outputs {
+            ser_output(&mut outs, o);
+        }
+        [sha256(&prevouts), sha256(&amounts), sha256(&scripts), sha256(&seqs), sha256(&outs)]
+    }
+
+    /// BIP341 key path for input 0, SIGHASH_DEFAULT or SIGHASH_ALL, no annex.
+    fn bip341_sighash(&self, ht: u8) -> [u8; 32] {
+        let t = self.tx;
+        let agg = self.aggregates();
+        let mut pre = vec![0x00, ht];
+        pre.extend_from_slice(&t.version.to_le_bytes());
+        pre.extend_from_slice(&t.lock_time.to_le_bytes());
+        for a in &agg {
+            pre.extend_from_slice(a);
+        }
+        pre.push(0x00); // spend_type: key path, no annex
+        pre.extend_from_slice(&0u32.to_le_bytes());
+        tagged_hash(b"TapSighash", &pre)
+    }
+
+    /// Knots `SignatureHashUnified` for input 0 and SIGHASH_ALL | SIGHASH_UNIFIED:
+    /// `script_type` 0 bare/P2SH, 1 segwit v0, 2 taproot key path.
+    fn unified_sighash(&self, ht: u8, script_code: Option<&[u8]>, script_type: u8) -> [u8; 32] {
+        let t = self.tx;
+        let agg = self.aggregates();
+        let mut pre = vec![0x00, ht];
+        pre.extend_from_slice(&t.version.to_le_bytes());
+        pre.extend_from_slice(&t.lock_time.to_le_bytes());
+        pre.push(0x00); // the fifth locktime byte
+        for a in &agg {
+            pre.extend_from_slice(a); // not ANYONECANPAY, output type ALL: all five
+        }
+        pre.push(script_type);
+        pre.extend_from_slice(&0u32.to_le_bytes());
+        match script_code {
+            Some(code) => var_bytes(&mut pre, code),
+            None => pre.push(0x00), // no annex
+        }
+        tagged_hash(b"UnifiedSighash", &pre)
+    }
+}
+
+/// BIP341: does `control` prove `script` is a leaf of the output key `x`?
+fn taproot_commits(x: &[u8; 32], script: &[u8], control: &[u8]) -> bool {
+    if control.len() < 33 || (control.len() - 33) % 32 != 0 || control.len() > 33 + 32 * 128 {
+        return false;
+    }
+    let mut leaf = vec![control[0] & 0xfe];
+    var_bytes(&mut leaf, script);
+    let mut k = tagged_hash(b"TapLeaf", &leaf);
+    for node in control[33..].chunks(32) {
+        let (a, b) = if k[..] < node[..] { (&k[..], node) } else { (node, &k[..]) };
+        k = tagged_hash(b"TapBranch", &[a, b].concat());
+    }
+    let (Ok(internal), Ok(output)) = (XOnlyPublicKey::from_slice(&control[1..33]), XOnlyPublicKey::from_slice(x)) else {
+        return false;
+    };
+    let Ok(t) = secp256k1::Scalar::from_be_bytes(tagged_hash(b"TapTweak", &[&control[1..33], &k[..]].concat())) else {
+        return false;
+    };
+    let parity = if control[0] & 1 == 1 { secp256k1::Parity::Odd } else { secp256k1::Parity::Even };
+    internal.tweak_add_check(&Secp256k1::verification_only(), &output, parity, t)
+}
+
+fn unified_allowed(opts: Options) -> bool {
+    cfg!(feature = "unified-sighash") && opts.unified_sighash
+}
+
+/// Opcodes of a script, skipping push data; `None` if a push runs off the end.
+fn script_ops(s: &[u8]) -> Option<Vec<u8>> {
+    let mut ops = Vec::new();
+    let mut i = 0;
+    while i < s.len() {
+        let op = s[i];
+        i += 1;
+        let n = match op {
+            0x01..=0x4b => op as usize,
+            OP_PUSHDATA1 => {
+                let n = *s.get(i)? as usize;
+                i += 1;
+                n
+            }
+            OP_PUSHDATA2 => {
+                let n = u16::from_le_bytes(s.get(i..i + 2)?.try_into().ok()?) as usize;
+                i += 2;
+                n
+            }
+            OP_PUSHDATA4 => {
+                let n = u32::from_le_bytes(s.get(i..i + 4)?.try_into().ok()?) as usize;
+                i += 4;
+                n
+            }
+            _ => {
+                ops.push(op);
+                0
+            }
+        };
+        i = i.checked_add(n)?;
+        if i > s.len() {
+            return None;
+        }
+    }
+    Some(ops)
+}
+
+/// `OP_m <pk>... OP_n OP_CHECKMULTISIG` with 1 ≤ m ≤ n ≤ 16.
+fn multisig(s: &[u8]) -> Option<(usize, Vec<&[u8]>)> {
+    let (&first, rest) = s.split_first()?;
+    let (&last, rest) = rest.split_last()?;
+    let (&n_op, mut body) = rest.split_last()?;
+    if last != OP_CHECKMULTISIG || !(OP_1..=OP_16).contains(&first) || !(OP_1..=OP_16).contains(&n_op) {
+        return None;
+    }
+    let (m, n) = ((first - OP_1 + 1) as usize, (n_op - OP_1 + 1) as usize);
+    let mut pks = Vec::new();
+    while let Some((&len, tail)) = body.split_first() {
+        if (len != 33 && len != 65) || tail.len() < len as usize {
+            return None;
+        }
+        pks.push(&tail[..len as usize]);
+        body = &tail[len as usize..];
+    }
+    (m <= n && pks.len() == n).then_some((m, pks))
+}
+
+pub fn p2pkh_script(h: &[u8; 20]) -> Vec<u8> {
+    let mut s = vec![OP_DUP, OP_HASH160, 0x14];
+    s.extend_from_slice(h);
+    s.extend_from_slice(&[OP_EQUALVERIFY, OP_CHECKSIG]);
+    s
+}
+
+/// STRICTENC; WITNESS_PUBKEYTYPE (compressed only) in segwit v0.
+fn check_pubkey(pk: &[u8], witness: bool) -> Result<(), Fail> {
+    let ok = match pk.first() {
+        Some(0x02 | 0x03) => pk.len() == 33,
+        Some(0x04) => pk.len() == 65 && !witness,
+        _ => false,
+    };
+    if ok {
+        Ok(())
+    } else if witness && pk.len() == 65 {
+        invalid("uncompressed public key in segwit (WITNESS_PUBKEYTYPE)")
+    } else {
+        invalid("public key encoding (STRICTENC)")
+    }
+}
+
+/// BIP66 strict DER, without the hash type byte.
+fn valid_der(sig: &[u8]) -> bool {
+    let len = sig.len();
+    if !(8..=72).contains(&len) || sig[0] != 0x30 || sig[1] as usize != len - 2 {
+        return false;
+    }
+    let len_r = sig[3] as usize;
+    if 5 + len_r >= len {
+        return false;
+    }
+    let len_s = sig[5 + len_r] as usize;
+    if len_r + len_s + 6 != len {
+        return false;
+    }
+    if sig[2] != 0x02 || len_r == 0 || sig[4] & 0x80 != 0 {
+        return false;
+    }
+    if len_r > 1 && sig[4] == 0x00 && sig[5] & 0x80 == 0 {
+        return false;
+    }
+    if sig[len_r + 4] != 0x02 || len_s == 0 || sig[len_r + 6] & 0x80 != 0 {
+        return false;
+    }
+    if len_s > 1 && sig[len_r + 6] == 0x00 && sig[len_r + 7] & 0x80 == 0 {
+        return false;
+    }
+    true
+}
