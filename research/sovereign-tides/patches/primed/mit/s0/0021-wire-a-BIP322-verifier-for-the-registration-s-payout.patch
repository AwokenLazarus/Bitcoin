+// ---------------------------------------------------------------------------------------
+// Signing (tests and vector generation)
+
+#[cfg(any(test, feature = "bip322-signer"))]
+pub mod signer {
+    //! Deterministic BIP322 signing for the handful of templates the tests need.
+    use super::*;
+    use secp256k1::{Keypair, Scalar, SecretKey};
+
+    pub fn pubkey(sk: &[u8; 32]) -> [u8; 33] {
+        let secp = Secp256k1::new();
+        PublicKey::from_secret_key(&secp, &SecretKey::from_slice(sk).unwrap()).serialize()
+    }
+
+    pub fn p2wpkh_script(sk: &[u8; 32]) -> Vec<u8> {
+        let mut s = vec![OP_0, 0x14];
+        s.extend_from_slice(&hash160(&pubkey(sk)));
+        s
+    }
+
+    pub fn p2pkh_script_of(sk: &[u8; 32]) -> Vec<u8> {
+        p2pkh_script(&hash160(&pubkey(sk)))
+    }
+
+    pub fn p2sh_p2wpkh_script(sk: &[u8; 32]) -> Vec<u8> {
+        let mut s = vec![OP_HASH160, 0x14];
+        s.extend_from_slice(&hash160(&p2wpkh_script(sk)));
+        s.push(OP_EQUAL);
+        s
+    }
+
+    /// `<pk> CHECKSIG`
+    pub fn pk_script(sk: &[u8; 32]) -> Vec<u8> {
+        let mut s = vec![33];
+        s.extend_from_slice(&pubkey(sk));
+        s.push(OP_CHECKSIG);
+        s
+    }
+
+    pub fn p2wsh_pk_script(sk: &[u8; 32]) -> Vec<u8> {
+        let mut s = vec![OP_0, 0x20];
+        s.extend_from_slice(&sha256(&pk_script(sk)));
+        s
+    }
+
+    /// BIP86 key-path output key (no script tree).
+    fn tweaked(sk: &[u8; 32]) -> Keypair {
+        let secp = Secp256k1::new();
+        let kp = Keypair::from_secret_key(&secp, &SecretKey::from_slice(sk).unwrap());
+        let (x, _) = kp.x_only_public_key();
+        let t = tagged_hash(b"TapTweak", &x.serialize());
+        kp.add_xonly_tweak(&secp, &Scalar::from_be_bytes(t).unwrap()).unwrap()
+    }
+
+    pub fn p2tr_script(sk: &[u8; 32]) -> Vec<u8> {
+        let mut s = vec![OP_1, 0x20];
+        s.extend_from_slice(&tweaked(sk).x_only_public_key().0.serialize());
+        s
+    }
+
+    fn ctx<'a>(tx: &'a Tx, challenge: &'a [u8]) -> Ctx<'a> {
+        Ctx { tx, challenge, opts: Options { unified_sighash: true }, unified: Default::default() }
+    }
+
+    fn ecdsa_sig(digest: [u8; 32], sk: &[u8; 32], ht: u8) -> Vec<u8> {
+        let secp = Secp256k1::new();
+        let sig = secp.sign_ecdsa(&Message::from_digest(digest), &SecretKey::from_slice(sk).unwrap());
+        let mut v = sig.serialize_der().to_vec();
+        v.push(ht);
+        v
+    }
+
+    /// `smp` P2WPKH signature; `ht` is 0x01, or 0x21 for `UnifiedSighash`.
+    pub fn simple_p2wpkh(sk: &[u8; 32], message: &[u8], ht: u8) -> String {
+        let challenge = p2wpkh_script(sk);
+        let tx = to_sign(&to_spend(&challenge, message));
+        let pk = pubkey(sk);
+        let code = p2pkh_script(&hash160(&pk));
+        let c = ctx(&tx, &challenge);
+        let d = if ht == SIGHASH_ALL_UNIFIED { c.unified_sighash(ht, Some(&code), 1) } else { c.bip143_sighash(&code, ht) };
+        format!("smp{}", base64_encode(&serialize_witness(&[ecdsa_sig(d, sk, ht), pk.to_vec()])))
+    }
+
+    /// `smp` P2WSH `<pk> CHECKSIG` signature.
+    pub fn simple_p2wsh_pk(sk: &[u8; 32], message: &[u8]) -> String {
+        let challenge = p2wsh_pk_script(sk);
+        let tx = to_sign(&to_spend(&challenge, message));
+        let ws = pk_script(sk);
+        let d = ctx(&tx, &challenge).bip143_sighash(&ws, SIGHASH_ALL);
+        format!("smp{}", base64_encode(&serialize_witness(&[ecdsa_sig(d, sk, SIGHASH_ALL), ws])))
+    }
+
+    /// `smp` P2TR key-path signature; `ht` 0x00 (64-byte), 0x01, or 0x21.
+    pub fn simple_p2tr(sk: &[u8; 32], message: &[u8], ht: u8) -> String {
+        let challenge = p2tr_script(sk);
+        let tx = to_sign(&to_spend(&challenge, message));
+        let c = ctx(&tx, &challenge);
+        let d = if ht == SIGHASH_ALL_UNIFIED { c.unified_sighash(ht, None, 2) } else { c.bip341_sighash(ht) };
+        let secp = Secp256k1::new();
+        let sig = secp.sign_schnorr_no_aux_rand(&Message::from_digest(d), &tweaked(sk));
+        let mut v = sig.as_ref().to_vec();
+        if ht != 0x00 {
+            v.push(ht);
+        }
+        format!("smp{}", base64_encode(&serialize_witness(&[v])))
+    }
+
+    /// `ful` P2SH-P2WPKH signature.
+    pub fn full_p2sh_p2wpkh(sk: &[u8; 32], message: &[u8]) -> String {
+        let challenge = p2sh_p2wpkh_script(sk);
+        let mut tx = to_sign(&to_spend(&challenge, message));
+        let redeem = p2wpkh_script(sk);
+        let mut ss = vec![redeem.len() as u8];
+        ss.extend_from_slice(&redeem);
+        tx.inputs[0].script_sig = ss;
+        let pk = pubkey(sk);
+        let d = ctx(&tx, &challenge).bip143_sighash(&p2pkh_script(&hash160(&pk)), SIGHASH_ALL);
+        tx.inputs[0].witness = vec![ecdsa_sig(d, sk, SIGHASH_ALL), pk.to_vec()];
+        format!("ful{}", base64_encode(&tx.serialize(true)))
+    }
+
+    /// `ful` P2PKH signature.
+    pub fn full_p2pkh(sk: &[u8; 32], message: &[u8]) -> String {
+        let challenge = p2pkh_script_of(sk);
+        let mut tx = to_sign(&to_spend(&challenge, message));
+        let d = ctx(&tx, &challenge).legacy_sighash(&challenge, SIGHASH_ALL);
+        let sig = ecdsa_sig(d, sk, SIGHASH_ALL);
+        let pk = pubkey(sk);
+        let mut ss = vec![sig.len() as u8];
+        ss.extend_from_slice(&sig);
+        ss.push(33);
+        ss.extend_from_slice(&pk);
+        tx.inputs[0].script_sig = ss;
+        format!("ful{}", base64_encode(&tx.serialize(true)))
+    }
+}
