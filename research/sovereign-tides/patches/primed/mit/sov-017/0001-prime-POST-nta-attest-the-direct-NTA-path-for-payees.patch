+
+    #[test]
+    fn the_direct_gate_keeps_order_token_rate_payee_per_tip() {
+        let d = Direct::new(Some("k".repeat(32)), 2, 3);
+        assert_eq!(d.admit(None), Err(Gate::Token));
+        assert_eq!(d.admit(Some(&"k".repeat(31))), Err(Gate::Token));
+        let tok = "k".repeat(32);
+        for _ in 0..3 {
+            assert_eq!(d.admit(Some(&tok)), Ok(()));
+        }
+        // the bucket holds `rate`: the fourth at once is over it
+        assert_eq!(d.admit(Some(&tok)), Err(Gate::Rate));
+
+        let open = Direct::new(None, 2, 1000);
+        assert_eq!(open.admit(None), Ok(()), "no token configured: none needed");
+        let (k1, k2) = ([1u8; 32], [2u8; 32]);
+        assert_eq!(open.admit_script(&k1, &T.prev, false), Err(Gate::NotPayee));
+        assert_eq!(open.admit_script(&k1, &T.prev, true), Ok(()));
+        assert_eq!(open.admit_script(&k1, &T.prev, true), Ok(()));
+        assert_eq!(open.admit_script(&k1, &T.prev, true), Err(Gate::PerTip));
+        assert_eq!(open.admit_script(&k2, &T.prev, true), Ok(()), "per script");
+        assert_eq!(open.admit_script(&k1, &[9u8; 32], true), Ok(()), "per tip");
+        // an old parent's counts are forgotten once enough newer ones arrive
+        for i in 0..DIRECT_PREVS_KEPT as u8 {
+            open.admit_script(&k1, &[100 + i; 32], true).unwrap();
+        }
+        assert_eq!(open.admit_script(&k1, &T.prev, true), Ok(()));
+        let st = open.stats_json();
+        assert_eq!(st["gated"][Gate::PerTip.reason()], 1);
+        assert_eq!(st["gated"][Gate::NotPayee.reason()], 1);
+    }
+
+    #[test]
+    fn a_direct_body_is_the_0x4e_fields_with_prev_in_rpc_order() {
+        let gw = signer(2);
+        let a = gw.attest(T.height, T.nbits, &T.prev);
+        let mut prev_rpc = T.prev;
+        prev_rpc[0] = 0xaa; // not symmetric, so byte order matters
+        let a = NtaAttest { prev_hash: prev_rpc, sig: gw.sign(T.height, T.nbits, &prev_rpc), ..a };
+        let mut display = prev_rpc;
+        display.reverse();
+        let body = |nbits: Value, version: u64| {
+            json!({"version": version, "key": hex::encode(a.key), "height": a.height, "nbits": nbits,
+                   "prev": hex::encode(display), "sig": hex::encode(a.sig)})
+            .to_string()
+        };
+        let parsed = parse_direct(&body(json!("207fffff"), 1)).unwrap();
+        assert_eq!(parsed, a);
+        assert!(parsed.verify());
+        assert_eq!(parse_direct(&body(json!(0x207f_ffffu32), 1)).unwrap(), a);
+        assert!(parse_direct(&body(json!("207fff"), 1)).is_err());
+        assert!(parse_direct(&body(json!("207fffff"), 2)).is_err());
+        assert!(parse_direct("{}").is_err());
+        assert!(parse_direct("not json").is_err());
+    }
+
+    #[test]
+    fn a_token_file_anyone_else_can_read_is_refused() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = std::env::temp_dir().join(format!("sov017-token-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let p = dir.join("token");
+        std::fs::write(&p, format!("{}\n", "t".repeat(40))).unwrap();
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(Direct::load_token(&p).unwrap_err().contains("chmod 600"));
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o600)).unwrap();
+        assert_eq!(Direct::load_token(&p).unwrap(), "t".repeat(40));
+        std::fs::write(&p, "short").unwrap();
+        assert!(Direct::load_token(&p).is_err());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
 }
