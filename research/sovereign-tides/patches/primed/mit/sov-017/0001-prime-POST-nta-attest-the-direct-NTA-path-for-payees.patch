 //! The (height, nBits) a coinbaser commits to are always Prime's own, from its node's tip,
 //! never a gateway's claim: one validly signed attestation for the wrong nBits would make
 //! every block that lists it invalid.
+//!
+//! SOV-017: a TIDES payee that is not a gateway (a pay-with-work provider, paid in coinbases
+//! other people's gateways ask for) sends the same attestation to `POST /nta/attest` instead
+//! ([`Direct`]). It is checked exactly as `0x4e` is and filed in the same book. The signature is
+//! what makes it count; [`Direct`] only keeps the endpoint from being used to burn CPU: the
+//! script must be a live payee in the window, a few tries per script per tip, a global rate.
 
 use std::collections::{HashMap, HashSet, VecDeque};
+use std::sync::Mutex;
 use std::time::Instant;
 
 use datum_wire::nta::{self, NtaAttest, Signer};
@@ -231,6 +238,224 @@ impl Book {
     }
 }
 
+/// Prime's own view of the block after `prev`: its node's tip, refreshed once if the caller is
+/// ahead of the poller. `None` if the node does not have `prev` as its tip. Noted in the book
+/// (when this Prime attests at all), so latency counts from when Prime first knew the tip.
+pub async fn target(shared: &crate::state::Shared, prev: &[u8; 32]) -> Option<Target> {
+    let from_tip = |shared: &crate::state::Shared| {
+        let tip = shared.tip_snapshot()?;
+        (tip.hash_le.as_ref() == Some(prev)).then_some(())?;
+        Some((Target { prev: *prev, height: tip.height + 1, nbits: tip.next_bits? }, tip.seen_at, tip.seen_ts))
+    };
+    let found = match from_tip(shared) {
+        Some(t) => Some(t),
+        None => {
+            crate::node::refresh_ahead(shared).await;
+            from_tip(shared)
+        }
+    };
+    let (t, seen_at, seen_ts) = found?;
+    if let Some(pool) = shared.nta_pool.as_ref().filter(|_| !shared.cfg.nta_disabled) {
+        shared.nta.lock().unwrap().note_tip(t, seen_at, seen_ts, pool);
+    }
+    Some(t)
+}
+
+/// Header a `POST /nta/attest` carries the optional token in.
+pub const TOKEN_HEADER: &str = "x-nta-token";
+/// Parents whose per-script try counts are kept; older ones are forgotten.
+const DIRECT_PREVS_KEPT: usize = 8;
+
+/// Why the direct endpoint turned a submission away before looking at its signature.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Gate {
+    Token,
+    Rate,
+    NotPayee,
+    PerTip,
+}
+
+impl Gate {
+    pub fn status(self) -> &'static str {
+        match self {
+            Gate::Token | Gate::NotPayee => "403 Forbidden",
+            Gate::Rate | Gate::PerTip => "429 Too Many Requests",
+        }
+    }
+
+    pub fn reason(self) -> &'static str {
+        match self {
+            Gate::Token => "nta token",
+            Gate::Rate => "rate limited: too many attestations to this Prime",
+            Gate::NotPayee => "not a live TIDES payee in the current window",
+            Gate::PerTip => "rate limited: too many attestations for this script on this tip",
+        }
+    }
+}
+
+#[derive(Debug)]
+struct DirectState {
+    /// Token bucket for the global cap: tokens left, and when it was last refilled.
+    bucket: f64,
+    refilled: Instant,
+    /// Parent (internal order) -> x-only key -> submissions, newest parent last.
+    tries: VecDeque<([u8; 32], HashMap<[u8; 32], u32>)>,
+    accepted: u64,
+    duplicate: u64,
+    refused: u64,
+    unknown_tip: u64,
+    gated: HashMap<&'static str, u64>,
+}
+
+/// Admission for `POST /nta/attest` (SOV-017).
+#[derive(Debug)]
+pub struct Direct {
+    token: Option<String>,
+    per_tip: u32,
+    rate: f64,
+    state: Mutex<DirectState>,
+}
+
+impl Direct {
+    pub fn new(token: Option<String>, per_tip: u32, rate: u32) -> Self {
+        let rate = f64::from(rate.max(1));
+        Self {
+            token,
+            per_tip: per_tip.max(1),
+            rate,
+            state: Mutex::new(DirectState {
+                bucket: rate,
+                refilled: Instant::now(),
+                tries: VecDeque::new(),
+                accepted: 0,
+                duplicate: 0,
+                refused: 0,
+                unknown_tip: 0,
+                gated: HashMap::new(),
+            }),
+        }
+    }
+
+    /// Read `nta-attest-token-file`: refused if group- or world-readable, or shorter than 32.
+    pub fn load_token(path: &std::path::Path) -> Result<String, String> {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            let mode = std::fs::metadata(path).map_err(|e| format!("{}: {e}", path.display()))?.permissions().mode();
+            if mode & 0o077 != 0 {
+                return Err(format!("{}: mode {:o}; the token must not be group- or world-readable (chmod 600)", path.display(), mode & 0o777));
+            }
+        }
+        let t = std::fs::read_to_string(path).map_err(|e| format!("{}: {e}", path.display()))?.trim().to_string();
+        if t.len() < 32 {
+            return Err(format!("{}: the token must be at least 32 characters", path.display()));
+        }
+        Ok(t)
+    }
+
+    fn gate(&self, st: &mut DirectState, g: Gate) -> Result<(), Gate> {
+        *st.gated.entry(g.reason()).or_insert(0) += 1;
+        Err(g)
+    }
+
+    /// The token, when one is configured (constant time), then one unit of the global rate.
+    /// Checked before the body is parsed.
+    pub fn admit(&self, presented: Option<&str>) -> Result<(), Gate> {
+        let mut st = self.state.lock().unwrap();
+        if let Some(want) = &self.token {
+            let p = presented.unwrap_or("").trim().as_bytes();
+            let w = want.as_bytes();
+            if w.len() != p.len() || w.iter().zip(p).fold(0u8, |acc, (x, y)| acc | (x ^ y)) != 0 {
+                return self.gate(&mut st, Gate::Token);
+            }
+        }
+        let now = Instant::now();
+        st.bucket = (st.bucket + now.duration_since(st.refilled).as_secs_f64() * self.rate).min(self.rate);
+        st.refilled = now;
+        if st.bucket < 1.0 {
+            return self.gate(&mut st, Gate::Rate);
+        }
+        st.bucket -= 1.0;
+        Ok(())
+    }
+
+    /// One try for `key` on `prev`, if it is a live payee and under `nta-attest-per-tip`.
+    pub fn admit_script(&self, key: &[u8; 32], prev: &[u8; 32], live_payee: bool) -> Result<(), Gate> {
+        let mut st = self.state.lock().unwrap();
+        if !live_payee {
+            return self.gate(&mut st, Gate::NotPayee);
+        }
+        let i = match st.tries.iter().position(|(p, _)| p == prev) {
+            Some(i) => i,
+            None => {
+                st.tries.push_back((*prev, HashMap::new()));
+                while st.tries.len() > DIRECT_PREVS_KEPT {
+                    st.tries.pop_front();
+                }
+                st.tries.len() - 1
+            }
+        };
+        let n = st.tries[i].1.entry(*key).or_insert(0);
+        if *n >= self.per_tip {
+            return self.gate(&mut st, Gate::PerTip);
+        }
+        *n += 1;
+        Ok(())
+    }
+
+    /// Count what the book made of an admitted submission.
+    pub fn note(&self, outcome: &Outcome) {
+        let mut st = self.state.lock().unwrap();
+        match outcome {
+            Outcome::Accepted(_) => st.accepted += 1,
+            Outcome::Duplicate => st.duplicate += 1,
+            Outcome::UnknownTip => st.unknown_tip += 1,
+            Outcome::Refused(_) => st.refused += 1,
+        }
+    }
+
+    pub fn stats_json(&self) -> Value {
+        let st = self.state.lock().unwrap();
+        json!({
+            "token": self.token.is_some(),
+            "per_tip": self.per_tip,
+            "rate": self.rate,
+            "accepted": st.accepted,
+            "duplicate": st.duplicate,
+            "refused": st.refused,
+            "unknown_tip": st.unknown_tip,
+            "gated": st.gated,
+        })
+    }
+}
+
+/// A `POST /nta/attest` body: the `0x4e` fields as JSON.
+/// `{"version": 1, "key": hex32, "height": n, "nbits": "207fffff", "prev": hex32, "sig": hex64}`,
+/// `prev` in RPC (display) order as `getbestblockhash` prints it; `nbits` as GBT's `bits`
+/// (8 hex) or a number.
+pub fn parse_direct(body: &str) -> Result<NtaAttest, String> {
+    let v: Value = serde_json::from_str(body).map_err(|e| format!("json: {e}"))?;
+    if v["version"].as_u64() != Some(u64::from(nta::ATTEST_VERSION)) {
+        return Err(format!("version: {} only", nta::ATTEST_VERSION));
+    }
+    fn hexn<const N: usize>(v: &Value, k: &str) -> Result<[u8; N], String> {
+        let s = v[k].as_str().ok_or_else(|| format!("{k}: missing"))?;
+        let raw = hex::decode(s).map_err(|_| format!("{k}: not hex"))?;
+        raw.try_into().map_err(|_| format!("{k}: {N} bytes"))
+    }
+    let key = hexn::<32>(&v, "key")?;
+    let height = v["height"].as_u64().and_then(|h| u32::try_from(h).ok()).ok_or("height: u32")?;
+    let nbits = match &v["nbits"] {
+        Value::String(s) if s.len() == 8 => u32::from_str_radix(s, 16).map_err(|_| "nbits: 8 hex")?,
+        Value::Number(n) => n.as_u64().and_then(|n| u32::try_from(n).ok()).ok_or("nbits: u32")?,
+        _ => return Err("nbits: 8 hex or a number".into()),
+    };
+    let mut prev_hash = hexn::<32>(&v, "prev")?;
+    prev_hash.reverse();
+    let sig = hexn::<64>(&v, "sig")?;
+    Ok(NtaAttest { key, height, nbits, prev_hash, sig })
+}
+
