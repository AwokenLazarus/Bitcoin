+/// `POST /nta/attest` (SOV-017): the direct path for payees that are not gateways, such as
+/// pay-with-work providers. Same fields as the `0x4e` body, checked against this Prime's own
+/// node exactly as `0x4e` is, filed in the same book. In order, cheapest first: token (if
+/// configured), global rate, body, live payee in the window, tries per script per tip, then
+/// tip and signature.
+async fn direct_attest(shared: &Arc<Shared>, req: &str, body: &str, peer: std::net::SocketAddr) -> (&'static str, Value) {
+    let Some(pool) = shared.nta_pool.as_ref().filter(|_| !shared.cfg.nta_disabled) else {
+        return ("503 Service Unavailable", json!({"error": "this Prime does not build attested coinbasers"}));
+    };
+    let gated = |g: crate::nta::Gate| (g.status(), json!({"error": g.reason()}));
+    if let Err(g) = shared.nta_direct.admit(header(req, crate::nta::TOKEN_HEADER)) {
+        return gated(g);
+    }
+    let a = match crate::nta::parse_direct(body) {
+        Ok(a) => a,
+        Err(e) => return ("400 Bad Request", json!({"error": e})),
+    };
+    let script = a.script();
+    let live = shared.coinbaser_base().scripts.values().any(|s| *s == script);
+    if let Err(g) = shared.nta_direct.admit_script(&a.key, &a.prev_hash, live) {
+        log::debug!("NTA direct from {peer}: key {} {}", &hex::encode(a.key)[..16], g.reason());
+        return gated(g);
+    }
+    let target = crate::nta::target(shared, &a.prev_hash).await;
+    let outcome = shared.nta.lock().unwrap().add(&a, target, "direct", pool);
+    shared.nta_direct.note(&outcome);
+    let key = &hex::encode(a.key)[..16];
+    match outcome {
+        crate::nta::Outcome::Accepted(ms) => {
+            log::info!("NTA direct attestation height={} key={key} +{ms:.1} ms after the tip", a.height);
+            ("200 OK", json!({"ok": true, "outcome": "accepted", "height": a.height, "ms": (ms * 10.0).round() / 10.0}))
+        }
+        crate::nta::Outcome::Duplicate => ("200 OK", json!({"ok": true, "outcome": "duplicate", "height": a.height})),
+        crate::nta::Outcome::UnknownTip => {
+            let tip = shared.tip_snapshot().and_then(|t| t.hash_le).map(|mut h| {
+                h.reverse();
+                hex::encode(h)
+            });
+            ("409 Conflict", json!({"error": "not this Prime's node's tip", "tip": tip}))
+        }
+        crate::nta::Outcome::Refused(why) => {
+            log::info!("NTA direct attestation from {peer} refused: key={key} {why}");
+            ("422 Unprocessable Entity", json!({"error": why}))
+        }
+    }
+}
