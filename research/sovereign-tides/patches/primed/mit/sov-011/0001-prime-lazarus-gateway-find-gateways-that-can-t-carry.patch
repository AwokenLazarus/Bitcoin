+
+    const CHAIN: Chain = Chain { nta_height: 3000, probe_window: 2016, next_height: Some(900) };
+
+    #[test]
+    fn probing_runs_from_the_window_to_activation_only() {
+        let at = |h| Chain { next_height: Some(h), ..CHAIN };
+        assert!(!at(983).probing());
+        assert!(at(984).probing() && at(2999).probing());
+        assert!(!at(3000).probing() && at(3000).active());
+        assert!(!Chain { next_height: None, ..CHAIN }.probing());
+        assert!(!Chain { probe_window: 0, ..at(2999) }.probing());
+        // a window wider than the chain: from genesis
+        assert!(Chain { nta_height: 100, probe_window: 2016, next_height: Some(1) }.probing());
+    }
+
+    #[test]
+    fn an_advertiser_is_never_probed_and_a_silent_gateway_is_probed_hourly() {
+        let c = Chain { next_height: Some(2500), ..CHAIN };
+        let mut b = Book::default();
+        assert_eq!(b.note_hello("aa", "lazarus-gateway/0.1", true, 10), Status::Ready);
+        assert!(!b.probe_due("aa", &c, 3600, 10));
+        assert_eq!(b.note_hello("bb", "v0.4.1-beta/x", false, 10), Status::Unknown);
+        assert!(b.probe_due("bb", &c, 3600, 10));
+        assert!(b.probe_due("never-seen", &c, 3600, 10));
+        b.note_probe_sent("bb", 2500, 10);
+        assert!(!b.probe_due("bb", &c, 3600, 3609));
+        assert!(b.probe_due("bb", &c, 3600, 3610));
+        // not before the window
+        assert!(!b.probe_due("bb", &CHAIN, 3600, 99_999));
+    }
+
+    #[test]
+    fn verdicts_move_status_and_an_upgrade_or_a_downgrade_is_seen_at_hello() {
+        let mut b = Book::default();
+        b.note_hello("bb", "stock", false, 1);
+        assert_eq!(b.note_probe_verdict("bb", false, 2), Some(Status::Unready));
+        assert_eq!(b.get("bb").unwrap().evidence, Evidence::ProbeDropped);
+        // a reconnect without the flag does not clear the verdict
+        assert_eq!(b.note_hello("bb", "stock", false, 3), Status::Unready);
+        // an upgraded gateway advertises and is ready at once
+        assert_eq!(b.note_hello("bb", "lazarus-gateway/0.1", true, 4), Status::Ready);
+        // and one that goes back to a build without the flag is unknown again, not ready
+        assert_eq!(b.note_hello("bb", "stock", false, 5), Status::Unknown);
+        assert_eq!(b.note_probe_verdict("bb", true, 6), Some(Status::Ready));
+        assert_eq!(b.note_probe_verdict("bb", true, 7), None);
+        assert_eq!(b.get("bb").unwrap().probes_kept, 2);
+        // after activation the coinbase outranks the hello
+        b.note_hello("cc", "liar", true, 8);
+        assert_eq!(b.note_attestation_verdict("cc", true, 9), None);
+        assert_eq!(b.get("cc").unwrap().evidence, Evidence::Advertised);
+        assert_eq!(b.note_attestation_verdict("cc", false, 10), Some(Status::Unready));
+        assert_eq!(b.status("cc"), Status::Unready);
+    }
+
+    #[test]
+    fn the_metric_weighs_by_recent_work_and_counts_blocks_to_activation() {
+        let mut b = Book::default();
+        let now = 100_000;
+        b.note_hello("r", "lazarus-gateway/0.1", true, now);
+        b.note_hello("u", "stock", false, now);
+        b.note_probe_verdict("u", false, now);
+        b.note_hello("k", "stock", false, now);
+        b.note_work("r", 600, now - 10);
+        b.note_work("u", 300, now - 5);
+        b.note_work("k", 100, now - 1);
+        // outside the hour: not counted
+        b.note_work("u", 1_000_000, now - RATE_WINDOW_SECS - 10);
+        b.note_work("u", 0, now);
