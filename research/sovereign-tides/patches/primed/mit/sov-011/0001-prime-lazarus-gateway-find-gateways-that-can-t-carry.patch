+++ b/prime/primed/tests/nta_readiness_e2e.rs
@@ -0,0 +1,273 @@
+//! End-to-end (SOV-011): XBT-NTA activation safety against a real `primed` and a stand-in node.
+//! A gateway that advertises `nta-v1` is ready; one that does not is probed with a 70-byte
+//! output before activation, never after, at most once an hour; `/nta.json` carries the
+//! readiness metric; and after activation an `nta-unready` gateway is told why and closed.
+//!
+//! The last test needs an accepted share, which is a diff-1 grind (~4.3 GH of BLAKE2b), so it
+//! is ignored by default:
+//!
+//!     cargo test --release -p primed --test nta_readiness_e2e -- --ignored --nocapture
+
+mod common;
+
+use std::io::{Read, Write};
+use std::net::TcpStream;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use common::*;
+use datum_wire::coinbase::{self, TxOut};
+use datum_wire::coinbaser::Output;
+use datum_wire::crypto::Identity;
+use datum_wire::handshake::NTA_V1_MARKER;
+use datum_wire::mining::{self, Blake2bSection, CoinbaseSection, JobSection, PowSubmit};
+use datum_wire::nta::{self, Signer};
+use datum_wire::pow::{self, Hash};
+
+const BITS: u32 = 0x1903_a30c;
+const TIP: Hash = [0x42; 32];
+
+fn unix_now() -> u32 {
+    SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs() as u32
+}
+
+fn pool_signer() -> Signer {
+    let mut sk = [0u8; 32];
+    sk[31] = 7;
+    Signer::from_secret(&sk).unwrap()
+}
+
+fn p2tr_address(key: &[u8; 32]) -> String {
+    bech32::segwit::encode(bech32::hrp::BC, bech32::segwit::VERSION_1, key).unwrap()
+}
+
+/// A node whose next block is `HEIGHT`, and a Prime building attested coinbasers from
+/// `nta_height`, probing from `window` blocks before it.
+fn start(nta_height: u32, window: u32, extra: &str) -> (MockNode, Primed, u16, Identity) {
+    let node = MockNode::start(Chain {
+        height: HEIGHT - 1,
+        tip: node_hex(&TIP),
+        parent: node_hex(&[0x41; 32]),
+        bits: BITS,
+        next_bits: Some(BITS),
+    });
+    let pool = Identity::generate();
+    let payout = p2tr_address(&pool_signer().key());
+    let cfg = format!(
+        "{}\nhouse-loopback = false\nnta-height = {nta_height}\nnta-probe-window = {window}\nnta-pool-key-file = \"@DATA_DIR@/nta.key\"\n{extra}",
+        node.config(0.2)
+    );
+    let mut sk = [0u8; 32];
+    sk[31] = 7;
+    let (primed, port) =
+        start_primed_paying(&pool, &payout, &cfg, |dir| std::fs::write(dir.join("nta.key"), hex::encode(sk)).unwrap());
+    wait_for_tip(&primed);
+    (node, primed, port, pool)
+}
+
+fn wait_for_tip(p: &Primed) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while stats(p)["node"]["height"].as_u64().unwrap_or(0) == 0 {
+        assert!(Instant::now() < deadline, "primed never read the node's tip: {}", stats(p));
+        std::thread::sleep(Duration::from_millis(100));
+    }
+}
+
+fn nta_json(p: &Primed) -> serde_json::Value {
+    let mut s = TcpStream::connect(("127.0.0.1", p.stats)).unwrap();
+    s.write_all(b"GET /nta.json HTTP/1.0\r\n\r\n").unwrap();
+    let mut buf = Vec::new();
+    s.read_to_end(&mut buf).unwrap();
+    let text = String::from_utf8_lossy(&buf);
+    serde_json::from_str(text.split("\r\n\r\n").nth(1).unwrap()).unwrap()
+}
+
+fn row<'a>(v: &'a serde_json::Value, gateway: &Identity) -> &'a serde_json::Value {
+    let gw = hex::encode(&gateway.sign_pk()[..8]);
+    v["readiness"]["list"].as_array().unwrap().iter().find(|r| r["gateway"] == gw.as_str()).expect("gateway row")
+}
+
+fn advertising() -> Vec<u8> {
+    let mut pad = NTA_V1_MARKER.to_vec();
+    pad.extend_from_slice(&[0x33; 9]);
+    pad
+}
+
+fn connect(port: u16, pool: &Identity, g: &Identity, pad: &[u8]) -> Gateway {
+    let mut gw = Gateway::open(port, pool, g, pad);
+    assert_eq!(gw.next_mining()[0], mining::SUB_CONFIGURE, "served: configure first");
+    gw
+}
+
+fn is_probe(o: &Output) -> bool {
+    o.sats == 0 && nta::is_attestation(&o.script) && o.script[6..].starts_with(b"XBT-NTA probe")
+}
+
+#[test]
+fn before_activation_only_a_gateway_that_does_not_advertise_is_probed_and_only_hourly() {
+    // next block HEIGHT; activation 5 blocks on, inside the default 2016-block window
+    let (_node, primed, port, pool) = start(HEIGHT + 5, 2016, "");
+    let (a, s) = (Identity::generate(), Identity::generate());
+    let mut ga = connect(port, &pool, &a, &advertising());
+    let mut gs = connect(port, &pool, &s, &[0x99; 16]);
+
+    let (_, plain) = ga.request_coinbaser_outputs(VALUE, &TIP);
+    assert!(!plain.iter().any(is_probe), "an advertiser is not probed: {plain:?}");
+    let (id, probed) = gs.request_coinbaser_outputs(VALUE, &TIP);
+    assert!(id > 0);
+    // the probe is the last output, 70 bytes, zero value; everything before it is the same split
+    let last = probed.last().unwrap();
+    assert!(is_probe(last) && last.script.len() == 70, "{probed:?}");
+    assert_eq!(&probed[..probed.len() - 1], &plain[..], "the probe changes no payee");
+    assert_eq!(probed.iter().map(|o| o.sats).sum::<u64>(), VALUE);
+    // once an hour: the next coinbaser (a fresh one, for another value) has none
+    let (_, again) = gs.request_coinbaser_outputs(VALUE - 1000, &TIP);
+    assert!(!again.iter().any(is_probe), "{again:?}");
+
+    let v = nta_json(&primed);
+    let r = &v["readiness"];
+    assert_eq!(r["blocks_until_activation"], 5, "{v}");
+    assert_eq!((r["probing"].as_bool(), r["active"].as_bool()), (Some(true), Some(false)), "{v}");
+    assert_eq!(r["gateways"], serde_json::json!({"ready": 1, "unready": 0, "unknown": 1}), "{v}");
+    assert_eq!(r["unready_policy"], "refuse");
+    assert_eq!(row(&v, &a)["evidence"], "advertised nta-v1");
+    assert_eq!(row(&v, &s)["status"], "unknown");
+    assert_eq!(row(&v, &s)["probes"]["sent"], 1);
+    assert_eq!(row(&v, &s)["probes"]["last_height"], HEIGHT);
+    let log = std::fs::read_to_string(primed.dir.join("primed.err")).unwrap_or_default();
+    assert!(log.contains("nta-v1=true nta=ready"), "{log}");
+    assert!(log.contains("NTA probe on coinbaser"), "{log}");
+}
+
+#[test]
+fn no_probe_before_the_window_and_none_when_probing_is_off() {
+    let (_node, primed, port, pool) = start(HEIGHT + 2016 + 1, 2016, "");
+    let mut gs = connect(port, &pool, &Identity::generate(), &[]);
+    let (_, outs) = gs.request_coinbaser_outputs(VALUE, &TIP);
+    assert!(!outs.iter().any(is_probe), "{outs:?}");
+    assert_eq!(nta_json(&primed)["readiness"]["probing"], false);
+
+    let (_node, _primed, port, pool) = start(HEIGHT + 5, 0, "");
+    let mut gs = connect(port, &pool, &Identity::generate(), &[]);
+    let (_, outs) = gs.request_coinbaser_outputs(VALUE, &TIP);
+    assert!(!outs.iter().any(is_probe), "{outs:?}");
+}
+
+#[test]
+fn after_activation_a_gateway_not_known_to_be_unready_is_served_and_never_probed() {
+    // the next block is the activation height
+    let (_node, primed, port, pool) = start(HEIGHT, 2016, "");
+    let mut gs = connect(port, &pool, &Identity::generate(), &[0x10; 20]);
+    let (_, outs) = gs.request_coinbaser_outputs(VALUE, &TIP);
+    assert!(!outs.iter().any(is_probe), "{outs:?}");
+    // attested: the pool's attestation follows its output
+    assert!(outs.iter().any(|o| o.sats == 0 && nta::is_attestation(&o.script)), "{outs:?}");
+    let r = &nta_json(&primed)["readiness"];
+    assert_eq!((r["active"].as_bool(), r["blocks_until_activation"].as_u64()), (Some(true), Some(0)));
+    assert_eq!(r["gateways"]["unknown"], 1);
+}
+
+/// A share paying `script` the whole `VALUE`, on the tip, ground to diff 1. The coinbaser id is
+/// not in the header, so the caller fills it in once one is issued.
+fn ground_share(script: &[u8]) -> PowSubmit {
+    let mut wc = vec![0x6a, 0x24, 0xaa, 0x21, 0xa9, 0xed];
+    wc.extend_from_slice(&[0x76; 32]);
+    let outs = vec![TxOut { value: VALUE, script: script.to_vec() }, TxOut { value: 0, script: wc }];
+    let (cb, tidx, split_at) = coinbase::build(HEIGHT, b"Lazarus", &outs, 0);
+    let txs: Vec<Hash> = (0..3u64)
+        .map(|i| {
+            let mut a = [0u8; 32];
+            a[..8].copy_from_slice(&(i + 1).to_le_bytes());
+            a
+        })
+        .collect();
+    let mut s = PowSubmit {
+        job_id: 1,
+        coinbase_id: 0,
+        flags: mining::FLAG_BLAKE2B,
+        target_pot: 0,
+        ntime32: 0,
+        nonce32: 0,
+        version: 0xa000_0000,
+        extranonce: [0x0b, 0x10, 0xc0, 0xde, 1, 2, 3, 4, 5, 6, 7, 8],
+        username: "bc1qminer.rig".into(),
+        reserved: [0; 4],
+        blake2b: Some(Blake2bSection { ntime: [0; 8], nonce: [0; 8] }),
+        time_on_wire: Some(unix_now()),
+        job: Some(JobSection {
+            prev_hash: TIP,
+            target_byte_index: tidx as u16,
+            nbits: BITS.to_le_bytes(),
+            coinbaser_id: 0,
+            height: HEIGHT,
+            coinbase_value: VALUE,
+            txn_count: txs.len() as u32,
+            txn_total_weight: 0,
+            txn_total_size: 0,
+            txn_total_sigops: 0,
+            merkle_branches: pow::merkle_branches_for_coinbase(&txs),
+        }),
+        coinbase: Some(CoinbaseSection {
+            coinbase_id: 0,
+            coinb1: cb[..split_at].to_vec(),
+            coinb2: cb[split_at + coinbase::EXTRANONCE_SLOT..].to_vec(),
+        }),
+    };
+    grind_diff1(&mut s);
+    s
+}
+
+#[test]
+#[ignore]
+fn a_gateway_that_drops_the_probe_is_unready_then_refused_at_activation_until_it_advertises() {
+    // Ground first: nothing is connected, so no session idles out meanwhile. The coinbase is
+    // what a stock gateway builds from a probe coinbaser on an empty window: the pool's output
+    // (all the split has), no probe.
+    let pool_script = pool_signer().script();
+    let mut share = ground_share(&pool_script);
+
+    let (node, primed, port, pool) = start(HEIGHT + 1, 2016, "nta-probe-every-secs = 3600");
+    let s = Identity::generate();
+    let mut gs = connect(port, &pool, &s, &[0x5a; 30]);
+    let (id, outs) = gs.request_coinbaser_outputs(VALUE, &TIP);
+    assert!(is_probe(outs.last().unwrap()), "{outs:?}");
+    assert_eq!(outs[..outs.len() - 1], [Output { sats: VALUE, script: pool_script.clone() }]);
+    share.job.as_mut().unwrap().coinbaser_id = id;
+    // Accepted in full: dropping a zero-value OP_RETURN costs the gateway nothing.
+    assert_eq!(gs.submit(&share).0, mining::ACCEPTED);
+    let v = nta_json(&primed);
+    assert_eq!(row(&v, &s)["status"], "nta-unready", "{v}");
+    assert_eq!(row(&v, &s)["evidence"], "probe dropped");
+    assert_eq!(v["readiness"]["hashrate_share"]["unready"], 1.0, "{v}");
+    let log = std::fs::read_to_string(primed.dir.join("primed.err")).unwrap_or_default();
+    assert!(log.contains("NTA probe DROPPED"), "{log}");
+
+    // Activation: the next tip makes the next block HEIGHT + 1 = nta-height.
+    *node.chain.lock().unwrap() =
+        Chain { height: HEIGHT, tip: node_hex(&[0x43; 32]), parent: node_hex(&TIP), bits: BITS, next_bits: Some(BITS) };
+    let frames = gs.frames_until_closed();
+    let info = frames.iter().find(|(c, _)| *c == datum_wire::cmd::INFO).expect("a server message");
+    let text = String::from_utf8_lossy(&info.1);
+    assert!(text.contains("datum_coinbaser.c:795") && text.contains("nta-v1"), "{text}");
+    assert!(text.ends_with('\0'), "NUL-terminated for the C side's %s");
+    assert!(
+        frames.iter().any(|(c, b)| *c == datum_wire::cmd::MINING && b[0] == nta::SUB_NTA_UNREADY),
+        "and the unknown sub-command a stock gateway logs at WARN: {frames:?}"
+    );
+    assert!(!frames.iter().any(|(c, b)| *c == datum_wire::cmd::MINING && b[0] == mining::SUB_COINBASER_REPLY));
+
+    // Reconnecting as it was: refused before any configure.
+    let mut again = Gateway::open(port, &pool, &s, &[0x5a; 30]);
+    let frames = again.frames_until_closed();
+    assert!(
