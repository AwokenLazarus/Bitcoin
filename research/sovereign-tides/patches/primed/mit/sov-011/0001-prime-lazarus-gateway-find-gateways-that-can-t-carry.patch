+/// What stock `datum_gateway` v0.4.1 keeps of a coinbaser v2 list: `datum_coinbaser_v2_parse`
+/// (`datum_coinbaser.c:760-815`, OCEAN `5b06123`), line for line. It stops, silently, at the
+/// first output whose value would take the running total past `coinbase_value` or whose script
+/// is shorter than 2 or longer than 64 bytes (:795), and after 512 outputs; what came before is
+/// kept. Under 9 bytes it keeps nothing. For tests and demos that play a stock gateway.
+pub fn stock_v041_parse(bytes: &[u8], coinbase_value: u64) -> (u8, Vec<Output>) {
+    if bytes.len() < 9 {
+        return (0, Vec::new());
+    }
+    let id = bytes[0];
+    let mut i = 1;
+    let mut tally = 0u64;
+    let mut out = Vec::new();
+    // `while (cidx < cblen)`: a truncated tail reads past the buffer in C; here it ends the list.
+    while i < bytes.len() {
+        let Some(v) = bytes.get(i..i + 8) else { break };
+        let value = u64::from_le_bytes(v.try_into().unwrap());
+        i += 8;
+        if value.saturating_add(tally) > coinbase_value {
+            break;
+        }
+        let Some(&slen) = bytes.get(i) else { break };
+        i += 1;
+        let slen = usize::from(slen);
+        if !(MIN_SCRIPT..=MAX_SCRIPT).contains(&slen) {
+            break;
+        }
+        let Some(script) = bytes.get(i..i + slen) else { break };
+        i += slen;
+        tally += value;
+        out.push(Output { sats: value, script: script.to_vec() });
+        if out.len() >= MAX_OUTPUTS {
+            break;
+        }
+    }
+    (id, out)
+}
