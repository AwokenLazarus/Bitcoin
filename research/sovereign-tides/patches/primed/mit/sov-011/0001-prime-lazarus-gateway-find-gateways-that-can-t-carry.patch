+++ b/prime/primed/src/readiness.rs
@@ -0,0 +1,540 @@
+//! XBT-NTA activation safety (SOV-011): which gateways can carry attestations.
+//!
+//! After `nta-height` every value-bearing coinbase output needs a 70-byte attestation output.
+//! Stock DATUM v0.4.1 stops reading a coinbaser at the first script over 64 bytes
+//! (`datum_coinbaser.c:795`) and says nothing, so it would keep the payees, drop the
+//! attestations and mine `bad-nta-count` blocks. Prime finds such gateways before that:
+//!
+//! * **Advertised.** A gateway that can carry them says `nta-v1` in its hello
+//!   ([`datum_wire::handshake::NTA_V1_MARKER`]): ready.
+//! * **Probed.** From `nta-height − nta-probe-window`, one coinbaser per gateway per
+//!   `nta-probe-every-secs` ends with a zero-value 70-byte NTA-shaped output
+//!   ([`datum_wire::nta::probe_script`]). The first share on that coinbaser that pays every
+//!   issued payee decides: probe there, ready; probe gone, `nta-unready`. A share on a smaller
+//!   coinbase (a stock size class keeps a prefix of the list) says nothing and is not counted.
+//! * **Watched.** After activation the attestations are the probe: a full-split share whose
+//!   coinbase lacks one the coinbaser listed marks the gateway unready.
+//!
+//! The probe pays nobody and changes no payee, and share classification skips zero-value
+//! OP_RETURNs, so it costs a gateway nothing whichever way it goes.
+//!
+//! The book is keyed by the gateway's `gateway=` hex (the first 8 bytes of its identity key,
+//! what the logs and `/stats.json` show) and outlives sessions, so a gateway found unready
+//! stays so across reconnects until it advertises or passes a probe.
+
+use std::collections::{HashMap, VecDeque};
+
+use datum_wire::coinbase::Coinbase;
+use datum_wire::coinbaser::Output;
+use serde_json::{json, Value};
+
+/// Work older than this is not in a gateway's rate.
+pub const RATE_WINDOW_SECS: u64 = 3600;
+/// Gateways not seen for this long are left out of the metric (kept in the book).
+const SEEN_WITHIN_SECS: u64 = 24 * 3600;
+/// Entries the book keeps; the least recently seen goes first.
+const MAX_ENTRIES: usize = 4096;
+/// Rate samples one gateway keeps (a share is ~ one per second per gateway at most).
+const MAX_SAMPLES: usize = 8192;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Status {
+    Unknown,
+    Ready,
+    Unready,
+}
+
+impl Status {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Status::Unknown => "unknown",
+            Status::Ready => "ready",
+            Status::Unready => "nta-unready",
+        }
+    }
+}
+
+/// What the status rests on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Evidence {
+    None,
+    /// `nta-v1` in its hello.
+    Advertised,
+    /// A probe output was in the coinbase of a full-split share.
+    ProbeKept,
+    /// A full-split share on a probe coinbaser had no probe output.
+    ProbeDropped,
+    /// After activation: a full-split share had every attestation its coinbaser listed.
+    AttestationsKept,
+    /// After activation: a full-split share lacked an attestation its coinbaser listed.
+    AttestationsDropped,
+}
+
+impl Evidence {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Evidence::None => "none",
+            Evidence::Advertised => "advertised nta-v1",
+            Evidence::ProbeKept => "probe kept",
+            Evidence::ProbeDropped => "probe dropped",
+            Evidence::AttestationsKept => "attestations kept",
+            Evidence::AttestationsDropped => "attestations dropped",
+        }
+    }
+}
+
+#[derive(Debug)]
+pub struct Entry {
+    pub status: Status,
+    pub evidence: Evidence,
+    pub user_agent: String,
+    pub advertised: bool,
+    pub since: u64,
+    pub last_seen: u64,
+    /// When the last probe coinbaser went out, and for which height.
+    pub last_probe: u64,
+    pub last_probe_height: u32,
+    pub probes_sent: u64,
+    pub probes_kept: u64,
+    pub probes_dropped: u64,
+    /// Sessions refused (or served pool-only) because of this status.
+    pub refusals: u64,
+    samples: VecDeque<(u64, u64)>,
+}
+
+impl Entry {
+    fn new(now: u64) -> Self {
+        Entry {
+            status: Status::Unknown,
+            evidence: Evidence::None,
+            user_agent: String::new(),
+            advertised: false,
+            since: now,
+            last_seen: now,
+            last_probe: 0,
+            last_probe_height: 0,
+            probes_sent: 0,
+            probes_kept: 0,
+            probes_dropped: 0,
+            refusals: 0,
+            samples: VecDeque::new(),
+        }
+    }
+
+    fn set(&mut self, status: Status, evidence: Evidence, now: u64) -> bool {
+        let changed = self.status != status;
+        if changed {
+            self.since = now;
+        }
+        self.status = status;
+        self.evidence = evidence;
+        changed
+    }
+
+    /// Credited work in the last [`RATE_WINDOW_SECS`], in difficulty-1 units.
+    pub fn recent_work(&self, now: u64) -> u64 {
+        let from = now.saturating_sub(RATE_WINDOW_SECS);
+        self.samples.iter().filter(|(t, _)| *t >= from).map(|(_, w)| *w).sum()
+    }
+}
+
+/// Where the chain stands against activation, for the metric.
+#[derive(Clone, Copy, Debug)]
+pub struct Chain {
+    pub nta_height: u32,
+    pub probe_window: u32,
+    /// Height of the next block (node tip + 1), if Prime's node has answered.
+    pub next_height: Option<u32>,
+}
+
+impl Chain {
+    pub fn active(&self) -> bool {
+        self.next_height.is_some_and(|h| h >= self.nta_height)
+    }
+
+    /// Next height is in `[nta-height − window, nta-height)`.
+    pub fn probing(&self) -> bool {
+        self.probe_window > 0
+            && self.next_height.is_some_and(|h| h < self.nta_height && h + self.probe_window >= self.nta_height)
+    }
+}
+
+#[derive(Debug, Default)]
+pub struct Book {
+    map: HashMap<String, Entry>,
+}
+
+impl Book {
+    fn entry(&mut self, gw: &str, now: u64) -> &mut Entry {
+        if !self.map.contains_key(gw) && self.map.len() >= MAX_ENTRIES {
+            if let Some(oldest) = self.map.iter().min_by_key(|(_, e)| e.last_seen).map(|(k, _)| k.clone()) {
+                self.map.remove(&oldest);
+            }
+        }
+        let e = self.map.entry(gw.to_string()).or_insert_with(|| Entry::new(now));
+        e.last_seen = e.last_seen.max(now);
+        e
+    }
+
+    pub fn get(&self, gw: &str) -> Option<&Entry> {
+        self.map.get(gw)
+    }
+
+    pub fn status(&self, gw: &str) -> Status {
+        self.map.get(gw).map_or(Status::Unknown, |e| e.status)
+    }
+
+    /// A hello. `nta-v1` makes the gateway ready. A gateway that stops advertising (a
+    /// downgrade) loses what the advertisement gave it; a probe or attestation verdict stands.
+    pub fn note_hello(&mut self, gw: &str, user_agent: &str, nta_v1: bool, now: u64) -> Status {
+        let e = self.entry(gw, now);
+        e.user_agent = user_agent.chars().take(128).collect();
+        e.advertised = nta_v1;
+        if nta_v1 {
+            e.set(Status::Ready, Evidence::Advertised, now);
+        } else if e.evidence == Evidence::Advertised {
+            e.set(Status::Unknown, Evidence::None, now);
+        }
+        e.status
+    }
+
+    /// Whether the next coinbaser for `gw` should carry a probe: probing, not advertised, and
+    /// none sent in the last `every` seconds.
+    pub fn probe_due(&self, gw: &str, chain: &Chain, every: u64, now: u64) -> bool {
+        if !chain.probing() {
+            return false;
+        }
+        match self.map.get(gw) {
+            Some(e) => !e.advertised && (e.probes_sent == 0 || now.saturating_sub(e.last_probe) >= every),
+            None => true,
+        }
+    }
+
+    pub fn note_probe_sent(&mut self, gw: &str, height: u32, now: u64) {
+        let e = self.entry(gw, now);
+        e.last_probe = now;
+        e.last_probe_height = height;
+        e.probes_sent += 1;
+    }
+
+    /// A full-split share on a probe coinbaser. Returns the status if it changed.
+    pub fn note_probe_verdict(&mut self, gw: &str, kept: bool, now: u64) -> Option<Status> {
+        let e = self.entry(gw, now);
+        let changed = if kept {
+            e.probes_kept += 1;
+            e.set(Status::Ready, Evidence::ProbeKept, now)
+        } else {
+            e.probes_dropped += 1;
+            e.set(Status::Unready, Evidence::ProbeDropped, now)
+        };
+        changed.then_some(e.status)
+    }
+
+    /// A full-split share on an attested coinbaser, after activation. An advertised gateway
+    /// that drops them has lied or broken; the coinbase outranks the hello.
+    pub fn note_attestation_verdict(&mut self, gw: &str, kept: bool, now: u64) -> Option<Status> {
+        let e = self.entry(gw, now);
+        let changed = if kept {
+            if e.evidence == Evidence::Advertised {
+                return None;
+            }
+            e.set(Status::Ready, Evidence::AttestationsKept, now)
+        } else {
+            e.set(Status::Unready, Evidence::AttestationsDropped, now)
+        };
+        changed.then_some(e.status)
+    }
+
+    pub fn note_refusal(&mut self, gw: &str, now: u64) {
+        self.entry(gw, now).refusals += 1;
+    }
+
+    /// Credited work from `gw`, for its share of the rate.
+    pub fn note_work(&mut self, gw: &str, work: u64, now: u64) {
+        let e = self.entry(gw, now);
+        match e.samples.back_mut() {
+            Some((t, w)) if *t == now => *w = w.saturating_add(work),
+            _ => e.samples.push_back((now, work)),
+        }
+        let from = now.saturating_sub(RATE_WINDOW_SECS);
+        while e.samples.front().is_some_and(|(t, _)| *t < from) || e.samples.len() > MAX_SAMPLES {
+            e.samples.pop_front();
+        }
+    }
+
+    /// The readiness metric: gateways and share of recent work that are ready, unready or
+    /// unknown, and how far activation is. `gateways` counts those seen in the last day;
+    /// `hashrate_share` weighs them by credited work in the last hour.
+    pub fn stats_json(&self, chain: &Chain, policy: &str, probe_every: u64, now: u64) -> Value {
+        let seen: Vec<(&String, &Entry)> =
+            self.map.iter().filter(|(_, e)| now.saturating_sub(e.last_seen) <= SEEN_WITHIN_SECS).collect();
+        let mut count = HashMap::new();
+        let mut work = HashMap::new();
+        for (_, e) in &seen {
+            *count.entry(e.status).or_insert(0u64) += 1;
+            *work.entry(e.status).or_insert(0u64) += e.recent_work(now);
+        }
+        let total: u64 = work.values().sum();
+        let share = |s: Status| -> Value {
+            if total == 0 {
+                Value::Null
+            } else {
+                json!(((work.get(&s).copied().unwrap_or(0) as f64 / total as f64) * 10_000.0).round() / 10_000.0)
+            }
+        };
+        let n = |s: Status| count.get(&s).copied().unwrap_or(0);
+        let mut list: Vec<(&String, &Entry)> = seen;
+        list.sort_by(|a, b| b.1.recent_work(now).cmp(&a.1.recent_work(now)).then(a.0.cmp(b.0)));
+        let list: Vec<Value> = list
+            .into_iter()
+            .map(|(gw, e)| {
+                json!({
+                    "gateway": gw,
+                    "status": e.status.as_str(),
+                    "evidence": e.evidence.as_str(),
+                    "advertised": e.advertised,
+                    "user_agent": e.user_agent,
+                    "since": e.since,
+                    "last_seen": e.last_seen,
+                    "work_1h": e.recent_work(now),
+                    "probes": {"sent": e.probes_sent, "kept": e.probes_kept, "dropped": e.probes_dropped,
+                               "last": e.last_probe, "last_height": e.last_probe_height},
+                    "refusals": e.refusals,
+                })
+            })
+            .collect();
+        json!({
+            "nta_height": chain.nta_height,
+            "next_height": chain.next_height,
+            "blocks_until_activation": chain.next_height.map(|h| chain.nta_height.saturating_sub(h)),
+            "active": chain.active(),
+            "probing": chain.probing(),
+            "probe_from": chain.nta_height.saturating_sub(chain.probe_window),
+            "probe_window": chain.probe_window,
+            "probe_every_secs": probe_every,
+            "unready_policy": policy,
+            "gateways": {"ready": n(Status::Ready), "unready": n(Status::Unready), "unknown": n(Status::Unknown)},
+            "hashrate_share": {"ready": share(Status::Ready), "unready": share(Status::Unready), "unknown": share(Status::Unknown)},
+            "work_1h": total,
+            "list": list,
+        })
+    }
+}
+
+/// Whether a coinbase has an output paying `script` (the probe, an attestation).
+pub fn has_output(cb: &Coinbase, script: &[u8]) -> bool {
+    cb.outputs.iter().any(|o| o.script == script)
+}
+
+/// Whether `cb` kept every attestation the coinbaser `issued` listed; `None` if it listed none.
+pub fn attestations_kept(issued: &[Output], cb: &Coinbase) -> Option<bool> {
+    let mut atts = issued.iter().filter(|o| o.sats == 0 && datum_wire::nta::is_attestation(&o.script)).peekable();
+    atts.peek()?;
+    Some(atts.all(|o| has_output(cb, &o.script)))
+}
+
+/// Why an `nta-unready` gateway gets no work, as its operator reads it: a stock gateway logs it
+/// as "DATUM Server message: …" (`datum_protocol.c:1251`) and again under the unknown mining
+/// command warning. One line, no run of spaces.
+pub fn refusal_text(nta_height: u32, evidence: Evidence) -> String {
+    let seen = match evidence {
+        Evidence::AttestationsDropped => "its coinbases dropped the XBT-NTA attestations Prime sent",
+        _ => "it dropped the 70-byte XBT-NTA probe output Prime sent",
+    };
+    format!(
+        "Prime refuses this gateway from block {nta_height}: {seen}. Stock datum_gateway v0.4.1 stops reading a coinbaser at the first script over 64 bytes (datum_coinbaser.c:795), so every block it builds after XBT-NTA activation is invalid. Upgrade to lazarus-gateway or a datum_gateway with the Lazarus split-only patch (it advertises nta-v1) and reconnect: an upgraded gateway is served straight away"
+    )
+}
+
