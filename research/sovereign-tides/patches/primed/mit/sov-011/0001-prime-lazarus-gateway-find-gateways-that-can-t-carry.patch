+    assert_eq!(row(&v, &s)["status"], "ready");
+    assert!(row(&v, &s)["refusals"].as_u64().unwrap() >= 2, "{v}");
+    let log = std::fs::read_to_string(primed.dir.join("primed.err")).unwrap_or_default();
+    assert!(log.contains("refused: nta-unready (probe dropped)"), "{log}");
+}
