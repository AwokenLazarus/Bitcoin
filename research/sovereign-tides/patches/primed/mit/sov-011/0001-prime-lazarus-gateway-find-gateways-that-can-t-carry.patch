+    use datum_wire::coinbase::{self, TxOut};
+    use datum_wire::coinbaser::{decode_v2, encode_v2, stock_v041_parse};
+    use datum_wire::verify::{classify_coinbase, CoinbaseKind, Policy};
+
+    const VALUE: u64 = 1_000_000;
+
+    fn p2tr(n: u8) -> Vec<u8> {
+        datum_wire::nta::p2tr(&[n; 32])
+    }
+
+    /// The coinbase a gateway builds from what it kept of `list`: every output as listed, the
+    /// remainder (none: the list sums to the value) to the pool, and a witness commitment.
+    fn gateway_coinbase(kept: &[Output]) -> Coinbase {
+        let mut outs: Vec<TxOut> = kept.iter().map(|o| TxOut { value: o.sats, script: o.script.clone() }).collect();
+        let mut wc = vec![0x6a, 0x24, 0xaa, 0x21, 0xa9, 0xed];
+        wc.extend_from_slice(&[0x76; 32]);
+        outs.push(TxOut { value: 0, script: wc });
+        let (raw, _, _) = coinbase::build(3000, b"Lazarus", &outs, 0);
+        coinbase::parse(&raw).unwrap()
+    }
+
+    fn classify(cb: &Coinbase, issued: &[Output], pool: &[u8]) -> CoinbaseKind {
+        let p = Policy {
+            pool_script: pool,
+            issued: Some(issued),
+            tolerance: 0,
+            now: 0,
+            min_pot: 0,
+            gateway_script: None,
+            empty_solo_fee_bps: 0,
+            trusted_target: false,
+            uncommitted_pot: 20,
+        };
+        classify_coinbase(cb, &p, false, 3, false)
+    }
+
+    #[test]
+    fn a_stock_gateway_drops_the_probe_and_nothing_else_so_the_share_is_a_full_split_without_it() {
+        let pool = p2tr(9);
+        let split = vec![
+            Output { sats: 600_000, script: p2tr(1) },
+            Output { sats: 300_000, script: p2tr(2) },
+            Output { sats: 100_000, script: pool.clone() },
+        ];
+        let probe = datum_wire::nta::probe_script(&[0x42; 64]);
+        let mut probed = split.clone();
+        probed.push(Output { sats: 0, script: probe.clone() });
+        let wire = encode_v2(5, &probed);
+
+        // stock v0.4.1: payees kept, probe gone, and the share still pays every payee in full
+        let (_, stock) = stock_v041_parse(&wire, VALUE);
+        assert_eq!(stock, split);
+        let cb = gateway_coinbase(&stock);
+        assert_eq!(classify(&cb, &probed, &pool), CoinbaseKind::Split);
+        assert!(!has_output(&cb, &probe));
+
+        // a gateway that keeps 70-byte scripts: the probe is there, and the verdict is ready
+        let (_, kept) = decode_v2(&wire).unwrap();
+        let cb_ready = gateway_coinbase(&kept);
+        assert_eq!(classify(&cb_ready, &probed, &pool), CoinbaseKind::Split);
+        assert!(has_output(&cb_ready, &probe));
+
+        // the probe changes no payout: same kind and same amount to every payee as without it
+        let cb_plain = gateway_coinbase(&split);
+        assert_eq!(classify(&cb_plain, &split, &pool), CoinbaseKind::Split);
+        for o in &split {
+            assert_eq!(cb_ready.paid_to(&o.script), cb_plain.paid_to(&o.script));
+            assert_eq!(cb.paid_to(&o.script), cb_plain.paid_to(&o.script));
+        }
+        assert_eq!(cb_ready.total_output_value(), cb_plain.total_output_value());
+
+        // a stock size class keeps a prefix: a Partial share, which is not a verdict
+        let prefix = gateway_coinbase(&stock[..1]);
+        assert!(matches!(classify(&prefix, &probed, &pool), CoinbaseKind::Partial(1)));
+    }
+
+    #[test]
+    fn after_activation_the_attestations_are_the_probe() {
+        let pool = p2tr(9);
+        let att = |n: u8| Output { sats: 0, script: datum_wire::nta::attestation_script(&[n; 64]) };
+        let issued = vec![
+            Output { sats: 700_000, script: p2tr(1) },
+            Output { sats: 300_000, script: pool.clone() },
+            att(1),
+            att(2),
+        ];
+        let (_, stock) = stock_v041_parse(&encode_v2(1, &issued), VALUE);
+        assert_eq!(stock, issued[..2].to_vec());
+        let cb = gateway_coinbase(&stock);
+        assert_eq!(classify(&cb, &issued, &pool), CoinbaseKind::Split);
+        assert_eq!(attestations_kept(&issued, &cb), Some(false));
+        assert_eq!(attestations_kept(&issued, &gateway_coinbase(&issued)), Some(true));
+        // a coinbaser without attestations says nothing
+        assert_eq!(attestations_kept(&issued[..2], &cb), None);
+    }
+
+    #[test]
+    fn the_refusal_names_the_cause_and_the_fix_on_one_line() {
+        let t = refusal_text(3000, Evidence::ProbeDropped);
+        assert!(t.contains("block 3000") && t.contains("datum_coinbaser.c:795") && t.contains("nta-v1"));
+        assert!(t.contains("probe"));
+        assert!(refusal_text(3000, Evidence::AttestationsDropped).contains("attestations Prime sent"));
+        assert!(!t.contains("  ") && !t.contains('\n'));
+        // fits the 511-byte MOTD-sized buffers a stock gateway prints from
+        assert!(t.len() < 511, "{}", t.len());
+    }
+}
