-        "Prime refuses this gateway from block {nta_height}: {seen}. Stock datum_gateway v0.4.1 stops reading a coinbaser at the first script over 64 bytes (datum_coinbaser.c:795), so every block it builds after XBT-NTA activation is invalid. Upgrade to lazarus-gateway or a datum_gateway with the Lazarus split-only patch (it advertises nta-v1) and reconnect: an upgraded gateway is served straight away"
+        "Prime refuses this gateway from block {nta_height}: {seen}. Stock datum_gateway v0.4.1 stops reading a coinbaser at the first script over 64 bytes (datum_coinbaser.c:795) and the XBT lineages discard such a coinbaser whole, so every block it builds after XBT-NTA activation is invalid. Upgrade to lazarus-gateway or a datum_gateway with the Lazarus split-only patch (it advertises nta-v1) and reconnect: an upgraded gateway is served straight away"
     )
 }
 
@@ -381,6 +395,16 @@ mod tests {
 
     const CHAIN: Chain = Chain { nta_height: 3000, probe_window: 2016, next_height: Some(900) };
 
+    #[test]
+    fn a_discarded_coinbaser_is_unready_and_says_why() {
+        let mut b = Book::default();
