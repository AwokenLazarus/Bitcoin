@@ -254,6 +260,13 @@ impl Book {
         changed.then_some(e.status)
     }
 
+    /// Shares on 70-byte coinbasers paid only the pool (see [`Evidence::CoinbaserDiscarded`]).
+    pub fn note_coinbaser_discarded(&mut self, gw: &str, now: u64) -> Option<Status> {
+        let e = self.entry(gw, now);
+        e.probes_dropped += 1;
+        e.set(Status::Unready, Evidence::CoinbaserDiscarded, now).then_some(e.status)
+    }
