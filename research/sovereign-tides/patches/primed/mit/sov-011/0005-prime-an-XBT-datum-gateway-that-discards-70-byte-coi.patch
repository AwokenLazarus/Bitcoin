+    fn judge_nta(&mut self, coinbaser_id: u8, v: &VerifiedShare, issued: Option<&[Output]>, job_seen: f64) -> bool {
+        if matches!(v.coinbase_kind, CoinbaseKind::PoolOnly) {
+            return self.judge_nta_pool_only(v, job_seen);
+        }
         if !matches!(v.coinbase_kind, CoinbaseKind::Split) {
             return false;
         }
