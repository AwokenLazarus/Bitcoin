+    /// SOV-020: a pool-only share on a job with transactions, at the height of the last
+    /// coinbaser Prime sent this session, first seen after it, when that coinbaser carried
+    /// payees and a 70-byte output (the probe before activation, attestations after). The XBT
+    /// datum lineages throw such a coinbaser away whole ("Script length (70) is invalid. Using
+    /// default/empty"), build every job on the tip pool-only and cite coinbaser 0, so no
+    /// full-split share ever comes and the probe alone never decides. Stock also publishes a
+    /// pool-only section on the first notify of a height with the split in hand (968440), and
+    /// a job's first-seen time is its first share's, so one is not a verdict: the second is.
+    fn judge_nta_pool_only(&mut self, v: &VerifiedShare, job_seen: f64) -> bool {
+        let Some(chain) = self.shared.nta_chain() else { return false };
+        let Some((height, sent, what)) = self.long_coinbaser else { return false };
+        if v.height != height || v.commitment.txcount <= 1 || job_seen < sent {
+            return false;
+        }
+        self.nta_discards += 1;
+        if self.nta_discards < 2 {
+            log::info!(
+                "[{}] {} a share at {height} paid only the pool after a coinbaser with payees and the {what}; one more and it is nta-unready",
+                self.id,
+                self.gateway_hex,
+            );
+            return false;
+        }
+        self.nta_probes.clear();
+        let changed = self.shared.readiness.lock().unwrap().note_coinbaser_discarded(&self.gateway_hex, now());
+        if changed.is_some() {
+            log::warn!(
+                "[{}] {} ua={:?} discards coinbasers with a 70-byte output: {} shares on jobs built after a coinbaser carrying payees and the {what} paid only the pool (the XBT datum lineages log \"Script length (70) is invalid. Using default/empty\"): nta-unready. From block {} it {} (nta-unready-policy = {}).",
+                self.id,
+                self.gateway_hex,
+                self.hello.user_agent,
+                self.nta_discards,
+                chain.nta_height,
+                if self.shared.cfg.nta_unready_policy == "refuse" { "gets no work" } else { "is served pool-only coinbasers, whose blocks are invalid all the same" },
+                self.shared.cfg.nta_unready_policy,
+            );
+        }
+        changed.is_some()
+    }
+
     /// What a full-split share says about this gateway: whether it kept the probe its coinbaser
     /// ended with, or (after activation) every attestation its coinbaser listed. Only a share
     /// that pays every issued payee counts: a smaller coinbase dropped outputs by design.
     /// Returns true if the gateway was just found unready.
