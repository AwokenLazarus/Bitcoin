+class Peer:
+    """One P2P connection, handshaken and kept open, so a tx can be pushed the moment it is due
+    (SOV-015: a foreign canary's twin must land right behind C). `rtt` is the handshake's round
+    trip. Send with `send_tx` (tx + ping), then `wait_pong` for the node's acknowledgement."""
+
+    def __init__(self, node: str, *, network: str = "regtest", proxy: str | None = None, timeout: float = 20.0):
+        self.node = node
+        self.magic = MAGIC[network]
+        self.timeout = timeout
+        host, port = split_hostport(node)
+        if host.endswith(".onion") and not proxy:
+            raise DeliveryError("an .onion node needs delivery.proxy (Tor SOCKS5)")
+        t0 = time.monotonic()
+        deadline = t0 + timeout
+        try:
+            self.sock = socks5_connect(proxy, host, port, timeout) if proxy else socket.create_connection((host, port), timeout=timeout)
+        except OSError as e:
+            raise DeliveryError(f"connect {node}: {e}") from None
+        try:
+            self.sock.settimeout(timeout)
+            sent = time.monotonic()
+            self.sock.sendall(message(self.magic, "version", version_payload(int.from_bytes(os.urandom(8), "little"))))
+            got_version = got_verack = False
+            self.rtt = None
+            while not (got_version and got_verack):
+                if time.monotonic() > deadline:
+                    raise DeliveryError("handshake timed out")
+                cmd, _ = read_message(self.sock, self.magic)
+                if cmd == "version":
+                    got_version = True
+                    self.rtt = time.monotonic() - sent
+                    self.sock.sendall(message(self.magic, "verack", b""))
+                elif cmd == "verack":
+                    got_verack = True
+        except (OSError, socket.timeout) as e:
+            self.close()
+            raise DeliveryError(f"{node}: {e}") from None
+        except DeliveryError:
+            self.close()
+            raise
+
+    def send_tx(self, raw_tx: bytes) -> bytes:
+        """Push the tx and a ping behind it; returns the ping nonce. Raises DeliveryError."""
+        nonce = os.urandom(8)
+        try:
+            self.sock.sendall(message(self.magic, "tx", raw_tx) + message(self.magic, "ping", nonce))
+        except OSError as e:
+            raise DeliveryError(f"{self.node}: {e}") from None
+        return nonce
+
+    def wait_pong(self, nonce: bytes, timeout: float | None = None) -> float:
+        """Unix time the node answered the ping (so had processed the tx). Raises DeliveryError."""
+        deadline = time.monotonic() + (self.timeout if timeout is None else timeout)
+        try:
+            while True:
+                if time.monotonic() > deadline:
+                    raise DeliveryError("no pong after the tx")
+                self.sock.settimeout(max(0.01, deadline - time.monotonic()))
+                cmd, payload = read_message(self.sock, self.magic)
+                if cmd == "pong" and payload == nonce:
+                    return time.time()
+                if cmd == "ping":
+                    self.sock.sendall(message(self.magic, "pong", payload))
+        except (OSError, socket.timeout) as e:
+            raise DeliveryError(f"{self.node}: {e}") from None
+
+    def close(self):
+        try:
+            self.sock.close()
+        except (OSError, AttributeError):
+            pass
+
