+    def fan_out(self, peers: dict, twin_raw: bytes, c_sent: float) -> dict[str, float | None]:
+        """Push the twin to every open peer at once and collect acknowledgements. Returns each
+        target's lag (its pong after C was sent, s), or None if it never acknowledged."""
+        nonces = {}
+        for o, p in peers.items():
+            try:
+                nonces[o] = p.send_tx(twin_raw)
+            except xbt_p2p.DeliveryError as e:
+                log(f"twin to {o[:16]} not sent: {e}")
+        lags: dict[str, float | None] = {o: None for o in peers}
+        lock = threading.Lock()
+
+        def wait(o):
+            try:
+                t = peers[o].wait_pong(nonces[o])
+                with lock:
+                    lags[o] = round(t - c_sent, 4)
+            except xbt_p2p.DeliveryError as e:
+                log(f"twin to {o[:16]} not acknowledged: {e}")
+
+        ths = [threading.Thread(target=wait, args=(o,), daemon=True) for o in nonces]
+        for th in ths:
+            th.start()
+        for th in ths:
+            th.join()
+        return lags
