+    def open_peers(self, targets: dict[str, str]) -> dict[str, "xbt_p2p.Peer"]:
+        """Handshaken connections to every target, opened in parallel; the unreachable are dropped."""
+        peers: dict[str, xbt_p2p.Peer] = {}
+        lock = threading.Lock()
+
+        def one(o, node):
+            try:
+                p = self.peer(node)
+            except xbt_p2p.DeliveryError as e:
+                log(f"foreign target {o[:16]} unreachable: {e}")
+                with lock:
+                    self.state["foreign"]["failed"] += 1
+                return
+            with lock:
+                peers[o] = p
+
+        ths = [threading.Thread(target=one, args=(o, n), daemon=True) for o, n in targets.items()]
+        for th in ths:
+            th.start()
+        for th in ths:
+            th.join()
+        return peers
