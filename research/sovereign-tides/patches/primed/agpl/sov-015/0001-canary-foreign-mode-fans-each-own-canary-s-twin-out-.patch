+class FakeNode:
+    """A P2P listener that answers the handshake and pings and logs every tx it gets, with the
+    time it read it."""
+
+    def __init__(self, delay: float = 0.0):
+        self.magic = xbt_p2p.MAGIC["regtest"]
+        self.srv = socket.socket()
+        self.srv.bind(("127.0.0.1", 0))
+        self.srv.listen(8)
+        self.addr = f"127.0.0.1:{self.srv.getsockname()[1]}"
+        self.txs = []
+        self.delay = delay
+        threading.Thread(target=self.serve, daemon=True).start()
+
+    def serve(self):
+        while True:
+            try:
+                c, _ = self.srv.accept()
+            except OSError:
+                return
+            threading.Thread(target=self.conn, args=(c,), daemon=True).start()
+
+    def conn(self, c):
+        c.settimeout(5)
+        try:
+            while True:
+                cmd, payload = xbt_p2p.read_message(c, self.magic)
+                if cmd == "version":
+                    c.sendall(xbt_p2p.message(self.magic, "version", xbt_p2p.version_payload(1)))
+                    c.sendall(xbt_p2p.message(self.magic, "verack", b""))
+                elif cmd == "tx":
+                    self.txs.append((lc.time.time(), payload))
+                elif cmd == "ping":
+                    lc.time.sleep(self.delay)
+                    c.sendall(xbt_p2p.message(self.magic, "pong", payload))
+        except (xbt_p2p.DeliveryError, OSError):
+            pass
+        finally:
+            c.close()
+
+    def close(self):
+        self.srv.close()
+
+
