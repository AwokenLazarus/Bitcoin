diff --git a/lazarus/canary/test_lazarus_canary.py b/lazarus/canary/test_lazarus_canary.py
index 1122a57..0f1aaa1 100644
--- a/lazarus/canary/test_lazarus_canary.py
+++ b/lazarus/canary/test_lazarus_canary.py
@@ -127,6 +127,24 @@ class Policy(unittest.TestCase):
         self.assertEqual(sorted(gws), sorted(["aa" * 32, "cc" * 32, "dd" * 32]))
 
 
+    def test_primeds_sovereignty_nodes_json_is_a_nodes_file(self):
+        # SOV-010: primed writes {G: {"node", "at_height", "updated"}} (only active keys)
+        s = self.svc()
+        with tempfile.TemporaryDirectory() as d:
+            nf = os.path.join(d, "sovereignty-nodes.json")
+            with open(nf, "w") as f:
+                json.dump({"aa" * 32: {"node": "198.51.100.1:8333", "at_height": 700, "updated": 1},
+                           "bb" * 32: {"node": "[2001:db8::7]:8333", "at_height": 701, "updated": 2}}, f)
+            s.cfg["nodes_file"] = nf
+            gws = s.gateways()
+            self.assertEqual(gws["aa" * 32]["node"], "198.51.100.1:8333")
+            self.assertEqual(gws["bb" * 32]["node"], "[2001:db8::7]:8333")
+            # an unreadable or torn file costs the round nothing but its gateways
+            with open(nf, "w") as f:
+                f.write("{")
+            s.cfg["gateways"] = [{"g": "dd" * 32, "node": "127.0.0.1:18444"}]
+            self.assertEqual(sorted(s.gateways()), ["dd" * 32])
+
 class StubPool:
     def __init__(self):
