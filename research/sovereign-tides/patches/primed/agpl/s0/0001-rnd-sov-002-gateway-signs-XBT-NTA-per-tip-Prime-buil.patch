+            let prev = h32(prev);
+            assert_eq!(hex::encode(attestation_hash(&signer.script(), height, nbits, &prev)), digest);
+            let got = signer.sign(height, nbits, &prev);
+            assert_eq!(hex::encode(got), sig);
+            assert!(verify(&signer.key(), height, nbits, &prev, &got));
+            let script = attestation_script(&got);
+            assert_eq!(script.len(), 70);
+            assert!(is_attestation(&script));
+        }
+    }
+
+    #[test]
+    fn a_signature_does_not_move_to_another_tip_height_bits_or_key() {
+        let (sk, _, height, nbits, prev, _, _) = VECTORS[0];
+        let s = Signer::from_hex(sk).unwrap();
+        let prev = h32(prev);
+        let sig = s.sign(height, nbits, &prev);
+        let mut other = prev;
+        other[0] ^= 1;
+        assert!(!verify(&s.key(), height, nbits, &other, &sig));
+        assert!(!verify(&s.key(), height + 1, nbits, &prev, &sig));
+        assert!(!verify(&s.key(), height, nbits ^ 1, &prev, &sig));
+        let t = Signer::from_hex(VECTORS[1].0).unwrap();
+        assert!(!verify(&t.key(), height, nbits, &prev, &sig));
+    }
+
+    #[test]
+    fn attest_message_round_trips() {
+        let s = Signer::from_hex(VECTORS[0].0).unwrap();
+        let a = s.attest(131, 0x207fffff, &[9u8; 32]);
+        let enc = a.encode();
+        assert_eq!(enc[0], SUB_NTA_ATTEST);
+        assert_eq!(enc.len(), 1 + 1 + 32 + 4 + 4 + 32 + 64 + 1);
+        let back = NtaAttest::decode(&enc[1..]).unwrap();
+        assert_eq!(back, a);
+        assert!(back.verify());
+        let mut bad = enc.clone();
+        bad[1] = 9;
+        assert!(NtaAttest::decode(&bad[1..]).is_none());
+        assert!(NtaAttest::decode(&enc[1..enc.len() - 1]).is_none());
+    }
+
+    #[test]
+    fn only_the_exact_attestation_shape_counts() {
+        let sig = [7u8; 64];
+        let mut s = attestation_script(&sig);
+        assert!(is_attestation(&s));
+        s[5] = 0x01;
+        assert!(!is_attestation(&s));
+        assert!(!is_attestation(&attestation_script(&sig)[..69]));
+    }
+
+    #[test]
+    fn a_coinbaser_may_carry_attestations_but_no_other_long_script() {
+        let mut blob = vec![7u8];
+        let push = |blob: &mut Vec<u8>, sats: u64, script: &[u8]| {
+            blob.extend_from_slice(&sats.to_le_bytes());
+            blob.push(script.len() as u8);
+            blob.extend_from_slice(script);
+        };
+        push(&mut blob, 1000, &p2tr(&[2u8; 32]));
+        push(&mut blob, 0, &attestation_script(&[9u8; 64]));
+        let cb = crate::coinbaser::parse_coinbaser_v2(&blob).unwrap();
+        assert_eq!(cb.outputs.len(), 2);
+        assert!(is_attestation(&cb.outputs[1].script));
+        let mut other = attestation_script(&[9u8; 64]);
+        other[2] = b'X';
+        let mut bad = vec![7u8];
+        push(&mut bad, 0, &other);
+        assert!(crate::coinbaser::parse_coinbaser_v2(&bad).is_none());
+    }
+
+    /// SOV-001's vectors (`~/xbt-rnd/sov-001/vectors/nta-vectors.json`): coinbases a regtest
+    /// Knots node judged, with each attestation's preimage and digest. Every digest must come
+    /// out byte for byte, every carried signature must verify exactly when the node said
+    /// `valid`, and the attestations must follow the payees in Knots' order.
+    #[test]
+    fn sov_001_node_vectors() {
+        let doc: serde_json::Value = serde_json::from_str(include_str!("../../../prime/wire/tests/data/nta-vectors.json")).unwrap();
+        assert_eq!(doc["tag"].as_str().unwrap().as_bytes(), TAG);
+        let vs = doc["vectors"].as_array().unwrap();
+        assert!(vs.len() >= 5);
+        let hx = |v: &serde_json::Value| hex::decode(v.as_str().unwrap()).unwrap();
+        for v in vs {
+            let name = v["name"].as_str().unwrap();
+            let height = v["height"].as_u64().unwrap() as u32;
+            let nbits = u32::from_str_radix(v["nBits"].as_str().unwrap(), 16).unwrap();
+            let mut prev: [u8; 32] = hx(&v["hashPrevBlock"]).try_into().unwrap();
+            prev.reverse(); // display order -> internal
+            let mut all_ok = true;
+            for a in v["attestations"].as_array().unwrap() {
+                let script = hx(&a["payee_script"]);
+                let digest = attestation_hash(&script, height, nbits, &prev);
+                assert_eq!(hex::encode(digest), a["digest"].as_str().unwrap(), "{name}: digest");
+                let key: [u8; 32] = hx(&a["payee_key"]).try_into().unwrap();
+                assert_eq!(p2tr(&key), script, "{name}: payee script");
+                let sig = a["carried_sig"].as_str().and_then(|s| hex::decode(s).ok()).and_then(|b| <[u8; 64]>::try_from(b).ok());
+                all_ok &= sig.is_some_and(|sig| verify(&key, height, nbits, &prev, &sig));
+                // Our signer over the same digest verifies under the payee key when it holds it.
+                if let Some(sk) = a["signer_seckey"].as_str().and_then(Signer::from_hex) {
+                    if sk.key() == key {
+                        assert!(verify(&key, height, nbits, &prev, &sk.sign(height, nbits, &prev)), "{name}: sign");
+                    }
+                }
+            }
+            let valid = v["result"] == "valid";
+            assert_eq!(all_ok, valid, "{name}: signatures vs node verdict {}", v["result"]);
+            if valid {
+                let outs: Vec<(u64, Vec<u8>)> = v["coinbase_outputs"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .map(|o| (o["value"].as_u64().unwrap(), hx(&o["scriptPubKey"])))
+                    .collect();
+                let payees = required_payees(outs.iter().map(|(s, p)| (*s, p.as_slice())));
+                let atts: Vec<&[u8]> = outs.iter().map(|(_, p)| p.as_slice()).filter(|p| is_attestation(p)).collect();
+                let want: Vec<Vec<u8>> = v["attestations"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .map(|a| attestation_script(&hx(&a["carried_sig"]).try_into().unwrap()))
+                    .collect();
+                assert_eq!(payees.len(), atts.len(), "{name}: one attestation per distinct payee");
+                assert_eq!(atts, want.iter().map(|w| w.as_slice()).collect::<Vec<_>>(), "{name}: order");
+                let order: Vec<Vec<u8>> = v["attestations"].as_array().unwrap().iter().map(|a| hx(&a["payee_script"])).collect();
+                assert_eq!(payees, order.iter().map(|o| o.as_slice()).collect::<Vec<_>>(), "{name}: payee order");
+            }
+        }
+    }
+}
