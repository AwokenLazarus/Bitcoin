+
+    def test_the_pool_node_is_never_given_the_key(self):
+        for m in ("importprivkey", "importdescriptors", "signrawtransactionwithkey", "signrawtransactionwithwallet",
+                  "dumpprivkey", "getdescriptorinfo"):
+            self.assertNotIn(m, lc.POOL_METHODS)
