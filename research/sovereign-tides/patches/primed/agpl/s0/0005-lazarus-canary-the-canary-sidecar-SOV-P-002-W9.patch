+"""Unit tests for lazarus-canary (no node needed): python3 -m unittest test_lazarus_canary"""
+import json
+import os
+import socket
+import struct
+import tempfile
+import threading
+import unittest
+
+import lazarus_canary as lc
+import xbt_p2p
+
+
+class Tx(unittest.TestCase):
+    def test_unsigned_tx_layout_and_txid(self):
+        raw = lc.unsigned_tx("11" * 32, 3, 19_000, b"\x00\x14" + b"\x22" * 20)
+        self.assertEqual(raw[:4], b"\x02\x00\x00\x00")
+        self.assertEqual(raw[5:37], bytes.fromhex("11" * 32)[::-1])
+        self.assertEqual(raw[37:41], (3).to_bytes(4, "little"))
+        self.assertEqual(len(raw), 4 + 1 + 36 + 1 + 4 + 1 + 8 + 1 + 22 + 4)
+        self.assertEqual(lc.txid_of(raw), xbt_p2p.sha256d(raw)[::-1].hex())
+
+    def test_segwit_txid_is_the_legacy_hash(self):
+        legacy = lc.unsigned_tx("ab" * 32, 0, 5_000, b"\x00\x14" + b"\x01" * 20)
+        wit = b"\x02" + b"\x47" + b"\x30" * 71 + b"\x21" + b"\x02" * 33
+        segwit = legacy[:4] + b"\x00\x01" + legacy[4:-4] + wit + legacy[-4:]
+        self.assertEqual(lc.txid_of(segwit), lc.txid_of(legacy))
+
+
+class P2P(unittest.TestCase):
+    def test_message_framing(self):
+        m = xbt_p2p.message(xbt_p2p.MAGIC["regtest"], "ping", b"\x01" * 8)
+        self.assertEqual(m[:4], bytes.fromhex("fabfb5da"))
+        self.assertEqual(m[4:16], b"ping" + b"\x00" * 8)
+        self.assertEqual(struct.unpack("<I", m[16:20])[0], 8)
+        self.assertEqual(m[20:24], xbt_p2p.sha256d(b"\x01" * 8)[:4])
+
+    def test_version_payload(self):
+        v = xbt_p2p.version_payload(7, now=1_700_000_000)
+        self.assertEqual(struct.unpack("<i", v[:4])[0], 70016)
+        self.assertEqual(v[-1], 1, "relay flag on, or the node would not take the tx")
+        self.assertIn(b"/Satoshi:", v)
+
+    def test_one_shot_delivery_against_a_fake_node(self):
+        """version/verack, then the tx, then ping/pong; nothing else is sent."""
+        magic = xbt_p2p.MAGIC["regtest"]
+        srv = socket.socket()
+        srv.bind(("127.0.0.1", 0))
+        srv.listen(1)
+        port = srv.getsockname()[1]
+        seen = []
+
+        def node():
+            c, _ = srv.accept()
+            c.settimeout(5)
+            try:
+                while True:
+                    cmd, payload = xbt_p2p.read_message(c, magic)
+                    seen.append((cmd, payload))
+                    if cmd == "version":
+                        c.sendall(xbt_p2p.message(magic, "version", xbt_p2p.version_payload(1)))
+                        c.sendall(xbt_p2p.message(magic, "ping", b"\x09" * 8))
+                        c.sendall(xbt_p2p.message(magic, "verack", b""))
+                    elif cmd == "ping":
+                        c.sendall(xbt_p2p.message(magic, "pong", payload))
+            except (xbt_p2p.DeliveryError, OSError):
+                pass
+            finally:
+                c.close()
+
+        th = threading.Thread(target=node, daemon=True)
+        th.start()
+        t = xbt_p2p.deliver(f"127.0.0.1:{port}", b"\xab" * 60, network="regtest", timeout=5)
+        th.join(5)
+        srv.close()
+        self.assertGreater(t, 0)
+        cmds = [c for c, _ in seen]
+        self.assertEqual(cmds, ["version", "verack", "tx", "ping"])
+        self.assertEqual(seen[2][1], b"\xab" * 60)
+
+    def test_onion_needs_a_proxy(self):
+        with self.assertRaises(xbt_p2p.DeliveryError):
+            xbt_p2p.deliver("abcdef.onion:8333", b"", network="main")
+
+    def test_unreachable_node_is_a_delivery_error(self):
+        s = socket.socket()
+        s.bind(("127.0.0.1", 0))
+        port = s.getsockname()[1]
+        s.close()
+        with self.assertRaises(xbt_p2p.DeliveryError):
+            xbt_p2p.deliver(f"127.0.0.1:{port}", b"", timeout=2)
+
+
+class Policy(unittest.TestCase):
+    def svc(self):
+        s = lc.Canary.__new__(lc.Canary)
+        s.cfg = lc.merged({})
+        s.cfg["cadence"]["jitter"] = 0.0
+        s.rng = __import__("random").Random(1)
+        return s
+
+    def test_cadence_follows_the_gateways_record(self):
+        s = self.svc()
+        c = s.cfg["cadence"]
+        self.assertEqual(s.interval(None), c["new_secs"])
+        self.assertEqual(s.interval({"canaries_due": 9}), c["new_secs"])
+        self.assertEqual(s.interval({"canaries_due": 40, "canary_rate": 0.9}), c["enrolled_secs"])
+        self.assertEqual(s.interval({"canaries_due": 120, "canary_rate": 0.85}), c["clean_secs"])
+        self.assertEqual(s.interval({"canaries_due": 120, "canary_rate": 0.5}), c["enrolled_secs"])
+        self.assertEqual(s.interval({"canaries_due": 500, "canary_rate": 1.0, "flagged": True}), c["flagged_secs"])
+
+    def test_jitter_stays_in_bounds(self):
+        s = self.svc()
+        s.cfg["cadence"]["jitter"] = 0.5
+        xs = [s.interval({"canaries_due": 40}) for _ in range(500)]
+        self.assertTrue(all(1800 <= x <= 5400 for x in xs))
+
+    def test_gateways_from_config_and_nodes_file(self):
+        s = self.svc()
+        with tempfile.TemporaryDirectory() as d:
+            nf = os.path.join(d, "nodes.json")
+            with open(nf, "w") as f:
+                json.dump({"AA" * 32: "10.0.0.2:8333", "bb" * 32: "none", "cc" * 32: "x.onion:8333"}, f)
+            s.cfg["nodes_file"] = nf
+            s.cfg["gateways"] = [{"g": "DD" * 32, "node": "127.0.0.1:18444"}, {"g": "ee" * 32, "node": "none"}]
+            gws = s.gateways()
+        self.assertEqual(sorted(gws), sorted(["aa" * 32, "cc" * 32, "dd" * 32]))
+
+
+class StubPool:
+    def __init__(self):
+        self.calls = []
+
+    def call(self, method, *params, **kw):
+        self.calls.append((method, params))
+        return None
+
+
+class Release(unittest.TestCase):
+    def test_a_shared_canary_is_released_after_its_window_and_only_once(self):
+        s = lc.Canary.__new__(lc.Canary)
+        s.cfg = lc.merged({})
+        s.pool = StubPool()
+        now = lc.time.time()
+        s.state = {"inflight": [
+            {"kind": "shared", "t": now - 700, "txids": ["aa" * 32], "delta": -2_890},
+            {"kind": "shared", "t": now - 60, "txids": ["bb" * 32], "delta": -2_890},
+            {"kind": "decoy", "t": now - 700, "txids": ["cc" * 32], "delta": 1_000_000},
+            {"kind": "own", "t": now - 700, "txids": ["dd" * 32, "ee" * 32]},
+        ]}
+        s.release_shared()
+        s.release_shared()
+        self.assertEqual(s.pool.calls, [("prioritisetransaction", ("aa" * 32, 0, 2_890))])
+        self.assertIn("released", s.state["inflight"][0])
+
+
+class Settle(unittest.TestCase):
+    def test_settling_saves_the_state_with_the_ledger(self):
+        """A canary settled between rounds is on disk at once (it used to wait for the next round)."""
+        class Pool(StubPool):
+            def call(self, method, *params, **kw):
+                self.calls.append((method, params))
+                if method == "gettxout":
+                    txid, vout = params[0], params[1]
+                    return {"value": 0.00018899} if txid == "cc" * 32 else None
+                return None
+
+        with tempfile.TemporaryDirectory() as d:
+            s = lc.Canary.__new__(lc.Canary)
+            s.cfg = lc.merged({})
+            s.pool = Pool()
+            s.state_path, s.ledger_path = os.path.join(d, "state.json"), os.path.join(d, "l.jsonl")
+            s.state = s._load()
+            s.state["inflight"] = [{"kind": "own", "gateway": "g", "t": lc.time.time(), "fees": [1100, 1101],
+                                    "input": {"txid": "aa" * 32, "vout": 0, "value": 20_000}, "txids": ["bb" * 32, "cc" * 32]}]
+            self.assertTrue(s.resolve())
+            with open(s.state_path) as f:
+                on_disk = json.load(f)
