+            self.assertEqual(on_disk["utxos"], [{"txid": "cc" * 32, "vout": 0, "value": 18_899}])
+            self.assertEqual(on_disk["inflight"], [])
+            with open(s.ledger_path) as f:
+                rec = json.loads(f.read())
+            self.assertEqual((rec["which"], rec["fee"]), ("C'", 1_101))
+            self.assertFalse(s.resolve(), "nothing moved: nothing written")
