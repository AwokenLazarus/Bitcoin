@@ -0,0 +1,545 @@
+#!/usr/bin/env python3
+"""lazarus-canary: places Sovereign TIDES canaries for primed (SOV-P-002 W9, §5).
+
+Per round:
+  own     for each registered gateway G that is due: a pair C / C' spending one canary UTXO.
+          The pool node is told never to template C (`prioritisetransaction C 0 -1e8`) before
+          C exists anywhere; C goes over one P2P connection to G's registered node and nowhere
+          else; C' (1 sat more fee) goes to the pool node. One of the pair confirms; both pay
+          back to the canary wallet.
+  shared  one tx D at a market fee, pre-prioritised on the pool node to a modified feerate
+          under its -blockmintxfee, then sent to the pool node: every node relays and templates
+          it on its base fee; the pool node keeps it and never templates it.
+  decoy   one zero-fee tx Q, pre-prioritised +delta on the pool node only: the pool templates
+          it, no peer accepts it.
+Every canary is reported to primed (`POST /sovereignty/canary`, `X-Sovereignty-Token`) with its
+kind; primed checks gateways' jobs for them (W8).
+
+Keys: the canary key is a WIF in `wallet.key_file` (0600). It is used only in
+`signrawtransactionwithkey` on the *signer* node, which is never asked to broadcast (its RPC is
+restricted to an allowlist here) and should have no peers. The pool node never holds the key in a
+wallet: at start and on every scan the sidecar asks each of the pool node's wallets about the
+canary address and refuses to run if one knows it.
+
+usage: lazarus_canary.py -c lazarus-canary.toml run|once|scan|status|check-isolation
+"""
+import argparse
+import base64
+import json
+import os
+import random
+import stat
+import sys
+import time
+import tomllib
+import urllib.error
+import urllib.request
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import xbt_p2p  # noqa: E402
+
+SAT = 100_000_000
+# P2WPKH 1-in 1-out: 10.5 + 68 + 31 vbytes, rounded up
+CANARY_VSIZE = 110
+
+DEFAULTS = {
+    "network": "regtest",
+    "prime": {"url": "http://127.0.0.1:28916", "token_file": "/var/lib/primed/sovereignty.token"},
+    "pool_node": {"url": "http://127.0.0.1:8332", "cookie": "", "user": "", "password": "",
+                  "blockmintxfee_satvb": 1.5, "wallets_rpc": True},
+    "signer": {"url": "", "cookie": "", "user": "", "password": ""},
+    "wallet": {"key_file": "/etc/lazarus-canary/canary.wif", "state_dir": "/var/lib/lazarus-canary",
+               "min_utxo_sats": 2_000, "inflight_max_secs": 86_400},
+    "fees": {"fee_rate_satvb": 0.0, "fallback_fee_rate_satvb": 5.0, "twin_extra_sats": 1,
+             "shared_modified_satvb": 0.0, "decoy_delta_sats": 1_000_000, "shared_release_secs": 600},
+    "cadence": {"tick_secs": 30, "round_min_gap_secs": 1_200, "new_secs": 1_200, "new_until_due": 10,
+                "enrolled_secs": 3_600, "clean_secs": 14_400, "clean_min_due": 100, "clean_min_rate": 0.8,
+                "flagged_secs": 1_200, "jitter": 0.5, "shared": True, "decoy": True},
+    "delivery": {"mode": "direct", "proxy": "", "timeout_secs": 20},
+    "gateways": [],
+    "nodes_file": "",
+}
+
+
+def merged(cfg: dict) -> dict:
+    out = json.loads(json.dumps(DEFAULTS))
+    for k, v in cfg.items():
+        if isinstance(v, dict) and isinstance(out.get(k), dict):
+            out[k].update(v)
+        else:
+            out[k] = v
+    return out
+
+
+def read_text(path: str) -> str:
+    with open(path) as f:
+        return f.read()
+
+
+def log(*a):
+    print(time.strftime("%Y-%m-%dT%H:%M:%S"), *a, flush=True)
+
+
+# --- RPC ---------------------------------------------------------------------------------------
+
+class Rpc:
+    """JSON-RPC to one node, limited to the methods its role needs."""
+
+    def __init__(self, conf: dict, allowed: set[str], role: str):
+        self.url = conf["url"].rstrip("/")
+        self.role = role
+        self.allowed = allowed
+        user, pw = conf.get("user") or "", conf.get("password") or ""
+        if conf.get("cookie"):
+            user, _, pw = read_text(conf["cookie"]).strip().partition(":")
+        self.auth = "Basic " + base64.b64encode(f"{user}:{pw}".encode()).decode()
+
+    def call(self, method: str, *params, wallet: str | None = None):
+        if method not in self.allowed:
+            raise PermissionError(f"{self.role} node: {method} is not allowed")
+        body = json.dumps({"jsonrpc": "1.0", "id": 0, "method": method, "params": list(params)}).encode()
+        url = self.url + (f"/wallet/{urllib.request.quote(wallet)}" if wallet is not None else "")
+        req = urllib.request.Request(url, body, {"Authorization": self.auth, "Content-Type": "application/json"})
+        try:
+            with urllib.request.urlopen(req, timeout=60) as r:
+                return json.load(r)["result"]
+        except urllib.error.HTTPError as e:
+            try:
+                err = json.load(e).get("error")
+            except Exception:  # noqa: BLE001
+                err = str(e)
+            raise RuntimeError(f"{self.role} {method}: {err}") from None
+
+
+POOL_METHODS = {"prioritisetransaction", "sendrawtransaction", "getmempoolinfo", "getmempoolentry",
+                "gettxout", "scantxoutset", "estimatesmartfee", "listwallets", "getaddressinfo",
+                "getblockcount", "getblocktemplate"}
+# the signer never sees sendrawtransaction: it signs and nothing else
+SIGNER_METHODS = {"signrawtransactionwithkey", "getdescriptorinfo", "deriveaddresses", "validateaddress"}
+
+
+# --- transactions ------------------------------------------------------------------------------
+
+def txid_of(raw: bytes) -> str:
+    """Display-hex txid of a raw tx in either serialization (the legacy bytes' SHA256d)."""
+    if raw[4:6] == b"\x00\x01":
+        # version | marker flag | ins outs | witnesses | locktime: rebuild the legacy bytes
+        pos = 6
+        n_in, pos = read_varint(raw, pos)
+        for _ in range(n_in):
+            pos += 36
+            sl, pos = read_varint(raw, pos)
+            pos += sl + 4
+        n_out, pos = read_varint(raw, pos)
+        for _ in range(n_out):
+            pos += 8
+            sl, pos = read_varint(raw, pos)
+            pos += sl
+        body_end = pos
+        legacy = raw[:4] + raw[6:body_end] + raw[-4:]
+    else:
+        legacy = raw
+    return xbt_p2p.sha256d(legacy)[::-1].hex()
+
+
+def read_varint(b: bytes, pos: int) -> tuple[int, int]:
+    first = b[pos]
+    if first < 0xFD:
+        return first, pos + 1
+    size = {0xFD: 2, 0xFE: 4, 0xFF: 8}[first]
+    return int.from_bytes(b[pos + 1:pos + 1 + size], "little"), pos + 1 + size
+
+
+def unsigned_tx(txid: str, vout: int, value_out: int, script_out: bytes) -> bytes:
+    """One input, one output, version 2, locktime 0, final sequence (no replacement signal)."""
+    return (b"\x02\x00\x00\x00" + b"\x01" + bytes.fromhex(txid)[::-1] + vout.to_bytes(4, "little") + b"\x00"
+            + b"\xff\xff\xff\xff" + b"\x01" + value_out.to_bytes(8, "little") + xbt_p2p.varint(len(script_out))
+            + script_out + b"\x00\x00\x00\x00")
+
+
+# --- the service -------------------------------------------------------------------------------
+
+class Canary:
+    def __init__(self, cfg: dict):
+        self.cfg = cfg
+        self.net = cfg["network"]
+        self.pool = Rpc(cfg["pool_node"], POOL_METHODS, "pool")
+        self.signer = Rpc(cfg["signer"], SIGNER_METHODS, "signer")
+        self.state_dir = cfg["wallet"]["state_dir"]
+        os.makedirs(self.state_dir, exist_ok=True)
+        self.state_path = os.path.join(self.state_dir, "state.json")
+        self.ledger_path = os.path.join(self.state_dir, "canaries.jsonl")
+        self.wif = self._read_key()
+        self.address, self.script = self._address()
+        self.state = self._load()
+        self.rng = random.Random()
+
+    # key and address
+    def _read_key(self) -> str:
+        path = self.cfg["wallet"]["key_file"]
+        st = os.stat(path)
+        if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
+            raise SystemExit(f"{path} is readable by group or others; chmod 600 it")
+        return read_text(path).strip()
+
+    def _address(self) -> tuple[str, bytes]:
+        info = self.signer.call("getdescriptorinfo", f"wpkh({self.wif})")
+        # the public descriptor (no key material) is what the signer hands back
+        addr = self.signer.call("deriveaddresses", info["descriptor"])[0]
+        spk = bytes.fromhex(self.signer.call("validateaddress", addr)["scriptPubKey"])
+        if len(spk) != 22 or spk[:2] != b"\x00\x14":
+            raise SystemExit("canary key must give a P2WPKH script")
+        return addr, spk
+
+    def check_isolation(self) -> list[str]:
+        """Wallets on the pool node that know the canary address (must be none)."""
+        if not self.cfg["pool_node"].get("wallets_rpc", True):
+            return []
+        bad = []
+        for w in self.pool.call("listwallets"):
+            info = self.pool.call("getaddressinfo", self.address, wallet=w)
+            if info.get("ismine") or info.get("iswatchonly") or info.get("solvable"):
+                bad.append(w)
+        return bad
+
+    # state
+    def _load(self) -> dict:
+        try:
+            return json.loads(read_text(self.state_path))
+        except (OSError, ValueError):
+            return {"utxos": [], "inflight": [], "rounds": 0, "last_round": 0, "next_due": {}, "fees_planned": 0,
+                    "fees_paid": 0, "resolved": 0, "delivered": {"own": 0, "shared": 0, "decoy": 0},
+                    "delivery_failed": 0, "leaks": 0}
+
+    def save(self):
+        tmp = self.state_path + ".tmp"
+        with open(tmp, "w") as f:
+            json.dump(self.state, f, indent=1)
+        os.replace(tmp, self.state_path)
+
+    def ledger(self, rec: dict):
+        with open(self.ledger_path, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+
+    def scan(self) -> int:
+        """Rebuild the UTXO list from the chain (slow on mainnet: run it for refills)."""
+        bad = self.check_isolation()
+        if bad:
+            raise SystemExit(f"the canary address is known to pool-node wallet(s) {bad}: refusing")
+        res = self.pool.call("scantxoutset", "start", [f"addr({self.address})"])
+        busy = {(i["input"]["txid"], i["input"]["vout"]) for i in self.state["inflight"]}
+        self.state["utxos"] = [
+            {"txid": u["txid"], "vout": u["vout"], "value": round(u["amount"] * SAT)}
+            for u in res.get("unspents", []) if (u["txid"], u["vout"]) not in busy
+        ]
+        self.save()
+        return len(self.state["utxos"])
+
+    # gateways and cadence
+    def gateways(self) -> dict[str, dict]:
+        out = {}
+        for g in self.cfg.get("gateways", []):
+            out[g["g"].lower()] = dict(g)
+        nf = self.cfg.get("nodes_file")
+        if nf and os.path.exists(nf):
+            data = json.loads(read_text(nf))
+            items = data.items() if isinstance(data, dict) else ((d.get("g"), d) for d in data)
+            for g, v in items:
+                node = v if isinstance(v, str) else (v or {}).get("node")
+                if g and node and node != "none":
+                    out.setdefault(g.lower(), {"g": g.lower(), "node": node})
+        return {g: v for g, v in out.items() if v.get("node") and v["node"] != "none"}
+
+    def prime_report(self) -> dict:
+        try:
+            with urllib.request.urlopen(self.cfg["prime"]["url"].rstrip("/") + "/sovereignty.json", timeout=30) as r:
+                return json.load(r).get("gateways") or {}
+        except Exception as e:  # noqa: BLE001
+            log("primed report unavailable:", e)
+            return {}
+
+    def interval(self, row: dict | None) -> float:
+        c = self.cfg["cadence"]
+        row = row or {}
+        due = row.get("canaries_due") or 0
+        rate = row.get("canary_rate")
+        if row.get("flagged"):
+            base = c["flagged_secs"]
+        elif due < c["new_until_due"]:
+            base = c["new_secs"]
+        elif due >= c["clean_min_due"] and (rate or 0) >= c["clean_min_rate"]:
+            base = c["clean_secs"]
+        else:
+            base = c["enrolled_secs"]
+        j = c["jitter"]
+        return base * self.rng.uniform(1 - j, 1 + j)
+
+    # fees
+    def fee_rate(self) -> float:
+        f = self.cfg["fees"]
+        if f["fee_rate_satvb"]:
+            return float(f["fee_rate_satvb"])
+        try:
+            est = self.pool.call("estimatesmartfee", 6)
+            if est.get("feerate"):
+                return est["feerate"] * SAT / 1000
+        except RuntimeError:
+            pass
+        return float(f["fallback_fee_rate_satvb"])
+
+    def shared_modified_sats(self) -> int:
+        f = self.cfg["fees"]
+        rate = f["shared_modified_satvb"]
+        if not rate:
+            relay = self.pool.call("getmempoolinfo")["minrelaytxfee"] * SAT / 1000
+            rate = (relay + float(self.cfg["pool_node"]["blockmintxfee_satvb"])) / 2
+        return int(rate * CANARY_VSIZE)
+
+    # utxos
+    def take_utxo(self, min_value: int) -> dict | None:
+        ok = [u for u in self.state["utxos"] if u["value"] >= min_value]
+        if not ok:
+            return None
+        u = self.rng.choice(ok)
+        self.state["utxos"].remove(u)
+        return u
+
+    def sign(self, u: dict, value_out: int) -> tuple[bytes, str]:
+        raw = unsigned_tx(u["txid"], u["vout"], value_out, self.script)
+        prev = [{"txid": u["txid"], "vout": u["vout"], "scriptPubKey": self.script.hex(),
+                 "amount": round(u["value"] / SAT, 8)}]
+        res = self.signer.call("signrawtransactionwithkey", raw.hex(), [self.wif], prev)
+        if not res.get("complete"):
+            raise RuntimeError(f"signing failed: {res.get('errors')}")
+        signed = bytes.fromhex(res["hex"])
+        return signed, txid_of(signed)
+
+    def report(self, gateway: str, t: float, txid: str, kind: str):
+        token = read_text(self.cfg["prime"]["token_file"]).strip()
+        body = json.dumps({"gateway": gateway, "t": t, "txid": txid, "kind": kind}).encode()
+        req = urllib.request.Request(self.cfg["prime"]["url"].rstrip("/") + "/sovereignty/canary", body,
+                                     {"Content-Type": "application/json", "X-Sovereignty-Token": token})
+        with urllib.request.urlopen(req, timeout=15) as r:
+            res = json.load(r)
+        if not res.get("ok"):
+            raise RuntimeError(f"primed refused the canary: {res}")
+
+    # one round
+    def own(self, g: str, node: str, rate: float) -> bool:
+        fee = int(rate * CANARY_VSIZE)
+        u = self.take_utxo(fee + self.cfg["wallet"]["min_utxo_sats"])
+        if u is None:
+            log("no canary UTXO left for", g[:16])
+            return False
+        extra = int(self.cfg["fees"]["twin_extra_sats"])
+        c_raw, c = self.sign(u, u["value"] - fee)
+        twin_raw, twin = self.sign(u, u["value"] - fee - extra)
+        # the pool node must never template C: set the delta before C exists anywhere
+        self.pool.call("prioritisetransaction", c, 0, -SAT)
+        d = self.cfg["delivery"]
+        try:
+            t = xbt_p2p.deliver(node, c_raw, network=self.net, proxy=(d["proxy"] or None) if d["mode"] == "socks5" else None,
+                                timeout=float(d["timeout_secs"]))
+        except xbt_p2p.DeliveryError as e:
+            log(f"own canary for {g[:16]} not delivered ({e}); its UTXO is kept")
+            self.pool.call("prioritisetransaction", c, 0, SAT)
+            self.state["utxos"].append(u)
+            self.state["delivery_failed"] += 1
+            return False
+        try:
+            self.pool.call("sendrawtransaction", twin_raw.hex())
+        except RuntimeError as e:
+            # C reached the pool first (relayed from G's node, deprioritised there) and C' lost:
+            # the canary still stands, the pool just has no twin to mine
+            log(f"twin for {g[:16]} refused by the pool node: {e}")
+        self.report(g, t, c, "own")
+        self.ledger({"event": "placed", "kind": "own", "gateway": g, "t": t, "txid": c, "twin": twin, "fee": fee})
+        self.state["inflight"].append({"kind": "own", "gateway": g, "t": t, "input": u, "txids": [c, twin],
+                                       "fees": [fee, fee + extra]})
+        self.state["fees_planned"] += fee + extra
+        self.state["delivered"]["own"] += 1
+        return True
+
+    def shared_or_decoy(self, kind: str, rate: float) -> bool:
+        fee = int(rate * CANARY_VSIZE) if kind == "shared" else 0
+        u = self.take_utxo(fee + self.cfg["wallet"]["min_utxo_sats"])
+        if u is None:
+            log(f"no canary UTXO left for a {kind} canary")
+            return False
+        raw, txid = self.sign(u, u["value"] - fee)
+        delta = self.shared_modified_sats() - fee if kind == "shared" else int(self.cfg["fees"]["decoy_delta_sats"])
+        # prioritised before acceptance: prioritising after races the template rebuild (SOV-004)
+        self.pool.call("prioritisetransaction", txid, 0, delta)
+        try:
+            self.pool.call("sendrawtransaction", raw.hex(), 0)
+        except RuntimeError as e:
+            log(f"{kind} canary refused by the pool node: {e}")
+            self.pool.call("prioritisetransaction", txid, 0, -delta)
+            self.state["utxos"].append(u)
+            return False
+        t = time.time()
+        self.report("*", t, txid, kind)
+        self.ledger({"event": "placed", "kind": kind, "gateway": "*", "t": t, "txid": txid, "fee": fee})
+        self.state["inflight"].append({"kind": kind, "gateway": "*", "t": t, "input": u, "txids": [txid], "fees": [fee],
+                                       "delta": delta})
+        self.state["fees_planned"] += fee
+        self.state["delivered"][kind] += 1
+        return True
+
+    def release_shared(self):
+        """A shared canary is evidence only while primed can judge it (checks of jobs up to 180 s
+        after it). After `shared_release_secs` its priority is lifted so the pool node mines it too;
+        otherwise only other pools' blocks would, and its UTXO would stay locked for as long."""
+        after = float(self.cfg["fees"]["shared_release_secs"])
+        now = time.time()
+        for f in self.state["inflight"]:
+            if f["kind"] == "shared" and not f.get("released") and after > 0 and now - f["t"] > after:
+                try:
+                    self.pool.call("prioritisetransaction", f["txids"][0], 0, -int(f.get("delta", 0)))
+                    f["released"] = now
+                except RuntimeError as e:
+                    log("could not release a shared canary:", e)
+
+    def resolve(self) -> bool:
+        """Return settled canaries' outputs to the UTXO list and book what they cost. Saves the
+        state when anything moved, so the ledger and state.json never disagree after a restart."""
+        before = json.dumps(self.state, sort_keys=True)
+        self.release_shared()
+        keep = []
+        now = time.time()
+        for f in self.state["inflight"]:
+            u = f["input"]
+            if self.pool.call("gettxout", u["txid"], u["vout"], False) is not None:
+                if now - f["t"] > self.cfg["wallet"]["inflight_max_secs"]:
+                    alive = False
+                    for x in f["txids"]:
+                        try:
+                            self.pool.call("getmempoolentry", x)
+                            alive = True
+                        except RuntimeError:
+                            pass
+                    if not alive:
+                        log(f"{f['kind']} canary {f['txids'][0][:16]} expired unconfirmed; input released")
+                        self.state["utxos"].append(u)
+                        continue
+                keep.append(f)
+                continue
+            got = None
+            for i, x in enumerate(f["txids"]):
+                o = self.pool.call("gettxout", x, 0, False)
+                if o is not None:
+                    got = (i, x, round(o["value"] * SAT))
+                    break
+            if got is None:
+                # the input is spent in the chain but neither output is there (spent already,
+                # or a reorg in flight): look again next time, give up after the max age
+                if now - f["t"] <= self.cfg["wallet"]["inflight_max_secs"]:
+                    keep.append(f)
+                else:
+                    log(f"{f['kind']} canary {f['txids'][0][:16]}: outcome unknown, dropped")
+                continue
+            i, x, value = got
+            fee = u["value"] - value
+            self.state["utxos"].append({"txid": x, "vout": 0, "value": value})
+            self.state["fees_paid"] += fee
+            self.state["resolved"] += 1
+            self.ledger({"event": "resolved", "kind": f["kind"], "gateway": f["gateway"], "t": f["t"], "confirmed": x,
+                         "which": ("C", "C'")[i] if f["kind"] == "own" else f["kind"], "fee": fee, "resolved_at": now})
+        self.state["inflight"] = keep
+        changed = json.dumps(self.state, sort_keys=True) != before
+        if changed:
+            self.save()
+        return changed
+
+    def leak_check(self) -> int:
+        """Own and shared canaries in the pool node's template right now (must be 0)."""
+        must_not = {f["txids"][0] for f in self.state["inflight"] if f["kind"] in ("own", "shared")}
+        if not must_not:
+            return 0
+        tpl = self.pool.call("getblocktemplate", {"rules": ["segwit", "blake2b"]})
+        leaks = sum(1 for t in tpl.get("transactions", []) if t["txid"] in must_not)
+        if leaks:
+            log(f"LEAK: {leaks} canaries in the pool node's template")
+        self.state["leaks"] += leaks
+        return leaks
+
+    def round(self, force: bool = False) -> dict:
+        self.resolve()
+        c = self.cfg["cadence"]
+        now = time.time()
+        gws = self.gateways()
+        rows = self.prime_report()
+        due = [g for g in gws if force or self.state["next_due"].get(g, 0) <= now]
+        if not due or (not force and now - self.state["last_round"] < c["round_min_gap_secs"]):
+            return {}
+        rate = self.fee_rate()
+        placed = {"own": 0, "shared": 0, "decoy": 0}
+        planned_before = self.state["fees_planned"]
+        for g in due:
+            if self.own(g, gws[g]["node"], rate):
+                placed["own"] += 1
+            self.state["next_due"][g] = now + self.interval(rows.get(g))
+        for kind in ("shared", "decoy"):
+            if c.get(kind, True) and self.shared_or_decoy(kind, rate):
+                placed[kind] += 1
+        self.state["rounds"] += 1
+        self.state["last_round"] = now
+        info = {"round": self.state["rounds"], "t": now, "placed": placed, "fee_rate": rate,
+                "fees_planned": self.state["fees_planned"] - planned_before, "utxos": len(self.state["utxos"]),
+                "inflight": len(self.state["inflight"])}
+        try:
+            info["leaks"] = self.leak_check()
+        except RuntimeError as e:
+            log("leak check failed:", e)
+        self.save()
+        log("round", json.dumps(info))
+        return info
+
+    def run(self):
+        bad = self.check_isolation()
+        if bad:
+            raise SystemExit(f"the canary address is known to pool-node wallet(s) {bad}: refusing")
+        if not self.state["utxos"] and not self.state["inflight"]:
+            log("no UTXOs on file; scanning")
+            log("utxos:", self.scan())
+        log(f"lazarus-canary up: {len(self.gateways())} gateways with a node, {len(self.state['utxos'])} UTXOs")
+        tick = float(self.cfg["cadence"]["tick_secs"])
+        while True:
+            try:
+                self.round()
+            except Exception as e:  # noqa: BLE001
+                log("round failed:", repr(e))
+            time.sleep(tick)
+
+    def status(self) -> dict:
+        s = self.state
+        return {"address": self.address, "utxos": len(s["utxos"]), "utxo_sats": sum(u["value"] for u in s["utxos"]),
+                "inflight": len(s["inflight"]), "rounds": s["rounds"], "delivered": s["delivered"],
+                "delivery_failed": s["delivery_failed"], "fees_planned": s["fees_planned"], "fees_paid": s["fees_paid"],
+                "resolved": s["resolved"], "leaks": s["leaks"]}
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("-c", "--config", required=True)
+    ap.add_argument("command", choices=["run", "once", "scan", "status", "check-isolation"])
+    a = ap.parse_args()
+    with open(a.config, "rb") as f:
+        cfg = merged(tomllib.load(f))
+    svc = Canary(cfg)
+    if a.command == "run":
+        svc.run()
+    elif a.command == "once":
+        print(json.dumps(svc.round(force=True)))
+    elif a.command == "scan":
+        print(json.dumps({"utxos": svc.scan()}))
+    elif a.command == "status":
+        print(json.dumps(svc.status(), indent=1))
+    elif a.command == "check-isolation":
+        bad = svc.check_isolation()
+        print(json.dumps({"address": svc.address, "pool_wallets_knowing_it": bad}))
+        sys.exit(1 if bad else 0)
+
+
+if __name__ == "__main__":
+    main()
