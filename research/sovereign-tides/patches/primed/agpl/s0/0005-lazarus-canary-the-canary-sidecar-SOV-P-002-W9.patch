+# SOV-P-002 S3: the canary sidecar. Shipped, not installed: install by hand when S3 starts.
+[Unit]
+Description=Lazarus canary sidecar (Sovereign TIDES canaries for primed)
+After=network-online.target lazarus-prime.service
+Wants=network-online.target
+
+[Service]
+Type=simple
+User=lazarus-canary
+Group=lazarus-canary
+ExecStart=/usr/bin/python3 /opt/lazarus-canary/lazarus_canary.py -c /etc/lazarus-canary/lazarus-canary.toml run
+Restart=on-failure
+RestartSec=30
+StateDirectory=lazarus-canary
+StateDirectoryMode=0700
+# primed's token file has to be readable by this user (a group ACL, not a world bit)
+ReadOnlyPaths=/etc/lazarus-canary /var/lib/primed/sovereignty.token
+NoNewPrivileges=true
+ProtectSystem=strict
+ProtectHome=true
+PrivateTmp=true
+PrivateDevices=true
+ProtectKernelTunables=true
+ProtectControlGroups=true
+RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
+UMask=0077
+
+[Install]
+WantedBy=multi-user.target
