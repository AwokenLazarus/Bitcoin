+# lazarus-canary (SOV-P-002 W9). Copy to /etc/lazarus-canary/lazarus-canary.toml.
+# Every key shown is optional except the node URLs, credentials and the gateways (or nodes_file).
+network = "main"                     # P2P magic: main | test | signet | regtest
+
+[prime]
+url = "http://127.0.0.1:28916"       # primed's stats listener (loopback)
+token_file = "/var/lib/primed/sovereignty.token"
+
+[pool_node]                          # the node primed builds on (Prime's). Needs -blockprioritysize=0
+url = "http://127.0.0.1:9332"        # and -blockmintxfee above its relay floor (see README)
+cookie = "/var/lib/bitcoind/.cookie"   # or user / password
+blockmintxfee_satvb = 1.5            # what the pool node runs with; shared canaries sit just under it
+wallets_rpc = true                   # ask its wallets whether they know the canary address (they must not)
+
+[signer]                             # a node with no peers (-connect=0 -listen=0 -disablewallet); it only
+url = "http://127.0.0.1:19332"       # signs (signrawtransactionwithkey) and is never asked to broadcast
+cookie = "/var/lib/lazarus-canary/signer/.cookie"
+
+[wallet]
+key_file = "/etc/lazarus-canary/canary.wif"   # WIF, 0600, owned by the service user; from Proton Pass
+state_dir = "/var/lib/lazarus-canary"          # state.json (UTXOs, in-flight pairs), canaries.jsonl (fees)
+min_utxo_sats = 2000
+inflight_max_secs = 86400
+
+[fees]
+fee_rate_satvb = 0                   # 0 = estimatesmartfee 6 on the pool node, else this
+fallback_fee_rate_satvb = 5
+twin_extra_sats = 1                  # C' pays this much more than C (not enough to replace it)
+shared_modified_satvb = 0            # 0 = halfway between the pool's relay floor and blockmintxfee
+decoy_delta_sats = 1000000           # the decoy's priority on the pool node
+shared_release_secs = 600            # then the shared canary's delta is lifted so the pool mines it too
+                                     # (primed judges it only with jobs up to 180 s old)
+
+[cadence]                            # SOV-P-002 §5
+tick_secs = 30
+round_min_gap_secs = 1200            # a round places one shared canary and one decoy for everyone
+new_secs = 1200                      # new or suspect gateway, until new_until_due canaries were judged
+new_until_due = 10
+enrolled_secs = 3600
+clean_secs = 14400                   # >= clean_min_due judged and hit rate >= clean_min_rate
+clean_min_due = 100
+clean_min_rate = 0.8
+flagged_secs = 1200
+jitter = 0.5                         # every interval is drawn from base * (1 +- jitter)
+shared = true
+decoy = true
+
+[delivery]
+mode = "direct"                      # direct | socks5 (Tor: proxy = "127.0.0.1:9050"; also reaches .onion)
+proxy = ""
+timeout_secs = 20
+
+# Gateways with a registered node (registration v1, W10). nodes_file is read on every round and may
+# be primed's sovereignty-nodes.json once W10 lands: {"<G hex>": "host:port"} or [{"g":..,"node":..}].
+nodes_file = ""
+# [[gateways]]
+# g = "<64 hex ed25519 DATUM identity key>"
+# node = "203.0.113.7:8333"
