+"""One-shot P2P delivery of a raw transaction to one node (lazarus-canary, SOV-P-002 W9).
+
+The canary must reach the gateway's registered node and nowhere else, so it is not handed to any
+node's RPC (which would relay it) but pushed over a single P2P connection: version/verack, `tx`,
+then `ping` and wait for the matching `pong`, which a node answers only after it has processed
+every message before it. Then the connection is closed.
+
+Plain TCP, or through a SOCKS5 proxy (Tor: `127.0.0.1:9050`, which also reaches `.onion` nodes).
+v1 transport only; nodes that require BIP324 v2 are not supported here.
+"""
+import hashlib
+import os
+import socket
+import struct
+import time
+
+MAGIC = {
+    "main": bytes.fromhex("f9beb4d9"),
+    "test": bytes.fromhex("0b110907"),
+    "signet": bytes.fromhex("0a03cf40"),
+    "regtest": bytes.fromhex("fabfb5da"),
+}
+PROTOCOL_VERSION = 70016
+# What an ordinary recent node says, so a canary connection does not name itself.
+USER_AGENT = b"/Satoshi:29.0.0/"
+
+
+class DeliveryError(Exception):
+    pass
+
+
+def sha256d(b: bytes) -> bytes:
+    return hashlib.sha256(hashlib.sha256(b).digest()).digest()
+
+
+def varint(n: int) -> bytes:
+    if n < 0xFD:
+        return bytes([n])
+    if n <= 0xFFFF:
+        return b"\xfd" + struct.pack("<H", n)
+    if n <= 0xFFFFFFFF:
+        return b"\xfe" + struct.pack("<I", n)
+    return b"\xff" + struct.pack("<Q", n)
+
+
+def message(magic: bytes, command: str, payload: bytes) -> bytes:
+    cmd = command.encode().ljust(12, b"\x00")
+    return magic + cmd + struct.pack("<I", len(payload)) + sha256d(payload)[:4] + payload
+
+
+def version_payload(nonce: int, now: int | None = None) -> bytes:
+    now = int(time.time()) if now is None else now
+    no_addr = struct.pack("<Q", 0) + b"\x00" * 10 + b"\xff\xff" + b"\x00" * 4 + struct.pack(">H", 0)
+    return (struct.pack("<iQq", PROTOCOL_VERSION, 0, now) + no_addr + no_addr + struct.pack("<Q", nonce)
+            + varint(len(USER_AGENT)) + USER_AGENT + struct.pack("<i", 0) + b"\x01")
+
+
+def split_hostport(addr: str) -> tuple[str, int]:
+    host, _, port = addr.rpartition(":")
+    if not host or not port.isdigit():
+        raise DeliveryError(f"node address must be host:port, got {addr!r}")
+    return host.strip("[]"), int(port)
+
+
+def _recv_exact(sock: socket.socket, n: int) -> bytes:
+    buf = b""
+    while len(buf) < n:
+        chunk = sock.recv(n - len(buf))
+        if not chunk:
+            raise DeliveryError("peer closed the connection")
+        buf += chunk
+    return buf
+
+
+def read_message(sock: socket.socket, magic: bytes) -> tuple[str, bytes]:
+    head = _recv_exact(sock, 24)
+    if head[:4] != magic:
+        raise DeliveryError("wrong network magic from peer")
+    command = head[4:16].rstrip(b"\x00").decode(errors="replace")
+    (length,) = struct.unpack("<I", head[16:20])
+    if length > 4_000_000:
+        raise DeliveryError("oversized message from peer")
+    payload = _recv_exact(sock, length)
+    if sha256d(payload)[:4] != head[20:24]:
+        raise DeliveryError("bad checksum from peer")
+    return command, payload
+
+
+def socks5_connect(proxy: str, host: str, port: int, timeout: float) -> socket.socket:
+    phost, pport = split_hostport(proxy)
+    s = socket.create_connection((phost, pport), timeout=timeout)
+    s.sendall(b"\x05\x01\x00")
+    if _recv_exact(s, 2) != b"\x05\x00":
+        s.close()
+        raise DeliveryError("SOCKS5 proxy refused no-auth")
+    h = host.encode()
+    s.sendall(b"\x05\x01\x00\x03" + bytes([len(h)]) + h + struct.pack(">H", port))
+    rep = _recv_exact(s, 4)
+    if rep[1] != 0:
+        s.close()
+        raise DeliveryError(f"SOCKS5 connect failed (code {rep[1]})")
+    skip = {1: 4, 4: 16}.get(rep[3])
+    if skip is None:
+        skip = _recv_exact(s, 1)[0]
+    _recv_exact(s, skip + 2)
+    return s
+
+
+def deliver(node: str, raw_tx: bytes, *, network: str = "regtest", proxy: str | None = None,
+            timeout: float = 20.0) -> float:
+    """Push `raw_tx` to `node` (host:port) over one fresh P2P connection. Returns the unix time the
+    node acknowledged (its `pong`, sent after it processed the `tx`). Raises DeliveryError."""
+    magic = MAGIC[network]
+    host, port = split_hostport(node)
+    if host.endswith(".onion") and not proxy:
+        raise DeliveryError("an .onion node needs delivery.proxy (Tor SOCKS5)")
+    deadline = time.monotonic() + timeout
+    try:
+        sock = socks5_connect(proxy, host, port, timeout) if proxy else socket.create_connection((host, port), timeout=timeout)
+    except OSError as e:
+        raise DeliveryError(f"connect {node}: {e}") from None
+    try:
+        sock.settimeout(timeout)
+        sock.sendall(message(magic, "version", version_payload(int.from_bytes(os.urandom(8), "little"))))
+        got_version = got_verack = False
+        while not (got_version and got_verack):
+            if time.monotonic() > deadline:
+                raise DeliveryError("handshake timed out")
+            cmd, _ = read_message(sock, magic)
+            if cmd == "version":
+                got_version = True
+                sock.sendall(message(magic, "verack", b""))
+            elif cmd == "verack":
+                got_verack = True
+        sock.sendall(message(magic, "tx", raw_tx))
+        nonce = os.urandom(8)
+        sock.sendall(message(magic, "ping", nonce))
+        while True:
+            if time.monotonic() > deadline:
+                raise DeliveryError("no pong after the tx")
+            cmd, payload = read_message(sock, magic)
+            if cmd == "pong" and payload == nonce:
+                return time.time()
+            if cmd == "ping":
+                sock.sendall(message(magic, "pong", payload))
+    except (OSError, socket.timeout) as e:
+        raise DeliveryError(f"{node}: {e}") from None
+    finally:
+        sock.close()
