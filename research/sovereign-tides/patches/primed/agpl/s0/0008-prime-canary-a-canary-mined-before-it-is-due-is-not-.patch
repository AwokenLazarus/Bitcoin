+class Resolved(unittest.TestCase):
+    """SOV-012: a settled canary is reported with the block that settled it."""
+
+    class Pool(StubPool):
+        def call(self, method, *params, **kw):
+            self.calls.append((method, params))
+            if method == "gettxout":
+                if params[0] == "bb" * 32:  # C confirmed: 3 confirmations at tip 120 → block 118
+                    return {"value": 0.000189, "confirmations": 3, "bestblock": "0120" * 16}
+                return None
+            if method == "getblockheader":
+                return {"0120" * 16: {"height": 120}, "0118" * 16: {"height": 118, "time": 1_700_000_118}}[params[0]]
+            if method == "getblockhash":
+                return "0118" * 16 if params[0] == 118 else None
+            return None
+
+    def test_a_settled_canary_is_reported_with_its_block_and_retried(self):
+        prime = FakePrimed({})
+        try:
+            with tempfile.TemporaryDirectory() as d:
+                s = NodesFromPrime.svc(None, d, prime)
+                s.pool = self.Pool()
+                s.state_path, s.ledger_path = os.path.join(d, "state.json"), os.path.join(d, "l.jsonl")
+                s.state = s._load()
+                s.state["inflight"] = [{"kind": "own", "gateway": "g", "t": lc.time.time(), "fees": [1100, 1101],
+                                        "input": {"txid": "aa" * 32, "vout": 0, "value": 20_000},
+                                        "txids": ["bb" * 32, "cc" * 32]}]
+                prime.down = True
+                self.assertTrue(s.resolve())
+                self.assertEqual(prime.posts, [])
+                self.assertEqual(len(s.state["unreported"]), 1)
+                prime.down = False
+                s.resolve()
+                self.assertEqual(prime.posts, [("/sovereignty/canary/resolved",
+                                                {"txid": "bb" * 32, "confirmed": "bb" * 32, "height": 118,
+                                                 "time": 1_700_000_118})])
+                self.assertEqual(s.state["unreported"], [])
+                with open(s.ledger_path) as f:
+                    rec = json.loads(f.read())
+                self.assertEqual((rec["which"], rec["height"], rec["block_time"]), ("C", 118, 1_700_000_118))
+        finally:
+            prime.close()
+
