+class FakePrimed:
+    """primed's stats listener, as far as the sidecar uses it: token-gated nodes and resolutions."""
+
+    def __init__(self, nodes: dict, token: str = "tok"):
+        fake = self
+        self.nodes, self.token, self.posts, self.down = nodes, token, [], False
+
+        class H(BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def reply(self, code, obj):
+                body = json.dumps(obj).encode()
+                self.send_response(code)
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def authed(self):
+                return self.headers.get("X-Sovereignty-Token") == fake.token and not fake.down
+
+            def do_GET(self):
+                if self.path == "/sovereignty/nodes" and self.authed():
+                    self.reply(200, fake.nodes)
+                else:
+                    self.reply(403, {"error": "sovereignty token"})
+
+            def do_POST(self):
+                body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+                if not self.authed():
+                    return self.reply(403, {"error": "sovereignty token"})
+                fake.posts.append((self.path, body))
+                self.reply(200, {"ok": True, "known": True})
+
+        self.srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
+        self.url = f"http://127.0.0.1:{self.srv.server_address[1]}"
+        threading.Thread(target=self.srv.serve_forever, daemon=True).start()
+
+    def close(self):
+        self.srv.shutdown()
+        self.srv.server_close()
+
+
+class NodesFromPrime(unittest.TestCase):
+    """SOV-012: sovereignty-nodes.json stays 0600; the sidecar asks primed instead."""
+
+    def svc(self, d, prime):
+        tf = os.path.join(d, "token")
+        with open(tf, "w") as f:
+            f.write("tok\n")
+        s = lc.Canary.__new__(lc.Canary)
+        s.cfg = lc.merged({"prime": {"url": prime.url, "token_file": tf}})
+        return s
+
+    def test_nodes_come_from_primed_with_the_file_as_fallback(self):
+        prime = FakePrimed({"aa" * 32: {"node": "198.51.100.1:8333", "at_height": 7, "updated": 1}})
+        try:
+            with tempfile.TemporaryDirectory() as d:
+                s = self.svc(d, prime)
+                self.assertEqual(s.cfg["nodes_source"], "prime")
+                nf = os.path.join(d, "sovereignty-nodes.json")
+                with open(nf, "w") as f:
+                    json.dump({"bb" * 32: {"node": "10.0.0.2:8333"}}, f)
+                s.cfg["nodes_file"] = nf
+                self.assertEqual(sorted(s.gateways()), ["aa" * 32])
+                # primed down or refusing: the file (the demos') is the fallback
+                prime.down = True
+                self.assertEqual(sorted(s.gateways()), ["bb" * 32])
+                # nothing but [[gateways]] when neither answers
+                os.chmod(nf, 0)
+                if os.geteuid() != 0:
+                    self.assertEqual(s.gateways(), {})
+                # nodes_source = "file" never asks primed
+                prime.down = False
+                os.chmod(nf, 0o600)
+                s.cfg["nodes_source"] = "file"
+                self.assertEqual(sorted(s.gateways()), ["bb" * 32])
+                # a wrong token is a refusal, not an empty set of gateways
+                s.cfg["nodes_source"], s.cfg["nodes_file"] = "prime", ""
+                with open(s.cfg["prime"]["token_file"], "w") as f:
+                    f.write("wrong")
+                self.assertEqual(s.gateways(), {})
+        finally:
+            prime.close()
+
