++#define IDENTITY_MAGIC "datum-identity-v1"
++
++////////////////////////////////////////////////////////////////////////////////
++// identity key file
++//
++// Text, five lines:
++//   datum-identity-v1
++//   ed25519_pk <64 hex>
++//   ed25519_sk <128 hex>   (libsodium form: seed || pk)
++//   x25519_pk <64 hex>
++//   x25519_sk <64 hex>
++// Must not be group/world accessible.
++////////////////////////////////////////////////////////////////////////////////
++
++static int lzt1_unhex(const char *in, size_t hexlen, unsigned char *out) {
++	size_t i;
++	for (i = 0; i < hexlen; i++) {
++		const char c = in[i];
++		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) return -1;
++	}
++	for (i = 0; i < hexlen; i += 2) {
++		out[i >> 1] = hex2bin_uchar(&in[i]);
++	}
++	return 0;
++}
++
++static void lzt1_hex(char *out, const unsigned char *in, size_t len) {
++	size_t i;
++	for (i = 0; i < len; i++) {
++		uchar_to_hex(&out[i << 1], in[i]);
++	}
++	out[len << 1] = 0;
++}
++
++// "name <hex of len bytes>\n" at *p; advances *p.
++static int identity_field(const char **p, const char *name, unsigned char *out, size_t len) {
++	const size_t nl = strlen(name);
++	const char *q = *p;
++	if (strncmp(q, name, nl) || q[nl] != ' ') return -1;
++	q += nl + 1;
++	if (strlen(q) < len * 2) return -1;
++	if (lzt1_unhex(q, len * 2, out)) return -1;
++	q += len * 2;
++	if (*q == '\r') q++;
++	if (*q == '\n') {
++		q++;
++	} else if (*q != 0) {
++		return -1;
++	}
++	*p = q;
++	return 0;
++}
++
++static int identity_parse(const char *buf, DATUM_ENC_KEYS *keys) {
++	const char *p = buf;
++	unsigned char check[crypto_sign_PUBLICKEYBYTES];
++	unsigned char seed[crypto_sign_SEEDBYTES];
++	unsigned char sk[crypto_sign_SECRETKEYBYTES];
++	const size_t ml = strlen(IDENTITY_MAGIC);
++
++	if (strncmp(p, IDENTITY_MAGIC, ml)) return -1;
++	p += ml;
++	if (*p == '\r') p++;
++	if (*p != '\n') return -1;
++	p++;
++	if (identity_field(&p, "ed25519_pk", keys->pk_ed25519, crypto_sign_PUBLICKEYBYTES)) return -1;
++	if (identity_field(&p, "ed25519_sk", keys->sk_ed25519, crypto_sign_SECRETKEYBYTES)) return -1;
++	if (identity_field(&p, "x25519_pk", keys->pk_x25519, crypto_box_PUBLICKEYBYTES)) return -1;
++	if (identity_field(&p, "x25519_sk", keys->sk_x25519, crypto_box_SECRETKEYBYTES)) return -1;
++	while (*p == '\n' || *p == '\r' || *p == ' ') p++;
++	if (*p) return -1;
++
++	// the halves must belong together: re-derive both from the seed
++	if (crypto_sign_ed25519_sk_to_seed(seed, keys->sk_ed25519) != 0) return -1;
++	if (crypto_sign_seed_keypair(check, sk, seed) != 0) return -1;
++	sodium_memzero(seed, sizeof(seed));
++	if (memcmp(check, keys->pk_ed25519, crypto_sign_PUBLICKEYBYTES) || sodium_memcmp(sk, keys->sk_ed25519, crypto_sign_SECRETKEYBYTES)) {
++		sodium_memzero(sk, sizeof(sk));
++		return -1;
++	}
++	sodium_memzero(sk, sizeof(sk));
++	if (crypto_scalarmult_base(check, keys->sk_x25519) != 0) return -1;
++	if (memcmp(check, keys->pk_x25519, crypto_box_PUBLICKEYBYTES)) return -1;
++	keys->is_remote = false;
++	return 0;
++}
++
++static int identity_create(const char *path, DATUM_ENC_KEYS *keys) {
++	char buf[512];
++	char h[crypto_sign_SECRETKEYBYTES * 2 + 1];
++	int n, fd;
++	ssize_t w;
++
++	if (datum_encrypt_generate_keys(keys) != 0) {
++		DLOG_FATAL("Could not generate DATUM identity keys");
++		return -1;
++	}
++	n = snprintf(buf, sizeof(buf), "%s\n", IDENTITY_MAGIC);
++	lzt1_hex(h, keys->pk_ed25519, crypto_sign_PUBLICKEYBYTES);
++	n += snprintf(&buf[n], sizeof(buf) - n, "ed25519_pk %s\n", h);
++	lzt1_hex(h, keys->sk_ed25519, crypto_sign_SECRETKEYBYTES);
++	n += snprintf(&buf[n], sizeof(buf) - n, "ed25519_sk %s\n", h);
++	lzt1_hex(h, keys->pk_x25519, crypto_box_PUBLICKEYBYTES);
++	n += snprintf(&buf[n], sizeof(buf) - n, "x25519_pk %s\n", h);
++	lzt1_hex(h, keys->sk_x25519, crypto_box_SECRETKEYBYTES);
++	n += snprintf(&buf[n], sizeof(buf) - n, "x25519_sk %s\n", h);
++	sodium_memzero(h, sizeof(h));
++
++	fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
++	if (fd < 0) {
++		sodium_memzero(buf, sizeof(buf));
++		if (errno == EEXIST) return 1; // someone else made it: load that one
++		DLOG_FATAL("Could not create DATUM identity key file %s: %s", path, strerror(errno));
++		return -1;
++	}
++	if (fchmod(fd, 0600) != 0) {
++		DLOG_FATAL("Could not set mode 0600 on DATUM identity key file %s: %s", path, strerror(errno));
++		close(fd);
++		sodium_memzero(buf, sizeof(buf));
++		return -1;
++	}
++	w = write(fd, buf, n);
++	sodium_memzero(buf, sizeof(buf));
++	if (w != n || fsync(fd) != 0) {
++		DLOG_FATAL("Could not write DATUM identity key file %s", path);
++		close(fd);
++		unlink(path);
++		return -1;
++	}
++	close(fd);
++	DLOG_INFO("Created DATUM identity key file %s (mode 0600)", path);
++	return 0;
++}
++
++int datum_identity_load_or_create(const char *path, DATUM_ENC_KEYS *keys) {
++	char buf[1024];
++	struct stat st;
++	ssize_t r;
++	int fd, i;
++
++	for (i = 0; i < 2; i++) {
++		fd = open(path, O_RDONLY | O_CLOEXEC);
++		if (fd < 0) {
++			if (errno != ENOENT) {
++				DLOG_FATAL("Could not open DATUM identity key file %s: %s", path, strerror(errno));
++				return -1;
++			}
++			const int c = identity_create(path, keys);
++			if (c <= 0) return c;
++			continue; // lost a creation race; load the winner's
++		}
++		if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
++			DLOG_FATAL("DATUM identity key file %s is not a regular file", path);
++			close(fd);
++			return -1;
++		}
++		if (st.st_mode & (S_IRWXG | S_IRWXO)) {
++			DLOG_FATAL("DATUM identity key file %s is accessible by group/others (mode %04o); chmod 600 it", path, (unsigned int)(st.st_mode & 07777));
++			close(fd);
++			return -1;
++		}
++		r = read(fd, buf, sizeof(buf) - 1);
++		close(fd);
++		if (r <= 0 || r >= (ssize_t)sizeof(buf) - 1) {
++			sodium_memzero(buf, sizeof(buf));
++			DLOG_FATAL("DATUM identity key file %s is malformed (size)", path);
++			return -1;
++		}
++		buf[r] = 0;
++		i = identity_parse(buf, keys);
++		sodium_memzero(buf, sizeof(buf));
++		if (i != 0) {
++			memset(keys, 0, sizeof(*keys));
++			DLOG_FATAL("DATUM identity key file %s is malformed", path);
++			return -1;
++		}
++		DLOG_INFO("Loaded DATUM identity key from %s", path);
++		return 0;
++	}
++	DLOG_FATAL("Could not load DATUM identity key file %s", path);
++	return -1;
++}
++
++////////////////////////////////////////////////////////////////////////////////
++// coinbaser shapes
++////////////////////////////////////////////////////////////////////////////////
++
++bool datum_coinbaser_script_is_nta(const unsigned char *script, int len) {
++	static const unsigned char prefix[6] = { 0x6a, 0x44, 'N', 'T', 'A', 0x02 };
++	return len == DATUM_COINBASER_NTA_SCRIPT_LEN && !memcmp(script, prefix, sizeof(prefix));
++}
++
++bool datum_lzt1_active(void) {
++	return datum_config.datum_lzt1_attest && datum_identity_persisted && datum_protocol_is_active();
++}
++
++////////////////////////////////////////////////////////////////////////////////
++// attestation
++////////////////////////////////////////////////////////////////////////////////
++
++// hex chars from the start of the output to the 32-byte id: value 8, len 1, 6a 44 "LZT1"
++#define LZT1_ID_HEX_OFF ((8 + 1 + 2 + 4) * 2)
++
++int datum_lzt1_append_placeholder(T_DATUM_STRATUM_JOB *s, int k, int *cb2idx) {
++	char *o = &s->coinbase[k].coinb2[cb2idx[k]];
++	int n;
++
++	n = sprintf(o, "0000000000000000%02x6a444c5a5431", LZT1_SCRIPT_LEN);
++	memset(&o[n], '0', 64); n += 64;
++	lzt1_hex(&o[n], local_datum_keys.pk_ed25519, 32); n += 64;
++	s->lzt1_cb2_off[k] = cb2idx[k];
++	s->lzt1_has[k] = true;
++	cb2idx[k] += n;
++	return n;
++}
++
++static bool lzt1_varint(const unsigned char *b, size_t len, size_t *pos, uint64_t *v) {
++	size_t p = *pos;
++	if (p >= len) return false;
++	if (b[p] < 0xfd) {
++		*v = b[p]; *pos = p + 1; return true;
++	}
++	if (b[p] == 0xfd) {
++		if (p + 3 > len) return false;
++		*v = (uint64_t)b[p+1] | ((uint64_t)b[p+2] << 8); *pos = p + 3; return true;
++	}
++	if (b[p] == 0xfe) {
++		if (p + 5 > len) return false;
++		*v = upk_u32le(b, (int)p + 1); *pos = p + 5; return true;
++	}
++	if (p + 9 > len) return false;
++	*v = upk_u64le(b, (int)p + 1); *pos = p + 9; return true;
++}
++
++static size_t lzt1_put_varint(unsigned char *b, uint64_t v) {
++	if (v < 0xfd) { b[0] = (unsigned char)v; return 1; }
++	if (v <= 0xffff) { b[0] = 0xfd; b[1] = v & 0xff; b[2] = (v >> 8) & 0xff; return 3; }
++	b[0] = 0xfe; pk_u32le(b, 1, (uint32_t)v); return 5;
++}
++
++static void lzt1_dump(const T_DATUM_STRATUM_JOB *s, const unsigned char *msg, const unsigned char *tx, size_t tx_len) {
++	// DATUM_LZT1_DUMP=<file>: append the arguments of prime's lzt1_check, one line per variant:
++	//   <0x5A msg> <coinbase> <prev> <G> [branches...]
++	const char *path = getenv("DATUM_LZT1_DUMP");
++	char h[65];
++	char *txh;
++	FILE *f;
++	int i;
++
++	if (!path || !path[0]) return;
++	txh = malloc(tx_len * 2 + 1);
++	if (!txh) return;
++	f = fopen(path, "a");
++	if (!f) {
++		free(txh);
++		return;
++	}
++	lzt1_hex(txh, msg, LZT1_MSG_LEN);
++	fputs(txh, f);
++	lzt1_hex(txh, tx, tx_len);
++	fprintf(f, " %s", txh);
++	lzt1_hex(h, s->prevhash_bin, 32);
++	fprintf(f, " %s", h);
++	lzt1_hex(h, local_datum_keys.pk_ed25519, 32);
++	fprintf(f, " %s", h);
++	for (i = 0; i < s->merklebranch_count; i++) {
++		lzt1_hex(h, s->merklebranches_bin[i], 32);
++		fprintf(f, " %s", h);
++	}
++	fputc('\n', f);
++	fclose(f);
++	free(txh);
++}
++
++static bool lzt1_finalize_variant(T_DATUM_STRATUM_JOB *s, int k) {
++	T_DATUM_STRATUM_COINBASE *cb = &s->coinbase[k];
++	unsigned char tx[MAX_COINBASE_TXN_SIZE_BYTES];
++	unsigned char payout[MAX_COINBASE_TXN_SIZE_BYTES + 16];
++	unsigned char a[LZT1_ATTESTATION_LEN];
++	unsigned char signed_msg[LZT1_DOMAIN_LEN + LZT1_ATTESTATION_LEN];
++	unsigned char id[32], digest[32], branches_hash[32];
++	unsigned char *msg = s->lzt1_msg[k];
++	size_t tx_len, pos, lzt_pos, out_start, pn;
++	uint64_t n_out, v, slen, value_sum = 0;
++	bool found = false;
++	uint64_t o;
++	char idh[65];
++
++	tx_len = (size_t)cb->coinb1_len + 12 + (size_t)cb->coinb2_len;
++	if (cb->coinb1_len < 1 || tx_len > sizeof(tx) || (s->lzt1_cb2_off[k] & 1)) return false;
++
++	// As Prime assembles a share's coinbase: coinb1 || 12 zero bytes || coinb2.
++	// On BLAKE2b the gateway hashes that too; on SHA256d the extranonce lives
++	// in the scriptSig for every variant that carries an LZT1 output.
++	memcpy(tx, cb->coinb1_bin, cb->coinb1_len);
++	memset(&tx[cb->coinb1_len], 0, 12);
++	memcpy(&tx[cb->coinb1_len + 12], cb->coinb2_bin, cb->coinb2_len);
++	lzt_pos = (size_t)cb->coinb1_len + 12 + (size_t)(s->lzt1_cb2_off[k] >> 1);
++
++	// walk: version, 1 input (prevout, scriptSig, sequence), outputs
++	if (tx_len < 5 + 36 || tx[4] != 1) return false;
++	pos = 5 + 36;
++	if (!lzt1_varint(tx, tx_len, &pos, &slen) || pos + slen + 4 > tx_len) return false;
++	pos += slen + 4;
++	if (!lzt1_varint(tx, tx_len, &pos, &n_out) || n_out < 2) return false;
++
++	pn = lzt1_put_varint(payout, n_out - 1);
++	for (o = 0; o < n_out; o++) {
++		out_start = pos;
++		if (pos + 8 > tx_len) return false;
++		v = upk_u64le(tx, (int)pos);
++		pos += 8;
++		if (!lzt1_varint(tx, tx_len, &pos, &slen) || pos + slen > tx_len) return false;
++		pos += slen;
++		value_sum += v;
++		if (out_start == lzt_pos) {
++			if (found || v != 0 || slen != LZT1_SCRIPT_LEN) return false;
++			found = true;
++			continue;
++		}
++		memcpy(&payout[pn], &tx[out_start], pos - out_start);
++		pn += pos - out_start;
++	}
++	if (!found || pos + 4 != tx_len) return false;
++
++	crypto_hash_sha256(digest, payout, pn);
++	crypto_hash_sha256(digest, digest, 32);
++
++	// branches exactly as the job section of a share carries them
++	crypto_generichash(branches_hash, 32, s->merklebranch_count ? s->merklebranches_bin[0] : branches_hash, (size_t)s->merklebranch_count * 32, NULL, 0);
++
++	memset(a, 0, sizeof(a));
++	a[0] = LZT1_VERSION;
++	memcpy(&a[1], local_datum_keys.pk_ed25519, 32);
++	pk_u32le(a, 33, (uint32_t)s->height);
++	memcpy(&a[37], s->prevhash_bin, 32);
++	memcpy(&a[69], branches_hash, 32);
++	pk_u64le(a, 101, value_sum);
++	pk_u32le(a, 109, s->block_template->txn_count + 1);
++	// 113: mempool_digest (16) and 129: node_tag (16) stay zero
++	pk_u64le(a, 145, s->tsms);
++	memcpy(&a[153], digest, 32);
++
++	crypto_generichash(id, 32, a, sizeof(a), NULL, 0);
++
++	// commit: the id into the output, hex and binary
++	lzt1_hex(idh, id, 32);
++	memcpy(&cb->coinb2[s->lzt1_cb2_off[k] + LZT1_ID_HEX_OFF], idh, 64);
++	memcpy(&cb->coinb2_bin[(s->lzt1_cb2_off[k] + LZT1_ID_HEX_OFF) >> 1], id, 32);
++	memcpy(&tx[lzt_pos + (LZT1_ID_HEX_OFF >> 1)], id, 32);
++
++	memcpy(signed_msg, LZT1_DOMAIN, LZT1_DOMAIN_LEN); // includes the NUL
++	memcpy(&signed_msg[LZT1_DOMAIN_LEN], a, sizeof(a));
++
++	msg[0] = LZT1_SUBCMD;
++	msg[1] = s->datum_job_idx;
++	msg[2] = (unsigned char)k;
