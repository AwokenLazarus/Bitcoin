+//! Sovereign TIDES template attestations (LZT1), gateway side: build `A` for a coinbase the
+//! gateway is about to publish, sign it with the DATUM identity key, put the 70-byte commitment
+//! in that coinbase, and send `A` and the signature to Prime as mining sub-command `0x5A`
+//! (SOV-P-002 W7/W12). Byte for byte the layout `prime/wire/src/authorship.rs` verifies; the
+//! test below holds it to that crate's fixture (`cargo run -p datum-wire --example lzt1_fixture`).
+//!
+//! ```text
+//! A   = v (1) | G (32) | height (u32) | prev_hash (32) | branches_hash (32) | coinbase_value (u64)
+//!       | n_tx (u32) | mempool_digest (16) | node_tag (16) | t_gbt (u64) | payout_digest (32)
+//! sig = ed25519_G("XBT-SOVEREIGN-TIDES/1\0" || A)
+//! out = 0 sat, OP_RETURN PUSH68 "LZT1" || BLAKE2b-256(A) || G          (70-byte script)
+//! msg = 0x5A | job_id | variant | A | sig | 0xFE                          (253 bytes)
+//! ```
+//!
+//! `payout_digest` is SHA256d over the coinbase's outputs other than the commitment, as
+//! serialized in the transaction (witness commitment included), so `A` cannot be lifted onto a
+//! coinbase that pays someone else.
+
+use crate::coinbaser::CoinbaserOutput;
+use crate::nacl;
+use crate::pow;
+
+pub const SUB_LZT1_ATTEST: u8 = 0x5A;
+pub const MAGIC: [u8; 4] = *b"LZT1";
+pub const DOMAIN: &[u8] = b"XBT-SOVEREIGN-TIDES/1\0";
+pub const VERSION: u8 = 1;
+pub const ENCODED_LEN: usize = 1 + 32 + 4 + 32 + 32 + 8 + 4 + 16 + 16 + 8 + 32;
+/// The commitment's scriptPubKey: under RDTS's 83-byte coinbase OP_RETURN cap.
+pub const SCRIPT_LEN: usize = 70;
+/// What one commitment adds to a coinbase: value, script length, script.
+pub const OUTPUT_LEN: usize = 8 + 1 + SCRIPT_LEN;
+pub const MSG_LEN: usize = 3 + ENCODED_LEN + 64 + 1;
+
+/// What the gateway says about its own node (fed to Prime's template-entropy detector; not
+/// checked by the verifier).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct NodeView {
+    /// Transactions in the block, coinbase included.
+    pub n_tx: u32,
+    pub mempool_digest: [u8; 16],
+    pub node_tag: [u8; 16],
+    /// When the node produced the template (unix ms).
+    pub t_gbt: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Attestation {
+    pub g: [u8; 32],
+    pub height: u32,
+    /// Internal byte order, as the DATUM job section carries it.
+    pub prev_hash: [u8; 32],
+    pub branches_hash: [u8; 32],
+    pub coinbase_value: u64,
+    pub node: NodeView,
+    pub payout_digest: [u8; 32],
+}
+
+fn compact(buf: &mut Vec<u8>, n: u64) {
+    buf.extend_from_slice(&crate::cbtx::compact(n));
+}
+
+/// BLAKE2b-256 over the job's merkle branches, concatenated (internal byte order).
+pub fn branches_hash(branches: &[[u8; 32]]) -> [u8; 32] {
+    pow::blake2b_256(&branches.concat())
+}
+
+/// SHA256d over `(value, script)` outputs in transaction order.
+pub fn payout_digest<'a>(outputs: impl ExactSizeIterator<Item = (u64, &'a [u8])>) -> [u8; 32] {
+    let mut buf = Vec::new();
+    compact(&mut buf, outputs.len() as u64);
+    for (value, script) in outputs {
+        buf.extend_from_slice(&value.to_le_bytes());
+        compact(&mut buf, script.len() as u64);
+        buf.extend_from_slice(script);
+    }
+    pow::sha256d(&buf)
+}
+
+impl Attestation {
+    pub fn encode(&self) -> Vec<u8> {
+        let mut b = Vec::with_capacity(ENCODED_LEN);
+        b.push(VERSION);
+        b.extend_from_slice(&self.g);
+        b.extend_from_slice(&self.height.to_le_bytes());
+        b.extend_from_slice(&self.prev_hash);
+        b.extend_from_slice(&self.branches_hash);
+        b.extend_from_slice(&self.coinbase_value.to_le_bytes());
+        b.extend_from_slice(&self.node.n_tx.to_le_bytes());
+        b.extend_from_slice(&self.node.mempool_digest);
+        b.extend_from_slice(&self.node.node_tag);
+        b.extend_from_slice(&self.node.t_gbt.to_le_bytes());
+        b.extend_from_slice(&self.payout_digest);
+        debug_assert_eq!(b.len(), ENCODED_LEN);
+        b
+    }
+
+    /// BLAKE2b-256(A): what the coinbase commits to.
+    pub fn id(&self) -> [u8; 32] {
+        pow::blake2b_256(&self.encode())
+    }
+
+    pub fn sign(&self, ed_sk: &[u8; 64]) -> [u8; 64] {
+        nacl::sign_detached(&[DOMAIN, &self.encode()].concat(), ed_sk).expect("ed25519 sign")
+    }
+
+    pub fn commitment_script(&self) -> Vec<u8> {
+        let mut s = Vec::with_capacity(SCRIPT_LEN);
+        s.extend_from_slice(&[0x6a, 68]);
+        s.extend_from_slice(&MAGIC);
+        s.extend_from_slice(&self.id());
+        s.extend_from_slice(&self.g);
+        s
+    }
+}
+
+/// The `0x5A` mining sub-command for `variant` (the share's coinbase id) of `job_id`.
+pub fn message(job_id: u8, variant: u8, a: &Attestation, sig: &[u8; 64]) -> Vec<u8> {
+    let mut m = Vec::with_capacity(MSG_LEN);
+    m.push(SUB_LZT1_ATTEST);
+    m.push(job_id);
+    m.push(variant);
+    m.extend_from_slice(&a.encode());
+    m.extend_from_slice(sig);
+    m.push(0xFE);
+    m
+}
+
+/// Attest a coinbase whose outputs, in order, are `outputs` then the witness commitment (if
+/// any): fill in `A`, sign it with the identity key `(ed_pk, ed_sk)`, and return it with its
+/// signature and the commitment output to append to `outputs` (before the witness commitment,
+/// which is where `cbtx` puts the pool's outputs).
+#[allow(clippy::too_many_arguments)]
+pub fn attest(
+    ed_pk: &[u8; 32],
+    ed_sk: &[u8; 64],
+    height: u32,
+    prev_hash: &[u8; 32],
+    branches: &[[u8; 32]],
+    outputs: &[CoinbaserOutput],
+    witness_commitment: Option<&[u8]>,
+    node: NodeView,
+) -> (Attestation, [u8; 64], CoinbaserOutput) {
+    let paid = outputs.iter().map(|o| (o.sats, o.script.as_slice()));
+    let wit = witness_commitment.map(|w| (0u64, w));
+    let all: Vec<(u64, &[u8])> = paid.chain(wit).collect();
+    let a = Attestation {
+        g: *ed_pk,
+        height,
+        prev_hash: *prev_hash,
+        branches_hash: branches_hash(branches),
+        coinbase_value: outputs.iter().map(|o| o.sats).sum(),
+        node,
+        payout_digest: payout_digest(all.into_iter()),
+    };
+    let sig = a.sign(ed_sk);
+    let out = CoinbaserOutput { sats: 0, script: a.commitment_script() };
+    (a, sig, out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn h(s: &str) -> Vec<u8> {
+        hex::decode(s).unwrap()
+    }
+
+    fn h32(s: &str) -> [u8; 32] {
+        h(s).try_into().unwrap()
+    }
+
+    /// The fixture Prime's verifier crate prints (fixed key: an ed25519 seed of 32 × 0x42).
+    #[test]
+    fn matches_primes_fixture_byte_for_byte() {
+        let fx: serde_json::Value =
+            serde_json::from_str(include_str!("../tests/data/lzt1-fixture.json")).unwrap();
+        let signing = ed25519_dalek::SigningKey::from_bytes(&[0x42; 32]);
+        let (ed_pk, ed_sk) = (signing.verifying_key().to_bytes(), signing.to_keypair_bytes());
+        assert_eq!(hex::encode(ed_pk), fx["pk"].as_str().unwrap());
+        let branches: Vec<[u8; 32]> =
+            fx["branches"].as_array().unwrap().iter().map(|b| h32(b.as_str().unwrap())).collect();
+        let outs = vec![
+            CoinbaserOutput { sats: 200_000_000, script: [&[0x00, 0x14][..], &[0x11; 20]].concat() },
+            CoinbaserOutput { sats: 112_538_966, script: [&[0x00, 0x20][..], &[0x5d; 32]].concat() },
+        ];
+        let wit = [&[0x6a, 0x24, 0xaa, 0x21, 0xa9, 0xed][..], &[0x76; 32]].concat();
+        let node = NodeView { n_tx: 12, mempool_digest: [0x0d; 16], node_tag: [0x7a; 16], t_gbt: 1_788_408_500_000 };
+        let prev = h32(fx["prev_hash"].as_str().unwrap());
+        let height = fx["height"].as_u64().unwrap() as u32;
+        let (a, sig, out) = attest(&ed_pk, &ed_sk, height, &prev, &branches, &outs, Some(&wit), node);
+        assert_eq!(hex::encode(a.encode()), fx["attestation"].as_str().unwrap());
+        assert_eq!(hex::encode(sig), fx["sig"].as_str().unwrap());
+        assert_eq!(out.script.len(), SCRIPT_LEN);
+        assert!(fx["coinbase"].as_str().unwrap().contains(&hex::encode(&out.script)), "same commitment");
+        let m = message(9, 0, &a, &sig);
+        assert_eq!((m.len(), m[0], m[1], m[2], m[m.len() - 1]), (MSG_LEN, 0x5A, 9, 0, 0xFE));
+    }
+}
