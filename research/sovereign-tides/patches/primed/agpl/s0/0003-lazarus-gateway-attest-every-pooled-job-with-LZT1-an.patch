 /// holding a pre-restart id would then be matched to an unrelated template. The high half
 /// is a per-process salt from extranonce1, the low half the counter. Solo mode issues one
 /// job per identity per template, so the counter half is 32 bits wide.
+/// SOV-P-002 W12: attest a pooled job's coinbase. Returns the `0x5A` message and the commitment
+/// output to add to `cb` (before the witness commitment, where `cbtx` puts it). `variant` is the
+/// coinbase id the job's shares carry (`cb.id`).
+fn lzt1_attest(
+    st: &Shared,
+    k: &lazarus_protocol::PoolKeys,
+    t: &Template,
+    cb: &CoinbaserV2,
+    job_id: u8,
+) -> (Vec<u8>, CoinbaserOutput) {
+    let node_tag = *st.lzt1_node_tag.get_or_init(|| {
+        let version = cookie_auth(&st.cfg.rpc_cookie)
+            .and_then(|auth| rpc(&st.cfg.rpc, &auth, "getnetworkinfo", json!([])))
+            .and_then(|v| v.get("subversion").and_then(|s| s.as_str()).map(str::to_string))
+            .unwrap_or_default();
+        pow::blake2b_256(version.as_bytes())[..16].try_into().unwrap()
+    });
+    let node = lazarus_protocol::lzt1::NodeView {
+        n_tx: t.txn_count,
+        mempool_digest: [0u8; 16],
+        node_tag,
+        t_gbt: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis() as u64).unwrap_or(0),
+    };
+    let (a, sig, out) = lazarus_protocol::lzt1::attest(
+        &k.ed_pk,
+        &k.ed_sk,
+        t.height,
+        &t.prev_block,
+        &t.branches,
+        &cb.outputs,
+        t.witness_commit.as_deref(),
+        node,
+    );
+    (lazarus_protocol::lzt1::message(job_id, cb.id, &a, &sig), out)
+}
+
