+//! `lazarus-gateway --config … enrol`: print this gateway's Sovereign TIDES registration
+//! (SOV-P-002 §4), signed by its persisted DATUM identity key `G`.
+//!
+//! v1 proves `G` and names the node canaries go to; v2 adds the payout address, which the
+//! operator then signs in their wallet (BIP322, or `signmessage` for a P2PKH payout) and pastes
+//! into the site's "Prove your template" form (`POST /api/sovereignty/enrol`).
+
+use std::path::Path;
+
+use lazarus_protocol::keys::PoolKeys;
+use lazarus_protocol::nacl;
+use serde_json::json;
+
+pub const DOMAIN: &[u8] = b"XBT-SOVEREIGN-TIDES/register\0";
+pub const POOL_NAME: &str = "lazarus-xbt";
+pub const MAX_TAG: usize = 32;
+
+pub struct Args<'a> {
+    pub version: &'a str,
+    pub node: &'a str,
+    pub tag: &'a str,
+    pub payout: Option<&'a str>,
+    pub at: (u64, String),
+}
+
+/// The message, exactly as §4.1/§4.2 lays it out (no trailing newline).
+pub fn message(g_hex: &str, a: &Args) -> Result<String, String> {
+    if a.tag.chars().count() > MAX_TAG || a.tag.chars().any(|c| c.is_control()) {
+        return Err(format!("tag must be at most {MAX_TAG} printable characters"));
+    }
+    if a.node.is_empty() || a.node.contains(char::is_whitespace) {
+        return Err("node must be host:port, xxx.onion:port or none".into());
+    }
+    let mut lines = vec![
+        format!("LZT1 register {}", a.version),
+        format!("pool: {POOL_NAME}"),
+        "chain: XBT".to_string(),
+        format!("G: {g_hex}"),
+        format!("node: {}", a.node),
+        format!("tag: {}", a.tag),
+        format!("at: {} {}", a.at.0, a.at.1),
+    ];
+    match (a.version, a.payout) {
+        ("v1", None) => {}
+        ("v2", Some(p)) if !p.trim().is_empty() => lines.push(format!("payout: {}", p.trim())),
+        ("v2", _) => return Err("v2 needs --payout <address the coinbase pays>".into()),
+        ("v1", Some(_)) => return Err("--payout is for v2".into()),
+        (v, _) => return Err(format!("version must be v1 or v2, not {v}")),
+    }
+    Ok(lines.join("\n"))
+}
+
+pub fn sign(keys: &PoolKeys, msg: &str) -> String {
+    let pre = [DOMAIN, msg.as_bytes()].concat();
+    hex::encode(nacl::sign_detached(&pre, &keys.ed_sk).expect("identity key"))
+}
+
+/// Read the persisted identity key; never make one (a new key would not be the gateway's).
+pub fn load_identity(path: &Path) -> Result<PoolKeys, String> {
+    if !path.exists() {
+        return Err(format!(
+            "{} does not exist: start the gateway once with identity_key_file set, so the key it enrols is the one it uses",
+            path.display()
+        ));
+    }
+    lazarus_protocol::keys::load_or_create_pool_keys(path).map_err(|e| format!("{}: {e}", path.display()))
+}
+
+/// What the operator pastes into the form (or POSTs), with the payout signature to fill in.
+pub fn body(msg: &str, g_sig: &str, v2: bool) -> serde_json::Value {
+    let mut b = json!({"message": msg, "g_sig": g_sig});
+    if v2 {
+        b["proof"] = json!("bip322");
+        b["payout_sig"] = json!("<BIP322 signature of the message by the payout address>");
+    }
+    b
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn prints_the_spec_message_and_signs_it_with_the_domain() {
+        let keys = lazarus_protocol::keys::generate_pool_keys();
+        let g = hex::encode(keys.ed_pk);
+        let at = (321, "ab".repeat(32));
+        let a = Args { version: "v1", node: "203.0.113.2:8333", tag: "Lazarus", payout: None, at: at.clone() };
+        let m = message(&g, &a).unwrap();
+        assert_eq!(
+            m,
+            format!("LZT1 register v1\npool: lazarus-xbt\nchain: XBT\nG: {g}\nnode: 203.0.113.2:8333\ntag: Lazarus\nat: 321 {}", at.1)
+        );
+        let sig = hex::decode(sign(&keys, &m)).unwrap();
+        use ed25519_dalek::Verifier;
+        let vk = ed25519_dalek::VerifyingKey::from_bytes(&keys.ed_pk).unwrap();
+        let s = ed25519_dalek::Signature::from_slice(&sig).unwrap();
+        assert!(vk.verify(&[DOMAIN, m.as_bytes()].concat(), &s).is_ok());
+        let v2 = Args { version: "v2", payout: Some("bcrt1pxyz"), ..a };
+        assert!(message(&g, &v2).unwrap().ends_with("\npayout: bcrt1pxyz"));
+        assert!(message(&g, &Args { payout: None, ..v2 }).is_err());
+        assert!(message(&g, &Args { version: "v1", tag: &"x".repeat(33), node: "none", payout: None, at }).is_err());
+    }
+}
