 }
+/// `enrol`: the tip from the node this gateway builds on, the message, G's signature.
+fn enrol_cmd(
+    cfg: &GwCfg,
+    version: &str,
+    node: &str,
+    payout: Option<&str>,
+    tag: Option<&str>,
+    at: Option<&str>,
+    json_only: bool,
+) -> Result<(), String> {
+    let path = cfg.identity_key_file.as_ref().ok_or("identity_key_file is not set in the config: a gateway enrols its persisted key")?;
+    let keys = enrol::load_identity(path)?;
+    let at = match at {
+        Some(s) => {
+            let (h, hash) = s.trim().split_once(' ').ok_or("--at is \"<height> <hash>\"")?;
+            (h.parse::<u64>().map_err(|_| "--at height")?, hash.to_string())
+        }
+        None => {
+            let auth = cookie_auth(&cfg.rpc_cookie).ok_or_else(|| format!("rpc cookie {} unreadable", cfg.rpc_cookie.display()))?;
+            let h = rpc(&cfg.rpc, &auth, "getblockcount", json!([])).and_then(|v| v.as_u64()).ok_or("node: getblockcount")?;
+            let hash = rpc(&cfg.rpc, &auth, "getblockhash", json!([h]))
+                .and_then(|v| v.as_str().map(str::to_string))
+                .ok_or("node: getblockhash")?;
+            (h, hash)
+        }
+    };
+    let tag = tag.map(str::to_string).unwrap_or_else(|| cfg.coinbase_tag.clone().unwrap_or_default());
+    let g_hex = hex::encode(keys.ed_pk);
+    let msg = enrol::message(&g_hex, &enrol::Args { version, node, tag: &tag, payout, at })?;
+    let sig = enrol::sign(&keys, &msg);
+    let body = enrol::body(&msg, &sig, version == "v2");
+    if json_only {
+        println!("{body}");
+        return Ok(());
+    }
+    println!("{msg}\n");
+    println!("G signature: {sig}\n");
+    if version == "v2" {
+        println!("Sign the message above (every line, no trailing newline) with the payout address in your wallet");
+        println!("(BIP322; signmessage for a legacy 1... address), then paste both into the pool site's");
+        println!("\"Prove your template\" form, or POST this with payout_sig filled in:\n");
+    } else {
+        println!("Submit it on the pool site's \"Prove your template\" form, or POST this:\n");
+    }
+    println!("{body}");
+    println!("\nat must still be one of the pool node's last 144 blocks when it arrives.");
+    Ok(())
+}
+
 fn main() {
     env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("info")).init();
     let cli = Cli::parse();
     let raw = std::fs::read_to_string(&cli.config).expect("config");
     let cfg: GwCfg = serde_json::from_str(&raw).expect("json config");
+    if let Some(Cmd::Enrol { version, node, payout, tag, at, json }) = &cli.cmd {
+        std::process::exit(match enrol_cmd(&cfg, version, node, payout.as_deref(), tag.as_deref(), at.as_deref(), *json) {
+            Ok(()) => 0,
+            Err(e) => {
+                eprintln!("enrol: {e}");
+                2
+            }
+        });
+    }
     let extra1: [u8; 4] = rand::random();
     let mode = run_mode(cfg.mode.as_deref());
     // Solo pays whoever solves the block, so the fee output is the only thing standing
