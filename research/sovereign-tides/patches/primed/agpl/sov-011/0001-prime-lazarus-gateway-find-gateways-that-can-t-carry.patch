+/// Say what Prime said, if it said something: a DATUM server message (proto cmd 7) or its
+/// `nta-unready` notice (mining sub-command 0x4e). Returns true if it was one of those.
+fn log_prime_notice(h: &Header, plain: &[u8]) -> bool {
+    let text = |b: &[u8]| String::from_utf8_lossy(b.split(|&c| c == 0).next().unwrap_or_default()).into_owned();
+    if h.proto_cmd == 7 {
+        if !plain.is_empty() {
+            log::warn!("Prime message: {}", text(plain));
+        }
+        return true;
+    }
+    if plain.first() == Some(&0x4e) {
+        log::error!("Prime refuses this gateway (nta-unready): {}", text(&plain[1..]));
+        return true;
+    }
+    false
+}
