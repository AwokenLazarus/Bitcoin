+/// What stock `datum_gateway` v0.4.1 keeps of a coinbaser v2 list (`datum_coinbaser_v2_parse`,
+/// `datum_coinbaser.c:760-815`, OCEAN `5b06123`): it stops without a word at the first output
+/// whose value would take the running total past `coinbase_value`, or whose script is under 2 or
+/// over 64 bytes (:795), and after 512; what came before is kept. Under 9 bytes: nothing.
+/// Only for `LAZARUS_GATEWAY_EMULATE_STOCK_V041` (SOV-011 demos); never on a real gateway.
+pub fn parse_coinbaser_stock_v041(buf: &[u8], coinbase_value: u64) -> Option<CoinbaserV2> {
+    if buf.len() < 9 {
+        return None;
+    }
+    let id = buf[0];
+    let mut i = 1;
+    let mut tally = 0u64;
+    let mut outputs = Vec::new();
+    while i < buf.len() {
+        let Some(v) = buf.get(i..i + 8) else { break };
+        let sats = u64::from_le_bytes(v.try_into().ok()?);
+        i += 8;
+        if sats.saturating_add(tally) > coinbase_value {
+            break;
+        }
+        let Some(&sl) = buf.get(i) else { break };
+        i += 1;
+        let sl = sl as usize;
+        if !(2..=64).contains(&sl) {
+            break;
+        }
+        let Some(script) = buf.get(i..i + sl) else { break };
+        i += sl;
+        tally += sats;
+        outputs.push(CoinbaserOutput { sats, script: script.to_vec() });
+        if outputs.len() >= 512 {
+            break;
+        }
+    }
+    Some(CoinbaserV2 { id, outputs })
+}
