+
+    /// BIP341 wallet test vectors, `keyPathSpending` inputs with no script tree: the tweaked
+    /// secret is exactly what this command writes.
+    #[test]
+    fn bip86_tweak_matches_the_bip341_key_path_vectors() {
+        assert_eq!(
+            hex::encode(bip86_tweak("6b973d88838f27366ed61c9ad6367663045cb456e28335c109e30717ae0c6baa").unwrap()),
+            "2405b971772ad26915c8dcdf10f238753a9b837e5f8e6a86fd7c0cce5b7296d9"
+        );
+    }
+
+    #[test]
+    fn the_body_is_what_prime_parses_and_verifies() {
+        let s = Signer::from_hex(&format!("{:064x}", 7)).unwrap();
+        let prev = "00".repeat(31) + "ab";
+        let t = Target { prev: prev.clone(), height: 130, nbits: 0x207f_ffff };
+        let v: Value = serde_json::from_str(&body_of(&s, &t).unwrap()).unwrap();
+        assert_eq!(v["prev"], prev);
+        assert_eq!(v["nbits"], "207fffff");
+        let mut prev_le: [u8; 32] = hex::decode(&prev).unwrap().try_into().unwrap();
+        prev_le.reverse();
+        let sig: [u8; 64] = hex::decode(v["sig"].as_str().unwrap()).unwrap().try_into().unwrap();
+        assert!(lazarus_protocol::nta::verify(&s.key(), 130, 0x207f_ffff, &prev_le, &sig));
+    }
+
+    #[test]
+    fn a_key_file_others_can_read_is_refused_and_its_contents_never_echoed() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = std::env::temp_dir().join(format!("nta-signer-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let p = dir.join("k");
+        let secret = format!("{:064x}", 9);
+        std::fs::write(&p, &secret).unwrap();
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o640)).unwrap();
+        let e = load_secret_file(&p).unwrap_err();
+        assert!(e.contains("chmod 600") && !e.contains(&secret));
+        std::fs::set_permissions(&p, std::fs::Permissions::from_mode(0o600)).unwrap();
+        assert!(signer_of(load_secret_file(&p).unwrap()).is_ok());
+        std::fs::write(&p, "zz").unwrap();
+        let e = load_secret_file(&p).and_then(signer_of).unwrap_err();
+        assert!(!e.contains("zz"));
+        let out = dir.join("tweaked");
+        write_secret(&out, &[1u8; 32]).unwrap();
+        assert_eq!(std::fs::metadata(&out).unwrap().permissions().mode() & 0o777, 0o600);
+        assert!(write_secret(&out, &[1u8; 32]).is_err(), "never overwrites a key");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
