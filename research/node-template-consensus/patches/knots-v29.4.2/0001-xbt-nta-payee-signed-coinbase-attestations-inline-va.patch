diff --git a/src/validation.cpp b/src/validation.cpp
index 26661fb..22ef2ac 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -42,6 +42,7 @@
 #include <pow.h>
 #include <primitives/block.h>
 #include <primitives/transaction.h>
+#include <pubkey.h>
 #include <random.h>
 #include <script/script.h>
 #include <script/sigcache.h>
@@ -4821,6 +4822,74 @@ static bool ContextualCheckBlockHeaderVolatile(const CBlockHeader& block, BlockV
     return true;
 }
 
+/** XBT-NTA, inline variant (v0 of the research draft, research/node-template-consensus).
+ *
+ *  After activation every value-bearing coinbase output must pay a key-path taproot
+ *  script OP_1 <K>, and for each distinct such script (in output order) the coinbase
+ *  must carry one zero-value attestation output, in the same order:
+ *
+ *      OP_RETURN PUSH68 ( "NTA" 0x02 || sig64 )
+ *
+ *  sig64 is a BIP340 signature by K over NtaAttestationHash(script, height, nBits,
+ *  hashPrevBlock), so a pool cannot pay a script whose key it does not hold, and a
+ *  signature does not move to another height, difficulty or tip. The draft's extra
+ *  transaction and inclusion list need an attestation sidecar (vtxa) and P2P, and
+ *  are not part of this variant. The attestation output is 70 bytes, within the
+ *  83-byte RDTS OP_RETURN limit.
+ */
+static constexpr std::array<unsigned char, 6> NTA_ATTESTATION_PREFIX{OP_RETURN, 68, 'N', 'T', 'A', 0x02};
+static constexpr size_t NTA_ATTESTATION_SCRIPT_SIZE{NTA_ATTESTATION_PREFIX.size() + 64};
+
+static uint256 NtaAttestationHash(const CScript& payee, int height, uint32_t nbits, const uint256& prev)
+{
+    static const HashWriter HASHER_NTA{TaggedHash("XBT-NTA/attestation")};
+    HashWriter h{HASHER_NTA};
+    h << payee << height << nbits << prev;
+    return h.GetSHA256();
+}
+
+/** Exact bytes, like the witness commitment: any other encoding is an ordinary OP_RETURN. */
+static bool IsNtaAttestation(const CScript& script)
+{
+    return script.size() == NTA_ATTESTATION_SCRIPT_SIZE &&
+           std::equal(NTA_ATTESTATION_PREFIX.begin(), NTA_ATTESTATION_PREFIX.end(), script.begin());
+}
+
+static bool CheckNodeTemplateAttestations(const CBlock& block, int height, BlockValidationState& state)
+{
+    std::vector<CScript> payees;
+    std::vector<Span<const unsigned char>> sigs;
+    for (const CTxOut& out : block.vtx[0]->vout) {
+        if (IsNtaAttestation(out.scriptPubKey)) {
+            if (out.nValue != 0) {
+                return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS, "bad-nta-att-value", "NTA attestation output carries value");
+            }
+            sigs.emplace_back(Span{out.scriptPubKey}.subspan(NTA_ATTESTATION_PREFIX.size()));
+            continue;
+        }
+        if (out.nValue == 0 || out.scriptPubKey.IsUnspendable()) continue;
+        const CScript& spk{out.scriptPubKey};
+        if (spk.size() != 34 || spk[0] != OP_1 || spk[1] != 32) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS, "bad-nta-payee", "coinbase pays a script that is not a key-path taproot output");
+        }
+        if (!XOnlyPubKey{Span{spk}.subspan(2)}.IsFullyValid()) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS, "bad-nta-payee-key", "coinbase payee key is not on the curve");
+        }
+        if (std::find(payees.begin(), payees.end(), spk) == payees.end()) payees.push_back(spk);
+    }
+    if (sigs.size() != payees.size()) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS, "bad-nta-count",
+                             strprintf("%u coinbase payees, %u NTA attestations", payees.size(), sigs.size()));
+    }
+    for (size_t i = 0; i < payees.size(); ++i) {
+        const XOnlyPubKey key{Span{payees[i]}.subspan(2)};
+        if (!key.VerifySchnorr(NtaAttestationHash(payees[i], height, block.nBits, block.hashPrevBlock), sigs[i])) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS, "bad-nta-sig", strprintf("NTA attestation %u is not signed by its payee key", i));
+        }
+    }
+    return true;
+}
+
 /** NOTE: This function is not currently invoked by ConnectBlock(), so we
  *  should consider upgrade issues if we change which consensus rules are
  *  enforced in this function (eg by adding a new consensus rule). See comment
@@ -4891,6 +4960,12 @@ static bool ContextualCheckBlock(const CBlock& block, BlockValidationState& stat
         return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS, "bad-blk-weight-reduced_data", strprintf("%s : RDTS weight limit failed", __func__));
     }
 
+    // XBT-NTA: coinbase payees must bring a payee-signed attestation.
+    if (DeploymentActiveAfter(pindexPrev, chainman, Consensus::DEPLOYMENT_NTA) &&
+        !CheckNodeTemplateAttestations(block, nHeight, state)) {
+        return false;
+    }
+
     return true;
 }
 
