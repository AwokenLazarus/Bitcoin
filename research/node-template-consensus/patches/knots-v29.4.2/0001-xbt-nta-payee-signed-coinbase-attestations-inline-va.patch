+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bitcoin Knots developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""XBT-NTA (inline variant): coinbase payees must bring a payee-signed attestation.
+
+After -testactivationheight=nta@<h>, every value-bearing coinbase output must pay a
+key-path taproot script OP_1 <K>, and for each distinct payee script (in output order)
+the coinbase carries a zero-value output OP_RETURN PUSH68("NTA" 0x02 || sig64), where
+sig64 is a BIP340 signature by K over
+
+    TaggedHash("XBT-NTA/attestation", ser(script) || height:i32 || nBits:u32 || prev:u256)
+
+Test vectors are ported from the research model (research/node-template-consensus,
+test_xbt.py on rnd/a1-nta). node0 enforces the rules; node1 runs the old rules and
+shows the soft-fork property.
+
+Set NTA_PORT_BASE to pin every port this test binds to NTA_PORT_BASE..+59.
+"""
+
+import hashlib
+import os
+import struct
+
+import test_framework.p2p as _p2p
+import test_framework.test_framework as _tf
+import test_framework.test_node as _tn
+import test_framework.util as _util
+
+from test_framework.blocktools import add_witness_commitment, create_block, create_coinbase
+from test_framework.key import TaggedHash, compute_xonly_pubkey, sign_schnorr
+from test_framework.messages import CTxOut, COIN, ser_string, ser_uint256
+from test_framework.script import CScript, OP_1, OP_RETURN, OP_TRUE
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+if os.getenv("NTA_PORT_BASE"):
+    _base = int(os.environ["NTA_PORT_BASE"])
+    _p2p_port = lambda n: _base + n            # noqa: E731  n <= MAX_NODES (12)
+    _rpc_port = lambda n: _base + 20 + n       # noqa: E731
+    _tor_port = lambda n: _base + 40 + n       # noqa: E731
+    for _m in (_util, _tn, _tf, _p2p):
+        if hasattr(_m, "p2p_port"):
+            _m.p2p_port = _p2p_port
+    _util.rpc_port = _rpc_port
+    _util.tor_port = _tn.tor_port = _tor_port
+
+BLAKE2B_HEIGHT = 101
+NTA_HEIGHT = 120
+NTA_PREFIX = bytes([0x4e, 0x54, 0x41, 0x02])  # "NTA" 0x02
+SECP_P = 2**256 - 2**32 - 977
+
+
+def keypair(seed: bytes):
+    sk = hashlib.sha256(b"xbt-nta/" + seed).digest()
+    return sk, compute_xonly_pubkey(sk)[0]
+
+
+def p2tr(key: bytes) -> CScript:
+    return CScript([OP_1, key])
+
+
+def att_hash(script: CScript, height: int, nbits: int, prev: int) -> bytes:
+    return TaggedHash("XBT-NTA/attestation",
+                      ser_string(bytes(script)) + struct.pack("<i", height) +
+                      struct.pack("<I", nbits) + ser_uint256(prev))
+
+
+def att_script(sig: bytes) -> CScript:
+    return CScript([OP_RETURN, NTA_PREFIX + sig])
+
+
+class Tmpl:
+    """Where the next block goes: height, parent and nBits."""
+
+    def __init__(self, node):
+        tip = node.getbestblockhash()
+        hdr = node.getblockheader(tip)
+        self.height = hdr["height"] + 1
+        self.prev = int(tip, 16)
+        self.nbits = int(hdr["bits"], 16)
+        self.time = hdr["time"] + 1
+
+    def sign(self, script, sk, *, height=None, nbits=None, prev=None):
+        return sign_schnorr(sk, att_hash(script, self.height if height is None else height,
+                                         self.nbits if nbits is None else nbits,
+                                         self.prev if prev is None else prev))
+
+    def block(self, outs, *, witness_commitment=False):
+        """outs: list of (script, value in sats)."""
+        cb = create_coinbase(self.height)
+        cb.vout = [CTxOut(v, s) for s, v in outs]
+        cb.rehash()
+        b = create_block(self.prev, cb, self.time, height=self.height, header_v2=True)
+        b.nBits = self.nbits
+        if witness_commitment:
+            add_witness_commitment(b)
+        b.hashMerkleRoot = b.calc_merkle_root()
+        b.solve()
+        return b
+
+
+def not_on_curve_key() -> bytes:
+    x = 1
+    while pow((x ** 3 + 7) % SECP_P, (SECP_P - 1) // 2, SECP_P) == 1:
+        x += 1
+    return x.to_bytes(32, "big")
+
+
+class XbtNtaTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+        common = [f"-testactivationheight=blake2b@{BLAKE2B_HEIGHT}", "-rdtsexpiry=4102444800",
+                  "-whitelist=noban@127.0.0.1"]
+        self.extra_args = [common + [f"-testactivationheight=nta@{NTA_HEIGHT}"], common]
+
+    def setup_network(self):
+        self.setup_nodes()  # unconnected: each block is handed to each node explicitly
+
+    def submit(self, node, block):
+        return node.submitblock(block.serialize().hex())
+
+    def accept(self, block, *nodes):
+        for n in nodes or self.nodes:
+            assert_equal(self.submit(n, block), None)
+            assert_equal(n.getbestblockhash(), block.hash)
+
+    def reject(self, block, reason):
+        assert_equal(self.submit(self.nodes[0], block), reason)
+        assert block.hash != self.nodes[0].getbestblockhash()
+
+    def run_test(self):
+        enf, old = self.nodes
+        anyone = CScript([OP_TRUE])
+        alice_sk, alice = keypair(b"alice")
+        bob_sk, bob = keypair(b"bob")
+        pool_sk, pool = keypair(b"pool")
+        cust_sk, cust = keypair(b"customer")
+        farm_sk, farm = keypair(b"farm")
+        sub = 50 * COIN
+
+        self.log.info("Mine to just below NTA activation with unattested blocks")
+        self.generatetodescriptor(enf, NTA_HEIGHT - 3, "raw(51)", sync_fun=self.no_op)
+        for h in range(1, NTA_HEIGHT - 2):
+            assert_equal(old.submitblock(enf.getblock(enf.getblockhash(h), 0)), None)
+        assert_equal(old.getbestblockhash(), enf.getbestblockhash())
+        info = enf.getdeploymentinfo()["deployments"]["nta"]
+        assert_equal((info["type"], info["height"], info["active"]), ("buried", NTA_HEIGHT, False))
+        assert "nta" not in old.getdeploymentinfo()["deployments"]
+
+        self.log.info("Before activation: a stratum-style block paying an unattested script is valid")
+        t = Tmpl(enf)
+        assert_equal(t.height, NTA_HEIGHT - 2)
+        self.accept(t.block([(anyone, sub)]))
+        t = Tmpl(enf)
+        self.accept(t.block([(p2tr(alice), sub), (att_script(t.sign(p2tr(alice), alice_sk)), 0)]))
+        assert_equal(enf.getblockcount(), NTA_HEIGHT - 1)
+        assert enf.getdeploymentinfo()["deployments"]["nta"]["active"]
+
+        self.log.info("After activation: unattested payee rejected, old node accepts it (soft fork)")
+        t = Tmpl(enf)
+        stratum = t.block([(p2tr(pool), sub)])
+        self.reject(stratum, "bad-nta-count")
+        self.reject(t.block([(anyone, sub)]), "bad-nta-payee")
+        assert_equal(self.submit(old, stratum), None)
+        assert_equal(old.getbestblockhash(), stratum.hash)
+
+        self.log.info("x04: non-taproot payee, key off the curve")
+        wpkh = CScript([0, b"\x11" * 20])
+        self.reject(t.block([(wpkh, sub), (att_script(b"\x00" * 64), 0)]), "bad-nta-payee")
+        bad = CScript([OP_1, not_on_curve_key()])
+        self.reject(t.block([(bad, sub), (att_script(b"\x00" * 64), 0)]), "bad-nta-payee-key")
+
+        self.log.info("x03: gifted attestation (pool signs for a customer's script) fails")
+        self.reject(t.block([(p2tr(cust), sub), (att_script(t.sign(p2tr(cust), pool_sk)), 0)]), "bad-nta-sig")
+
+        self.log.info("x05: a signature does not move to another height, nBits, tip or payee")
+        for kw in ({"height": t.height + 1}, {"nbits": t.nbits - 1}, {"prev": t.prev ^ 1}):
+            self.reject(t.block([(p2tr(alice), sub), (att_script(t.sign(p2tr(alice), alice_sk, **kw)), 0)]), "bad-nta-sig")
+        swapped = t.block([(p2tr(alice), sub // 2), (p2tr(bob), sub // 2),
+                           (att_script(t.sign(p2tr(bob), bob_sk)), 0), (att_script(t.sign(p2tr(alice), alice_sk)), 0)])
+        self.reject(swapped, "bad-nta-sig")
+
+        self.log.info("x09: attestation count, value and encoding")
+        self.reject(t.block([(p2tr(alice), sub // 2), (p2tr(bob), sub // 2),
+                             (att_script(t.sign(p2tr(alice), alice_sk)), 0)]), "bad-nta-count")
+        sig = t.sign(p2tr(alice), alice_sk)
+        self.reject(t.block([(p2tr(alice), sub), (att_script(sig), 0), (att_script(sig), 0)]), "bad-nta-count")
+        self.reject(t.block([(p2tr(alice), sub - 1), (att_script(sig), 1)]), "bad-nta-att-value")
+        # a truncated attestation is just an OP_RETURN, so the payee is unattested
+        self.reject(t.block([(p2tr(alice), sub), (CScript([OP_RETURN, NTA_PREFIX + sig[:63]]), 0)]), "bad-nta-count")
+
+        self.log.info("x01: signed payee is valid (with a SegWit commitment beside it); old node agrees")
+        ok = t.block([(p2tr(alice), sub), (att_script(sig), 0)], witness_commitment=True)
+        self.accept(ok, enf)
+        assert self.submit(old, ok) in (None, "inconclusive")  # equal-work side branch: old keeps its first-seen tip
+        assert_equal(old.getbestblockhash(), stratum.hash)
+
+        self.log.info("x02: TIDES-style split, each payee signs; repeated script shares one attestation")
+        t = Tmpl(enf)
+        split = t.block([(p2tr(alice), sub // 4), (p2tr(bob), sub // 2), (p2tr(alice), sub // 4),
+                         (att_script(t.sign(p2tr(alice), alice_sk)), 0), (att_script(t.sign(p2tr(bob), bob_sk)), 0)])
+        self.accept(split, enf)
+
+        self.log.info("Old node reorgs from the unattested block onto the heavier attested chain")
+        assert_equal(self.submit(old, split), None)
+        assert_equal(old.getbestblockhash(), enf.getbestblockhash())
+        tips = {c["hash"]: c["status"] for c in old.getchaintips()}
+        assert_equal(tips[stratum.hash], "valid-fork")
+
+        self.log.info("x06: custody residual - a pool that holds the farm's key can sign for it")
+        t = Tmpl(enf)
+        custody = t.block([(p2tr(farm), sub), (att_script(t.sign(p2tr(farm), farm_sk)), 0)])
+        self.accept(custody)
+
+        self.log.info("Zero-value and OP_RETURN outputs are not payees")
+        t = Tmpl(enf)
+        self.accept(t.block([(CScript([OP_RETURN, b"hello"]), 0), (p2tr(bob), 0)]))
+
+        self.log.info("Restart: the enforcing node reloads the attested chain")
+        self.restart_node(0)
+        assert_equal(enf.getbestblockhash(), old.getbestblockhash())
+
+
+if __name__ == "__main__":
+    XbtNtaTest(__file__).main()
