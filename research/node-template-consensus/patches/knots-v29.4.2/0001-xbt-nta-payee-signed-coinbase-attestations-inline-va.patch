+#!/usr/bin/env bash
+# XBT-065 demo: XBT-NTA Knots patch (branch rnd/xbt-065-nta, local only). No miners.
+#  1. model vectors (rnd/a1-nta research/node-template-consensus/test_xbt.py)
+#  2. functional test feature_xbt_nta.py (ported vectors), ports 30640-30692
+#  3. 3-node regtest: before/after activation, old node follows (ports 30601-30613)
+# Ports 30600-30699 and datadirs under ~/xbt-rnd/xbt-065/run only.
+set -euo pipefail
+ROOT=$HOME/xbt-rnd/xbt-065
+KNOTS=$ROOT/knots
+RUN=$ROOT/run
+BIN=$KNOTS/build/bin
+NTA=${NTA_DIR:-$HOME/Bitcoin.worktrees/rnd-a1-nta/research/node-template-consensus}
+if [[ ! -x $BIN/bitcoind ]] || [[ -n $(find "$KNOTS/src" -newer "$BIN/bitcoind" -name '*.cpp' -o -newer "$BIN/bitcoind" -name '*.h' | head -1) ]]; then
+  echo "== 0. build (nice -n 10 make -j4)"; (cd "$KNOTS/build" && nice -n 10 make -j4 bitcoind bitcoin-cli >/dev/null)
+fi
+mkdir -p "$RUN"
+echo "== 1. model: XBT profile vectors"
+(cd "$NTA" && python3 -W ignore test_xbt.py 2>&1 | tail -n 1)
+echo "== 2. functional test feature_xbt_nta.py"
+rm -rf "$RUN/ft"
+NTA_PORT_BASE=30640 python3 "$KNOTS/test/functional/feature_xbt_nta.py" \
+  --configfile "$KNOTS/build/test/config.ini" --tmpdir "$RUN/ft" > "$RUN/ft.log" 2>&1 || true
+sed -n 's/^.*TestFramework ([A-Z]*): //p' "$RUN/ft.log" | grep -v -e '^PRNG' -e '^Initializing' -e '^Cleaning up'
+grep -q "Tests successful" "$RUN/ft.log" || { echo "functional test FAILED: $RUN/ft.log"; exit 1; }
+echo "== 3. three-node regtest"
+python3 "$KNOTS/contrib/xbt-nta/nta_demo.py" "$BIN" "$RUN/demo" 30600
diff --git a/contrib/xbt-nta/nta_demo.py b/contrib/xbt-nta/nta_demo.py
new file mode 100644
index 0000000..d8f3a1c
--- /dev/null
+++ b/contrib/xbt-nta/nta_demo.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""XBT-NTA 3-node regtest demo (no miners; blocks are built and solved in Python).
+
+  A  enforces NTA (-testactivationheight=nta@120), mines payee-attested blocks
+  B  enforces NTA; unattested (stratum-to-pool style) blocks are handed to it
+  C  old rules (NTA unscheduled): shows the soft-fork property
+
+Before activation B accepts an unattested block. After activation B rejects one,
+C accepts it, and C then follows the heavier attested chain that A mines.
+
+usage: nta_demo.py <bindir> <rundir> <port-base>
+  ports: p2p base+1..3, rpc base+11..13 (all loopback)
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "..", "test", "functional"))
+
+from test_framework.authproxy import AuthServiceProxy, JSONRPCException  # noqa: E402
+from test_framework.messages import COIN  # noqa: E402
+from test_framework.script import CScript, OP_TRUE  # noqa: E402
+from feature_xbt_nta import NTA_HEIGHT, Tmpl, att_script, keypair, p2tr  # noqa: E402
+
+BLAKE2B_HEIGHT = 101
+COMMON = [f"-testactivationheight=blake2b@{BLAKE2B_HEIGHT}", "-rdtsexpiry=4102444800",
+          "-whitelist=noban@127.0.0.1", "-listenonion=0", "-dnsseed=0", "-fixedseeds=0",
+          "-discover=0", "-upnp=0", "-natpmp=0", "-printtoconsole=0", "-server=1"]
+NODES = {
+    "A": [f"-testactivationheight=nta@{NTA_HEIGHT}"],
+    "B": [f"-testactivationheight=nta@{NTA_HEIGHT}"],
+    "C": [],
+}
+FAILS = []
+
+
+def check(ok, what):
+    print(("PASS  " if ok else "FAIL  ") + what)
+    if not ok:
+        FAILS.append(what)
+
+
+class Node:
+    def __init__(self, name, idx, bindir, rundir, base):
+        self.name, self.p2p, self.rpcport = name, base + 1 + idx, base + 11 + idx
+        self.datadir = os.path.join(rundir, name)
+        shutil.rmtree(self.datadir, ignore_errors=True)
+        os.makedirs(self.datadir)
+        args = [os.path.join(bindir, "bitcoind"), "-regtest", f"-datadir={self.datadir}",
+                f"-port={self.p2p}", f"-bind=127.0.0.1:{self.p2p}", f"-rpcport={self.rpcport}",
+                "-rpcbind=127.0.0.1", "-rpcallowip=127.0.0.1"] + COMMON + NODES[name]
+        self.proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        self.rpc = None
+
+    def connect_rpc(self):
+        cookie = os.path.join(self.datadir, "regtest", ".cookie")
+        for _ in range(300):
+            if self.proc.poll() is not None:
+                raise SystemExit(f"node {self.name} exited ({self.proc.returncode}); see {self.datadir}/regtest/debug.log")
+            try:
+                with open(cookie) as f:
+                    auth = f.read().strip()
+                self.rpc = AuthServiceProxy(f"http://{auth}@127.0.0.1:{self.rpcport}", timeout=60)
+                self.rpc.getblockcount()
+                return
+            except (OSError, JSONRPCException):
+                time.sleep(0.1)
+        raise SystemExit(f"node {self.name}: RPC not up")
+
+    def stop(self):
+        try:
+            self.rpc.stop()
+        except Exception:
+            pass
+        try:
+            self.proc.wait(30)
+        except subprocess.TimeoutExpired:
+            self.proc.kill()
+
+    def tip(self):
+        return self.rpc.getbestblockhash()
+
+
+def wait_for(pred, secs=30):
+    end = time.time() + secs
+    while time.time() < end:
+        if pred():
+            return True
+        time.sleep(0.1)
+    return False
+
+
+def main():
+    bindir, rundir, base = sys.argv[1], sys.argv[2], int(sys.argv[3])
+    os.makedirs(rundir, exist_ok=True)
+    nodes = [Node(n, i, bindir, rundir, base) for i, n in enumerate(NODES)]
+    try:
+        for n in nodes:
+            n.connect_rpc()
+        A, B, C = nodes
+        for x, y in ((A, B), (B, C), (A, C)):
+            x.rpc.addnode(f"127.0.0.1:{y.p2p}", "onetry")
+        wait_for(lambda: all(n.rpc.getconnectioncount() >= 2 for n in nodes))
+        print(f"nodes up: A(enforce nta@{NTA_HEIGHT}) B(enforce) C(old rules); p2p {A.p2p}-{C.p2p}, rpc {A.rpcport}-{C.rpcport}")
+
+        alice_sk, alice = keypair(b"alice")   # a DATUM miner: runs a node, holds her payout key
+        _, pool = keypair(b"pool")            # a stratum pool paying its own script, no attestation
+        sub = 50 * COIN
+
+        A.rpc.generatetodescriptor(NTA_HEIGHT - 3, "raw(51)")
+        check(wait_for(lambda: len({n.tip() for n in nodes}) == 1), f"all nodes synced at height {NTA_HEIGHT - 3}")
+
+        print(f"-- before activation (block {NTA_HEIGHT - 2})")
+        t = Tmpl(B.rpc)
+        pre = t.block([(p2tr(pool), sub)])
+        check(B.rpc.submitblock(pre.serialize().hex()) is None, "B accepts an unattested block before activation")
+        check(wait_for(lambda: all(n.tip() == pre.hash for n in nodes)), "A, B and C all follow it")
+        t = Tmpl(A.rpc)
+        att = t.block([(p2tr(alice), sub), (att_script(t.sign(p2tr(alice), alice_sk)), 0)])
+        check(A.rpc.submitblock(att.serialize().hex()) is None, "A mines an attested block")
+        check(wait_for(lambda: all(n.tip() == att.hash for n in nodes)), f"all at height {NTA_HEIGHT - 1}")
+        check(A.rpc.getdeploymentinfo()["deployments"]["nta"]["active"], "NTA active for the next block on A")
+
+        print(f"-- after activation (block {NTA_HEIGHT})")
+        t = Tmpl(B.rpc)
+        stratum = t.block([(p2tr(pool), sub)])
+        r = B.rpc.submitblock(stratum.serialize().hex())
+        check(r == "bad-nta-count", f"B rejects the unattested block: {r}")
+        check(B.tip() == att.hash and A.tip() == att.hash, "A and B stay on the attested tip")
+        r = C.rpc.submitblock(stratum.serialize().hex())
+        check(r is None and C.tip() == stratum.hash, "C (old rules) accepts the unattested block")
+        time.sleep(1)
+        check(A.tip() == att.hash and B.tip() == att.hash, "relayed by C, it is still refused by A and B")
+
+        t = Tmpl(A.rpc)
+        a1 = t.block([(p2tr(alice), sub), (att_script(t.sign(p2tr(alice), alice_sk)), 0)])
+        check(A.rpc.submitblock(a1.serialize().hex()) is None, f"A mines attested block {NTA_HEIGHT}")
+        t = Tmpl(A.rpc)
+        a2 = t.block([(p2tr(alice), sub), (att_script(t.sign(p2tr(alice), alice_sk)), 0)])
+        check(A.rpc.submitblock(a2.serialize().hex()) is None, f"A mines attested block {NTA_HEIGHT + 1}")
+        check(wait_for(lambda: all(n.tip() == a2.hash for n in nodes)),
+              "C reorgs off the unattested block onto the heavier attested chain (soft fork)")
+        c_tips = {c["hash"]: c["status"] for c in C.rpc.getchaintips()}
+        a_tips = {c["hash"]: c["status"] for c in A.rpc.getchaintips()}
+        check(c_tips.get(stratum.hash) == "valid-fork", f"C: unattested block is a stale valid-fork ({c_tips.get(stratum.hash)})")
+        check(a_tips.get(stratum.hash, "invalid") == "invalid", f"A: unattested block is invalid ({a_tips.get(stratum.hash, 'invalid, never stored')})")
+        heights = {n.name: n.rpc.getblockcount() for n in nodes}
+        print(f"final heights {heights}, tip {a2.hash[:16]}…")
+        anyone = Tmpl(A.rpc).block([(CScript([OP_TRUE]), sub)])
+        check(A.rpc.submitblock(anyone.serialize().hex()) == "bad-nta-payee", "A rejects an anyone-can-spend payee")
+    finally:
+        for n in nodes:
+            n.stop()
+    print("RESULT: " + ("PASS" if not FAILS else f"FAIL ({len(FAILS)})"))
+    return 1 if FAILS else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
