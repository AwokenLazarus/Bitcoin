# Knots 29.4.1.knots20260508 BLAKE2b mainnet — runs on Umbrel/Bitmox
# Existing Umbrel Knots (SHA256d + Lightning) stays on :9332/:9333
datadir=/home/umbrel/blake2b/bitcoin
server=1
listen=1
txindex=1
dbcache=4096
maxmempool=1000
blockreconstructionextratxn=1000000
# 800000 is the consensus limit; leave ~64k weight for Prime's TIDES coinbase (<=14000 bytes)
blockmaxweight=736000
blockmaxsize=300000
# Spam filter (policy only, not consensus): stock Knots 29.4.2 relays and mines the large
# fake-multisig data transactions (590-byte witnesses, hundreds of inputs). 589 refuses them.
# It also declines very large multisig spends (about 5-of-7 and up); other nodes still mine those.
maxscriptsize=589
rpcuser=<redacted>
rpcpassword=<redacted>
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
rpcport=18332
port=18333
addnode=127.0.0.1:9333
blocknotify=curl -fsS -o /dev/null http://127.0.0.1:7152/NOTIFY
printtoconsole=0
debuglogfile=/home/umbrel/blake2b/logs/debug.log
