@@ -0,0 +1,67 @@
+import { isDATUMCoinbase, parseDATUMTemplateCreator, parseTemplateCreator } from '../../utils/bitcoin-script';
+
+function hex(s: string): string {
+  return Buffer.from(s, 'latin1').toString('hex');
+}
+
+// Coinbase scriptSigs as datum_gateway builds them (src/datum_coinbaser.c): BIP34 height push,
+// `<primary> 0x0F <secondary> 0x00` tag push, unique-id push, then the stratum extranonces.
+function datumCoinbase(primary: string, secondary: string | null): string {
+  const tags = secondary === null ? `${primary}\x00` : `${primary}\x0f${secondary}\x00`;
+  return '03ccc10e'
+    + tags.length.toString(16).padStart(2, '0') + hex(tags)
+    + '0bff34120102030405060708'
+    + '000000000000000000000000';
+}
+
+describe('bitcoin-script', () => {
+  describe('isDATUMCoinbase', () => {
+    test('detects a pool tag with a template-creator tag', () => {
+      expect(isDATUMCoinbase(datumCoinbase('Lazarus', 'Their Name'))).toBe(true);
+      expect(isDATUMCoinbase(datumCoinbase('OCEAN.XYZ', 'Bitaxe Solo'))).toBe(true);
+    });
+
+    test('ignores a DATUM coinbase without a secondary tag', () => {
+      expect(isDATUMCoinbase(datumCoinbase('Lazarus', null))).toBe(false);
+    });
+
+    test('ignores coinbases that do not follow the DATUM layout', () => {
+      // Lazarus public stratum: tag push with no separator or terminator
+      expect(isDATUMCoinbase('03ccc10e074c617a61727573e99dcaea0000000000000000')).toBe(false);
+      // Foundry USA
+      expect(isDATUMCoinbase('03a8ff0c' + '1c' + hex('/Foundry USA Pool #dropgold/') + '2f3d5e0d')).toBe(false);
+      // DMND: NUL delimiter instead of a push
+      expect(isDATUMCoinbase('03a8ff0c00' + hex('/DMND/miner one/') + '00')).toBe(false);
+      // separator present but the tag bytes are not printable
+      expect(isDATUMCoinbase('03ccc10e' + '08' + 'ff0102030f0a0b00')).toBe(false);
+      // empty secondary
+      expect(isDATUMCoinbase('03ccc10e' + '09' + hex('Lazarus\x0f\x00'))).toBe(false);
+      // two separators
+      expect(isDATUMCoinbase(datumCoinbase('Lazarus', 'a\x0fb'))).toBe(false);
+      // truncated
+      expect(isDATUMCoinbase('03ccc10e20' + hex('Lazarus\x0fx\x00'))).toBe(false);
+      expect(isDATUMCoinbase('')).toBe(false);
+      expect(isDATUMCoinbase('zz')).toBe(false);
+    });
+  });
+
+  describe('parseTemplateCreator', () => {
+    test('exposes the template creator for any pool using DATUM', () => {
+      expect(parseTemplateCreator('Lazarus', datumCoinbase('Lazarus', 'Their Name'))).toEqual(['Lazarus', 'Their Name']);
+      expect(parseTemplateCreator('Unknown', datumCoinbase('SomePool', 'solo-1'))).toEqual(['SomePool', 'solo1']);
+    });
+
+    test('keeps the existing OCEAN and DMND behaviour', () => {
+      const ocean = datumCoinbase('OCEAN.XYZ', 'Bitaxe');
+      expect(parseTemplateCreator('OCEAN', ocean)).toEqual(parseDATUMTemplateCreator(ocean));
+      expect(parseTemplateCreator('OCEAN', datumCoinbase('OCEAN.XYZ', null))).toEqual(['OCEANXYZ']);
+      expect(parseTemplateCreator('DMND', '03a8ff0c00' + hex('/DMND/miner one/') + '00')).toEqual(['DMND', 'miner one']);
+    });
+
+    test('returns null for pools without template-creator tags', () => {
+      expect(parseTemplateCreator('Lazarus', '03ccc10e074c617a61727573e99dcaea0000000000000000')).toBeNull();
+      expect(parseTemplateCreator('Foundry USA', '03a8ff0c1c' + hex('/Foundry USA Pool #dropgold/') + '2f3d5e0d')).toBeNull();
+      expect(parseTemplateCreator('Unknown', '')).toBeNull();
+    });
+  });
+});
