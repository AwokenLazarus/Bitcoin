#!/usr/bin/env bash
# Umbrel Bitcoin Knots app hook. Stock permission + Tor HS wait, plus:
#   1) bind-mount the BLAKE2b Knots build in blake2b/prefix over the image bitcoind (every start)
#   2) ensure DATUM / electrs / pool helpers
#
# Policy such as the relay/mining fee floor lives in the app's data/app/settings.json (sat/vB,
# fractions allowed): the app regenerates umbrel-bitcoin.conf from it on every start, and the
# first includeconf wins, so blake2b.conf cannot override those keys.
#
# Install: copy to ~/umbrel/app-data/bitcoin-knots/hooks/pre-start and chmod +x
# The bind is applied BEFORE the hidden-service early-exit so it still
# runs on later boots (stock hook exited first and skipped this).

APP_DATA_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../data")"
DESIRED_OWNER="1000:1000"
PREFIX_BITCOIND="${PREFIX_BITCOIND:-/home/umbrel/blake2b/prefix/bin/bitcoind}"
ENSURE="${ENSURE_SCRIPT:-/home/umbrel/blake2b/bin/ensure-blake2b-services.sh}"

set_correct_permissions() {
	local -r path="${1}"
	if [[ -f "${path}" ]]; then
		owner=$(stat -c "%u:%g" "${path}")
		if [[ "${owner}" != "${DESIRED_OWNER}" ]]; then
			chown "${DESIRED_OWNER}" "${path}"
			echo "Changed ownership of ${path} to ${DESIRED_OWNER}"
		fi
	else
		echo "Skipping ${path} - file does not exist"
	fi
}

set_correct_permissions "${APP_DATA_DIR}/bitcoin/umbrel-bitcoin.conf"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/bitcoin.conf"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/bitcoin.conf.save"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/settings.json"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/regtest/settings.json"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/signet/settings.json"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/testnet3/settings.json"
set_correct_permissions "${APP_DATA_DIR}/bitcoin/testnet4/settings.json"

if [[ -d "${APP_DATA_DIR}/app" ]]; then
	chown -R "${DESIRED_OWNER}" "${APP_DATA_DIR}/app"
fi

# Keep the blake2b/prefix Knots on the live datadir (re-applied every start / after app update).
COMPOSE="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../docker-compose.yml")"
RC4_BIND="      - ${PREFIX_BITCOIND}:/opt/bitcoind/v29.4.knots20260508/bitcoind:ro"
if [[ -f "${COMPOSE}" && -x "${PREFIX_BITCOIND}" ]] && ! grep -q "blake2b/prefix/bin/bitcoind\|knots20260508/bitcoind" "${COMPOSE}"; then
	python3 - "${COMPOSE}" "${RC4_BIND}" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
bind = sys.argv[2] + "\n"
text = p.read_text()
needle = "      - ${APP_DATA_DIR}/data:/data\n"
if needle in text and "bitcoind:ro" not in text:
    p.write_text(text.replace(needle, needle + bind, 1))
PY
fi
if [[ -x "${ENSURE}" ]]; then
	"${ENSURE}" || true
fi

# Stock Umbrel: delay full boot until RPC/P2P Tor hidden services exist.
HIDDEN_SERVICE_FILE="${TOR_DATA_DIR}/app-${APP_ID}-rpc/hostname"

if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
	exit 0
fi

/opt/umbreld/source/modules/apps/legacy-compat/app-script compose "${APP_ID}" up --detach app
/opt/umbreld/source/modules/apps/legacy-compat/app-script compose "${APP_ID}" up --detach tor

echo "App: ${APP_ID} - Generating Tor Hidden Service..."

for attempt in $(seq 1 100); do
	if [[ -f "${HIDDEN_SERVICE_FILE}" ]]; then
		echo "App: ${APP_ID} - Hidden service file created successfully!"
		break
	fi
	sleep 0.1
done

if [[ ! -f "${HIDDEN_SERVICE_FILE}" ]]; then
	echo "App: ${APP_ID} - Hidden service file wasn't created"
fi
