network = "bitcoin"
daemon_dir = "/home/umbrel/umbrel/app-data/bitcoin-knots/data/bitcoin"
daemon_rpc_addr = "127.0.0.1:9332"
daemon_p2p_addr = "127.0.0.1:9333"
electrum_rpc_addr = "0.0.0.0:50011"
monitoring_addr = "127.0.0.1:4225"
db_dir = "/home/umbrel/blake2b/electrs-db"
log_filters = "INFO"
# Address pages walk scripthash history. Too short → nginx 504; unlimited → one
# busy address wedges Electrum for everyone (single-threaded RPC).
jsonrpc_timeout = 90
index_lookup_limit = 5000
index_batch_size = 10
server_banner = "Umbrel electrs header-v2 (BLAKE2b)"
# Clients allowed to negotiate protocol 1.4 on this v2-header chain. They are still refused
# block headers; mempool's backend only queries scripthashes, so it is safe here.
legacy_protocol_clients = "mempool-v2"
