# Lazarus DATUM Prime (primed). Copy to prime.toml, chmod 600.
# Do not commit a live payout address or cookie path.
#
# Every key the previous lazarus-prime accepted is still accepted here, so an
# existing lazarus-prime.toml starts unchanged. Keys it has no use for
# (activation-height, verify-shares) are reported once at startup and otherwise ignored.
#
# Refuse stock empty-first / size-class gateways. Hello UA must be lazarus-gateway*
# or contain lazarus-split. Lazarus production sets this true.
# require-split-gateway = false
#
# Gateway builds, by git-hash prefix (7 to 40 hex digits), that hand every miner coinbase
# section 0 (the whole reward to the one script they were configured with) whatever split
# they hold, so every block they find owes the window the whole reward. A session whose hello
# (v0.4.1-beta/<hash>) names one is configured with the gateway's own payout script once its
# first 16 shares all name that one payout, and left there while no other payout mines on it:
# its work becomes its own solo work, accepted but not credited in the window, and a find owes
# nobody. A second payout on the session puts it back on the pool for the rest of the session.
# Its operator loses TIDES credit and takes solo variance; the pool stops owing make-goods.
# A build with local changes (<hash>+), a lazarus-split UA and the house gateway
# are never matched; an entry that is not 7-40 hex digits matches nothing. Empty (default):
# nothing is held. The builds known to do this are CONVOY commits from c61c2e7 up to, not
# including, 155b6bf. The ones seen live (beb9461 is not in the published history):
# held-split-builds = ["e894b8a", "f74c22a", "2fea7e5", "57f1aee", "beb9461"]
#
# Hold a class-limited CONVOY gateway's coinbasers to the payee bytes its smallest size class
# keeps, learned per session from its own Partial shares (the same bytes on 3 coinbasers) and
# learned again six hours after it was last set. The class then keeps the whole list, a block
# found on it is a full split, and the payees that did not fit wait in carry instead of a
# make-good. Only CONVOY-generation C gateways; never lazarus-gateway, lazarus-split, ratum, the
# house gateway or a held-split build. Off (default): every reply is what it always was.
# BEFORE TURNING IT ON the fee wallet must hold back the carry these blocks record in
# carry_reserved_sats, or it sweeps miners' money as fee: see README, "Class budgets". Once it
# does, say so with class-budget-fee-wallet-reserves = true; class-budget without that is
# ignored, with a warning at startup.
# class-budget = false
# class-budget-fee-wallet-reserves = false
# No reply is held to a class budget while carry on the books is at or over this many sats;
# they are again once it is back under three quarters of it. Default 5 XBT.
# class-budget-carry-ceiling = 500000000

# DATUM listener gateways connect to.
listen = "0.0.0.0:28915"
# HTTP: /stats.json (pool UI), /ledger.json (legacy credits view), /healthz.
stats-listen = "127.0.0.1:28916"
# Only reported in stats.
advertise-address = "datum.lazarus-xbt.xyz:28915"
# Key, ledger, block log, and mirrored stats.json / ledger.json.
data-dir = "/home/umbrel/blake2b/lazarus-prime"
# key-file = "/home/umbrel/blake2b/lazarus-prime/prime.key"   # default: <data-dir>/prime.key
# Handshake MOTD. Gateways print it as "DATUM Server MOTD". Cap is 511 bytes
# (stock DATUM strncpy). Same line as the pool site footer.
motd = "Proverbs 11:1 — a just weight is his delight."
headline = "Lazarus"

# Pool's own address: receives the fee and any remainder the split cannot place.
# Gateways are told to pay this script; it is also their `mining.pool_address`.
payout-address = "<your address>"
coinbase-tag = "Lazarus"
# Nonzero; identifies this Prime to gateways.
prime-id = 1
# mainnet | testnet | signet | regtest. Decides which miner addresses are payable.
network = "mainnet"

# TIDES window in multiples of network difficulty (work, not time).
window = 8
# Floor on the window target in difficulty-1 shares; only matters where network
# difficulty is tiny (regtest). 0 disables.
window-min-work = 0
# Floor for split outputs, sats. An identity under it is not paid this block; what it
# earned is carried forward and paid on top of its first output that clears the floor.
min-payout = 546
# A miner who stops with less than min-payout on the books would wait for ever. After this many
# days without a share its balance is *stale*: listed in stats.json (window.stale), payable by
# hand (scripts/stale_payout.py), and, with stale-coinbase, paid whole by the next block that
# has room once everyone mining has been placed. 0 turns all of it off.
stale-after-days = 7
# Smallest stale balance worth an output, sats (not below 546).
stale-min-payout = 10000
stale-coinbase = true
# Most stale balances one coinbase pays; a backlog drains over blocks.
stale-per-block = 25
# DATUM / Prime-gateway fee in basis points (0 = free).
fee-bps = 0
# Public house-stratum fee (1000 = 10%). 0 inherits fee-bps.
stratum-fee-bps = 1000
# Share of the stratum fee handed to DATUM work instead of kept, in basis points of stratum
# work's value (500 = 5 points of the 10% above). Not an output of the coinbase: when a
# block is found it is credited to the window's DATUM miners as carry, pro rata by DATUM work,
# and paid out of the pool's remainder with each one's next output that clears min-payout — so
# a gateway too small for a given coinbase is credited just the same. Must not exceed
# stratum-fee-bps. 0 turns it off.
datum-rebate-bps = 500

# Grace for an address that starts on the public stratum, so a miner whose own gateway is down
# is not charged a donation-level stratum-fee-bps while it fails over. For this many hours from
# the address's first stratum share, its stratum work pays stratum-grace-fee-bps (and
# stratum-grace-rebate-bps of it goes to DATUM work) instead. An address that has had DATUM work
# here gets stratum-grace-datum-hours. After stratum-grace-rearm-hours off the public stratum the
# next share starts a new grace (0: one grace per address). stratum-grace-epoch (unix time) is when
# the clock is taken to have started for addresses already on stratum when this is first switched on.
# Off unless stratum-grace-hours is set.
# stratum-grace-hours = 24
# stratum-grace-datum-hours = 96
# stratum-grace-fee-bps = 2500
# stratum-grace-rebate-bps = 1250
# stratum-grace-rearm-hours = 168
# stratum-grace-epoch = 0
# Same, out of each dedicated-solo block's reward: when a block whose coinbase is tagged
# solo-coinbase-tag and pays the pool script lands on chain, this share of its value is
# credited to the DATUM miners then in the window. Off: dedicated solo keeps its own 5% fee
# and owes nothing to the window.
solo-rebate-bps = 0
# solo-coinbase-tag = "Lazarus/solo"
# Signing keys (hex) of the pool's own public-stratum gateway: the full 64-digit key, or a
# prefix of at least 16 digits. Remote DATUM users who run lazarus-gateway are not matched
# by UA — only loopback (default) and these keys pay the higher fee. A shorter prefix still
# matches but is warned about at startup. A house gateway is also
# trusted with its shares' difficulty (its whole-coinbase form carries no target byte), so
# give the full key, and turn house-loopback off if anything on this host forwards outside
# connections to the DATUM port: through a local proxy every gateway arrives from 127.0.0.1.
# house-gateways = ["9d992e5cfec05102..."]
# A share whose difficulty is not part of what it hashed (an older lazarus-gateway away from
# the pool host; a gateway with an unfamiliar scriptSig layout) is not refused. It is credited
# by its hash alone: 2^uncommitted-pot if the hash meets that, nothing otherwise. Fair on
# average for miners at any vardiff up to it, so keep it at or above the largest vardiff in use.
# uncommitted-pot = 20
# house-loopback = true
# Smallest share difficulty accepted; power of two. Also the vardiff floor sent to gateways.
# A share under it is not refused: it is credited by its hash alone, at this difficulty, so a
# small miner behind a gateway that ignores the floor earns the same on average. What the floor
# buys is that only a hash meeting it touches the ledger, the duplicate set and the identity
# table; at 1 a flood of those costs an ASIC nothing.
min-diff = 1024
# Sats of slack per issued output when checking a coinbase against the split.
split-tolerance = 2
# Shares one height behind the tip are accepted for this many seconds after the tip moved.
stale-grace-secs = 30
# Bounds on what an unknown gateway key can make the Prime hold. A gateway is one
# connection; a farm behind one address is a few.
# max-connections = 256
# max-connections-per-ip = 8
# Coinbase-section bytes one session may have buffered across its job slots.
# session-coinbase-budget = 4194304

# Knots JSON-RPC. Cookie wins if both cookie and user/password are set.
rpc = "http://127.0.0.1:9332"
rpc-cookie = "/home/umbrel/umbrel/app-data/bitcoin-knots/data/bitcoin/.cookie"
# rpc-user = ""
# rpc-password = ""
# Tip poll interval, seconds.
poll = 0.5

# Import a lazarus-prime ledger.json into the window once, if the window is empty.
# import-ledger = "/home/umbrel/blake2b/lazarus-prime/ledger.json"
